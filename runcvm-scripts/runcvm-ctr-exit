#!/.runcvm/guest/bin/bash

# Load RunCVM's own environment, saved by runcvm-ctr-entrypoint
. /.runcvm/config

# Load defaults and aliases
. $RUNCVM_GUEST/scripts/runcvm-ctr-defaults

# runcvm-init execs this script when it exits.
# It:
# - performs any post-VM tests.
# - retrieves any saved exit code.
# - resets terminal readline horizontal scroll
# - exits with exit code

# Prints PID 1's exit status from the last 'Attempted to kill init! exitcode=0x<wait status>' panic
# in the kernel log (see runcvm-ctr-qemu). As for a container's process, a process ended by
# signal N has status 128+N.
pid1_exit_status() {
  local line status=""

  [ -f /.runcvm/state/kernel.log ] || return 1
  while IFS= read -r line
  do
    [[ "$line" =~ "Attempted to kill init! exitcode=0x"([0-9a-fA-F]+) ]] && status=$(( 16#${BASH_REMATCH[1]} ))
  done </.runcvm/state/kernel.log
  [ -n "$status" ] || return 1

  if (( (status & 127) == 0 )); then
    echo $(( (status >> 8) & 255 ))
  else
    echo $(( 128 + (status & 127) ))
  fi
}

# The exit status, in order of preference: the one the workload saved in /.runcvm/exitcode; PID 1's,
# from the kernel log; or the one the workload gave qemu-exit, which on x86 ends QEMU with status
# 1+2*<status> ($1).
if [ -f /.runcvm/exitcode ]; then
  read CODE </.runcvm/exitcode

  # Convert negative codes to positive and ensure in acceptable range (0-255)
  CODE=$(( $CODE & 255 ))
elif CODE=$(pid1_exit_status); then
  :
elif [ -n "$1" ]; then
  CODE=$(( ($1+1)/2 ))
fi

# Workaround for https://github.com/cirosantilli/linux-kernel-module-cheat/issues/110
tput smam 2>/dev/null

exit ${CODE:-0}