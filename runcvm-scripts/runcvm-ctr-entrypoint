#!/.runcvm/guest/bin/bash -e

# DEBUG
if [[ "$RUNCVM_BREAK" =~ (prenet|postnet) ]]; then set -x; fi

# READ THE WORKLOAD'S ENVIRONMENT
# runcvm-runtime passes it as a count N, then N NAME=VALUE entries, before the original
# entrypoint and command; this script's own environment is RunCVM's alone.
env=("${@:2:$1}")
shift $(($1 + 1))

# SAVE ENTRYPOINT
args=("$@")
printf "%s\n" "${args[@]}" >/.runcvm/entrypoint

# SET HOME IN THE WORKLOAD'S ENVIRONMENT IF NEEDED

# - See https://github.com/moby/moby/issues/2968#issuecomment-35822318
#   for details of how Docker sets HOME.
#
# - What this means is that:
#   1. if HOME is defined in the image and
#      docker run:
#      a. does not define HOME
#         - config.json process.env[] will show the image-defined value and this value will be used
#         - docker exec
#           - does not define HOME, then process.json env[] will show the image-defined value and this value will be used
#           - does define HOME, then process.json env[] will show the exec-defined value and this value will be used
#      b. does define HOME, config.json process.env[] will show the docker run-defined value and this value will be used
#         - docker exec
#           - does not define HOME, then process.json env[] will show the docker run-defined value and this value will be used
#           - does define HOME, then process.json env[] will show the exec-defined value and this value will be used
#   (the above is irrespective of -u setting)
#
#   2. if HOME is not defined in the image and
#      docker run:
#      a. does not define HOME
#         - config.json process.env[] will show no HOME value and the user's default homedir will be used
#         - docker exec
#           - does not define HOME, then process.json env[] will show no HOME value and the user's default homedir will be used
#           - does define HOME, then process.json env[] will show the exec-defined value and this value will be used
#      b. does define HOME, config.json process.env[] will show the docker run-defined value and this value will be used
#         - docker exec
#           - does not define HOME, then process.json env[] will show the docker run-defined value and this value will be used
#           - does define HOME, then process.json env[] will show the exec-defined value and this value will be used

# In case 2a, runc sets HOME for the process it starts, from the user's entry in /etc/passwd.
# The process runc starts, however, is RunCVM's own (runcvm-ctr-entrypoint or runcvm-ctr-exec),
# run as root (to run virtiofsd and QEMU, and to reach the VM), with RunCVM's own HOME.
# The workload's environment, as passed to these scripts by runcvm-runtime, holds HOME only
# where the image, docker run or docker exec defined it; runcvm-runtime also indicates this:
# - in the docker run case, via the RUNCVM_HAS_HOME env var
# - in the docker exec case, via an argument to runcvm-ctr-exec
#
# Where HOME is not defined, RunCVM sets it in the workload's environment to the requested
# user's home directory (in accordance with https://github.com/moby/moby/issues/2968), or, as
# runc does for a user with no home directory in /etc/passwd, to /.

if [ "$RUNCVM_HAS_HOME" == "0" ]; then
  HOME_DIR=$($RUNCVM_GUEST/usr/bin/getent passwd "${RUNCVM_UIDGID%%:*}" | $RUNCVM_GUEST/bin/cut -d':' -f6)
  env+=("HOME=${HOME_DIR:-/}")
fi

if [ -z "$RUNCVM_CPUS" ] || [ "$RUNCVM_CPUS" -le 0 ]; then
  RUNCVM_CPUS=$($RUNCVM_GUEST/bin/busybox nproc)
fi

# SAVE RUNCVM'S OWN ENVIRONMENT, for its other scripts
export -n SHLVL OLDPWD

export >/.runcvm/config

# NOW LOAD DEFAULT ENV AND PATH
. $RUNCVM_GUEST/scripts/runcvm-ctr-defaults

# SAVE THE WORKLOAD'S ENVIRONMENT, without RunCVM's own variables, NUL-separated, for
# runcvm-vm-start
workload_env env
: >/.runcvm/env
[ ${#env[@]} -eq 0 ] || printf '%s\0' "${env[@]}" >/.runcvm/env

# LOAD IP MANIPULATION FUNCTIONS
. $RUNCVM_GUEST/scripts/runcvm-ip-functions

# SAVE PWD
busybox pwd >/.runcvm/pwd

# DEBUG
if [[ "$RUNCVM_BREAK" =~ prenet ]]; then bash; fi

# SAVE NETWORKING CONFIG AND CONFIGURE BRIDGES

# Identify default gateway device and IP address. '|| true' keeps 'bash -e' from exiting silently
# when there is no default route, so that the check below can explain it.
read -r DOCKER_GW_IF DOCKER_GW_IF_IP < \
  <(ip -json route show | jq -r '.[] | (select(.dst == "default") | [.dev, .gateway]) | @tsv') || true
# e.g. eth0 172.25.10.1

# The VM's networking, and 'docker exec' (which reaches the VM over it), are configured from the
# interface holding the default route.
if [ -z "$DOCKER_GW_IF" ]; then
  echo "RunCVM: Error: the container has no default route (as with --network=none, or only --internal networks); a RunCVM Container/VM needs a network that provides a default route" >&2
  exit 1
fi

# Identify IPv6 default gateway device and IP address, if any.
read -r DOCKER_GW_IF6 DOCKER_GW_IF6_IP < \
  <(ip -6 -json route show default | jq -r '.[0] | [.dev, .gateway] | @tsv')
# e.g. eth0 fd00:1::1

# QEMU_BRIDGE_IP, on the default gateway interface's bridge, is the source of 'docker exec'
# connections to the VM, which reaches it on its own link (see runcvm-vm-init), never through the
# Docker network's gateway.
QEMU_BRIDGE_IP=169.254.1.1
RUNCVM_DNS_IP=169.254.169.254

mkdir -p /.runcvm/network/devices

# The 'ip -N' parses below match protocols and scopes by number (protocol 2 is 'kernel'; scope 0 is
# 'global' and 253 'link'), because their names come from /etc/iproute2, which is the image's.

# Save non-link-scope non-default routes for later restoration in the running VM.
ip -N -json route show | jq -r '.[] | select(.scope != "253" and .dst != "default") | "\(.dst) \(.gateway) \(.dev) \(.prefsrc)"' >/.runcvm/network/routes

# Save non-kernel (i.e. non-connected, non-link-local) non-default IPv6 routes
# for later restoration in the running VM. Kernel-derived on-link prefix routes
# are not saved: the VM's kernel recreates each one when the VM adds the
# interface's IPv6 address. fe80::/64 is link-local, and likewise recreated by
# the kernel when the VM brings up its interface.
ip -N -6 -json route show | jq -r '.[] | select(.protocol != "2" and .dst != "default" and .dst != "fe80::/64") | "\(.dst) \(.gateway) \(.dev)"' >/.runcvm/network/routes6

for if in $(ip -json link show | jq -r '.[] | .ifname')
do

  [ "$if" = "lo" ] && continue

  read -r DOCKER_IF_IP DOCKER_IF_IP_NETPREFIX DOCKER_IF_MAC DOCKER_IF_MTU < \
    <(ip -json addr show "$if" | jq -r '.[0] as $l | first($l.addr_info[] | select(.family=="inet")) as $a | [$a.local, $a.prefixlen, $l.address, $l.mtu] | @tsv')
  # e.g. 172.25.10.2 24 52:54:00:b7:0b:b6 1500

  # Capture the on-link (connected) route prefix for this interface, before its
  # address (and the kernel route derived from it) is flushed below.
  DOCKER_NET=$(ip -json route show dev "$if" scope 253 | jq -r '.[0].dst // empty')

  # Fall back to deriving the prefix from the interface's IPv4 address, for an
  # interface with no on-link route (otherwise 'ip route add' below would fail
  # and abort the entrypoint).
  if [ -z "$DOCKER_NET" ]; then
    DOCKER_NET=$(ip_prefix_to_network "$DOCKER_IF_IP" "$DOCKER_IF_IP_NETPREFIX")/"$DOCKER_IF_IP_NETPREFIX"
  fi

  # Capture a global IPv6 address for this interface, if any. Absence of a
  # devices6/<if> file for an interface is what signals "no IPv6 on this
  # interface" downstream. Unlike IPv4, no container-side IPv6 address or
  # route is restored below: the VM is the sole owner of this address.
  # (Under `set -e`, this read legitimately fails, with nothing to abort
  # for, whenever this interface has no global IPv6 address - the common
  # case for an IPv4-only container - since the underlying jq select()
  # then produces no output at all for read to consume.)
  read -r DOCKER_IF6_IP DOCKER_IF6_IP_NETPREFIX < \
    <(ip -N -json addr show "$if" | jq -r '.[0].addr_info[] | select(.family=="inet6" and .scope=="0" and ((.deprecated // false) | not)) | [.local, .prefixlen] | @tsv' | head -n 1) || true

  # Save container network parameters
  if [ "$if" = "$DOCKER_GW_IF" ]; then
    printf "%s %s %s %s %s %s\n" \
      "$if" "$DOCKER_IF_MAC" "$DOCKER_IF_MTU" "$DOCKER_IF_IP" "$DOCKER_IF_IP_NETPREFIX" "$DOCKER_GW_IF_IP" \
      >/.runcvm/network/devices/$if
    ln -s "$if" /.runcvm/network/devices/default
  else
    printf "%s %s %s %s %s %s\n" \
      "$if" "$DOCKER_IF_MAC" "$DOCKER_IF_MTU" "$DOCKER_IF_IP" "$DOCKER_IF_IP_NETPREFIX" "-" \
      >/.runcvm/network/devices/$if
  fi

  if [ -n "$DOCKER_IF6_IP" ]; then
    mkdir -p /.runcvm/network/devices6
    if [ "$if" = "$DOCKER_GW_IF6" ]; then
      printf "%s %s %s %s\n" \
        "$if" "$DOCKER_IF6_IP" "$DOCKER_IF6_IP_NETPREFIX" "$DOCKER_GW_IF6_IP" \
        >/.runcvm/network/devices6/$if
      ln -s "$if" /.runcvm/network/devices6/default
    else
      printf "%s %s %s %s\n" \
        "$if" "$DOCKER_IF6_IP" "$DOCKER_IF6_IP_NETPREFIX" "-" \
        >/.runcvm/network/devices6/$if
    fi
  fi

  # RECONFIGURE CONTAINER NETWORK
  ip addr flush dev "$if"

  QEMU_BRIDGE="br-$if"

  # The bridge's MAC address is fixed, rather than taken from a port, so that the VM can be told
  # it. It is derived from the interface's, as the VM's is (52:54:00:...), so that it is
  # distinct on the Docker network.
  QEMU_BRIDGE_MAC="52:55:00:${DOCKER_IF_MAC:9}"

  # Create the container bridge
  # See https://bugs.launchpad.net/neutron/+bug/1738659
  ip link add "$QEMU_BRIDGE" address "$QEMU_BRIDGE_MAC" type bridge forward_delay 0 ageing 0

  # Add the original container interface to the bridge and bring it up.
  ip link set dev "$if" master "$QEMU_BRIDGE"
  ip link set dev "$if" up

  # Bring the bridge up.
  ip link set dev "$QEMU_BRIDGE" up

  # Restore network route via this bridge
  ip route add "$DOCKER_NET" dev "$QEMU_BRIDGE"

  # If this interface is the default gateway interface, perform additional special steps.
  if [ "$if" = "$DOCKER_GW_IF" ]; then

    # Add a private IP to this bridge.
    # We need it so the bridge can receive traffic, but the IP won't ever see the light of day.
    ip addr add "$QEMU_BRIDGE_IP" dev "$QEMU_BRIDGE"

    # The VM reaches the bridge's address on its own link, at this MAC address.
    echo "$if $QEMU_BRIDGE_MAC $QEMU_BRIDGE_IP" >/.runcvm/network/bridge

    # Restore default gateway route via this bridge.
    ip route add default via "$DOCKER_GW_IF_IP" dev "$QEMU_BRIDGE"

    # Accept DNS requests for $RUNCVM_DNS_IP; these will be passed to dnsmasq
    XTABLES_LIBDIR=$RUNCVM_GUEST/usr/lib/xtables xtables-nft-multi iptables -t nat -A PREROUTING -d "$RUNCVM_DNS_IP/32" -p udp -m udp --dport 53 -j REDIRECT

    # Accept VNC requests on published port (5900 + display number)
    if [[ "$RUNCVM_DISPLAY_MODE" = "vnc" ]] || is_natural_int "$RUNCVM_QEMU_VNC_DISPLAY"; then
      XTABLES_LIBDIR=$RUNCVM_GUEST/usr/lib/xtables xtables-nft-multi iptables -t nat -A PREROUTING -p tcp -m tcp --dport $((RUNCVM_QEMU_VNC_DISPLAY+5900)) -j REDIRECT
    fi

    # Match UDP port 53 traffic, outgoing via the QEMU bridge, from the bridge's own IP:
    # -> Masquerade as if from the VM's IP.
    #    This allows outgoing DNS requests from the VM to be received by dnsmasq running in the container.
    XTABLES_LIBDIR=$RUNCVM_GUEST/usr/lib/xtables xtables-nft-multi iptables -t nat -A POSTROUTING -o "$QEMU_BRIDGE" -s "$QEMU_BRIDGE_IP/32" -p udp -m udp --sport 53 -j SNAT --to-source "$DOCKER_IF_IP"
    XTABLES_LIBDIR=$RUNCVM_GUEST/usr/lib/xtables xtables-nft-multi iptables -t nat -A POSTROUTING -o "$QEMU_BRIDGE" -s "$QEMU_BRIDGE_IP/32" -p udp -m udp --dport 53 -j SNAT --to-source "$DOCKER_IF_IP"
  fi

done

# FIXME: Bind-mount /etc/resolv.conf as well as /vm/etc/resolv.conf to prevent them showing in 'docker diff'
cat /vm/etc/resolv.conf >/etc/resolv.conf
RESOLV_CONF_NEW=$(busybox sed -r "s/127.0.0.11/$RUNCVM_DNS_IP/" /vm/etc/resolv.conf)
echo "$RESOLV_CONF_NEW" >/vm/etc/resolv.conf

# LAUNCH DNSMASQ
# It will receive local DNS requests (within the container, on 127.0.0.1)
# and requests redirected locally (via the iptables PREROUTING REDIRECT rule) for $RUNCVM_DNS_IP.
# '-C /dev/null' keeps it from reading the image's /etc/dnsmasq.conf (and any conf-dir it names).
dnsmasq -C /dev/null -u root --no-hosts

# LAUNCH VIRTIOFSD
$RUNCVM_GUEST/scripts/runcvm-ctr-virtiofsd &

# DEBUG
if [[ "$RUNCVM_BREAK" =~ postnet ]]; then bash; fi

# LAUNCH INIT SUPERVISING QEMU
# FIXME: Add -v to debug
exec $RUNCVM_GUEST/sbin/runcvm-init -c $RUNCVM_GUEST/scripts/runcvm-ctr-qemu
