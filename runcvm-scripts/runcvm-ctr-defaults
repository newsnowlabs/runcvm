#!/bin/bash

RUNCVM_GUEST=${RUNCVM_GUEST:-/.runcvm/guest}
RUNCVM_PATH=$RUNCVM_GUEST/usr/sbin:$RUNCVM_GUEST/usr/bin:$RUNCVM_GUEST/sbin:$RUNCVM_GUEST/bin:$RUNCVM_GUEST/usr/lib/qemu

QEMU_VIRTIOFSD_SOCKET=/run/.virtiofs.sock
QEMU_GUEST_AGENT=/run/.qemu-guest-agent
QEMU_MONITOR_SOCKET=/run/.qemu-monitor-socket

SSHD_PORT=22222

# Variables used only by RunCVM: removed from the workload's environment (by workload_env),
# and from the environment of RunCVM's own long-running processes in the VM (by clean_env).
# One per line, sorted, so that changes merge cleanly.
RUNCVM_ENV_VARS=(
  RUNCVM_BIOS
  RUNCVM_BIOS_DEBUG
  RUNCVM_BREAK
  RUNCVM_CGROUPFS
  RUNCVM_CPUS
  RUNCVM_DISKS
  RUNCVM_DISPLAY_MODE
  RUNCVM_DNS_IP
  RUNCVM_GUEST
  RUNCVM_HAS_HOME
  RUNCVM_HUGETLB
  RUNCVM_INIT
  RUNCVM_IPV6
  RUNCVM_KERNEL
  RUNCVM_KERNEL_APPEND
  RUNCVM_KERNEL_DEBUG
  RUNCVM_KERNEL_FALLBACK
  RUNCVM_KERNEL_INITRAMFS_PATH
  RUNCVM_KERNEL_MODULES
  RUNCVM_KERNEL_MOUNT_LIB_MODULES
  RUNCVM_KERNEL_PATH
  RUNCVM_KERNEL_ROOT
  RUNCVM_MEM_SIZE
  RUNCVM_QEMU_ACCEL
  RUNCVM_QEMU_ARCH
  RUNCVM_QEMU_DEBUG
  RUNCVM_QEMU_DISPLAY
  RUNCVM_QEMU_MEM_PREALLOC
  RUNCVM_QEMU_NET_VHOST
  RUNCVM_QEMU_TCG_TB_MEM_SIZE
  RUNCVM_QEMU_USB
  RUNCVM_QEMU_VGA
  RUNCVM_QEMU_VNC_DISPLAY
  RUNCVM_RUNTIME_DEBUG
  RUNCVM_SHUTDOWN
  RUNCVM_SYS_ADMIN
  RUNCVM_TMPFS
  RUNCVM_TTY
  RUNCVM_UIDGID
  RUNCVM_VIRTIOFSD_CACHE
  RUNCVM_VIRTIOFSD_CACHE_PATHS
  RUNCVM_VIRTIOFSD_KILLPRIV
  RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT
  RUNCVM_VIRTIOFSD_SUBMOUNT_CACHE
  RUNCVM_VM_MOUNTPOINT
)

clean_env() {
  export -n "${RUNCVM_ENV_VARS[@]}"

  # May be set in VM by busybox init process
  export -n USER
}

# workload_env <array name>
# Remove RunCVM's own variables (RUNCVM_ENV_VARS) from the named array of NAME=VALUE entries,
# which then holds the workload's environment.
workload_env() {
  local -n _entries="$1"
  local -A _drop
  local _name _entry _kept=()

  for _name in "${RUNCVM_ENV_VARS[@]}"; do _drop[$_name]=1; done

  for _entry in "${_entries[@]}"
  do
    _name="${_entry%%=*}"
    if [ -z "$_name" ] || [ -z "${_drop[$_name]}" ]; then
      _kept+=("$_entry")
    fi
  done

  _entries=("${_kept[@]}")
}

# disk_fs <fs>
# Looks up filesystem <fs> in $RUNCVM_GUEST/etc/disk-filesystems, the filesystems that disks in
# RUNCVM_DISKS may have, setting DISK_FS_MODULES (an array of kernel modules), DISK_FS_LABEL_OPT,
# DISK_FS_SUBDIRS_LABEL and DISK_FS_MKFS (an array: the mkfs command and its options). Returns 1
# if <fs> is not listed. Fields are split at whitespace, whatever the caller's IFS.
disk_fs() {
  local fs modules packages label_opt label mkfs
  local IFS=$' \t\n'

  while read -r fs modules packages label_opt label mkfs
  do
    [[ -z "$fs" || "$fs" = \#* || "$fs" != "$1" ]] && continue
    IFS=',' read -r -a DISK_FS_MODULES <<< "$modules"
    DISK_FS_LABEL_OPT="$label_opt"
    DISK_FS_SUBDIRS_LABEL="$label"
    read -r -a DISK_FS_MKFS <<< "$mkfs"
    return 0
  done <"$RUNCVM_GUEST/etc/disk-filesystems"

  return 1
}

# disk_fs_list <field>
# Prints field <field> (1, the name; 5, the subdirs label) of each filesystem in
# $RUNCVM_GUEST/etc/disk-filesystems, one per line.
disk_fs_list() {
  awk -v f="$1" '$1 !~ /^#/ && NF { print $f }' "$RUNCVM_GUEST/etc/disk-filesystems"
}

load_network() {
  local if="${1:-default}"
  [ -d /.runcvm/network/devices ] && [ -s /.runcvm/network/devices/$if ] || return 1
  read -r DOCKER_IF DOCKER_IF_MAC DOCKER_IF_MTU DOCKER_IF_IP DOCKER_IF_IP_NETPREFIX DOCKER_IF_IP_GW </.runcvm/network/devices/$if
  return 0
}

# Loads IPv6 addressing for interface $1 (or the default-route interface, if
# omitted), if any was captured. Returns 1 (leaving DOCKER_IF6_* empty) for an
# interface with no IPv6 address, or when the container has no IPv6 at all,
# i.e. /.runcvm/network/devices6 does not exist.
load_network6() {
  local if="${1:-default}"
  # Always reset first: unlike load_network(), this is routinely called for
  # interfaces that turn out to have no IPv6, and callers rely on
  # DOCKER_IF6_* being genuinely empty (not left over from a previous
  # interface) when this returns 1.
  DOCKER_IF6= DOCKER_IF6_IP= DOCKER_IF6_IP_NETPREFIX= DOCKER_IF6_IP_GW=
  [ -d /.runcvm/network/devices6 ] && [ -s /.runcvm/network/devices6/$if ] || return 1
  read -r DOCKER_IF6 DOCKER_IF6_IP DOCKER_IF6_IP_NETPREFIX DOCKER_IF6_IP_GW </.runcvm/network/devices6/$if
  return 0
}

# Prints the path of command $1 in RunCVM's own tool directories (RUNCVM_PATH), whatever the
# caller's IFS; returns 1 if it is not there.
which() {
  local cmd="$1" p
  local IFS=':'
  for p in $RUNCVM_PATH; do [ -x "$p/$cmd" ] && echo "$p/$cmd" && return 0; done
  return 1
}

create_aliases() {
  # Commands to run from the RunCVM guest tree, regardless of the workload's PATH.
  # One per line, sorted, so that changes merge cleanly.
  local cmds=(
    awk
    bash
    blkid
    busybox
    cat
    chgrp
    chmod
    cut
    dbclient
    dnsmasq
    dropbear
    dropbearkey
    findmnt
    getent
    grep
    head
    hostname
    init
    jq
    ln
    ls
    mkdir
    mke2fs
    mount
    nc
    nft
    poweroff
    ps
    qemu-ga
    qemu-system-aarch64
    qemu-system-x86_64
    rm
    rmdir
    s6-applyuidgid
    sh
    sysctl
    touch
    tr
  )

  local cmd
  for cmd in "${cmds[@]}"
  do
    eval "$cmd() { $(which $cmd) \"\$@\"; }"
  done

  # Commands that also need their own environment, so that they use nothing from the image:
  # - ip would load link-type plugins (e.g. for 'type bridge') from the image's /usr/lib/ip;
  #   RunCVM ships no plugins, so IP_LIB_DIR names a directory that does not exist.
  # - tput would use the image's terminfo database.
  eval "ip() { IP_LIB_DIR=$RUNCVM_GUEST/usr/lib/ip $(which ip) \"\$@\"; }"
  eval "tput() { TERMINFO=$RUNCVM_GUEST/usr/share/terminfo $(which tput) \"\$@\"; }"
}

create_aliases