#!/.runcvm/guest/bin/bash

# Decodes runcvm-ctr-exec's encoding: base64 of NUL-terminated values. Runs before
# runcvm-ctr-defaults is loaded (RUNCVM_GUEST is not yet set), with dropbear's PATH, so must name
# RunCVM's own busybox explicitly.
decode() {
  /.runcvm/guest/bin/busybox base64 -d
}

error() {
  echo "OCI runtime exec failed: exec failed: unable to start container process: chdir to cwd (\"$cwd\") set in config.json failed: no such file or directory: unknown"
  exit 126
}

uidgid="$1"
cwd_enc="$2"
shift 2

IFS=':' read -r uid gid additionalGids <<< "$uidgid"

args_enc="$1"
env_enc="$2"

mapfile -t -d '' args < <(echo -n "$args_enc" | decode)
mapfile -t -d '' env < <(echo -n "$env_enc" | decode)
IFS= read -r -d '' cwd < <(echo -n "$cwd_enc" | decode)

cd "$cwd" 2>/dev/null && unset OLDPWD || error

# Load RunCVM's own environment, saved by runcvm-ctr-entrypoint
. /.runcvm/config

# Load defaults and aliases
. $RUNCVM_GUEST/scripts/runcvm-ctr-defaults

exec -c $RUNCVM_GUEST/bin/busybox env -i "${env[@]}" $RUNCVM_GUEST/usr/bin/s6-applyuidgid -u $uid -g $gid -G "$additionalGids" "${args[@]}"