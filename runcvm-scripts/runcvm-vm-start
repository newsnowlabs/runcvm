#!/.runcvm/guest/bin/bash

# Load original environment
. /.runcvm/config

# Load defaults and aliases
. $RUNCVM_GUEST/scripts/runcvm-ctr-defaults

if [ -f /.runcvm/once ]; then
  poweroff
  exit 0
else
  touch /.runcvm/once
fi

# Change to saved PWD
cd $(cat /.runcvm/pwd) && unset OLDPWD

# Reload original environment
. /.runcvm/config

# Load original entrypoint
mapfile -t ARGS </.runcvm/entrypoint

# Clean RUNCVM env vars
clean_env

IFS=':' read -r uid gid additionalGids <<< "$RUNCVM_UIDGID"
if [ "${RUNCVM_STDIO_BRIDGE:-0}" = 1 ]; then
  # BusyBox init owns reaping and shutdown. The bridge owns application pipes
  # and returns only after the host has acknowledged delivery of its output.
  "$RUNCVM_GUEST/sbin/runcvm-stdio" --guest auto -- \
    "$RUNCVM_GUEST/bin/s6-applyuidgid" -u "$uid" -g "$gid" -G "$additionalGids" "${ARGS[@]}"
  code=$?
  echo "$code" >/.runcvm/exitcode
  poweroff
  exit "$code"
fi
exec $RUNCVM_GUEST/bin/s6-applyuidgid -u $uid -g $gid -G "$additionalGids" "${ARGS[@]}"
