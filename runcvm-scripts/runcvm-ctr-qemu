#!/.runcvm/guest/bin/bash

# Exit on errors
set -o errexit -o pipefail

# Load RunCVM's own environment, saved by runcvm-ctr-entrypoint
. /.runcvm/config

# Load defaults
. $RUNCVM_GUEST/scripts/runcvm-ctr-defaults && unset PATH

QEMU_IFUP="$RUNCVM_GUEST/scripts/runcvm-ctr-qemu-ifup"
QEMU_IFDOWN="$RUNCVM_GUEST/scripts/runcvm-ctr-qemu-ifdown"

INIT="init=$RUNCVM_GUEST/scripts/runcvm-vm-init"

# Must export TERMINFO so curses library can find terminfo database.
export TERMINFO="$RUNCVM_GUEST/usr/share/terminfo"

error() {
  echo "$1" >&2
  exit 1
}

# Prints path $1 in normal form: with repeated '/' collapsed and any trailing '/' removed.
# Fails if $1 is not absolute, is '/', or has a '.' or '..' component.
disk_normalise_path() {
  local path="$1"

  [[ "$path" = /* ]] || return 1

  while [[ "$path" = *//* ]]; do path="${path//\/\//\/}"; done
  path="${path%/}"

  [[ -n "$path" && "/$path/" != */./* && "/$path/" != */../* ]] || return 1

  echo "$path"
}

# Prints normalised path $1 with each symbolic link in the image's filesystem (below
# $RUNCVM_VM_MOUNTPOINT) resolved, as mounting at $1 in the VM would resolve it. Components that do
# not exist are kept as given. Fails after 40 links, as the kernel does.
disk_resolve_path() {
  local rest="${1#/}" resolved="" comp target links=0

  while [ -n "$rest" ]
  do
    comp="${rest%%/*}"
    if [[ "$rest" = */* ]]; then rest="${rest#*/}"; else rest=""; fi

    case "$comp" in
      ""|.) continue ;;
      ..) resolved="${resolved%/*}"; continue ;;
    esac

    if [ -L "$RUNCVM_VM_MOUNTPOINT$resolved/$comp" ]; then
      links=$((links+1))
      [ "$links" -le 40 ] || return 1
      target=$(busybox readlink "$RUNCVM_VM_MOUNTPOINT$resolved/$comp") || return 1
      [[ "$target" = /* ]] && resolved=""
      rest="${target#/}${rest:+/$rest}"
    else
      resolved="$resolved/$comp"
    fi
  done

  echo "${resolved:-/}"
}

# Prints the name of the top-level directory of a disk with layout 'subdirs' that holds destination
# $1, a normalised path: the path without its leading '/', with each '%', '-' and '=' encoded as
# '%25', '%2D' and '%3D', and then each '/' replaced by '-'. For example, '/var/lib/docker' is held
# in 'var-lib-docker', '/a/b' in 'a-b' and '/a-b' in 'a%2Db'.
#
# The encoding is reversible, so distinct destinations always have distinct names; and the name
# depends only on the destination, so it is the same on every boot. The name must contain no '=',
# because mke2fs's '-P SUBDIR=SRC' ends SUBDIR at the first '='.
disk_subdir() {
  local name="${1#/}"

  name="${name//%/%25}"
  name="${name//-/%2D}"
  name="${name//=/%3D}"
  name="${name//\//-}"

  echo "$name"
}

# The filesystem label that marks a disk with layout 'subdirs'. A disk's layout is chosen when it is
# created, and read from its label thereafter: any other label, or none, means layout 'root'.
DISK_SUBDIRS_LABEL="runcvm-subdirs"

# Prints path $1 with each character special to mke2fs's '-x PATTERN' wildcards ('\', '*', '?'
# and '[') escaped, so that the pattern matches only that path.
disk_glob_escape() {
  local path="$1"

  path="${path//\\/\\\\}"
  path="${path//\*/\\*}"
  path="${path//\?/\\?}"
  path="${path//\[/\\[}"

  echo "$path"
}

# Prints, one per line, each mountpoint directly below $RUNCVM_VM_MOUNTPOINT, other than /.runcvm,
# as its path in the VM: Docker's volumes, bind mounts and files such as /etc/hosts, and the
# kernel modules.
disk_vm_mounts() {
  local id parent mnt vm_id="" rest
  local IFS=$' \t\n'

  while read -r id parent _ _ mnt rest
  do
    if [ "$mnt" = "$RUNCVM_VM_MOUNTPOINT" ]; then
      vm_id="$id"
    fi
  done </proc/self/mountinfo

  while read -r id parent _ _ mnt rest
  do
    [ "$parent" = "$vm_id" ] || continue

    # Decode mountinfo's octal escapes (e.g. '\040' for a space).
    mnt=$(printf '%b' "$mnt")
    mnt="${mnt#"$RUNCVM_VM_MOUNTPOINT"}"

    [ "$mnt" = "/.runcvm" ] || echo "$mnt"
  done </proc/self/mountinfo
}

# Creates disk backing file $2, of size $3, for disk spec $1, if it does not already exist.
disk_create_file() {
  local spec="$1" src="$2" size="$3" dir

  if [[ -z "$size" ]]; then
    error "Error: disk spec '$spec' invalid: size must be specified if src '$src' does not exist"
  fi

  # Create directory for disk backing file, if needed.
  dir="$(busybox dirname "$src")"
  if ! [ -d "$dir" ]; then
    mkdir -p "$dir"
  fi

  # Create disk backing file.
  busybox truncate -s "$size" "$src" >&2 || error "Error: disk spec '$spec' invalid: truncate on '$src' with size '$size' failed"
}

# Argument, in positional form: <src>,<dst>[:<dst2>:...],<fs>[,<size>][,layout=subdirs|root]
# e.g. /volume/disk1,/var/lib/docker:/var/lib/containerd:/home,ext4,5G
#
# or in keyed form, when the first field begins with one of the keys followed by '=':
#   src=<src>,dst=<dst>[,dst=<dst2>...],fs=<fs>[,size=<size>][,layout=subdirs|root]
# with fields in any order, 'source' accepted for 'src', and 'target' and 'destination' for 'dst';
# e.g. src=/volume/disk1,dst=/var/lib/docker,dst=/home,fs=ext4,size=5G
#
# A disk with layout 'subdirs' (the default for a new disk) holds each destination's contents in its
# own top-level directory, named by disk_subdir. It is mounted at /.runcvm/disks/<id>, and each
# directory is bind-mounted over its destination.
#
# A disk with layout 'root' has exactly one destination, holds its contents at its root, and is
# mounted at that destination.
#
# A disk with destination '/' (a whole-root disk) holds the VM's whole root filesystem: see
# do_root_disk. It must be the disk's only destination, have fs 'ext4' and layout 'root', and be the
# only such disk.
do_disk() {
  local spec="$1"
  local id="$2"
  local src="" dsts dst fs="" size="" layout layout_opt="" field key value UUID LABEL i j path
  local whole_root=0
  local -a fields=() dests=() subdirs=() resolved=() populate=()
  local -A seen=()

  IFS=',' read -r -a fields <<< "$spec"

  if [[ "${fields[0]}" =~ ^(src|source|dst|target|destination|fs|size|layout)= ]]; then
    # Keyed form: every field is <key>=<value>, split at the first '='; only dst may be repeated.
    for field in "${fields[@]}"
    do
      [[ "$field" = *=* ]] || error "Error: disk spec '$spec' invalid: field '$field' must be of the form <key>=<value>"
      key="${field%%=*}"
      value="${field#*=}"

      case "$key" in
        source) key="src" ;;
        target|destination) key="dst" ;;
      esac

      case "$key" in
        src|fs|size|layout)
          [ -z "${seen[$key]}" ] || error "Error: disk spec '$spec' invalid: $key specified more than once"
          seen[$key]=1
          ;;
        dst)
          [ -n "$value" ] || error "Error: disk spec '$spec' invalid: dst must not be empty"
          dests+=("$value")
          ;;
        *)
          error "Error: disk spec '$spec' invalid: unknown option '$key'"
          ;;
      esac

      case "$key" in
        src) src="$value" ;;
        fs) fs="$value" ;;
        size) size="$value" ;;
        layout) layout_opt="$value" ;;
      esac
    done
  else
    # Positional form: <src>,<dst>[:<dst2>:...],<fs>, then an optional <size>, then options of the
    # form <key>=<value>.
    src="${fields[0]}"
    dsts="${fields[1]}"
    fs="${fields[2]}"

    for i in "${!fields[@]}"
    do
      [ "$i" -ge 3 ] || continue
      field="${fields[$i]}"
      case "$field" in
        layout=*)
          [ -z "$layout_opt" ] || error "Error: disk spec '$spec' invalid: layout specified more than once"
          layout_opt="${field#layout=}"
          ;;
        *=*)
          error "Error: disk spec '$spec' invalid: unknown option '${field%%=*}'"
          ;;
        *)
          [ "$i" -eq 3 ] || error "Error: disk spec '$spec' invalid: unexpected field '$field'"
          size="$field"
          ;;
      esac
    done

    if [[ "$dsts" = :* || "$dsts" = *: || "$dsts" = *::* ]]; then
      error "Error: disk spec '$spec' invalid: dst must not be empty"
    fi

    [ -z "$dsts" ] || IFS=':' read -r -a dests <<< "$dsts"
  fi

  if [[ -z "$src" || "${#dests[@]}" -eq 0 || -z "$fs" ]]; then
    error "Error: disk spec '$spec' invalid: src, dst and fs must all be specified"
  fi

  if [[ -n "$layout_opt" && "$layout_opt" != "subdirs" && "$layout_opt" != "root" ]]; then
    error "Error: disk spec '$spec' invalid: layout must be 'subdirs' or 'root'"
  fi

  if [[ -e "$src" && ! -f "$src" ]]; then
    error "Error: disk spec '$spec' invalid: src '$src' must be a plain file if it exists"
  fi

  # An existing disk keeps the layout it was created with, as recorded by its label.
  if [[ -f "$src" ]]; then
    LABEL=$(blkid -p -s LABEL -o value "$src") || true
    if [ "$LABEL" = "$DISK_SUBDIRS_LABEL" ]; then
      layout="subdirs"
    else
      layout="root"
    fi

    if [[ -n "$layout_opt" && "$layout_opt" != "$layout" ]]; then
      error "Error: disk spec '$spec' invalid: src '$src' exists, with layout '$layout', not '$layout_opt'"
    fi

    if [[ "$layout" = "root" && "${#dests[@]}" -gt 1 ]]; then
      error "Error: disk spec '$spec' invalid: src '$src' exists, with layout 'root', which holds exactly one dst"
    fi
  else
    layout="${layout_opt:-subdirs}"

    if [[ "$layout" = "root" && "${#dests[@]}" -gt 1 ]]; then
      error "Error: disk spec '$spec' invalid: layout 'root' holds exactly one dst"
    fi
  fi

  for dst in "${dests[@]}"
  do
    if [[ "$dst" =~ ^/+$ ]]; then
      whole_root=1
    fi
  done

  if [ "$whole_root" = "1" ]; then
    if [ "${#dests[@]}" -gt 1 ]; then
      error "Error: disk spec '$spec' invalid: dst '/' must be the disk's only dst"
    fi

    if [ "$fs" != "ext4" ]; then
      error "Error: disk spec '$spec' invalid: a disk with dst '/' must have fs 'ext4'"
    fi

    if [ "$layout_opt" = "subdirs" ]; then
      error "Error: disk spec '$spec' invalid: a disk with dst '/' must have layout 'root'"
    fi

    if [[ -f "$src" && "$layout" = "subdirs" ]]; then
      error "Error: disk spec '$spec' invalid: src '$src' exists, with layout 'subdirs', not 'root' as dst '/' requires"
    fi

    if [ -n "$ROOT_DISK_SPEC" ]; then
      error "Error: disk spec '$spec' invalid: only one disk may have dst '/'"
    fi

    # Populating a new whole-root disk excludes every other disk, so it waits until do_disks has
    # handled them all.
    ROOT_DISK_SPEC="$spec"
    ROOT_DISK_SRC="$src"
    ROOT_DISK_SIZE="$size"
    ROOT_DISK_ID="$id"
    return 0
  fi

  if [ "$layout" = "subdirs" ]; then
    for i in "${!dests[@]}"
    do
      dst="${dests[$i]}"

      if [[ "$dst" = *[[:space:]\\]* ]]; then
        error "Error: disk spec '$spec' invalid: dst '$dst' must not contain whitespace or '\\'"
      fi

      dests[$i]=$(disk_normalise_path "$dst") || \
        error "Error: disk spec '$spec' invalid: dst '$dst' must be an absolute path other than '/', without '.' or '..' components"

      subdirs[$i]=$(disk_subdir "${dests[$i]}")
      if [ "${#subdirs[$i]}" -gt 255 ]; then
        error "Error: disk spec '$spec' invalid: dst '$dst' is too long"
      fi

      # mke2fs creates lost+found in the root of every filesystem, so no destination's directory may
      # take that name.
      if [ "${subdirs[$i]}" = "lost+found" ]; then
        error "Error: disk spec '$spec' invalid: dst '$dst' requires layout 'root'"
      fi

      resolved[$i]=$(disk_resolve_path "${dests[$i]}") || \
        error "Error: disk spec '$spec' invalid: dst '$dst' has too many levels of symbolic links"
    done

    # Each destination's directory is bind-mounted over the destination, so no destination may be
    # another's ancestor, or the same, once symbolic links are resolved: one bind mount would hide or
    # be hidden by the other.
    for i in "${!dests[@]}"
    do
      for j in "${!dests[@]}"
      do
        [ "$i" -lt "$j" ] || continue
        if [[ "${resolved[$i]}" = "${resolved[$j]}" || "${resolved[$j]}" = "${resolved[$i]%/}"/* || "${resolved[$i]}" = "${resolved[$j]%/}"/* ]]; then
          if [[ "${resolved[$i]}" = "${dests[$i]}" && "${resolved[$j]}" = "${dests[$j]}" ]]; then
            error "Error: disk spec '$spec' invalid: dst '${dests[$i]}' and dst '${dests[$j]}' overlap"
          else
            error "Error: disk spec '$spec' invalid: dst '${dests[$i]}' and dst '${dests[$j]}' overlap, as '${resolved[$i]}' and '${resolved[$j]}'"
          fi
        fi
      done
    done
  fi

  for dst in "${dests[@]}"
  do
    if [[ "$src" = "$dst" ]]; then
      error "Error: disk spec '$spec' invalid: src '$src' cannot be same as dst"
    fi

    if [[ -e "$dst" && ! -d "$dst" ]]; then
      error "Error: disk spec '$spec' invalid: dst '$dst' must be a directory if it exists"
    fi
  done

  # Create each destination directory, if it doesn't already exist: it is the source from which
  # a new disk is populated, and the mountpoint within the VM.
  for dst in "${dests[@]}"
  do
    [ -d "$RUNCVM_VM_MOUNTPOINT/$dst" ] || mkdir -p "$RUNCVM_VM_MOUNTPOINT/$dst" >&2
  done

  if [[ ! -f "$src" ]]; then
    disk_create_file "$spec" "$src" "$size"

    # Create filesystem on disk backing file, populated with any pre-existing files from each dst.
    # Use RunCVM's own mke2fs configuration, not the image's /etc/mke2fs.conf.
    if [ "$layout" = "subdirs" ]; then
      populate=(-L "$DISK_SUBDIRS_LABEL")
      for i in "${!dests[@]}"
      do
        populate+=(-P "${subdirs[$i]}=$RUNCVM_VM_MOUNTPOINT${dests[$i]}")
      done
    else
      populate=(-d "$RUNCVM_VM_MOUNTPOINT/${dests[0]}")
    fi

    MKE2FS_CONFIG="$RUNCVM_GUEST/etc/mke2fs.conf" mke2fs -q -F -t "$fs" "${populate[@]}" "$src" >&2 || error "Error: disk spec '$spec' invalid: mke2fs on '$src' with fs '$fs' failed"
  fi

  # Obtain the filesystem's UUID by probing the backing file directly, without the image's blkid
  # configuration or cache, and add the disk to fstab.
  UUID=$(blkid -p -s UUID -o value "$src") || true
  if [ -z "$UUID" ]; then
    error "Error: disk spec '$spec' invalid: no filesystem UUID found in src '$src'"
  fi

  if [ "$layout" = "subdirs" ]; then
    echo "UUID=$UUID /.runcvm/disks/$id $fs defaults,noatime 0 0" >>/.runcvm/fstab
    for i in "${!dests[@]}"
    do
      echo "/.runcvm/disks/$id/${subdirs[$i]} ${dests[$i]} none bind 0 0" >>/.runcvm/fstab
    done
  else
    echo "UUID=$UUID ${dests[0]} $fs defaults,noatime 0 0" >>/.runcvm/fstab
  fi

  # Record this disk's backing file, and each of its destinations, for do_root_disk: a whole-root
  # disk leaves them out, as this disk holds the destinations' contents. Each is recorded as its
  # path in the image's filesystem, with symbolic links resolved.
  DISK_EXCLUDES+=("$(busybox realpath "$src")")
  for dst in "${dests[@]}"
  do
    path=$(disk_normalise_path "$dst") && path=$(disk_resolve_path "$path") || path="$dst"
    DISK_EXCLUDES+=("$path")
  done

  disk_add_device "$src" "$id"
}

# Creates and populates a new whole-root disk, and records it for runcvm-vm-init, which switches the
# VM's root filesystem to it with pivot_root, before anything else uses the root.
#
# The disk is populated from the image's filesystem below $RUNCVM_VM_MOUNTPOINT, without crossing
# into other filesystems, so it leaves out everything that must stay live: /.runcvm, Docker's
# volumes, bind mounts and files such as /etc/hosts, and the kernel modules, leaving an empty
# directory at each mountpoint that is a directory. It also leaves out each disk's backing file,
# and the contents of every other disk's destinations. A disk is populated only when it is created:
# it does not see later changes to the image or the container's filesystem.
#
# /.runcvm/rootdisk holds the disk's filesystem UUID; /.runcvm/rootdisk-mounts lists the paths
# runcvm-vm-init carries from the image's filesystem onto the disk.
do_root_disk() {
  local spec="$ROOT_DISK_SPEC" src="$ROOT_DISK_SRC" path UUID
  local -a excludes=()

  if [[ ! -f "$src" ]]; then
    disk_create_file "$spec" "$src" "$ROOT_DISK_SIZE"

    for path in "${DISK_EXCLUDES[@]}" "$(busybox realpath "$src")"
    do
      excludes+=(-x "$(disk_glob_escape "$path")")
    done

    MKE2FS_CONFIG="$RUNCVM_GUEST/etc/mke2fs.conf" mke2fs -q -F -t ext4 -d "$RUNCVM_VM_MOUNTPOINT" -E one_file_system "${excludes[@]}" "$src" >&2 || error "Error: disk spec '$spec' invalid: mke2fs on '$src' with fs 'ext4' failed"
  fi

  UUID=$(blkid -p -s UUID -o value "$src") || true
  if [ -z "$UUID" ]; then
    error "Error: disk spec '$spec' invalid: no filesystem UUID found in src '$src'"
  fi

  echo "$UUID" >/.runcvm/rootdisk
  disk_vm_mounts >/.runcvm/rootdisk-mounts

  disk_add_device "$src" "$ROOT_DISK_ID"
}

# Adds disk backing file $1 to the QEMU command line, as disk number $2.
disk_add_device() {
  local src="$1" id="$2" queues

  if [ "${RUNCVM_CPUS:-1}" -gt 8 ]; then
    queues=8
  else
    queues="${RUNCVM_CPUS:-1}"
  fi

  DISKS+=(
    # Create a block backend (no implicit frontend device attached)
    # -drive id=drv$id       : give this backend a unique identifier
    # file=$src              : source image file
    # if=none                : do not attach directly, will be bound later with -device
    # format=raw             : treat the file as raw block device
    # media=disk             : marks this as a disk, not a CD-ROM
    # cache=none             : use O_DIRECT, bypass host page cache, rely on guest flushes for durability
    # aio=io_uring           : use Linux io_uring for asynchronous I/O (lower overhead than libaio)
    # discard=unmap          : propagate guest TRIM/UNMAP to host (space reclamation)
    # detect-zeroes=unmap    : convert guest zero writes into UNMAPs for efficiency
    -drive id=drv$id,file=$src,if=none,format=raw,media=disk,cache=none,aio=io_uring,discard=unmap,detect-zeroes=unmap

    # Create a dedicated I/O thread (dataplane) to offload block I/O
    # -object iothread,id=ioth$id : defines an iothread with a unique identifier
    -object iothread,id=ioth$id

    # Attach a virtio-blk PCI frontend to the backend and iothread
    # -device virtio-blk-pci     : create a virtio block device on PCI bus
    # drive=drv$id               : connect to backend created above
    # iothread=ioth$id           : process requests in dedicated I/O thread
    # queue-size=1024            : set depth of each virtqueue
    # num-queues=4               : create 4 queues, allowing parallel I/O across vCPUs
    -device virtio-blk-pci,drive=drv$id,iothread=ioth$id,queue-size=1024,num-queues=$queues
  )
}

# Argument e.g. /disk1,/home,ext4,5G;/disk2,/var,ext4,1G
do_disks() {
  local IFS=';'
  local disk
  local id=0
  ROOT_DISK_SPEC=""
  DISK_EXCLUDES=()

  for disk in $1
  do
    do_disk "$disk" "$id"
    id=$((id+1))
  done

  if [ -n "$ROOT_DISK_SPEC" ]; then
    do_root_disk
  fi
}

do_networks() {
  local id=0 ifpath if mac vhost
  local DOCKER_IF DOCKER_IF_MAC DOCKER_IF_MTU DOCKER_IF_IP DOCKER_IF_IP_NETPREFIX DOCKER_IF_IP_GW

  HAS_IPV6=0

  for ifpath in /.runcvm/network/devices/*
  do
    if=$(busybox basename "$ifpath")

    [ "$if" = "default" ] && continue

    load_network "$if"

    # Set (not local): read by the caller to decide whether to enable IPv6
    # on the VM's kernel command line.
    if load_network6 "$if"; then
      HAS_IPV6=1
    fi

    mac=$(busybox sed -r 's/^..:..:../52:54:00/' <<<$DOCKER_IF_MAC)

    if [ "$RUNCVM_QEMU_NET_VHOST" = "1" ]; then
      vhost="on"
    else
      vhost="off"
    fi

    IFACES+=(
        -netdev tap,id=qemu$id,ifname=tap-$DOCKER_IF,script=$QEMU_IFUP,downscript=$QEMU_IFDOWN,vhost=$vhost
        -device virtio-net-pci,netdev=qemu$id,mac=$mac,rombar=$id
    )

    id=$((id+1))
  done
}

DISKS=()
if [ -n "$RUNCVM_DISKS" ]; then
  do_disks "$RUNCVM_DISKS"
fi

# vhost-net needs /dev/vhost-net, which the runtime passes into the container only if it
# exists on the host: without it, QEMU would fail to start with vhost=on.
if [ "$RUNCVM_QEMU_NET_VHOST" = "1" ] && ! [ -e /dev/vhost-net ]; then
  echo "RunCVM: Warning: RUNCVM_QEMU_NET_VHOST=1 but /dev/vhost-net is unavailable; continuing without vhost-net" >&2
  RUNCVM_QEMU_NET_VHOST=0
fi

IFACES=()
do_networks

if [ -n "$RUNCVM_TMPFS" ]; then
  echo "$RUNCVM_TMPFS" >>/.runcvm/fstab
fi

if [[ -z "$RUNCVM_CPUS" || "$RUNCVM_CPUS" -le 0 ]]; then
  RUNCVM_CPUS=$(busybox nproc)
fi

# TODO:
# - Consider using '-device pvpanic'

# Choose QEMU acceleration according to RUNCVM_QEMU_ACCEL (validated by runcvm-runtime):
# - kvm (default): KVM, which requires /dev/kvm
# - auto: KVM if /dev/kvm is available, otherwise software emulation (TCG), with a warning
# - tcg: always software emulation (TCG), deliberately and so without a warning
case "${RUNCVM_QEMU_ACCEL:-kvm}" in
  tcg)
    ACCEL="tcg"
    ;;
  auto)
    if [ -e /dev/kvm ]; then
      ACCEL="kvm"
    else
      ACCEL="tcg"
      echo "RunCVM: Warning: /dev/kvm is unavailable; falling back to software emulation (TCG), which is much slower" >&2
    fi
    ;;
  *)
    [ -e /dev/kvm ] || error "RunCVM: Error: /dev/kvm is unavailable; launch with --env=RUNCVM_QEMU_ACCEL=auto or tcg to allow software emulation"
    ACCEL="kvm"
    ;;
esac

# Software emulation (TCG) keeps a cache of translated code which, by default, may grow to
# 1GiB. Size it to RUNCVM_QEMU_TCG_TB_MEM_SIZE (Mb), which runcvm-runtime adds to the
# container's memory limit, keeping the container's memory limit aligned with QEMU's use.
TCG_ACCEL=(-accel tcg,tb-size=${RUNCVM_QEMU_TCG_TB_MEM_SIZE:-128})

if [ "$RUNCVM_QEMU_ARCH" = "arm64" ]; then
  CMD="$(which qemu-system-aarch64)"
  if [ "$ACCEL" = "kvm" ]; then
    MACHINE+=(-cpu host -machine virt,accel=kvm,gic-version=max,usb=off)
  else
    MACHINE+=(-cpu max -machine virt,gic-version=max,usb=off "${TCG_ACCEL[@]}")
  fi
else
  CMD="$(which qemu-system-x86_64)"

  # QEMU machine configuration:
  # - q35: modern Intel chipset with PCIe and UEFI support
  # - accel=kvm: enable KVM for near-native performance (requires hardware virtualisation)
  # - usb=on: enable USB support (e.g., for peripherals or boot devices)
  # - sata=off: disable SATA controller if using virtio/NVMe instead
  # - vmport=off: disable VMware backdoor port for improved security/stealth
  # - smm=on: enable System Management Mode (required for UEFI Secure Boot)
  # - dump-guest-core=off: disable saving core dumps on guest crash (saves disk space)
  # - hpet=off: disable High Precision Event Timer to avoid timing issues in some guests
  # - kernel_irqchip=on: enable kernel-based interrupt controller for better performance

  # - usb=on: enable USB support when requested
  if [ "$RUNCVM_QEMU_USB" = "on" ]; then
    USB="on"
  else
    USB="off"
  fi

  # Use KVM or software emulation, as chosen above.
  # kernel_irqchip is a KVM-only feature, so it is omitted from the TCG variant.
  if [ "$ACCEL" = "kvm" ]; then
    MACHINE+=(-cpu host,pmu=off)
    MACHINE+=(-machine q35,accel=kvm,sata=off,vmport=off,smm=on,dump-guest-core=off,hpet=off,usb=$USB,kernel_irqchip=on)
  else
    MACHINE+=(-cpu max)
    MACHINE+=(-machine q35,sata=off,vmport=off,smm=on,dump-guest-core=off,hpet=off,usb=$USB "${TCG_ACCEL[@]}")
  fi

  # Enable the QEMU debug exit device for debugging purposes.
  # This device allows the guest to trigger a debug exit, which can be useful for debugging
  MACHINE+=(-device isa-debug-exit)

  # Set the virtual hardware clock to UTC time and enable drift correction using slewing.
  # This ensures the VM clock starts in UTC and gradually adjusts for time drift,
  # providing smooth and accurate timekeeping without sudden changes.
  MACHINE+=(-rtc base=utc,driftfix=slew)
fi

# RUNCVM_QEMU_DISPLAY -- the display frontend: none, curses
# RUNCVM_QEMU_VGA -- the backend VGA video device: none, std, virtio, cirrus
# RUNCVM_QEMU_VNC_DISPLAY -- the VNC display number (where enabled): 0, 1, ...

CONSOLE=()
DISPLAY=()

case "${RUNCVM_DISPLAY_MODE:-headless}" in
  headless) # virtconsole / hvc0
    RUNCVM_QEMU_DISPLAY="${RUNCVM_QEMU_DISPLAY:-none}"
    RUNCVM_QEMU_VGA="${RUNCVM_QEMU_VGA:-none}"

    # Creates a stdio backend connected to the virtual console.
    # Use with /dev/hvc0
    CONSOLE+=(
      -chardev stdio,id=char0,mux=off,signal=off
      -device virtconsole,chardev=char0,id=console0
    )

    CONSOLE_DEV="hvc0"
    NOMODESET="1"
    ;;
  serial) # stdio + monitor / ttyS0
    RUNCVM_QEMU_DISPLAY="${RUNCVM_QEMU_DISPLAY:-none}"
    RUNCVM_QEMU_VGA="${RUNCVM_QEMU_VGA:-none}"

    # Creates a multiplexed stdio backend connected to the serial port (and the QEMU monitor).
    # Use with /dev/ttyS0
    CONSOLE+=(
      -chardev stdio,id=char0,mux=on,signal=off
      -serial chardev:char0 -mon chardev=char0
    )

    # Set monitor escape key to CTRL-T to reduce risk of conflict (as default, CTRL-A, is  commonly used)
    CONSOLE+=(-echr 20)
    CONSOLE_DEV="ttyS0"
    NOMODESET="1"
    ;;
  vnc) # VNC + tty0
    RUNCVM_QEMU_DISPLAY="${RUNCVM_QEMU_DISPLAY:-none}"
    RUNCVM_QEMU_VGA="${RUNCVM_QEMU_VGA:-virtio}"
    RUNCVM_QEMU_VNC_DISPLAY="${RUNCVM_QEMU_VNC_DISPLAY:-0}"

    CONSOLE_DEV="tty0"
    NOMODESET="0"
    ;;
  *)
    error "Error: RUNCVM_DISPLAY_MODE '$RUNCVM_DISPLAY_MODE' invalid, must be one of: default|headless, serial, vnc" ;;
esac

# Save choice of console device
echo "$CONSOLE_DEV" >/.runcvm/console

# Generate QEMU display options
if [ -n "$RUNCVM_QEMU_DISPLAY" ]; then
  DISPLAY+=(-display $RUNCVM_QEMU_DISPLAY)
fi

if [ -n "$RUNCVM_QEMU_VGA" ]; then

  # i.e. virtio, std, none
  DISPLAY+=(-vga $RUNCVM_QEMU_VGA)

  if [ "$RUNCVM_QEMU_VGA" != "none" ]; then
    NOMODESET="0" # Disable nomodeset if using a graphical console
    DISPLAY+=(-device virtio-tablet-pci)
    DISPLAY+=(-audiodev none,id=snd0 -device intel-hda -device hda-output,audiodev=snd0)

    # For now, unless/until `-device virtio-gpu-pci` support is provided,
    # the VNC display is only relevant if VGA is not 'none'
    if [ -n "$RUNCVM_QEMU_VNC_DISPLAY" ]; then
      DISPLAY+=(-vnc :$RUNCVM_QEMU_VNC_DISPLAY,password=off)
    fi
  fi
fi

# Append nomodeset unless using a graphical console (i.e. not serial or virtconsole)
# PROBABLY ONLY NEEDED FOR `-display curses` (RUNCVM_QEMU_DISPLAY=curses) CASE
if [ "$NOMODESET" = "1" ]; then
  APPEND+=(nomodeset)
fi

if [ "$RUNCVM_BIOS_DEBUG" != "1" ]; then
  # Disable SeaBIOS serial console.
  # This -cfw_cfg path is modified from the SeaBIOS default (to avoid an otherwise-inevitable QEMU
  # warning being emitted) and so requires patched bios.bin file(s) (see Dockerfile)
  OPTS+=(-fw_cfg opt/org.seabios/etc/sercon-port,string=0)
fi

if [ "$RUNCVM_BIOS" = "EFI" ]; then
  # UEFI firmware
  OPTS+=(
    # -drive if=pflash,format=raw,unit=0,readonly=on,file=$RUNCVM_GUEST/usr/share/OVMF/OVMF_CODE.fd
    # -drive if=pflash,format=raw,unit=1,readonly=on,file=$RUNCVM_GUEST/usr/share/OVMF/OVMF_VARS.fd
    -bios $RUNCVM_GUEST/usr/share/OVMF/OVMF.fd
  )
fi

MEM_BACKEND=(-numa node,memdev=mem)
if [ "$RUNCVM_HUGETLB" != "1" ]; then
  # prealloc defaults to off, as it is slower with mem-path=/dev/shm
  MEM_PATH="/dev/shm" 
  MEM_BACKEND+=(-object memory-backend-file,id=mem,size=$RUNCVM_MEM_SIZE,mem-path=$MEM_PATH,share=on,prealloc=${RUNCVM_QEMU_MEM_PREALLOC:-off})
else
  # Fastest option: about 15% faster for CPU- and network-intensive workloads, and 3.5x
  # for disk-intensive workloads, than /dev/shm.
  MEM_BACKEND+=(-object memory-backend-memfd,id=mem,size=$RUNCVM_MEM_SIZE,share=on,prealloc=${RUNCVM_QEMU_MEM_PREALLOC:-off},hugetlb=on)
fi

# Queue sizes of 16-64 can outperform 1024 in some scenarios; 1024 is the default.
VIRTIOFS_QUEUE_SIZE=1024
VIRTIOFS+=(
  -chardev socket,id=virtiofs,path=$QEMU_VIRTIOFSD_SOCKET
  -device vhost-user-fs-pci,queue-size=$VIRTIOFS_QUEUE_SIZE,chardev=virtiofs,tag=runcvmfs,ats=off
)

# Experimental: Enable to specify a dedicated PCI bridge
# OPTS+=(-device pci-bridge,bus=pcie.0,id=pci-bridge-0,chassis_nr=1,shpc=off,addr=2,io-reserve=4k,mem-reserve=1m,pref64-reserve=1m)

# Experimental: Enable for a SCSI bus
# OPTS+=(-device virtio-scsi-pci,id=scsi0,disable-modern=true)

# Enable IPv6 in the VM only if a global IPv6 address was captured for at
# least one interface (set by do_networks(), above), unless overridden with
# --env=RUNCVM_IPV6=<0|1>. Otherwise, disable IPv6 entirely at kernel boot
# time.
case "$RUNCVM_IPV6" in
  1) HAS_IPV6=1 ;;
  0) HAS_IPV6=0 ;;
esac

[ "$HAS_IPV6" = "1" ] || APPEND+=(ipv6.disable=1)
APPEND+=(panic=-1)

# Disable unneeded functionality
APPEND+=(scsi_mod.scan=none tsc=reliable no_timer_check rcupdate.rcu_expedited=1 i8042.direct=1 i8042.dumbkbd=1 i8042.nopnp=1 i8042.noaux=1 noreplace-smp reboot=k cryptomgr.notests pci=lastbus=0 selinux=0)

# Enable systemd startup logging by default:
# - Only effective when --env=RUNCVM_KERNEL_DEBUG=1
# - Override this by launching with --env='RUNCVM_KERNEL_APPEND=systemd.show_status=0'
APPEND+=(systemd.show_status=1)

if [ "$RUNCVM_KERNEL_DEBUG" = "1" ]; then
  APPEND+=(console=$CONSOLE_DEV)
else
  APPEND+=(quiet)
fi

ARGS=(
  -no-user-config
  -nodefaults
  -no-reboot

  -action panic=none
  -action reboot=shutdown

  "${MACHINE[@]}"
  "${DISPLAY[@]}"
  "${OPTS[@]}"

  # N.B. There is a counterintuitive relationship between cpus and memory, and performance:
  # - more cpus needs more memory to maintain the same virtiofs disk I/O performance.
  -m "$RUNCVM_MEM_SIZE"
  -smp $RUNCVM_CPUS,cores=1,threads=1,sockets=$RUNCVM_CPUS,maxcpus=$RUNCVM_CPUS

  # Creates a virtio-serial bus on the PCI bus; this is used for the guest agent and virtiofs
  -device virtio-serial-pci,id=serial0 

  # Creates an RNG on the PCI bus
  -object rng-random,id=rng0,filename=/dev/urandom -device virtio-rng-pci,rng=rng0

  # Memory backend
  "${MEM_BACKEND[@]}"

  # virtiofs socket and interface
  "${VIRTIOFS[@]}"

  # Configure host/container tap device with PXE roms disabled
  "${IFACES[@]}"
  "${DISKS[@]}"

  # Configure console
  "${CONSOLE[@]}"

  # Support for guest agent
  -chardev socket,id=qemuguest0,path=$QEMU_GUEST_AGENT,server=on,wait=off
  -device virtserialport,chardev=qemuguest0,name=org.qemu.guest_agent.0

  # Creates a unix socket for the QEMU monitor
  -monitor unix:$QEMU_MONITOR_SOCKET,server,nowait

  # Kernel and initrd and kernel cmdline
  -kernel $RUNCVM_KERNEL_PATH
  -initrd $RUNCVM_KERNEL_INITRAMFS_PATH
  -L $RUNCVM_GUEST/usr/share/qemu
  -append "$RUNCVM_KERNEL_ROOT $INIT rw ${APPEND[*]} $RUNCVM_KERNEL_APPEND"
)

# virtiofsd is started in the background by runcvm-ctr-entrypoint, and QEMU fails at once if the
# virtiofsd socket does not yet exist: wait up to 30s for it.
for ((i = 0; i < 300; i++)); do
  [ -S "$QEMU_VIRTIOFSD_SOCKET" ] && break
  busybox sleep 0.1
done
[ -S "$QEMU_VIRTIOFSD_SOCKET" ] || error "RunCVM: Error: virtiofsd socket $QEMU_VIRTIOFSD_SOCKET not created within 30s (see /run/.virtiofsd.log)"

if [[ "$RUNCVM_BREAK" =~ preqemu ]]; then echo "Preparing to run: '$CMD' ${ARGS[@]@Q}"; bash; fi

if [ "$RUNCVM_QEMU_DEBUG" = "1" ]; then
  "$CMD" "${ARGS[@]}" || echo "QEMU exited with code: $?" >&2
  echo "QEMU memory cgroup events:" >&2
  cat /sys/fs/cgroup/memory.events >&2
else
exec "$CMD" "${ARGS[@]}"
fi