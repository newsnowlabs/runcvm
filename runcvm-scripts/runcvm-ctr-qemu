#!/.runcvm/guest/bin/bash

# Exit on errors, so that a failure while preparing the VM stops it from launching.
#
# Under pipefail, every command after a pipe in a pipeline whose status matters must read all its
# input: not grep -q, -m or -l, head, sed's q, awk's exit or a single read, which can exit first
# and leave the command writing to them killed by SIGPIPE, failing the pipeline at random. Use e.g.
# 'grep ... >/dev/null', or capture the output first. tests/43-pipefail-readers checks this.
#
# Sourced rather than run (as tests/53-disk-mount-order does, to check the disk planner), this script
# only defines its functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  set -o errexit -o pipefail

  # Load RunCVM's own environment, saved by runcvm-ctr-entrypoint
  . /.runcvm/config

  # Load defaults
  . $RUNCVM_GUEST/scripts/runcvm-ctr-defaults && unset PATH
fi

QEMU_IFUP="$RUNCVM_GUEST/scripts/runcvm-ctr-qemu-ifup"
QEMU_IFDOWN="$RUNCVM_GUEST/scripts/runcvm-ctr-qemu-ifdown"

INIT="init=$RUNCVM_GUEST/scripts/runcvm-vm-init"

# Must export TERMINFO so curses library can find terminfo database.
export TERMINFO="$RUNCVM_GUEST/usr/share/terminfo"

error() {
  echo "$1" >&2
  exit 1
}

# Prints path $1 with fstab's octal escapes for '\', space, tab and newline ('\134', '\040', '\011'
# and '\012'), as every path is written to the files that runcvm-vm-init reads: /.runcvm/fstab,
# /.runcvm/held-mounts, /.runcvm/disks-populate, /.runcvm/disks-populate-masks and
# /.runcvm/rootdisk-mounts. A field so written never contains a separator, and each '\' in it
# begins an escape, so it decodes exactly, with bash's printf '%b'.
path_encode() {
  local path="$1"

  path="${path//\\/\\134}"
  path="${path// /\\040}"
  path="${path//$'\t'/\\011}"
  path="${path//$'\n'/\\012}"

  printf '%s' "$path"
}

# Sets REPLY to path $1 in normal form: with repeated '/' collapsed and any trailing '/' removed.
# Fails if $1 is not absolute, is '/', or has a '.' or '..' component.
disk_normalise_path() {
  local path="$1"

  [[ "$path" = /* ]] || return 1

  while [[ "$path" = *//* ]]; do path="${path//\/\//\/}"; done
  path="${path%/}"

  [[ -n "$path" && "/$path/" != */./* && "/$path/" != */../* ]] || return 1

  REPLY="$path"
}

# Sets REPLY to normalised path $1 with each symbolic link in the image's filesystem (below
# $RUNCVM_VM_MOUNTPOINT) resolved, as mounting at $1 in the VM would resolve it. Components that do
# not exist are kept as given. Fails after 40 links, as the kernel does.
disk_resolve_path() {
  local rest="${1#/}" resolved="" comp target links=0

  while [ -n "$rest" ]
  do
    comp="${rest%%/*}"
    if [[ "$rest" = */* ]]; then rest="${rest#*/}"; else rest=""; fi

    case "$comp" in
      ""|.) continue ;;
      ..) resolved="${resolved%/*}"; continue ;;
    esac

    if [ -L "$RUNCVM_VM_MOUNTPOINT$resolved/$comp" ]; then
      links=$((links+1))
      [ "$links" -le 40 ] || return 1
      # readlink's output ends with one newline, which $(...) removes, together with any newlines
      # that end the target itself; the '/' appended first keeps those.
      target=$(busybox readlink "$RUNCVM_VM_MOUNTPOINT$resolved/$comp"; echo /) || return 1
      target="${target%$'\n/'}"
      [[ "$target" = /* ]] && resolved=""
      rest="${target#/}${rest:+/$rest}"
    else
      resolved="$resolved/$comp"
    fi
  done

  REPLY="${resolved:-/}"
}

# Sets REPLY to destination $1 as its path in the image's filesystem: normalised, with symbolic
# links resolved (see disk_resolve_path), or as given where either fails.
disk_image_path() {
  disk_normalise_path "$1" && disk_resolve_path "$REPLY" || REPLY="$1"
}

# Prints the name of the top-level directory of a disk with layout 'subdirs' that holds destination
# $1, a normalised path: the path without its leading '/', with each '%', '-' and '=' encoded as
# '%25', '%2D' and '%3D', and then each '/' replaced by '-'. For example, '/var/lib/docker' is held
# in 'var-lib-docker', '/a/b' in 'a-b' and '/a-b' in 'a%2Db'.
#
# The encoding is reversible, so distinct destinations always have distinct names; and the name
# depends only on the destination, so it is the same on every boot. The name must contain no '=',
# because mke2fs's '-P SUBDIR=SRC' ends SUBDIR at the first '='.
disk_subdir() {
  local name="${1#/}"

  name="${name//%/%25}"
  name="${name//-/%2D}"
  name="${name//=/%3D}"
  name="${name//\//-}"

  echo "$name"
}

# Sets REPLY to path $1 with each character special to mke2fs's '-x PATTERN' wildcards ('\', '*',
# '?' and '[') escaped, so that the pattern matches only that path. (Set, not printed: $(...) would
# drop any newlines the path ends in.)
disk_glob_escape() {
  local path="$1"

  path="${path//\\/\\\\}"
  path="${path//\*/\\*}"
  path="${path//\?/\\?}"
  path="${path//\[/\\[}"

  REPLY="$path"
}

# Succeeds if path $1 is strictly below path $2, where $2 may be '/'.
path_below() {
  [[ "$1" = "${2%/}"/* ]]
}

# Records every mount in this container in MI_POINT, MI_DEV and MI_ROOT (see the tables below), and
# each mountpoint below $RUNCVM_VM_MOUNTPOINT, at any depth, once, as its path in the VM:
# Docker's volumes and bind mounts, including files such as /etc/hosts, and the kernel modules.
# (There are no tmpfs mounts: runcvm-runtime removes them from the container, passing them to the
# VM in RUNCVM_TMPFS instead.) /.runcvm, and the mounts below it, are left out. Mountinfo gives each
# path as the kernel resolved it, so it is already a path in the image's filesystem.
#
# CMOUNT_PATH holds each path, CMOUNT_TYPE 'dir' or 'file', and CMOUNT_TOP 1 for a mount directly
# below $RUNCVM_VM_MOUNTPOINT in the mount tree (as a whole-root disk carries it, see
# do_root_disk) and 0 otherwise. Nothing changes these arrays afterwards.
container_mounts() {
  local id parent mnt vm_id="" rest i
  local -A seen=()
  local IFS=$' \t\n'  # Split on whitespace, whatever IFS the caller has set.

  CMOUNT_PATH=() CMOUNT_TYPE=() CMOUNT_TOP=() MI_POINT=() MI_DEV=() MI_ROOT=()

  # Each line of mountinfo describes a mount: its ID, its parent's ID, and, in the fifth field, its
  # mountpoint, with octal escapes (e.g. '\040' for a space).
  while read -r id parent _ _ mnt rest
  do
    if [ "$mnt" = "$RUNCVM_VM_MOUNTPOINT" ]; then
      vm_id="$id"
    fi
  done </proc/self/mountinfo

  while read -r id parent dev root mnt rest
  do
    printf -v mnt '%b' "$mnt"
    i="${#MI_POINT[@]}"
    MI_POINT[$i]="$mnt"
    MI_DEV[$i]="$dev"
    printf -v MI_ROOT[$i] '%b' "$root"

    [[ "$mnt" = "$RUNCVM_VM_MOUNTPOINT"/* ]] || continue
    mnt="${mnt#"$RUNCVM_VM_MOUNTPOINT"}"  # Strip the prefix, leaving the path in the VM.
    [[ "$mnt" = /.runcvm || "$mnt" = /.runcvm/* ]] && continue

    if [ -n "${seen[$mnt]+x}" ]; then
      i="${seen[$mnt]}"
    else
      i="${#CMOUNT_PATH[@]}"
      seen[$mnt]="$i"
      CMOUNT_PATH[$i]="$mnt"
      CMOUNT_TOP[$i]=0
      if [ -d "$RUNCVM_VM_MOUNTPOINT$mnt" ]; then CMOUNT_TYPE[$i]=dir; else CMOUNT_TYPE[$i]=file; fi
    fi
    [ "$parent" != "$vm_id" ] || CMOUNT_TOP[$i]=1
  done </proc/self/mountinfo
}

# Succeeds if paths $1 and $2 reach one file: the same device and inode.
same_file() {
  [[ -e "$1" && -e "$2" ]] || return 1
  [ "$(busybox stat -L -c '%d:%i' "$1")" = "$(busybox stat -L -c '%d:%i' "$2")" ]
}

# Adds a backing-file view row for each path in the image's view (below $RUNCVM_VM_MOUNTPOINT) at
# which the VM sees disk $1's backing file, whose canonical path in this container is $2. The two
# views differ: Docker's mounts, other than those at or below /disks, are mounted only below
# $RUNCVM_VM_MOUNTPOINT, so a container path such as /data/x.img is the image's own directory,
# while the VM's /data may be a volume; and one filesystem may be mounted at several paths (e.g.
# one volume at both /disks and /data). So spellings are only candidates:
# - the container path, without any $RUNCVM_VM_MOUNTPOINT prefix;
# - for each mount below $RUNCVM_VM_MOUNTPOINT of the same device as the container mount holding the
#   backing file, whose root (its directory within that filesystem) holds the backing file, the
#   backing file's path through that mount.
# Each candidate is confirmed where both views reach one file: for an existing backing file, the
# file itself; for a new one, the nearest directory above it that exists in this container, each
# directory missing there being missing in the image's view too.
disk_backing_views() {
  local id="$1" path="$2" i m=-1 len=-1 rel cand cdir vdir v
  local -a cands=()
  local -A seen=()

  if [[ "$path" = "$RUNCVM_VM_MOUNTPOINT"/* ]]; then
    cands+=("${path#"$RUNCVM_VM_MOUNTPOINT"}")
  else
    cands+=("$path")
  fi

  # The container mount holding the path: the one with the longest mountpoint at or above it, and
  # of those, the last mounted.
  for i in "${!MI_POINT[@]}"
  do
    if [[ "${MI_POINT[$i]}" = "/" || "$path" = "${MI_POINT[$i]}" ]] || path_below "$path" "${MI_POINT[$i]}"; then
      [ "${#MI_POINT[$i]}" -lt "$len" ] || { m="$i"; len="${#MI_POINT[$i]}"; }
    fi
  done

  if [ "$m" -ge 0 ]; then
    # The path within the mount's filesystem.
    if [ "${MI_POINT[$m]}" = "/" ]; then rel="$path"; else rel="${path#"${MI_POINT[$m]}"}"; fi
    rel="${MI_ROOT[$m]%/}$rel"

    for i in "${!MI_POINT[@]}"
    do
      [ "${MI_DEV[$i]}" = "${MI_DEV[$m]}" ] || continue
      [[ "${MI_POINT[$i]}" = "$RUNCVM_VM_MOUNTPOINT" ]] || path_below "${MI_POINT[$i]}" "$RUNCVM_VM_MOUNTPOINT" || continue
      [[ "${MI_ROOT[$i]}" = "/" ]] || path_below "$rel" "${MI_ROOT[$i]}" || continue
      if [ "${MI_ROOT[$i]}" = "/" ]; then cand="$rel"; else cand="${rel#"${MI_ROOT[$i]}"}"; fi
      cands+=("${MI_POINT[$i]#"$RUNCVM_VM_MOUNTPOINT"}$cand")
    done
  fi

  for cand in "${cands[@]}"
  do
    [ -z "${seen[$cand]+x}" ] || continue
    seen[$cand]=1

    if [ -e "$path" ]; then
      same_file "$path" "$RUNCVM_VM_MOUNTPOINT$cand" || continue
    else
      # Walk up both paths together, which share every component of the backing file's name, to
      # the nearest directory that exists in this container: each directory missing here, which
      # creating the backing file creates, must be missing in the image's view too, or that view
      # has something else there (such as a volume).
      cdir="${path%/*}" vdir="${cand%/*}"
      while ! [ -d "${cdir:-/}" ]
      do
        [[ ! -e "$RUNCVM_VM_MOUNTPOINT$vdir" && -n "$vdir" && -n "$cdir" ]] || continue 2
        cdir="${cdir%/*}" vdir="${vdir%/*}"
      done
      same_file "${cdir:-/}" "$RUNCVM_VM_MOUNTPOINT${vdir:-/}" || continue
    fi

    v="${#BACKING_DISK[@]}"
    BACKING_DISK[$v]="$id"
    BACKING_PATH[$v]="$cand"
  done
}

# Sets REPLY to the canonical path of existing path $1, as realpath gives it, whole: $(...) alone
# would drop any newlines it ends in.
disk_realpath() {
  REPLY=$(busybox realpath "$1"; echo /)
  REPLY="${REPLY%$'\n/'}"
}

# Sets REPLY to the file that disk backing file path $1 names, or will name once created: the path,
# with repeated '/' collapsed, and each symbolic link it ends in followed, as creating the file would
# follow it. Fails, setting REPLY to the reason, unless the path is absolute, without '.' or '..'
# components, a trailing '/' or a newline, so that each backing file has one spelling, which the
# checks between disks can compare; '..' after a directory not yet created (e.g. /disks/missing/../a)
# would name an existing file once that directory is created. A link's target is resolved where the
# directory holding it exists, and is held to the same rules where it doesn't. Fails likewise after
# 40 links.
disk_src_file() {
  local path="$1" target dir links=0

  while [[ "$path" = *//* ]]; do path="${path//\/\//\/}"; done
  if [[ "$path" != /* || "$path" = */ || "/$path/" = */./* || "/$path/" = */../* || "$path" = *$'\n'* ]]; then
    REPLY="must be an absolute path to a file, without '.' or '..' components or a newline"
    return 1
  fi

  while [ -L "$path" ]
  do
    links=$((links+1))
    if [ "$links" -gt 40 ]; then
      REPLY="has too many levels of symbolic links"
      return 1
    fi

    # readlink's output ends with one newline, which $(...) removes, together with any newlines
    # that end the target itself; the '/' appended first keeps those.
    target=$(busybox readlink "$path"; echo /)
    target="${target%$'\n/'}"
    [[ "$target" = /* ]] || target="${path%/*}/$target"
    while [[ "$target" = *//* ]]; do target="${target//\/\//\/}"; done

    dir="${target%/*}"
    if [[ "${target##*/}" != "" && "${target##*/}" != "." && "${target##*/}" != ".." && -d "${dir:-/}" ]]; then
      disk_realpath "${dir:-/}"
      target="${REPLY%/}/${target##*/}"
    fi
    if [[ "$target" = *$'\n'* ]]; then
      REPLY="is a symbolic link to a path with a newline"
      return 1
    fi
    if [[ "$target" = */ || "/$target/" = */./* || "/$target/" = */../* ]]; then
      REPLY="is a symbolic link to '$target', which must be an absolute path to a file, without '.' or '..' components, where the directory holding it does not exist"
      return 1
    fi
    path="$target"
  done

  REPLY="$path"
}

# Sets REPLY to a key identifying the file that disk backing file $1 (as disk_src_file gives it)
# names, or will name once created, whatever path reaches it: for an existing file, its device and
# inode; otherwise the device and inode of the nearest directory above it that exists, with the rest
# of the path. Two paths with one key name one file (e.g. /disks/a and /disks/alias/a, with one
# volume mounted at both).
disk_src_key() {
  local path="$1" rest=""

  if [ -e "$path" ]; then
    REPLY="file $(busybox stat -L -c '%d:%i' "$path")"
    return 0
  fi

  while ! [ -d "${path:-/}" ]
  do
    rest="/${path##*/}$rest"
    path="${path%/*}"
  done
  REPLY="dir $(busybox stat -L -c '%d:%i' "${path:-/}")$rest"
}

# Creates disk $1's backing file, at the path disk_src_file gave it, with its directory if needed.
# disk_parse has checked the size. The file is claimed by creating it exclusively (bash's noclobber
# opens it with O_EXCL), so that a file that has appeared there since disk_parse found none, such as
# one another Container/VM starting at the same time is creating, is not touched: only a file this
# claim created is sized and formatted.
disk_create_file() {
  local id="$1" file="${DISK_SRC_FILE[$1]}" dir

  dir="${file%/*}"
  [ -d "${dir:-/}" ] || mkdir -p "$dir"

  ( set -o noclobber; : >"$file" ) 2>/dev/null || \
    error "Error: disk spec '${DISK_SPEC[$id]}' invalid: src '${DISK_SRC[$id]}' exists, though it did not when the disks were checked"

  busybox truncate -s "${DISK_SIZE[$id]}" "$file" >&2 || \
    error "Error: disk spec '${DISK_SPEC[$id]}' invalid: truncate on '${DISK_SRC[$id]}' with size '${DISK_SIZE[$id]}' failed"
}

# Allocates every block of disk backing file $2, for disk spec $1, keeping its contents, so that the
# filesystem holding it cannot run out of space while the VM runs. mkfs commands may discard a
# file's blocks (mke2fs punches holes in a plain file), so a new disk is allocated after its mkfs.
disk_prealloc() {
  local spec="$1" src="$2" size

  size=$(busybox stat -c %s "$src") && busybox fallocate -l "$size" "$src" >&2 || \
    error "Error: disk spec '$spec': fallocate on '$src' failed (the filesystem holding it may lack the space, or not support fallocate)"
}

# RUNCVM_DISKS is planned, checked and created in phases, sharing these tables (parallel arrays
# with a common index), each filled by one phase only:
#
# - Disks, by disk id (position in RUNCVM_DISKS), filled by disk_parse: DISK_SPEC, DISK_SRC,
#   DISK_SRC_FILE (the file the backing file path names, see disk_src_file), DISK_SRC_PATH (that
#   file's canonical path in this container), DISK_SRC_KEY (what identifies the file, existing or
#   not, for checks between disks, see disk_src_key), DISK_FS, DISK_SIZE, DISK_PREALLOC,
#   DISK_LAYOUT ('subdirs', 'root', or 'whole' for a whole-root disk), DISK_NEW (1 if the backing
#   file doesn't exist) and DISK_UUID (an existing disk's, from disk_parse; a new disk's, from
#   disks_create).
# - Destinations, one row per destination, filled by disk_parse: DEST_DISK (disk id), DEST_GIVEN
#   (normalised, for mounting and messages), DEST_PATH (its path in the image's filesystem, with
#   symbolic links resolved: what population reads from, and what the plan compares) and DEST_DIR
#   (its directory on the disk: its subdirectory for layout 'subdirs', '.' otherwise). A
#   whole-root disk's row has destination '/', and is used for population only.
# - Mounts, one row per mount the VM makes at a path, filled by disk_parse, tmpfs_parse and
#   plan_mounts: MOUNT_PATH (in the image's filesystem), MOUNT_KIND ('disk', 'tmpfs' or 'held':
#   a container mount hidden by a disk or tmpfs mount above it, mounted again over it), MOUNT_TYPE
#   ('dir' or 'file'), MOUNT_REF (the destination row, the tmpfs entry, or the held mount's ID).
#   MOUNT_ORDER lists the rows in order of depth.
# - Backing-file views, one row per path in the image's view at which the VM sees a disk's backing
#   file, filled by disk_parse (see disk_backing_views): BACKING_DISK, BACKING_PATH.
# - Container mounts, from container_mounts: CMOUNT_PATH, CMOUNT_TYPE, CMOUNT_TOP; and every
#   mount in this container, MI_POINT (mountpoint), MI_DEV (device) and MI_ROOT (its directory
#   within the device's filesystem).
# - Held mounts, by held mount ID, filled by plan_mounts: HELD_CMOUNT (the container mount row).
# - Exclusions, one row per path a new disk is not populated with, filled by plan_mounts:
#   EXCL_DEST (the destination row), EXCL_PATH (in the image's filesystem), EXCL_ON_DISK (its path
#   on the disk, as mke2fs's -x matches it) and EXCL_TYPE ('dir' or 'file').
#
# Nothing is created until every check has passed: disk_parse, tmpfs_parse, plan_check and
# plan_mounts write nothing; disks_create creates the destinations and disks; write_manifests
# writes /.runcvm/fstab and the other files runcvm-vm-init reads.

# Argument, in positional form: <src>,<dst>[:<dst2>:...],<fs>[,<size>][,layout=subdirs|root][,prealloc=on|off]
# e.g. /volume/disk1,/var/lib/docker:/var/lib/containerd:/home,ext4,5G
#
# or in keyed form, when the first field begins with one of the keys followed by '=':
#   src=<src>,dst=<dst>[,dst=<dst2>...],fs=<fs>[,size=<size>][,layout=subdirs|root][,prealloc=on|off]
# with fields in any order, 'source' accepted for 'src', and 'target' and 'destination' for 'dst';
# e.g. src=/volume/disk1,dst=/var/lib/docker,dst=/home,fs=ext4,size=5G
#
# <fs> must be listed in $RUNCVM_GUEST/etc/disk-filesystems, which gives the mkfs command that
# formats a new disk, and the label that marks layout 'subdirs'. A disk's layout is chosen when it
# is created, and read from its label thereafter: any other label, or none, means layout 'root'.
# mke2fs populates a new disk from its destinations; any other mkfs command formats it empty, and
# the disk is recorded in /.runcvm/disks-populate, for runcvm-vm-init to populate.
#
# A disk with layout 'subdirs' (the default for a new disk) holds each destination's contents in its
# own top-level directory, named by disk_subdir. It is mounted at /.runcvm/disks/<id>, and each
# directory is bind-mounted over its destination.
#
# A disk with layout 'root' has exactly one destination, holds its contents at its root, and is
# mounted at that destination.
#
# A new disk is populated only from the image's filesystem at each destination, not from anything
# mounted below it: Docker's volumes and bind mounts, other disks and tmpfs mounts (see
# plan_mounts).
#
# With prealloc=on, every block of the disk's backing file is allocated (see disk_prealloc), whether
# the file is new or existing, and QEMU attaches the disk ignoring the VM's discard requests and
# writing zeroes as data, so that the allocation stays. With prealloc=off (the default), the file is
# sparse, and the VM's discards and zero writes free its blocks.
#
# A disk with destination '/' (a whole-root disk) holds the VM's whole root filesystem: see
# do_root_disk. It must be the disk's only destination, have fs 'ext4' and layout 'root', and be the
# only such disk.
#
# disk_parse checks spec $1, of disk id $2, and records the disk and its destinations in the
# tables, creating nothing.
disk_parse() {
  local spec="$1"
  local id="$2"
  local src="" file dsts dst fs="" size="" layout layout_opt="" prealloc="off" field key value i j path dir
  local whole_root=0
  local -a fields=() dests=() subdirs=() resolved=() fss=()
  local -A seen=()

  IFS=',' read -r -a fields <<< "$spec"

  if [[ "${fields[0]}" =~ ^(src|source|dst|target|destination|fs|size|layout|prealloc)= ]]; then
    # Keyed form: every field is <key>=<value>, split at the first '='; only dst may be repeated.
    for field in "${fields[@]}"
    do
      [[ "$field" = *=* ]] || error "Error: disk spec '$spec' invalid: field '$field' must be of the form <key>=<value>"
      key="${field%%=*}"
      value="${field#*=}"

      case "$key" in
        source) key="src" ;;
        target|destination) key="dst" ;;
      esac

      case "$key" in
        src|fs|size|layout|prealloc)
          [ -z "${seen[$key]}" ] || error "Error: disk spec '$spec' invalid: $key specified more than once"
          seen[$key]=1
          ;;
        dst)
          [ -n "$value" ] || error "Error: disk spec '$spec' invalid: dst must not be empty"
          dests+=("$value")
          ;;
        *)
          error "Error: disk spec '$spec' invalid: unknown option '$key'"
          ;;
      esac

      case "$key" in
        src) src="$value" ;;
        fs) fs="$value" ;;
        size) size="$value" ;;
        layout) layout_opt="$value" ;;
        prealloc) prealloc="$value" ;;
      esac
    done
  else
    # Positional form: <src>,<dst>[:<dst2>:...],<fs>, then an optional <size>, then options of the
    # form <key>=<value>.
    src="${fields[0]}"
    dsts="${fields[1]}"
    fs="${fields[2]}"

    for i in "${!fields[@]}"
    do
      [ "$i" -ge 3 ] || continue
      field="${fields[$i]}"
      case "$field" in
        layout=*)
          [ -z "$layout_opt" ] || error "Error: disk spec '$spec' invalid: layout specified more than once"
          layout_opt="${field#layout=}"
          ;;
        prealloc=*)
          [ -z "${seen[prealloc]}" ] || error "Error: disk spec '$spec' invalid: prealloc specified more than once"
          seen[prealloc]=1
          prealloc="${field#prealloc=}"
          ;;
        *=*)
          error "Error: disk spec '$spec' invalid: unknown option '${field%%=*}'"
          ;;
        *)
          [ "$i" -eq 3 ] || error "Error: disk spec '$spec' invalid: unexpected field '$field'"
          size="$field"
          ;;
      esac
    done

    if [[ "$dsts" = :* || "$dsts" = *: || "$dsts" = *::* ]]; then
      error "Error: disk spec '$spec' invalid: dst must not be empty"
    fi

    [ -z "$dsts" ] || IFS=':' read -r -a dests <<< "$dsts"
  fi

  if [[ -z "$src" || "${#dests[@]}" -eq 0 || -z "$fs" ]]; then
    error "Error: disk spec '$spec' invalid: src, dst and fs must all be specified"
  fi

  # Every check of the backing file is made of the file the path names (see disk_src_file).
  disk_src_file "$src" || error "Error: disk spec '$spec' invalid: src '$src' $REPLY"
  file="$REPLY"

  if [[ -n "$layout_opt" && "$layout_opt" != "subdirs" && "$layout_opt" != "root" ]]; then
    error "Error: disk spec '$spec' invalid: layout must be 'subdirs' or 'root'"
  fi

  if [[ "$prealloc" != "on" && "$prealloc" != "off" ]]; then
    error "Error: disk spec '$spec' invalid: prealloc must be 'on' or 'off'"
  fi

  if ! disk_fs "$fs"; then
    mapfile -t fss < <(disk_fs_list 1)
    error "Error: disk spec '$spec' invalid: fs '$fs' unsupported; fs must be one of: $(IFS=' '; echo "${fss[*]}")"
  fi

  if [[ -e "$file" && ! -f "$file" ]]; then
    error "Error: disk spec '$spec' invalid: src '$src' must be a plain file if it exists"
  fi

  # An existing disk keeps the filesystem it was created with, and the layout, as recorded by its
  # label. Its UUID, by which the VM mounts it, is read now, probing the backing file directly,
  # without the image's blkid configuration or cache.
  if [[ -f "$file" ]]; then
    value=$(blkid -p -s TYPE -o value "$file") || true
    if [[ -n "$value" && "$value" != "$fs" ]]; then
      error "Error: disk spec '$spec' invalid: src '$src' exists, with fs '$value', not '$fs'"
    fi

    value=$(blkid -p -s LABEL -o value "$file") || true
    # grep reads all of disk_fs_list's output (no -q), as the pipefail note at the top requires.
    if [[ -n "$value" ]] && disk_fs_list 5 | grep -xF -- "$value" >/dev/null; then
      layout="subdirs"
    else
      layout="root"
    fi

    if [[ -n "$layout_opt" && "$layout_opt" != "$layout" ]]; then
      error "Error: disk spec '$spec' invalid: src '$src' exists, with layout '$layout', not '$layout_opt'"
    fi

    if [[ "$layout" = "root" && "${#dests[@]}" -gt 1 ]]; then
      error "Error: disk spec '$spec' invalid: src '$src' exists, with layout 'root', which holds exactly one dst"
    fi

    DISK_UUID[$id]=$(blkid -p -s UUID -o value "$file") || true
    if [ -z "${DISK_UUID[$id]}" ]; then
      error "Error: disk spec '$spec' invalid: no filesystem UUID found in src '$src'"
    fi
    DISK_NEW[$id]=0
  else
    layout="${layout_opt:-subdirs}"

    if [[ "$layout" = "root" && "${#dests[@]}" -gt 1 ]]; then
      error "Error: disk spec '$spec' invalid: layout 'root' holds exactly one dst"
    fi

    if [[ -z "$size" ]]; then
      error "Error: disk spec '$spec' invalid: size must be specified if src '$src' does not exist"
    fi

    # The size is checked by the truncate that will create the backing file, on a scratch file in
    # /.runcvm, a tmpfs, where it takes no space.
    busybox truncate -s "$size" /.runcvm/disk-size-check 2>/dev/null || \
      error "Error: disk spec '$spec' invalid: size '$size' invalid"
    busybox rm -f /.runcvm/disk-size-check

    which "${DISK_FS_MKFS[0]}" >/dev/null || \
      error "Error: disk spec '$spec' invalid: fs '$fs' needs '${DISK_FS_MKFS[0]}', which RunCVM lacks"

    DISK_UUID[$id]=""
    DISK_NEW[$id]=1
  fi

  for dst in "${dests[@]}"
  do
    if [[ "$dst" =~ ^/+$ ]]; then
      whole_root=1
    fi
  done

  if [ "$whole_root" = "1" ]; then
    if [ "${#dests[@]}" -gt 1 ]; then
      error "Error: disk spec '$spec' invalid: dst '/' must be the disk's only dst"
    fi

    if [ "$fs" != "ext4" ]; then
      error "Error: disk spec '$spec' invalid: a disk with dst '/' must have fs 'ext4'"
    fi

    if [ "$layout_opt" = "subdirs" ]; then
      error "Error: disk spec '$spec' invalid: a disk with dst '/' must have layout 'root'"
    fi

    if [[ -f "$file" && "$layout" = "subdirs" ]]; then
      error "Error: disk spec '$spec' invalid: src '$src' exists, with layout 'subdirs', not 'root' as dst '/' requires"
    fi

    if [ -n "$ROOT_DISK_ID" ]; then
      error "Error: disk spec '$spec' invalid: only one disk may have dst '/'"
    fi

    ROOT_DISK_ID="$id"
    layout="whole"
    dests=("/")
    resolved=("/")
  else
    # Every destination is an absolute path, other than '/', without '.' or '..' components,
    # whitespace or '\', and is compared with others as its path in the image's filesystem.
    for i in "${!dests[@]}"
    do
      dst="${dests[$i]}"

      if [[ "$dst" = *[[:space:]\\]* ]]; then
        error "Error: disk spec '$spec' invalid: dst '$dst' must not contain whitespace or '\\'"
      fi

      disk_normalise_path "$dst" || \
        error "Error: disk spec '$spec' invalid: dst '$dst' must be an absolute path other than '/', without '.' or '..' components"
      dests[$i]="$REPLY"

      disk_resolve_path "${dests[$i]}" || \
        error "Error: disk spec '$spec' invalid: dst '$dst' has too many levels of symbolic links"
      resolved[$i]="$REPLY"

      if [[ -e "$RUNCVM_VM_MOUNTPOINT${resolved[$i]}" && ! -d "$RUNCVM_VM_MOUNTPOINT${resolved[$i]}" ]]; then
        error "Error: disk spec '$spec' invalid: dst '$dst' must be a directory if it exists"
      fi

      if [[ "$src" = "$dst" ]]; then
        error "Error: disk spec '$spec' invalid: src '$src' cannot be same as dst"
      fi
    done
  fi

  if [ "$layout" = "subdirs" ]; then
    for i in "${!dests[@]}"
    do
      dst="${dests[$i]}"

      subdirs[$i]=$(disk_subdir "$dst")
      if [ "${#subdirs[$i]}" -gt 255 ]; then
        error "Error: disk spec '$spec' invalid: dst '$dst' is too long"
      fi

      # mke2fs creates lost+found in the root of each filesystem it formats, and other filesystems'
      # repair tools (e.g. xfs_repair) may create it, so no destination's directory may take that
      # name.
      if [ "${subdirs[$i]}" = "lost+found" ]; then
        error "Error: disk spec '$spec' invalid: dst '$dst' requires layout 'root'"
      fi
    done

    # Each destination's directory is bind-mounted over the destination, so no destination may be
    # another's ancestor, or the same, once symbolic links are resolved: one bind mount would hide or
    # be hidden by the other.
    for i in "${!dests[@]}"
    do
      for j in "${!dests[@]}"
      do
        [ "$i" -lt "$j" ] || continue
        if [[ "${resolved[$i]}" = "${resolved[$j]}" ]] || path_below "${resolved[$j]}" "${resolved[$i]}" || path_below "${resolved[$i]}" "${resolved[$j]}"; then
          if [[ "${resolved[$i]}" = "${dests[$i]}" && "${resolved[$j]}" = "${dests[$j]}" ]]; then
            error "Error: disk spec '$spec' invalid: dst '${dests[$i]}' and dst '${dests[$j]}' overlap"
          else
            error "Error: disk spec '$spec' invalid: dst '${dests[$i]}' and dst '${dests[$j]}' overlap, as '${resolved[$i]}' and '${resolved[$j]}'"
          fi
        fi
      done
    done
  fi

  # The backing file's canonical path: an existing file's, or, for a new one, its directory's, where
  # that exists, with its name.
  if [ -e "$file" ]; then
    disk_realpath "$file"
    path="$REPLY"
  else
    dir="${file%/*}"
    if [ -d "${dir:-/}" ]; then
      disk_realpath "${dir:-/}"
      path="${REPLY%/}/${file##*/}"
    else
      path="$file"
    fi
  fi

  DISK_SPEC[$id]="$spec"
  DISK_SRC[$id]="$src"
  DISK_SRC_FILE[$id]="$file"
  DISK_SRC_PATH[$id]="$path"
  disk_src_key "$file"
  DISK_SRC_KEY[$id]="$REPLY"
  disk_backing_views "$id" "$path"
  DISK_FS[$id]="$fs"
  DISK_SIZE[$id]="$size"
  DISK_PREALLOC[$id]="$prealloc"
  DISK_LAYOUT[$id]="$layout"

  for i in "${!dests[@]}"
  do
    j="${#DEST_DISK[@]}"
    DEST_DISK[$j]="$id"
    DEST_GIVEN[$j]="${dests[$i]}"
    DEST_PATH[$j]="${resolved[$i]}"
    DEST_DIR[$j]="${subdirs[$i]:-.}"

    [ "$layout" = "whole" ] || mount_add "${resolved[$i]}" disk dir "$j"
  done
}

# Adds a mount row: a mount at path $1 (in the image's filesystem) of kind $2, type $3, referring to
# $4 (see the tables above).
mount_add() {
  local i="${#MOUNT_PATH[@]}"

  MOUNT_PATH[$i]="$1"
  MOUNT_KIND[$i]="$2"
  MOUNT_TYPE[$i]="$3"
  MOUNT_REF[$i]="$4"
}

# Records each tmpfs mount, which runcvm-runtime passes in RUNCVM_TMPFS as fstab entries, one per
# line, with fstab's octal escapes in each field: TMPFS_ENTRY holds each entry, and a 'tmpfs' mount
# row refers to it, at its destination's path in the image's filesystem (or as given, where that
# cannot be resolved).
tmpfs_parse() {
  local line dst i

  while IFS= read -r line
  do
    # The destination is the second of the entry's space-separated fields.
    dst="${line#* }"
    dst="${dst%% *}"
    [ -n "$dst" ] || continue
    printf -v dst '%b' "$dst"

    i="${#TMPFS_ENTRY[@]}"
    TMPFS_ENTRY[$i]="$line"
    disk_image_path "$dst"
    mount_add "$REPLY" tmpfs dir "$i"
  done <<< "$RUNCVM_TMPFS"
}

# Checks the disks against each other and against the tmpfs mounts:
# - no two disks with one destination, nor a disk with a tmpfs mount's destination, as each would
#   hide the other (a disk at a volume's or bind mount's destination is mounted over it, and a new
#   disk is populated from it);
# - no two disks with one backing file, whether named by one path or another that leads, or will
#   lead once created, to the same file, or as hard links to one file (see disk_src_key);
# - no two existing disks with one filesystem UUID, by which the VM finds each disk.
# Each error names the later disk's spec.
plan_check() {
  local i j di dj

  for j in "${!DEST_DISK[@]}"
  do
    [ "${DISK_LAYOUT[${DEST_DISK[$j]}]}" != "whole" ] || continue

    for i in "${!DEST_DISK[@]}"
    do
      [ "$i" -lt "$j" ] || break
      if [[ "${DEST_DISK[$i]}" != "${DEST_DISK[$j]}" && "${DEST_PATH[$i]}" = "${DEST_PATH[$j]}" ]]; then
        error "Error: disk spec '${DISK_SPEC[${DEST_DISK[$j]}]}' invalid: dst '${DEST_GIVEN[$j]}' is also the dst of an earlier disk"
      fi
    done

    for i in "${!MOUNT_KIND[@]}"
    do
      if [[ "${MOUNT_KIND[$i]}" = "tmpfs" && "${MOUNT_PATH[$i]}" = "${DEST_PATH[$j]}" ]]; then
        error "Error: disk spec '${DISK_SPEC[${DEST_DISK[$j]}]}' invalid: dst '${DEST_GIVEN[$j]}' is also the destination of a tmpfs mount"
      fi
    done
  done

  for dj in "${!DISK_SPEC[@]}"
  do
    for di in "${!DISK_SPEC[@]}"
    do
      [ "$di" -lt "$dj" ] || break

      if [ "${DISK_SRC_KEY[$di]}" = "${DISK_SRC_KEY[$dj]}" ]; then
        error "Error: disk spec '${DISK_SPEC[$dj]}' invalid: src '${DISK_SRC[$dj]}' is the same file as the src of an earlier disk, '${DISK_SRC[$di]}'"
      fi

      if [[ "${DISK_NEW[$di]}" = "0" && "${DISK_NEW[$dj]}" = "0" && "${DISK_UUID[$di]}" = "${DISK_UUID[$dj]}" ]]; then
        error "Error: disk spec '${DISK_SPEC[$dj]}' invalid: src '${DISK_SRC[$dj]}' has the same filesystem UUID as the src of an earlier disk, '${DISK_SRC[$di]}', so the VM cannot tell them apart (a copied disk keeps its UUID)"
      fi
    done
  done
}

# Plans the VM's mounts, and what each new disk is populated with:
#
# - Held mounts: each container mount strictly below a disk's or tmpfs mount's destination would be
#   hidden by that mount, so is held during boot, and mounted again over it, as Docker mounts a
#   deeper mount over a shallower one. A container mount at a disk's destination is not: the disk is
#   mounted over it. Each held mount gets the next ID, its slot in /.runcvm/submounts (see
#   runcvm-vm-init), and a 'held' mount row.
#
# - MOUNT_ORDER: the mount rows in order of depth (the number of components of each path), and
#   otherwise in the order added (disks, tmpfs mounts, held mounts), so a mount is made only once
#   every mount at a path above it has been, whatever the order of the disks in RUNCVM_DISKS.
#
# - Exclusions: a new disk holds nothing that is mounted below its destinations in the VM. For each
#   new disk's destination (a whole-root disk's '/' included), every container mount, every disk's
#   and tmpfs mount's destination, and every disk backing file that the VM sees (its own included),
#   strictly below it is excluded, outermost only (a path below another excluded path needs no
#   exclusion of its own); a whole-root disk also excludes /.runcvm. A container mount at the destination itself is not
#   excluded: a new disk at a volume's destination is populated from the volume.
#
# - mke2fs's limits, checked for each new disk it populates: at most 256 exclusions (-x) and 64
#   subdirectories (-P).
plan_mounts() {
  local c i j d id held=0 path depth max=0 rel n p
  local -a cand=() cand_type=() subdirs=()
  local -A excl_count=() subdir_count=()

  for c in "${!CMOUNT_PATH[@]}"
  do
    path="${CMOUNT_PATH[$c]}"
    j=""
    for i in "${!MOUNT_KIND[@]}"
    do
      [ "${MOUNT_KIND[$i]}" != "held" ] || continue
      if [[ "${MOUNT_KIND[$i]}" = "disk" && "${MOUNT_PATH[$i]}" = "$path" ]]; then
        j=""
        break
      fi
      path_below "$path" "${MOUNT_PATH[$i]}" && j=1
    done
    [ -n "$j" ] || continue

    HELD_CMOUNT[$held]="$c"
    mount_add "$path" held "${CMOUNT_TYPE[$c]}" "$held"
    held=$((held+1))
  done

  # Depth: the number of '/' in the path, one per component.
  MOUNT_ORDER=()
  for i in "${!MOUNT_PATH[@]}"
  do
    path="${MOUNT_PATH[$i]//[^\/]/}"
    MOUNT_DEPTH[$i]="${#path}"
    [ "${MOUNT_DEPTH[$i]}" -le "$max" ] || max="${MOUNT_DEPTH[$i]}"
  done
  for ((depth = 0; depth <= max; depth++))
  do
    for i in "${!MOUNT_PATH[@]}"
    do
      [ "${MOUNT_DEPTH[$i]}" -ne "$depth" ] || MOUNT_ORDER+=("$i")
    done
  done

  for d in "${!DEST_DISK[@]}"
  do
    id="${DEST_DISK[$d]}"
    [ "${DISK_NEW[$id]}" = "1" ] || continue
    p="${DEST_PATH[$d]}"

    cand=() cand_type=()
    for c in "${!CMOUNT_PATH[@]}"
    do
      path_below "${CMOUNT_PATH[$c]}" "$p" || continue
      cand+=("${CMOUNT_PATH[$c]}")
      cand_type+=("${CMOUNT_TYPE[$c]}")
    done
    for i in "${!MOUNT_KIND[@]}"
    do
      [ "${MOUNT_KIND[$i]}" != "held" ] || continue
      path_below "${MOUNT_PATH[$i]}" "$p" || continue
      cand+=("${MOUNT_PATH[$i]}")
      cand_type+=(dir)
    done
    for i in "${!BACKING_PATH[@]}"
    do
      path_below "${BACKING_PATH[$i]}" "$p" || continue
      cand+=("${BACKING_PATH[$i]}")
      cand_type+=(file)
    done
    if [ "${DISK_LAYOUT[$id]}" = "whole" ]; then
      cand+=(/.runcvm)
      cand_type+=(dir)
    fi

    # Keep each candidate once, and only where no other candidate is above it.
    for i in "${!cand[@]}"
    do
      for j in "${!cand[@]}"
      do
        if path_below "${cand[$i]}" "${cand[$j]}" || [[ "$j" -lt "$i" && "${cand[$j]}" = "${cand[$i]}" ]]; then
          continue 2
        fi
      done

      if [ "$p" = "/" ]; then rel="${cand[$i]}"; else rel="${cand[$i]#"$p"}"; fi
      n="${#EXCL_DEST[@]}"
      EXCL_DEST[$n]="$d"
      EXCL_PATH[$n]="${cand[$i]}"
      EXCL_TYPE[$n]="${cand_type[$i]}"
      if [ "${DISK_LAYOUT[$id]}" = "subdirs" ]; then
        EXCL_ON_DISK[$n]="/${DEST_DIR[$d]}$rel"
      else
        EXCL_ON_DISK[$n]="$rel"
      fi
      excl_count[$id]=$(( ${excl_count[$id]:-0} + 1 ))
    done

    [ "${DISK_LAYOUT[$id]}" != "subdirs" ] || subdir_count[$id]=$(( ${subdir_count[$id]:-0} + 1 ))
  done

  for id in "${!DISK_SPEC[@]}"
  do
    [ "${DISK_NEW[$id]}" = "1" ] || continue
    disk_fs "${DISK_FS[$id]}"
    [ "${DISK_FS_MKFS[0]}" = "mke2fs" ] || continue

    if [ "${excl_count[$id]:-0}" -gt 256 ]; then
      error "Error: disk spec '${DISK_SPEC[$id]}' invalid: a new disk with fs '${DISK_FS[$id]}' can leave out at most 256 paths mounted below its destinations, and this one has ${excl_count[$id]}"
    fi
    if [ "${subdir_count[$id]:-0}" -gt 64 ]; then
      error "Error: disk spec '${DISK_SPEC[$id]}' invalid: a new disk with fs '${DISK_FS[$id]}' and layout 'subdirs' can have at most 64 dst"
    fi
  done
}

# Creates the destinations and disks as planned: first every missing destination directory, at its
# path in the image's filesystem (mode 0755, owned by root, as are any missing directories above
# it), the source from which a new disk is populated and the mountpoint in the VM; then each disk,
# in spec order, with a whole-root disk last (see do_root_disk). A new disk is formatted, populated
# by mke2fs, or else listed for runcvm-vm-init to populate; then its backing file is preallocated,
# if asked, and it is added to the QEMU command line.
#
# A new disk that its mkfs command leaves empty is listed in /.runcvm/disks-populate, one line per
# destination: <id> <UUID> <fs> <directory> <path>, where <directory> is the destination's
# directory on the disk ('.' for its root) and <path> its path in the image's filesystem. Its
# exclusions are listed in /.runcvm/disks-populate-masks, one line each:
# <id> <directory> <dir|file> <path>, where <directory> is as in /.runcvm/disks-populate, and
# <path> is the excluded path in the image's filesystem. Paths are encoded with path_encode.
disks_create() {
  local d id i path
  local -a populate=()

  for d in "${!DEST_DISK[@]}"
  do
    path="$RUNCVM_VM_MOUNTPOINT${DEST_PATH[$d]}"
    [ -d "$path" ] || (umask 022 && mkdir -p "$path") >&2
  done

  for id in "${!DISK_SPEC[@]}"
  do
    [ "${DISK_LAYOUT[$id]}" != "whole" ] || continue
    disk_fs "${DISK_FS[$id]}"

    if [ "${DISK_NEW[$id]}" = "1" ]; then
      disk_create_file "$id"

      populate=()
      if [ "${DISK_LAYOUT[$id]}" = "subdirs" ]; then
        populate=("$DISK_FS_LABEL_OPT" "$DISK_FS_SUBDIRS_LABEL")
      fi

      # mke2fs populates the disk with the image's files at each destination, staying on the
      # filesystem holding the destination, and leaving out each excluded path by its path on the
      # disk: an excluded directory is created empty, and an excluded file is left out.
      if [ "${DISK_FS_MKFS[0]}" = "mke2fs" ]; then
        populate+=(-E one_file_system)
        for i in "${!EXCL_DEST[@]}"
        do
          [ "${DEST_DISK[${EXCL_DEST[$i]}]}" = "$id" ] || continue
          # -x takes a wildcard pattern, so escape the path to match only itself.
          disk_glob_escape "${EXCL_ON_DISK[$i]}"
          populate+=(-x "$REPLY")
        done
        for d in "${!DEST_DISK[@]}"
        do
          [ "${DEST_DISK[$d]}" = "$id" ] || continue
          if [ "${DISK_LAYOUT[$id]}" = "subdirs" ]; then
            populate+=(-P "${DEST_DIR[$d]}=$RUNCVM_VM_MOUNTPOINT${DEST_PATH[$d]}")
          else
            populate+=(-d "$RUNCVM_VM_MOUNTPOINT${DEST_PATH[$d]}")
          fi
        done
      fi

      # Run the mkfs command from RunCVM's own tools, with RunCVM's own mke2fs and libblkid
      # configuration, not the image's /etc/mke2fs.conf and /etc/blkid.conf.
      path=$(which "${DISK_FS_MKFS[0]}")
      MKE2FS_CONFIG="$RUNCVM_GUEST/etc/mke2fs.conf" BLKID_CONF="$RUNCVM_GUEST/etc/blkid.conf" BLKID_FILE=/dev/null \
        "$path" "${DISK_FS_MKFS[@]:1}" "${populate[@]}" "${DISK_SRC_FILE[$id]}" >&2 || \
        error "Error: disk spec '${DISK_SPEC[$id]}' invalid: ${DISK_FS_MKFS[0]} on '${DISK_SRC[$id]}' with fs '${DISK_FS[$id]}' failed"

      DISK_UUID[$id]=$(blkid -p -s UUID -o value "${DISK_SRC_FILE[$id]}") || true
      if [ -z "${DISK_UUID[$id]}" ]; then
        error "Error: disk spec '${DISK_SPEC[$id]}' invalid: no filesystem UUID found in src '${DISK_SRC[$id]}'"
      fi

      if [ "${DISK_FS_MKFS[0]}" != "mke2fs" ]; then
        for d in "${!DEST_DISK[@]}"
        do
          [ "${DEST_DISK[$d]}" = "$id" ] || continue
          echo "$id ${DISK_UUID[$id]} ${DISK_FS[$id]} ${DEST_DIR[$d]} $(path_encode "${DEST_PATH[$d]}")" >>/.runcvm/disks-populate
          for i in "${!EXCL_DEST[@]}"
          do
            [ "${EXCL_DEST[$i]}" = "$d" ] || continue
            echo "$id ${DEST_DIR[$d]} ${EXCL_TYPE[$i]} $(path_encode "${EXCL_PATH[$i]}")" >>/.runcvm/disks-populate-masks
          done
        done
      fi
    fi

    [ "${DISK_PREALLOC[$id]}" = "off" ] || disk_prealloc "${DISK_SPEC[$id]}" "${DISK_SRC_FILE[$id]}"

    disk_add_device "${DISK_SRC_FILE[$id]}" "$id" "${DISK_PREALLOC[$id]}"
  done

  [ -z "$ROOT_DISK_ID" ] || do_root_disk
}

# Creates and populates a new whole-root disk, and records it for runcvm-vm-init, which switches the
# VM's root filesystem to it with pivot_root, before anything else uses the root.
#
# The disk is populated from the image's filesystem below $RUNCVM_VM_MOUNTPOINT, without crossing
# into other filesystems, and leaving out its exclusions (see plan_mounts): everything that must
# stay live (/.runcvm, Docker's volumes, bind mounts and files such as /etc/hosts, and the kernel
# modules), each disk's backing file, and every other disk's and tmpfs mount's destination. It
# holds an empty directory at each excluded directory. A disk is populated only when it is
# created: it does not see later changes to the image or the container's filesystem.
#
# /.runcvm/rootdisk holds the disk's filesystem UUID; /.runcvm/rootdisk-mounts lists, encoded with
# path_encode, the container mounts runcvm-vm-init carries from the image's filesystem onto the
# disk: those directly below $RUNCVM_VM_MOUNTPOINT in the mount tree.
do_root_disk() {
  local id="$ROOT_DISK_ID" spec src i
  local -a excludes=()

  spec="${DISK_SPEC[$id]}"
  src="${DISK_SRC_FILE[$id]}"

  if [ "${DISK_NEW[$id]}" = "1" ]; then
    disk_create_file "$id"

    for i in "${!EXCL_DEST[@]}"
    do
      [ "${DEST_DISK[${EXCL_DEST[$i]}]}" = "$id" ] || continue
      disk_glob_escape "${EXCL_ON_DISK[$i]}"
      excludes+=(-x "$REPLY")
    done

    MKE2FS_CONFIG="$RUNCVM_GUEST/etc/mke2fs.conf" BLKID_CONF="$RUNCVM_GUEST/etc/blkid.conf" BLKID_FILE=/dev/null \
      mke2fs -q -F -t ext4 -d "$RUNCVM_VM_MOUNTPOINT" -E one_file_system "${excludes[@]}" "$src" >&2 || \
      error "Error: disk spec '$spec' invalid: mke2fs on '${DISK_SRC[$id]}' with fs 'ext4' failed"

    DISK_UUID[$id]=$(blkid -p -s UUID -o value "$src") || true
    if [ -z "${DISK_UUID[$id]}" ]; then
      error "Error: disk spec '$spec' invalid: no filesystem UUID found in src '${DISK_SRC[$id]}'"
    fi
  fi

  echo "${DISK_UUID[$id]}" >/.runcvm/rootdisk
  for i in "${!CMOUNT_PATH[@]}"
  do
    [ "${CMOUNT_TOP[$i]}" = "0" ] || echo "$(path_encode "${CMOUNT_PATH[$i]}")"
  done >/.runcvm/rootdisk-mounts

  [ "${DISK_PREALLOC[$id]}" = "off" ] || disk_prealloc "$spec" "$src"

  disk_add_device "$src" "$id" "${DISK_PREALLOC[$id]}"
}

# Writes /.runcvm/fstab, for runcvm-vm-init to mount in order, as MOUNT_ORDER lists the mounts:
# first each disk with layout 'subdirs' at /.runcvm/disks/<id>, the source of its destinations' bind
# mounts; then each mount at its path, in order of depth. Nothing is written where there are no
# mounts.
#
# Each held mount is listed in /.runcvm/held-mounts, one line each, <id> <path>, for runcvm-vm-init
# to hold at /.runcvm/submounts/<id> before mounting anything; and in its place in /.runcvm/fstab,
# where runcvm-vm-init mounts it again: with RUNCVM_FSTAB=disks (the default), as a comment
# '#runcvm-held <id> <path>'; with RUNCVM_FSTAB=all, as a bind mount from /.runcvm/submounts/<id>,
# which systemd and 'mount -a' can mount again. Paths are encoded with path_encode.
write_manifests() {
  local i d id ref path

  for i in "${!HELD_CMOUNT[@]}"
  do
    echo "$i $(path_encode "${CMOUNT_PATH[${HELD_CMOUNT[$i]}]}")"
  done >>/.runcvm/held-mounts

  [ "${#MOUNT_PATH[@]}" -gt 0 ] || return 0

  {
    for id in "${!DISK_SPEC[@]}"
    do
      [ "${DISK_LAYOUT[$id]}" = "subdirs" ] || continue
      echo "UUID=${DISK_UUID[$id]} /.runcvm/disks/$id ${DISK_FS[$id]} defaults,noatime 0 0"
    done

    for i in "${MOUNT_ORDER[@]}"
    do
      ref="${MOUNT_REF[$i]}"
      case "${MOUNT_KIND[$i]}" in
        disk)
          id="${DEST_DISK[$ref]}"
          path=$(path_encode "${DEST_GIVEN[$ref]}")
          if [ "${DISK_LAYOUT[$id]}" = "subdirs" ]; then
            echo "/.runcvm/disks/$id/${DEST_DIR[$ref]} $path none bind 0 0"
          else
            echo "UUID=${DISK_UUID[$id]} $path ${DISK_FS[$id]} defaults,noatime 0 0"
          fi
          ;;
        tmpfs)
          echo "${TMPFS_ENTRY[$ref]}"
          ;;
        held)
          path=$(path_encode "${MOUNT_PATH[$i]}")
          if [ "${RUNCVM_FSTAB:-disks}" = "all" ]; then
            echo "/.runcvm/submounts/$ref $path none bind 0 0"
          else
            echo "#runcvm-held $ref $path"
          fi
          ;;
      esac
    done
  } >>/.runcvm/fstab
}

# Adds disk backing file $1 to the QEMU command line, as disk number $2, with prealloc $3 ('on' or
# 'off').
disk_add_device() {
  local src="$1" id="$2" prealloc="$3" queues discard

  if [ "${RUNCVM_CPUS:-1}" -gt 8 ]; then
    queues=8
  else
    queues="${RUNCVM_CPUS:-1}"
  fi

  # A preallocated disk ignores the VM's discards and writes zeroes as data, keeping its blocks
  # allocated; a sparse disk passes both on to the backing file, freeing its blocks.
  if [ "$prealloc" = "on" ]; then
    discard="discard=ignore,detect-zeroes=off"
  else
    discard="discard=unmap,detect-zeroes=unmap"
  fi

  DISKS+=(
    # Create a block backend (no implicit frontend device attached)
    # -drive id=drv$id       : give this backend a unique identifier
    # file=${src//,/,,}      : source image file, each ',' doubled, as QEMU's option syntax needs
    # if=none                : do not attach directly, will be bound later with -device
    # format=raw             : treat the file as raw block device
    # media=disk             : marks this as a disk, not a CD-ROM
    # cache=none             : use O_DIRECT, bypass host page cache, rely on guest flushes for durability
    # aio=io_uring           : use Linux io_uring for asynchronous I/O (lower overhead than libaio)
    # $discard              : discard=unmap,detect-zeroes=unmap passes guest TRIM/UNMAP, and
    #                          converts guest zero writes into UNMAPs, to the backing file;
    #                          discard=ignore,detect-zeroes=off does neither (see above)
    # The whole argument is quoted: the path may hold whitespace.
    -drive "id=drv$id,file=${src//,/,,},if=none,format=raw,media=disk,cache=none,aio=io_uring,$discard"

    # Create a dedicated I/O thread (dataplane) to offload block I/O
    # -object iothread,id=ioth$id : defines an iothread with a unique identifier
    -object iothread,id=ioth$id

    # Attach a virtio-blk PCI frontend to the backend and iothread
    # -device virtio-blk-pci     : create a virtio block device on PCI bus
    # drive=drv$id               : connect to backend created above
    # iothread=ioth$id           : process requests in dedicated I/O thread
    # queue-size=1024            : set depth of each virtqueue
    # num-queues=4               : create 4 queues, allowing parallel I/O across vCPUs
    -device virtio-blk-pci,drive=drv$id,iothread=ioth$id,queue-size=1024,num-queues=$queues
  )
}

do_networks() {
  local id=0 ifpath if mac vhost
  local DOCKER_IF DOCKER_IF_MAC DOCKER_IF_MTU DOCKER_IF_IP DOCKER_IF_IP_NETPREFIX DOCKER_IF_IP_GW

  HAS_IPV6=0

  for ifpath in /.runcvm/network/devices/*
  do
    if=$(busybox basename "$ifpath")

    [ "$if" = "default" ] && continue

    load_network "$if"

    # Set (not local): read by the caller to decide whether to enable IPv6
    # on the VM's kernel command line.
    if load_network6 "$if"; then
      HAS_IPV6=1
    fi

    mac=$(busybox sed -r 's/^..:..:../52:54:00/' <<<$DOCKER_IF_MAC)

    if [ "$RUNCVM_QEMU_NET_VHOST" = "1" ]; then
      vhost="on"
    else
      vhost="off"
    fi

    IFACES+=(
        -netdev tap,id=qemu$id,ifname=tap-$DOCKER_IF,script=$QEMU_IFUP,downscript=$QEMU_IFDOWN,vhost=$vhost
        -device virtio-net-pci,netdev=qemu$id,mac=$mac,rombar=$id
    )

    id=$((id+1))
  done
}

[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

DISKS=()
ROOT_DISK_ID=""
container_mounts
if [ -n "$RUNCVM_DISKS" ]; then
  # e.g. /disk1,/home,ext4,5G;/disk2,/var,ext4,1G
  IFS=';' read -r -a DISK_SPECS <<< "$RUNCVM_DISKS"
  for i in "${!DISK_SPECS[@]}"
  do
    disk_parse "${DISK_SPECS[$i]}" "$i"
  done
fi
tmpfs_parse
plan_check
plan_mounts
disks_create
write_manifests

# vhost-net needs /dev/vhost-net, which the runtime passes into the container only if it
# exists on the host: without it, QEMU would fail to start with vhost=on.
if [ "$RUNCVM_QEMU_NET_VHOST" = "1" ] && ! [ -e /dev/vhost-net ]; then
  echo "RunCVM: Warning: RUNCVM_QEMU_NET_VHOST=1 but /dev/vhost-net is unavailable; continuing without vhost-net" >&2
  RUNCVM_QEMU_NET_VHOST=0
fi

IFACES=()
do_networks

if [[ -z "$RUNCVM_CPUS" || "$RUNCVM_CPUS" -le 0 ]]; then
  RUNCVM_CPUS=$(busybox nproc)
fi

# TODO:
# - Consider using '-device pvpanic'

# Choose QEMU acceleration according to RUNCVM_QEMU_ACCEL (validated by runcvm-runtime):
# - kvm (default): KVM, which requires /dev/kvm
# - auto: KVM if /dev/kvm is available, otherwise software emulation (TCG), with a warning
# - tcg: always software emulation (TCG), deliberately and so without a warning
case "${RUNCVM_QEMU_ACCEL:-kvm}" in
  tcg)
    ACCEL="tcg"
    ;;
  auto)
    if [ -e /dev/kvm ]; then
      ACCEL="kvm"
    else
      ACCEL="tcg"
      echo "RunCVM: Warning: /dev/kvm is unavailable; falling back to software emulation (TCG), which is much slower" >&2
    fi
    ;;
  *)
    [ -e /dev/kvm ] || error "RunCVM: Error: /dev/kvm is unavailable; launch with --env=RUNCVM_QEMU_ACCEL=auto or tcg to allow software emulation"
    ACCEL="kvm"
    ;;
esac

# runcvm-runtime sets RUNCVM_KERNEL_FALLBACK to '<ID> <kernel>' when it found no kernel for the
# image's distribution (its os-release ID), or any it names in ID_LIKE, and chose its default.
if [ -n "$RUNCVM_KERNEL_FALLBACK" ]; then
  echo "RunCVM: Warning: RunCVM has no kernel for the image's distribution ('${RUNCVM_KERNEL_FALLBACK% *}'), so is booting its '${RUNCVM_KERNEL_FALLBACK##* }' kernel; launch with --env=RUNCVM_KERNEL=<dist> to choose another" >&2
fi

# Software emulation (TCG) keeps a cache of translated code which, by default, may grow to
# 1GiB. Size it to RUNCVM_QEMU_TCG_TB_MEM_SIZE (Mb), which runcvm-runtime adds to the
# container's memory limit, keeping the container's memory limit aligned with QEMU's use.
TCG_ACCEL=(-accel tcg,tb-size=${RUNCVM_QEMU_TCG_TB_MEM_SIZE:-128})

if [ "$RUNCVM_QEMU_ARCH" = "arm64" ]; then
  CMD="$(which qemu-system-aarch64)"
  if [ "$ACCEL" = "kvm" ]; then
    MACHINE+=(-cpu host -machine virt,accel=kvm,gic-version=max,usb=off)
  else
    MACHINE+=(-cpu max -machine virt,gic-version=max,usb=off "${TCG_ACCEL[@]}")
  fi
else
  CMD="$(which qemu-system-x86_64)"

  # QEMU machine configuration:
  # - q35: modern Intel chipset with PCIe and UEFI support
  # - accel=kvm: enable KVM for near-native performance (requires hardware virtualisation)
  # - usb=on: enable USB support (e.g., for peripherals or boot devices)
  # - sata=off: disable SATA controller if using virtio/NVMe instead
  # - vmport=off: disable VMware backdoor port for improved security/stealth
  # - smm=on: enable System Management Mode (required for UEFI Secure Boot)
  # - dump-guest-core=off: disable saving core dumps on guest crash (saves disk space)
  # - hpet=off: disable High Precision Event Timer to avoid timing issues in some guests
  # - kernel_irqchip=on: enable kernel-based interrupt controller for better performance

  # - usb=on: enable USB support when requested
  if [ "$RUNCVM_QEMU_USB" = "on" ]; then
    USB="on"
  else
    USB="off"
  fi

  # Use KVM or software emulation, as chosen above.
  # kernel_irqchip is a KVM-only feature, so it is omitted from the TCG variant.
  if [ "$ACCEL" = "kvm" ]; then
    MACHINE+=(-cpu host,pmu=off)
    MACHINE+=(-machine q35,accel=kvm,sata=off,vmport=off,smm=on,dump-guest-core=off,hpet=off,usb=$USB,kernel_irqchip=on)
  else
    MACHINE+=(-cpu max)
    MACHINE+=(-machine q35,sata=off,vmport=off,smm=on,dump-guest-core=off,hpet=off,usb=$USB "${TCG_ACCEL[@]}")
  fi

  # Enable the QEMU debug exit device for debugging purposes.
  # This device allows the guest to trigger a debug exit, which can be useful for debugging
  MACHINE+=(-device isa-debug-exit)

  # Set the virtual hardware clock to UTC time and enable drift correction using slewing.
  # This ensures the VM clock starts in UTC and gradually adjusts for time drift,
  # providing smooth and accurate timekeeping without sudden changes.
  MACHINE+=(-rtc base=utc,driftfix=slew)
fi

# RUNCVM_QEMU_DISPLAY -- the display frontend: none, curses
# RUNCVM_QEMU_VGA -- the backend VGA video device: none, std, virtio, cirrus
# RUNCVM_QEMU_VNC_DISPLAY -- the VNC display number (where enabled): 0, 1, ...

CONSOLE=()
DISPLAY=()

case "${RUNCVM_DISPLAY_MODE:-headless}" in
  headless) # virtconsole / hvc0
    RUNCVM_QEMU_DISPLAY="${RUNCVM_QEMU_DISPLAY:-none}"
    RUNCVM_QEMU_VGA="${RUNCVM_QEMU_VGA:-none}"

    # Creates a stdio backend connected to the virtual console.
    # Use with /dev/hvc0
    CONSOLE+=(
      -chardev stdio,id=char0,mux=off,signal=off
      -device virtconsole,chardev=char0,id=console0
    )

    CONSOLE_DEV="hvc0"
    NOMODESET="1"
    ;;
  serial) # stdio + monitor / ttyS0
    RUNCVM_QEMU_DISPLAY="${RUNCVM_QEMU_DISPLAY:-none}"
    RUNCVM_QEMU_VGA="${RUNCVM_QEMU_VGA:-none}"

    # Creates a multiplexed stdio backend connected to the serial port (and the QEMU monitor).
    # Use with /dev/ttyS0
    CONSOLE+=(
      -chardev stdio,id=char0,mux=on,signal=off
      -serial chardev:char0 -mon chardev=char0
    )

    # Set monitor escape key to CTRL-T to reduce risk of conflict (as default, CTRL-A, is  commonly used)
    CONSOLE+=(-echr 20)
    CONSOLE_DEV="ttyS0"
    NOMODESET="1"
    ;;
  vnc) # VNC + tty0
    RUNCVM_QEMU_DISPLAY="${RUNCVM_QEMU_DISPLAY:-none}"
    RUNCVM_QEMU_VGA="${RUNCVM_QEMU_VGA:-virtio}"
    RUNCVM_QEMU_VNC_DISPLAY="${RUNCVM_QEMU_VNC_DISPLAY:-0}"

    CONSOLE_DEV="tty0"
    NOMODESET="0"
    ;;
  *)
    error "Error: RUNCVM_DISPLAY_MODE '$RUNCVM_DISPLAY_MODE' invalid, must be one of: default|headless, serial, vnc" ;;
esac

# Save choice of console device
echo "$CONSOLE_DEV" >/.runcvm/console

# Generate QEMU display options
if [ -n "$RUNCVM_QEMU_DISPLAY" ]; then
  DISPLAY+=(-display $RUNCVM_QEMU_DISPLAY)
fi

if [ -n "$RUNCVM_QEMU_VGA" ]; then

  # i.e. virtio, std, none
  DISPLAY+=(-vga $RUNCVM_QEMU_VGA)

  if [ "$RUNCVM_QEMU_VGA" != "none" ]; then
    NOMODESET="0" # Disable nomodeset if using a graphical console
    DISPLAY+=(-device virtio-tablet-pci)
    DISPLAY+=(-audiodev none,id=snd0 -device intel-hda -device hda-output,audiodev=snd0)

    # For now, unless/until `-device virtio-gpu-pci` support is provided,
    # the VNC display is only relevant if VGA is not 'none'
    if [ -n "$RUNCVM_QEMU_VNC_DISPLAY" ]; then
      DISPLAY+=(-vnc :$RUNCVM_QEMU_VNC_DISPLAY,password=off)
    fi
  fi
fi

# Append nomodeset unless using a graphical console (i.e. not serial or virtconsole)
# PROBABLY ONLY NEEDED FOR `-display curses` (RUNCVM_QEMU_DISPLAY=curses) CASE
if [ "$NOMODESET" = "1" ]; then
  APPEND+=(nomodeset)
fi

if [ "$RUNCVM_BIOS_DEBUG" != "1" ]; then
  # Disable SeaBIOS serial console.
  # This -cfw_cfg path is modified from the SeaBIOS default (to avoid an otherwise-inevitable QEMU
  # warning being emitted) and so requires patched bios.bin file(s) (see Dockerfile)
  OPTS+=(-fw_cfg opt/org.seabios/etc/sercon-port,string=0)
fi

if [ "$RUNCVM_BIOS" = "EFI" ]; then
  # UEFI firmware
  OPTS+=(
    # -drive if=pflash,format=raw,unit=0,readonly=on,file=$RUNCVM_GUEST/usr/share/OVMF/OVMF_CODE.fd
    # -drive if=pflash,format=raw,unit=1,readonly=on,file=$RUNCVM_GUEST/usr/share/OVMF/OVMF_VARS.fd
    -bios $RUNCVM_GUEST/usr/share/OVMF/OVMF.fd
  )
fi

MEM_BACKEND=(-numa node,memdev=mem)
if [ "$RUNCVM_HUGETLB" != "1" ]; then
  # prealloc defaults to off, as it is slower with mem-path=/dev/shm
  MEM_PATH="/dev/shm" 
  MEM_BACKEND+=(-object memory-backend-file,id=mem,size=$RUNCVM_MEM_SIZE,mem-path=$MEM_PATH,share=on,prealloc=${RUNCVM_QEMU_MEM_PREALLOC:-off})
else
  # Fastest option: about 15% faster for CPU- and network-intensive workloads, and 3.5x
  # for disk-intensive workloads, than /dev/shm.
  MEM_BACKEND+=(-object memory-backend-memfd,id=mem,size=$RUNCVM_MEM_SIZE,share=on,prealloc=${RUNCVM_QEMU_MEM_PREALLOC:-off},hugetlb=on)
fi

# Queue sizes of 16-64 can outperform 1024 in some scenarios; 1024 is the default.
VIRTIOFS_QUEUE_SIZE=1024
VIRTIOFS+=(
  -chardev socket,id=virtiofs,path=$QEMU_VIRTIOFSD_SOCKET
  -device vhost-user-fs-pci,queue-size=$VIRTIOFS_QUEUE_SIZE,chardev=virtiofs,tag=runcvmfs,ats=off
)

# Experimental: Enable to specify a dedicated PCI bridge
# OPTS+=(-device pci-bridge,bus=pcie.0,id=pci-bridge-0,chassis_nr=1,shpc=off,addr=2,io-reserve=4k,mem-reserve=1m,pref64-reserve=1m)

# Experimental: Enable for a SCSI bus
# OPTS+=(-device virtio-scsi-pci,id=scsi0,disable-modern=true)

# Enable IPv6 in the VM only if a global IPv6 address was captured for at
# least one interface (set by do_networks(), above), unless overridden with
# --env=RUNCVM_IPV6=<0|1>. Otherwise, disable IPv6 entirely at kernel boot
# time.
case "$RUNCVM_IPV6" in
  1) HAS_IPV6=1 ;;
  0) HAS_IPV6=0 ;;
esac

[ "$HAS_IPV6" = "1" ] || APPEND+=(ipv6.disable=1)
APPEND+=(panic=-1)

# Disable unneeded functionality
APPEND+=(scsi_mod.scan=none tsc=reliable no_timer_check rcupdate.rcu_expedited=1 i8042.direct=1 i8042.dumbkbd=1 i8042.nopnp=1 i8042.noaux=1 noreplace-smp reboot=k cryptomgr.notests pci=lastbus=0 selinux=0)

# Enable systemd startup logging by default:
# - Only effective when --env=RUNCVM_KERNEL_DEBUG=1
# - Override this by launching with --env='RUNCVM_KERNEL_APPEND=systemd.show_status=0'
APPEND+=(systemd.show_status=1)

if [ "$RUNCVM_KERNEL_DEBUG" = "1" ]; then
  APPEND+=(console=$CONSOLE_DEV)
else
  APPEND+=(quiet)
fi

ARGS=(
  -no-user-config
  -nodefaults
  -no-reboot

  -action panic=none
  -action reboot=shutdown

  "${MACHINE[@]}"
  "${DISPLAY[@]}"
  "${OPTS[@]}"

  # N.B. There is a counterintuitive relationship between cpus and memory, and performance:
  # - more cpus needs more memory to maintain the same virtiofs disk I/O performance.
  -m "$RUNCVM_MEM_SIZE"
  -smp $RUNCVM_CPUS,cores=1,threads=1,sockets=$RUNCVM_CPUS,maxcpus=$RUNCVM_CPUS

  # Creates a virtio-serial bus on the PCI bus; this is used for the guest agent and virtiofs
  -device virtio-serial-pci,id=serial0 

  # Creates an RNG on the PCI bus
  -object rng-random,id=rng0,filename=/dev/urandom -device virtio-rng-pci,rng=rng0

  # Memory backend
  "${MEM_BACKEND[@]}"

  # virtiofs socket and interface
  "${VIRTIOFS[@]}"

  # Configure host/container tap device with PXE roms disabled
  "${IFACES[@]}"
  "${DISKS[@]}"

  # Configure console
  "${CONSOLE[@]}"

  # Support for guest agent
  -chardev socket,id=qemuguest0,path=$QEMU_GUEST_AGENT,server=on,wait=off
  -device virtserialport,chardev=qemuguest0,name=org.qemu.guest_agent.0

  # Creates a unix socket for the QEMU monitor
  -monitor unix:$QEMU_MONITOR_SOCKET,server,nowait

  # Kernel and initrd and kernel cmdline
  -kernel $RUNCVM_KERNEL_PATH
  -initrd $RUNCVM_KERNEL_INITRAMFS_PATH
  -L $RUNCVM_GUEST/usr/share/qemu
  -append "$RUNCVM_KERNEL_ROOT $INIT rw ${APPEND[*]} $RUNCVM_KERNEL_APPEND"
)

# With a terminal ('docker run -t') as standard input, QEMU's stdio console keeps output
# processing (OPOST) on the container's terminal, while the VM's console translates each LF to
# CR LF itself, as a terminal does: stop the container's terminal from translating it again, so
# lines end CR LF, not CR CR LF.
#
# This applies where the VM's console is QEMU's stdio, which every console device but tty0 is, in
# any display mode and on any architecture (e.g. hvc0, or a serial port's ttyS0): so tty0 alone,
# the console of display mode 'vnc', which is the VM's display, is left out.
if [ -t 0 ] && [ "$CONSOLE_DEV" != tty0 ]; then
  busybox stty -onlcr 2>/dev/null || true
fi

# virtiofsd is started in the background by runcvm-ctr-entrypoint, and QEMU fails at once if the
# virtiofsd socket does not yet exist: wait up to 30s for it.
for ((i = 0; i < 300; i++)); do
  [ -S "$QEMU_VIRTIOFSD_SOCKET" ] && break
  busybox sleep 0.1
done
[ -S "$QEMU_VIRTIOFSD_SOCKET" ] || error "RunCVM: Error: virtiofsd socket $QEMU_VIRTIOFSD_SOCKET not created within 30s (see /run/.virtiofsd.log)"

if [[ "$RUNCVM_BREAK" =~ preqemu ]]; then echo "Preparing to run: '$CMD' ${ARGS[@]@Q}"; bash; fi

if [ "$RUNCVM_QEMU_DEBUG" = "1" ]; then
  "$CMD" "${ARGS[@]}" || echo "QEMU exited with code: $?" >&2
  echo "QEMU memory cgroup events:" >&2
  cat /sys/fs/cgroup/memory.events >&2
else
exec "$CMD" "${ARGS[@]}"
fi