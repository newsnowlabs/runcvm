#!/.runcvm/guest/bin/bash

# Load defaults and aliases
. /.runcvm/guest/scripts/runcvm-ctr-defaults

if [ "$RUNCVM_SYS_ADMIN" = "1" ]; then
  OPTS+=(--modcaps=+sys_admin)
fi

# RUNCVM_VIRTIOFSD_CACHE takes virtiofsd's --cache values, and 'none' as a name for 'never'
VIRTIOFSD_CACHE=${RUNCVM_VIRTIOFSD_CACHE:-auto}
[ "$VIRTIOFSD_CACHE" = "none" ] && VIRTIOFSD_CACHE=never
OPTS+=(--cache="$VIRTIOFSD_CACHE")

# RUNCVM_VIRTIOFSD_KILLPRIV=1, which runcvm-runtime validates, has virtiofsd clear setuid and setgid
# bits and file capabilities when the VM modifies a file (FUSE's KILLPRIV_V2), sparing the VM a
# request to check for file capabilities before each write. RunCVM's virtiofsd patches (see
# patches/virtiofsd) cover fallocate and copy_file_range, which the protocol gives no flag for.
if [ "$RUNCVM_VIRTIOFSD_KILLPRIV" = "1" ]; then
  OPTS+=(--killpriv-v2)
fi

# RUNCVM_VIRTIOFSD_POLL_US=<microseconds>, which runcvm-runtime validates (0 to 1000), has virtiofsd
# keep polling the VM's request queue for that long after it runs dry, before waiting to be
# notified (RunCVM's virtiofsd patch 0006).
if [ "${RUNCVM_VIRTIOFSD_POLL_US:-0}" -gt 0 ]; then
  OPTS+=(--queue-poll-us="$RUNCVM_VIRTIOFSD_POLL_US")
fi

# --inode-file-handles=never keeps virtiofsd from requiring CAP_DAC_READ_SEARCH, which containers
# lack by default (virtiofsd's default, 'prefer', needs it).
# Send logs to /run in container (not in VM)
exec "$(which virtiofsd)" "${OPTS[@]}" --announce-submounts --xattr --inode-file-handles=never --socket-path=$QEMU_VIRTIOFSD_SOCKET --shared-dir=$RUNCVM_VM_MOUNTPOINT --sandbox=chroot >/run/.virtiofsd.log 2>&1
