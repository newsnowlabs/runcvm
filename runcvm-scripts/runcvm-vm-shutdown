#!/.runcvm/guest/bin/bash

# RunCVM's init (--init) runs this as its shutdown action, however it was asked to end the VM
# (poweroff, halt or reboot): it ends every other process, as Docker's own init would, unmounts
# the filesystems in /.runcvm/fstab, the disks among them, so that each is left clean, and then
# powers the VM off itself. Busybox init would otherwise end the VM as it was asked to, and a
# halted VM, unlike one powered off or rebooted, would leave the container running.
#
# - When the container is being stopped (runcvm-ctr-shutdown has created
#   /.runcvm/state/stopping), every process is sent SIGTERM, and is waited for however long it
#   takes: Docker's stop timeout alone limits the wait, as for any container. The disks are synced
#   every second meanwhile, so that should Docker end the VM, writes made to them up to then are
#   kept.
# - When the entrypoint has exited by itself, every process left is killed at once (SIGKILL).

# Load RunCVM's own environment, saved by runcvm-ctr-entrypoint
. /.runcvm/config

BUSYBOX=$RUNCVM_GUEST/bin/busybox

# The mountpoints of /.runcvm/fstab's entries, in the order they are mounted (dsts), held mounts
# included, whether as '#runcvm-held <id> <path>' or as binds from /.runcvm/submounts/<id>; and of
# the disks' own mounts among them, each mounting a disk by its UUID (disks), with the root
# filesystem if it is a whole-root disk. Each path is written with fstab's octal escapes (see
# path_encode in runcvm-ctr-qemu), which printf's %b decodes.
dsts=()
disks=()
if [ -f /.runcvm/fstab ]; then
  while read -r src dst path _
  do
    [ "$src" = "#runcvm-held" ] && dst="$path"
    [[ -n "$dst" && ( "$src" != \#* || "$src" = "#runcvm-held" ) ]] || continue
    printf -v dst '%b' "$dst"
    dsts+=("$dst")
    [[ "$src" != UUID=* ]] || disks+=("$dst")
  done </.runcvm/fstab
fi
[ -f /.runcvm/rootdisk ] && disks+=(/)

# Syncs the disks alone, each with syncfs (sync -f), never with a plain sync: that would also sync
# the VM's virtiofs filesystems, and virtiofsd would answer by syncing the whole of each host
# filesystem shared with the VM. The disks need this sync, as their writes stay in the VM's memory
# until synced; writes to virtiofs go straight to the host.
sync_disks() {
  local disk

  for disk in "${disks[@]}"
  do
    $BUSYBOX sync -f "$disk" 2>/dev/null
  done
}

# Prints the PIDs of the processes still running, other than init, this script, the subshell
# running this function ($BASHPID, as in "$(processes)") and kernel threads (whose command line is
# empty).
processes() {
  local p pid cmdline

  for p in /proc/[0-9]*
  do
    pid="${p#/proc/}"
    [[ "$pid" = 1 || "$pid" = "$$" || "$pid" = "$BASHPID" ]] && continue
    cmdline=""
    read -r -d '' cmdline <"$p/cmdline" 2>/dev/null
    [ -n "$cmdline" ] && echo "$pid"
  done
}

# kill -1 signals every process but init and the caller, so it must be bash's own kill: busybox's,
# as a separate process, would signal this script too.
if [ -f /.runcvm/state/stopping ]; then
  kill -TERM -1 2>/dev/null
else
  kill -KILL -1 2>/dev/null
fi

# Wait for the processes to end, syncing the disks every second (every fifth check).
for ((i = 1; ; i++))
do
  [ -z "$(processes)" ] && break
  (( i % 5 )) || sync_disks
  $BUSYBOX sleep 0.2
done

sync_disks

# Unmount the entries of /.runcvm/fstab in the reverse of the order they are mounted, so that a
# mount below a path is unmounted before the mount at that path. A filesystem that can't be
# unmounted is remounted read-only: a disk with layout 'subdirs' is mounted at /.runcvm/disks/<n>,
# its own entry, where remounting it read-only applies to the whole filesystem, whatever is still
# mounted from it.
for ((i = ${#dsts[@]} - 1; i >= 0; i--))
do
  $BUSYBOX umount "${dsts[$i]}" 2>/dev/null || \
    $BUSYBOX mount -o remount,ro "${dsts[$i]}" 2>/dev/null
done

# A whole-root disk is the VM's root filesystem, which can only be remounted read-only.
if [ -f /.runcvm/rootdisk ]; then
  $BUSYBOX mount -o remount,ro / 2>/dev/null
fi

# Every process has ended and the disks are clean, so power off at once (-f), without signalling
# init.
$BUSYBOX poweroff -f
