#!/.runcvm/guest/bin/bash -e

# Load RunCVM's own environment, saved by runcvm-ctr-entrypoint
. /.runcvm/config

# Load defaults and aliases
. $RUNCVM_GUEST/scripts/runcvm-ctr-defaults

# Keep the console's device out of runtime power management, where it has it (e.g. the arm64 virt
# machine's UART, ttyAMA0, in RUNCVM_DISPLAY_MODE=serial): a runtime-suspended UART defers output
# until it resumes, so output written just before the VM powers off would be lost.
console_pm=/sys/class/tty/$(cat /.runcvm/console)/device/power/control
[ -w "$console_pm" ] && echo on >"$console_pm" || true

# Alpine initrd doesn't honour command-line rw flag.
# -i keeps mount from running any /sbin/mount.<type> helper from the image, and
# --options-source=disable keeps the image's /etc/fstab from adding options to the remount (e.g.
# 'errors=remount-ro', which virtiofs rejects, halting the VM as this script runs with 'bash -e').
mount -i --options-source=disable -o remount,rw /

# FIXME: Something is making /.runcvm ro, so remount it rw
# until such time as exit code handling and dropbear key creation
# obviate the need for this.
mount -i --options-source=disable -o remount,rw /.runcvm

# Alpine initrd doesn't configure /dev device permissions and ownership
# to support non-root users.
if [ "$(findmnt -rnu -o FSTYPE /dev)" = "devtmpfs" ]; then
  [ -e /dev/stdin ] || ln -snf /proc/self/fd/0 /dev/stdin
  [ -e /dev/stdout ] || ln -snf /proc/self/fd/1 /dev/stdout
  [ -e /dev/stderr ] || ln -snf /proc/self/fd/2 /dev/stderr
  [ -e /proc/kcore ] && ln -snf /proc/kcore /dev/core
  [ -h /dev/ptmx ] || ln -snf pts/ptmx /dev/ptmx
  chmod 666 /dev/null /dev/random /dev/urandom /dev/zero /dev/tty /dev/pts/ptmx
  chmod 620 /dev/tty[0-9]*
  # Images without a 'tty' group (e.g. images with no /etc/group) have no members to grant access
  # to, so leave the devices' group unchanged: runcvm-vm-init runs with 'bash -e' as the VM's PID 1,
  # so a failure here would halt the VM.
  chgrp tty /dev/tty* 2>/dev/null || true
fi

# Unmount /run if it is a tmpfs (not a virtiofs) mounted by the initramfs
# /run may be populated in the underlying image, and may also be a volume or be bind-mounted,
# and its contents should be accessible in these cases.
if [ "$(findmnt -rnu -o FSTYPE /run)" = "tmpfs" ]; then
  busybox umount -fl /run
fi

# FIXME: virtiofs mounts aren't always made rw. Remount them all rw (if allowed)
# $RUNCVM_GUEST/bin/mount -t virtiofs | awk '{print $3}' | xargs -n 1 mount -o remount,rw

# Some systems do not set up /dev/fd. If needed, add it.
if ! [ -h /dev/fd ]; then
  ln -s /proc/self/fd /dev/fd
fi

# Have the kernel load modules on demand through RunCVM's module loader, which runs the image's
# modprobe where the image has one and RunCVM's otherwise: the kernel's default, /sbin/modprobe, is
# absent from many images (e.g. busybox, rancher/k3s), and the kernel then loads no module that it
# requests, such as overlay on its first mount. The loader is in RunCVM's tools, which stay
# available to the kernel for the VM's lifetime, including after a switch to a whole-root disk.
echo "$RUNCVM_GUEST/scripts/runcvm-vm-modprobe" >/proc/sys/kernel/modprobe

# Reports error $1 on the console device, which the container's output is connected to, and powers
# the VM off with exit status 1.
vm_init_error() {
  local console

  read -r console </.runcvm/console
  echo "RunCVM: Error: $1" >"/dev/$console"
  echo 1 >/.runcvm/exitcode
  poweroff -f
  exit 1
}

# Sets variable $1 to field $2 decoded: RunCVM writes each path in /.runcvm/fstab and the other
# files it passes to the VM with fstab's octal escapes for '\', space, tab and newline (see
# path_encode in runcvm-ctr-qemu), as the kernel writes mountpoints in mountinfo. Each '\' in such a
# field begins an escape, so it decodes exactly; assigning directly keeps any trailing newline.
path_decode() {
  printf -v "$1" '%b' "$2"
}

# Load the kernel modules of each disk's filesystem, as listed in disk-filesystems, before any disk
# is mounted.
if [ -f /.runcvm/fstab ]; then
  declare -A DISK_FSS=()
  while read -r src _ type _
  do
    [[ "$src" != UUID=* ]] || DISK_FSS[$type]=1
  done </.runcvm/fstab

  for fs in "${!DISK_FSS[@]}"
  do
    disk_fs "$fs" || vm_init_error "fs '$fs' is not supported"
    for module in "${DISK_FS_MODULES[@]}"
    do
      busybox modprobe "$module" || vm_init_error "fs '$fs' needs kernel module '$module', which the VM's kernel ($(busybox uname -r)) lacks"
    done
  done
fi

# Populates each new disk that its mkfs command left empty, as listed in /.runcvm/disks-populate
# (see disks_create in runcvm-ctr-qemu), from the image's filesystem at root $1: copies each
# destination's contents to its directory on the disk, with RunCVM's own cp, which preserves
# ownership, permissions, timestamps, links and extended attributes, and stays on the filesystem
# holding the destination.
#
# Each path listed for the destination in /.runcvm/disks-populate-masks is masked while copying, so
# that the disk holds none of its contents: a directory with an empty tmpfs, with the original's
# mode, owner and group, leaving an empty directory on the disk; and a file with an empty file
# bind-mounted from a scratch tmpfs, whose copy is then removed, leaving nothing. The masks are
# removed in the reverse order, every file mask before the scratch tmpfs is detached.
populate_disks() {
  local root="${1%/}" id uuid fs dir dst mnt mid mdir mpath i mode uid gid file
  local scratch=/.runcvm/populate-scratch
  local -a masks=() file_masks=()
  local -A mounted=()

  [ -f /.runcvm/disks-populate ] || return 0

  while read -r id uuid fs dir dst
  do
    path_decode dst "$dst"
    dst="$root$dst"

    mnt="/.runcvm/disks/$id"
    if [ -z "${mounted[$id]}" ]; then
      mkdir -p "$mnt"
      BLKID_CONF="$RUNCVM_GUEST/etc/blkid.conf" BLKID_FILE=/dev/null mount -i --options-source=disable -t "$fs" -o noatime "UUID=$uuid" "$mnt" || \
        vm_init_error "dst '$dst' cannot be populated: mounting its new disk failed"
      mounted[$id]=1
    fi

    masks=() file_masks=()
    if [ -f /.runcvm/disks-populate-masks ]; then
      while read -r mid mdir _ mpath
      do
        [[ "$mid" = "$id" && "$mdir" = "$dir" ]] || continue
        path_decode mpath "$mpath"
        mpath="$root$mpath"
        # A tmpfs mount's destination may not exist in the image: there is nothing there to copy.
        [ -e "$mpath" ] || continue

        read -r mode uid gid < <(busybox stat -c '%a %u %g' "$mpath")
        if [ -d "$mpath" ]; then
          mount -i --options-source=disable -t tmpfs -o "mode=$mode,uid=$uid,gid=$gid" tmpfs "$mpath" || \
            vm_init_error "dst '$dst' cannot be populated: masking '$mpath' failed"
        else
          if ! findmnt -rn --mountpoint "$scratch" >/dev/null; then
            mkdir -p "$scratch"
            mount -i --options-source=disable -t tmpfs -o mode=0700 tmpfs "$scratch"
          fi
          file="$scratch/${#masks[@]}"
          : >"$file"
          busybox chown "$uid:$gid" "$file"
          busybox chmod "$mode" "$file"
          mount -i --options-source=disable --bind "$file" "$mpath" || \
            vm_init_error "dst '$dst' cannot be populated: masking '$mpath' failed"
          file_masks+=("$mpath")
        fi
        masks+=("$mpath")
      done </.runcvm/disks-populate-masks
    fi

    mkdir -p "$mnt/$dir"
    if [ -d "$dst" ]; then
      $RUNCVM_GUEST/bin/coreutils --coreutils-prog=cp -a -x "$dst/." "$mnt/$dir/" || \
        vm_init_error "dst '$dst' cannot be populated: copying its contents to its new disk failed"
    fi

    for ((i = ${#masks[@]} - 1; i >= 0; i--))
    do
      busybox umount "${masks[$i]}" || \
        vm_init_error "dst '$dst' cannot be populated: unmasking '${masks[$i]}' failed"
    done

    # Leave out each masked file, as mke2fs does: the empty copy of its mask is removed. (The VM's
    # mount step creates an empty file where a mount needs one.)
    for mpath in "${file_masks[@]}"
    do
      busybox rm -f "$mnt/$dir/${mpath#"$dst"/}"
    done
  done </.runcvm/disks-populate

  if findmnt -rn --mountpoint "$scratch" >/dev/null; then
    busybox umount "$scratch"
    rmdir "$scratch"
  fi

  # Unmount the disks again, for the fstab to mount them as for any other boot.
  for id in "${!mounted[@]}"
  do
    busybox umount "/.runcvm/disks/$id" || vm_init_error "unmounting new disk '/.runcvm/disks/$id' after populating it failed"
  done
}

# Populate the new disks from the image's filesystem, before any switch to a whole-root disk, which
# holds none of the other disks' destinations.
populate_disks /

# Switch the root filesystem to the whole-root disk, if RUNCVM_DISKS defines one (see do_root_disk
# in runcvm-ctr-qemu). This must happen before anything else uses the root: everything after it,
# and the workload, sees the disk as /.
if [ -f /.runcvm/rootdisk ]; then
  read -r ROOTDISK_UUID </.runcvm/rootdisk

  # The paths to carry onto the disk: each mount directly below the root, such as /proc, /sys and
  # /dev; and each path the container recorded as a mountpoint, as Docker's volumes appear in the
  # VM as mounts only once accessed, and its bind-mounted files, such as /etc/hosts, never do. Both
  # are kept encoded, as mountinfo and /.runcvm/rootdisk-mounts give them, until the set is complete,
  # so that each path is in it once.
  declare -A ROOTDISK_ENCODED=()
  while read -r id parent _ _ mnt _
  do
    [ "$mnt" != "/" ] || ROOTDISK_ROOT="$id"
  done </proc/self/mountinfo
  while read -r id parent _ _ mnt _
  do
    if [[ "$parent" = "$ROOTDISK_ROOT" && "$mnt" != "/" && "$mnt" != "/.runcvm" ]]; then
      ROOTDISK_ENCODED[$mnt]=1
    fi
  done </proc/self/mountinfo
  while IFS= read -r mnt
  do
    [ -z "$mnt" ] || ROOTDISK_ENCODED[$mnt]=1
  done </.runcvm/rootdisk-mounts

  ROOTDISK_MOUNTS=()
  for mnt in "${!ROOTDISK_ENCODED[@]}"
  do
    path_decode path "$mnt"
    ROOTDISK_MOUNTS+=("$path")
  done

  busybox modprobe ext4
  mkdir -p /.runcvm/newroot /.runcvm/vmroot
  mount -i --options-source=disable -t ext4 -o noatime "UUID=$ROOTDISK_UUID" /.runcvm/newroot

  # Carry /.runcvm, and RunCVM's own tools in /.runcvm/guest, onto the disk.
  mkdir -p /.runcvm/newroot/.runcvm
  mount -i --options-source=disable --bind /.runcvm /.runcvm/newroot/.runcvm
  mount -i --options-source=disable --bind /.runcvm/guest /.runcvm/newroot/.runcvm/guest

  # Bind each path over the same path on the disk, recursively, so that each carries the mounts
  # below it (so a path below another in the set is carried by that one), creating a mountpoint of
  # the same kind if the disk lacks one: the disk holds an empty directory at each mountpoint that
  # is a directory, and an empty file at a mounted file.
  for path in "${ROOTDISK_MOUNTS[@]}"
  do
    for other in "${ROOTDISK_MOUNTS[@]}"
    do
      [[ "$path" = "${other%/}"/* ]] && continue 2
    done

    if [ -d "$path" ]; then
      mkdir -p "/.runcvm/newroot$path"
    else
      mkdir -p "/.runcvm/newroot${path%/*}"
      [ -e "/.runcvm/newroot$path" ] || touch "/.runcvm/newroot$path"
    fi

    mount -i --options-source=disable --rbind "$path" "/.runcvm/newroot$path"
  done

  # Switch to the disk. Everything this script uses must already be on the disk: RunCVM's tools,
  # which find their libraries through /proc/self/exe, need /proc. Nothing needs the image's
  # filesystem afterwards, so detach it.
  cd /.runcvm/newroot
  busybox pivot_root . .runcvm/vmroot
  cd /
  busybox umount -l /.runcvm/vmroot
  rmdir /.runcvm/vmroot /.runcvm/newroot
fi

# Some kernels (e.g. Alpine's) build IPv6 as a module. Unless IPv6 is disabled on the kernel command
# line, load it now: the per-interface settings below need /proc/sys/net/ipv6, and must be made
# before the module's defaults could apply to any interface.
if ! [ -d /proc/sys/net/ipv6 ] && ! grep -qw 'ipv6.disable=1' /proc/cmdline; then
  busybox modprobe ipv6 2>/dev/null || true
fi

# Disable IPv6 on every interface by default (both those that already exist,
# and any that may appear later), before any of them are renamed or brought
# up, so that none of them briefly performs SLAAC/DAD or joins a
# solicited-node multicast group using its unwanted kernel-assigned EUI-64
# address. Interfaces with a captured IPv6 address are selectively
# re-enabled, by their real (post-rename) name, below.
# https://bugzilla.redhat.com/show_bug.cgi?id=501934
for i in default $(ls /sys/class/net/ | grep -v '^lo$')
do
  sysctl -q -w -e net.ipv6.conf.$i.disable_ipv6=1 net.ipv6.conf.$i.autoconf=0 net.ipv6.conf.$i.accept_ra=0 || true
done

# Bring up local interface
ip link set lo up

# Identify each interface by MAC address, then give each a temporary name
# (as we might ultimately need to rename e.g. eth0->eth1 and eth1->eth0).
for ifpath in /.runcvm/network/devices/*
do
  if=$(busybox basename "$ifpath")

  [ "$if" = "default" ] && continue

  load_network "$if"

  # Locate the actual network device by its MAC address.
  mac=$(busybox sed -r 's/^..:..:../52:54:00/' <<<$DOCKER_IF_MAC)
  device=$(ip -json link show | jq -r --arg mac "$mac" '.[] | select(.address == $mac) | .ifname')

  ip link set $device name $DOCKER_IF-tmp
done

# Configure, rename and bring up all interfaces.
for ifpath in /.runcvm/network/devices/*
do
  if=$(busybox basename "$ifpath")

  [ "$if" = "default" ] && continue

  load_network "$if"

  ip link set $DOCKER_IF-tmp name $DOCKER_IF

  if load_network6 "$if"; then
    # Re-enable IPv6 on this interface only. accept_ra/autoconf are left off
    # (as set for every interface above): Docker addresses IPv6 statically,
    # like IPv4, and runs no RA daemon on its bridge networks, so the VM
    # should behave deterministically rather than react to anything it can
    # now see on the raw L2 segment.
    sysctl -q -w -e net.ipv6.conf.$DOCKER_IF.disable_ipv6=0 net.ipv6.conf.$DOCKER_IF.autoconf=0 net.ipv6.conf.$DOCKER_IF.accept_ra=0 || true
  fi

  ip addr add $DOCKER_IF_IP/$DOCKER_IF_IP_NETPREFIX broadcast + dev $DOCKER_IF
  ip link set $DOCKER_IF up mtu "${DOCKER_IF_MTU:=1500}"

  # If this is the default gateway interface, establish the default gateway
  [ -n "$DOCKER_IF_IP_GW" ] && [ "$DOCKER_IF_IP_GW" != "-" ] && ip route add default via $DOCKER_IF_IP_GW

  if [ -n "$DOCKER_IF6_IP" ]; then
    # The address is definitionally ours: Docker allocated it, and the
    # container released it (at entrypoint time, before enslaving this
    # interface) well before this point, so nothing else can answer for it.
    # Skip DAD so the address is usable immediately: with DAD enabled the
    # address is 'tentative' for ~1s, and the default route below would
    # otherwise intermittently fail ('Network is unreachable') against a
    # tentative source address.
    ip -6 addr add $DOCKER_IF6_IP/$DOCKER_IF6_IP_NETPREFIX dev $DOCKER_IF nodad
    [ -n "$DOCKER_IF6_IP_GW" ] && [ "$DOCKER_IF6_IP_GW" != "-" ] && ip -6 route add default via $DOCKER_IF6_IP_GW dev $DOCKER_IF
  fi
done

# Read and install any supplementary routes.
while read -r DOCKER_RT_NET DOCKER_RT_GW DOCKER_RT_DEV DOCKER_RT_PREFSRC
do
  [ -n "$DOCKER_RT_NET" ] && [ -n "$DOCKER_RT_GW" ] && [ -n "$DOCKER_RT_DEV" ] && \
    ip route add "$DOCKER_RT_NET" via "$DOCKER_RT_GW" dev "$DOCKER_RT_DEV" || true
done </.runcvm/network/routes

# Read and install any supplementary IPv6 routes.
while read -r DOCKER_RT6_NET DOCKER_RT6_GW DOCKER_RT6_DEV
do
  [ -n "$DOCKER_RT6_NET" ] && [ -n "$DOCKER_RT6_GW" ] && [ -n "$DOCKER_RT6_DEV" ] && \
    ip -6 route add "$DOCKER_RT6_NET" via "$DOCKER_RT6_GW" dev "$DOCKER_RT6_DEV" || true
done </.runcvm/network/routes6

# TODO
# - bind-mount or overwrite /etc/resolv.conf, /etc/hosts and /etc/hostname?

# Setup hostname
hostname -F /etc/hostname

# Load the kernel modules that RUNCVM_KERNEL_MODULES names (checked by runcvm-runtime as a
# comma-separated list of module names), before the workload starts: for modules that nothing
# requests from the kernel on demand, such as kvm_intel or kvm_amd for VMs nested in this one.
if [ -n "$RUNCVM_KERNEL_MODULES" ]; then
  IFS=',' read -r -a modules <<<"$RUNCVM_KERNEL_MODULES"
  for module in "${modules[@]}"
  do
    busybox modprobe "$module" || \
      vm_init_error "RUNCVM_KERNEL_MODULES: kernel module '$module' cannot be loaded into the VM's kernel ($(busybox uname -r))"
  done
fi

# Mount the filesystems in /.runcvm/fstab, as RUNCVM_DISKS and the tmpfs mounts define them (see
# write_manifests in runcvm-ctr-qemu).
if [ -f /.runcvm/fstab ]; then
  # Hold on to each mount that a disk or tmpfs mount will hide once mounted at its destination, as
  # listed in /.runcvm/held-mounts, one line each, <id> <path>: Docker's volumes and bind mounts,
  # including files such as /etc/hosts, below a disk's or tmpfs mount's destination. Bind each
  # non-recursively (each mount below it is listed too) into a private tmpfs, at
  # /.runcvm/submounts/<id>, from where it is mounted again at its path, in its place among the
  # mounts in /.runcvm/fstab. Binding a Docker volume also mounts it in the VM, which otherwise sees
  # it only once accessed. Each is a container mount, so a held mount missing in the VM is an error.
  held_paths=()
  if [ -s /.runcvm/held-mounts ]; then
    mkdir -p /.runcvm/submounts
    mount -i --options-source=disable -t tmpfs -o mode=0700 tmpfs /.runcvm/submounts
    mount -i --make-rprivate /.runcvm/submounts

    while read -r id path
    do
      [ -n "$id" ] || continue
      path_decode path "$path"
      [ -e "$path" ] || vm_init_error "'$path' cannot be mounted over the mount above it: it is missing in the VM"

      held="/.runcvm/submounts/$id"
      if [ -d "$path" ]; then
        mkdir "$held"
      else
        touch "$held"
      fi

      mount -i --options-source=disable --bind "$path" "$held" || \
        vm_init_error "'$path' cannot be mounted over the mount above it: binding it before mounting the disks failed"
      held_paths+=("$path")
    done </.runcvm/held-mounts

    # Detach each held mount from its path, deepest first: the disk or tmpfs mount above it would
    # only hide it, and the mount table would then show two mounts at its path once it is mounted
    # again, which misleads mount -a (busybox's skips the path as mounted) and systemd (whose
    # umount of the path fails). A path that is not a mountpoint in the VM (such as Docker's
    # bind-mounted files) has nothing to detach.
    for ((i = ${#held_paths[@]} - 1; i >= 0; i--))
    do
      busybox umount -l "${held_paths[$i]}" 2>/dev/null || true
    done
  fi

  # Mounts held mount $1 again at its path $2, creating a mountpoint of the same kind if the mount
  # above it lacks one.
  mount_held() {
    local held="/.runcvm/submounts/$1" path="$2" parent

    if [ -d "$held" ]; then
      mkdir -p "$path"
    else
      # The parent directory, by ${path%/*}, not $(dirname), which would drop newlines ending it.
      parent="${path%/*}"
      mkdir -p "${parent:-/}"
      [ -e "$path" ] || touch "$path"
    fi

    mount -i --options-source=disable --bind "$held" "$path" || \
      vm_init_error "'$path' cannot be mounted over the mount above it: binding it again failed"
  }

  # Mount each entry in /.runcvm/fstab in turn, in the order written there, creating its mountpoint
  # if it lacks one; and each held mount again at its path, at its '#runcvm-held <id> <path>' comment
  # (RUNCVM_FSTAB=disks) or its bind mount from /.runcvm/submounts/<id> (RUNCVM_FSTAB=all). Each
  # field is decoded, as mount is given it directly. Resolve UUID= with RunCVM's own libblkid
  # configuration, which scans devices and keeps no cache, not with the image's /etc/blkid.conf and
  # /run/blkid cache. -i keeps mount from running any /sbin/mount.<type> helper from the image.
  #
  # Each entry left unmounted is named. A bind mount from a disk with layout 'subdirs' fails if the
  # disk, once mounted at /.runcvm/disks/<n>, has no directory for its destination: a destination
  # added to the disk's spec after the disk was created. That is reported only where the disk
  # itself is mounted, as an unmounted disk holds no directories to look for.
  unmounted=()
  while IFS= read -r line
  do
    if [[ "$line" = "#runcvm-held "* ]]; then
      read -r _ id path <<<"$line"
      path_decode path "$path"
      mount_held "$id" "$path"
      continue
    fi

    # An fstab entry's first four fields; skip blank lines and other comments.
    read -r src dst type options _ <<<"$line"
    [[ -z "$dst" || "$src" = \#* ]] && continue
    path_decode src "$src"
    path_decode dst "$dst"
    path_decode options "$options"

    if [[ "$src" = /.runcvm/submounts/* ]]; then
      mount_held "${src##*/}" "$dst"
      continue
    fi

    # Add X-mount.mkdir to the entry's options, after a comma if it has any. Once mounted, go on to
    # the next entry; otherwise, report it below.
    BLKID_CONF="$RUNCVM_GUEST/etc/blkid.conf" BLKID_FILE=/dev/null \
      mount -i --options-source=disable -t "$type" -o "${options:+$options,}X-mount.mkdir" "$src" "$dst" && continue

    # For a bind mount from /.runcvm/disks/<n>/<directory>: ${src%/*} is the disk's mountpoint,
    # and ${src##*/} the directory.
    if [[ "$src" = /.runcvm/disks/* ]] && findmnt -rn --mountpoint "${src%/*}" >/dev/null && ! [ -d "$src" ]; then
      vm_init_error "dst '$dst' cannot be mounted: its disk has no directory '${src##*/}', so was created without this destination; destinations cannot be added to an existing disk"
    fi
    unmounted+=("$dst")
  done </.runcvm/fstab

  if [ "${#unmounted[@]}" -gt 0 ]; then
    vm_init_error "mounting the filesystems in /.runcvm/fstab failed, leaving unmounted: ${unmounted[*]}"
  fi

  # With RUNCVM_FSTAB=all, keep the tmpfs that holds the mounts, from which /.runcvm/fstab's bind
  # mounts mount them again; otherwise detach it.
  if [[ -d /.runcvm/submounts && "${RUNCVM_FSTAB:-disks}" != "all" ]]; then
    busybox umount -l /.runcvm/submounts
    rmdir /.runcvm/submounts
  fi

  # Mount our fstab over the image's /etc/fstab, where the image has one. An image without one
  # (e.g. busybox, or a static binary's) is left without one, unless RUNCVM_FSTAB=all, for which an
  # empty /etc/fstab is created to mount it over, so that systemd and 'mount -a' find the held
  # mounts' entries.
  if [[ ! -e /etc/fstab && "${RUNCVM_FSTAB:-disks}" = "all" ]]; then
    { mkdir -p /etc && touch /etc/fstab; } || vm_init_error "RUNCVM_FSTAB=all: /etc/fstab cannot be created"
  fi
  if [ -e /etc/fstab ]; then
    mount -i --options-source=disable --bind /.runcvm/fstab /etc/fstab || vm_init_error "/.runcvm/fstab cannot be mounted over /etc/fstab"
  fi
fi

# Mount cgroupfs as RUNCVM_CGROUPFS requests, by default:
# - nothing, if the entrypoint is systemd (which mounts its own);
# - else cgroup2 alone, on /sys/fs/cgroup.

# Load cgroupfs functions first.
. $RUNCVM_GUEST/scripts/functions/cgroupfs

# Load the original entrypoint and its arguments, saved NUL-separated by runcvm-ctr-entrypoint
mapfile -d '' -t ARGS </.runcvm/entrypoint

ARGS_INIT="${ARGS[0]}"

# Check if ARGS_INIT is a symlink and follow it if it is
if [ -L "$ARGS_INIT" ]; then
    ARGS_INIT=$(busybox readlink -f "$ARGS_INIT")
fi

if [[ "$ARGS_INIT" =~ /systemd$ ]]; then
  cgroupfs_mount "${RUNCVM_CGROUPFS:-none}"
else
  cgroupfs_mount "${RUNCVM_CGROUPFS:-2}"
fi

# Record how runcvm-ctr-shutdown asks the guest to power off, as RUNCVM_SHUTDOWN requests; by
# default ('auto'), as the guest's init understands: 'busybox' for RunCVM's own init (--init) or
# an entrypoint .../init that is busybox's; 'systemd' for systemd; otherwise 'all'.
case "${RUNCVM_SHUTDOWN:-auto}" in
  auto)
    if [ "$RUNCVM_INIT" = "1" ] || [[ "${ARGS[0]}" =~ /init$ && "$ARGS_INIT" =~ /busybox$ ]]; then
      shutdown_mode=busybox
    elif [[ "$ARGS_INIT" =~ /systemd$ ]]; then
      shutdown_mode=systemd
    else
      shutdown_mode=all
    fi
    ;;
  *)
    shutdown_mode="$RUNCVM_SHUTDOWN"
    ;;
esac
echo "$shutdown_mode" >/.runcvm/state/shutdown

# Make directory for dropbear host keys and public/private keypair
mkdir -p /.runcvm/dropbear

# Create dropbear RSA public/private key pair
KEY_PUBLIC=$(dropbearkey -t rsa -s 2048 -f /.runcvm/dropbear/key 2>/dev/null | grep ^ssh | cut -d' ' -f2)

# Create json for dropbear EPKA module
cat <<_EOE_ >/.runcvm/dropbear/epka.json && chmod 400 /.runcvm/dropbear/epka.json
[
    {
        "user": "root",
        "keytype": "ssh-rsa",
        "key": "$KEY_PUBLIC",
        "options":"no-X11-forwarding",
        "comments": ""
    }
]
_EOE_

# Load choice of console device
read -r CONSOLE_DEVICE </.runcvm/console

# Rename /.dockerenv, because presence of this file leads to systemd-detect-virt detecting presence of a container,
# which in-turn prevents loading certain units (like systemd-modules-load.service), that
# specify 'ConditionVirtualization=!container'
[ -f "/.dockerenv" ] && busybox mv /.dockerenv /.dockerenv.runcvm

if [ "$RUNCVM_INIT" = "1" ]; then
  # If launched with '--init' (or --env=RUNCVM_INIT=1) then run our own init in place of Docker's/Podman's.

  cat >/etc/inittab <<_EOE_
$CONSOLE_DEVICE::respawn:-$RUNCVM_GUEST/scripts/runcvm-vm-start-wrapper
null::respawn:$RUNCVM_GUEST/scripts/runcvm-vm-qemu-ga
null::respawn:$RUNCVM_GUEST/usr/sbin/dropbear -REF -j -k -p $SSHD_PORT -A $RUNCVM_GUEST/usr/lib/dropbear/libepka_file.so,/.runcvm/dropbear/epka.json -P /.runcvm/dropbear/dropbear.pid
null::ctrlaltdel:$RUNCVM_GUEST/bin/poweroff
null::restart:$RUNCVM_GUEST/bin/poweroff
null::shutdown:$RUNCVM_GUEST/scripts/runcvm-vm-shutdown
_EOE_

  # Allow runcvm-vm-start to run once (and only once)
  rm -f /.runcvm/once

  # Clear the environment, and run our own init, disconnecting stdout and stderr from terminal
  exec -c $RUNCVM_GUEST/bin/init &>/dev/null
else
  # If not, assume the user knows what they're doing: launch qemu-ga and just run their entrypoint.

  # Clean RUNCVM env vars
  clean_env

  # Each daemon below runs in a session of its own, as a child of PID 1, with its output discarded.
  # This VM's PID 1 may hold a terminal as its controlling terminal (as after a dracut initramfs's
  # systemd switches root to it), and giving it up, as runcvm-init and systemd each do, makes the
  # kernel send SIGHUP to PID 1's process group, which would otherwise include them. The session is
  # created in the foreground, so it exists before runcvm-init runs.
  start_daemon() {
    busybox setsid $RUNCVM_GUEST/bin/bash -c '"$@" &>/dev/null &' start_daemon "$@"
  }

  # Run the qemu guest agent, needed to support future functionality
  start_daemon $RUNCVM_GUEST/scripts/runcvm-vm-qemu-ga

  # Run dropbear SSH server, needed to support 'docker exec'.
  # It accepts only RunCVM's own key (via the EPKA plugin), and has no password logins; -j and -k
  # disable port forwarding. It runs commands with RunCVM's bash, and its sessions inherit its
  # environment, so it starts with an empty one: variables from the image, such as BASH_ENV,
  # would otherwise reach that bash.
  start_daemon busybox env -i $RUNCVM_GUEST/usr/sbin/dropbear -REF -j -k -p $SSHD_PORT -A $RUNCVM_GUEST/usr/lib/dropbear/libepka_file.so,/.runcvm/dropbear/epka.json -P /.runcvm/dropbear/dropbear.pid

  # Run init from the image
  # Pipe input/output from/to console device
  exec </dev/$CONSOLE_DEVICE &>/dev/$CONSOLE_DEVICE
  
  # Invoke runcvm-init with --no-fork purely to create controlling tty,
  # then exec runcvm-vm-start
  exec -c $RUNCVM_GUEST/sbin/runcvm-init --no-fork $RUNCVM_GUEST/scripts/runcvm-vm-start
fi
