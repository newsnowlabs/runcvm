#!/.runcvm/guest/bin/bash -e

# Load RunCVM's own environment, saved by runcvm-ctr-entrypoint
. /.runcvm/config

# Load defaults and aliases
. $RUNCVM_GUEST/scripts/runcvm-ctr-defaults

# Alpine initrd doesn't honour command-line rw flag.
# -i keeps mount from running any /sbin/mount.<type> helper from the image, and
# --options-source=disable keeps the image's /etc/fstab from adding options to the remount (e.g.
# 'errors=remount-ro', which virtiofs rejects, halting the VM as this script runs with 'bash -e').
mount -i --options-source=disable -o remount,rw /

# FIXME: Something is making /.runcvm ro, so remount it rw
# until such time as exit code handling and dropbear key creation
# obviate the need for this.
mount -i --options-source=disable -o remount,rw /.runcvm

# Alpine initrd doesn't configure /dev device permissions and ownership
# to support non-root users.
if [ "$(findmnt -rnu -o FSTYPE /dev)" = "devtmpfs" ]; then
  [ -e /dev/stdin ] || ln -snf /proc/self/fd/0 /dev/stdin
  [ -e /dev/stdout ] || ln -snf /proc/self/fd/1 /dev/stdout
  [ -e /dev/stderr ] || ln -snf /proc/self/fd/2 /dev/stderr
  [ -e /proc/kcore ] && ln -snf /proc/kcore /dev/core
  [ -h /dev/ptmx ] || ln -snf pts/ptmx /dev/ptmx
  chmod 666 /dev/null /dev/random /dev/urandom /dev/zero /dev/tty /dev/pts/ptmx
  chmod 620 /dev/tty[0-9]*
  # Images without a 'tty' group (e.g. images with no /etc/group) have no members to grant access
  # to, so leave the devices' group unchanged: runcvm-vm-init runs with 'bash -e' as the VM's PID 1,
  # so a failure here would halt the VM.
  chgrp tty /dev/tty* 2>/dev/null || true
fi

# Unmount /run if it is a tmpfs (not a virtiofs) mounted by the initramfs
# /run may be populated in the underlying image, and may also be a volume or be bind-mounted,
# and its contents should be accessible in these cases.
if [ "$(findmnt -rnu -o FSTYPE /run)" = "tmpfs" ]; then
  busybox umount -fl /run
fi

# FIXME: virtiofs mounts aren't always made rw. Remount them all rw (if allowed)
# $RUNCVM_GUEST/bin/mount -t virtiofs | awk '{print $3}' | xargs -n 1 mount -o remount,rw

# Some systems do not set up /dev/fd. If needed, add it.
if ! [ -h /dev/fd ]; then
  ln -s /proc/self/fd /dev/fd
fi

# Have the kernel load modules on demand through RunCVM's module loader, which runs the image's
# modprobe where the image has one and RunCVM's otherwise: the kernel's default, /sbin/modprobe, is
# absent from many images (e.g. busybox, rancher/k3s), and the kernel then loads no module that it
# requests, such as overlay on its first mount. The loader is in RunCVM's tools, which stay
# available to the kernel for the VM's lifetime, including after a switch to a whole-root disk.
echo "$RUNCVM_GUEST/scripts/runcvm-vm-modprobe" >/proc/sys/kernel/modprobe

# Switch the root filesystem to the whole-root disk, if RUNCVM_DISKS defines one (see do_root_disk
# in runcvm-ctr-qemu). This must happen before anything else uses the root: everything after it,
# and the workload, sees the disk as /.
if [ -f /.runcvm/rootdisk ]; then
  read -r ROOTDISK_UUID </.runcvm/rootdisk

  # The paths to carry onto the disk: each mount directly below the root, such as /proc, /sys and
  # /dev; and each path the container recorded as a mountpoint, as Docker's volumes appear in the
  # VM as mounts only once accessed, and its bind-mounted files, such as /etc/hosts, never do.
  ROOTDISK_MOUNTS=$(
    {
      awk 'NR==FNR { if ($5 == "/") root=$1; next } $2 == root && $5 != "/.runcvm" { print $5 }' /proc/self/mountinfo /proc/self/mountinfo
      cat /.runcvm/rootdisk-mounts
    } | busybox sort -u
  )

  busybox modprobe ext4
  mkdir -p /.runcvm/newroot /.runcvm/vmroot
  mount -i --options-source=disable -t ext4 -o noatime "UUID=$ROOTDISK_UUID" /.runcvm/newroot

  # Carry /.runcvm, and RunCVM's own tools in /.runcvm/guest, onto the disk.
  mkdir -p /.runcvm/newroot/.runcvm
  mount -i --options-source=disable --bind /.runcvm /.runcvm/newroot/.runcvm
  mount -i --options-source=disable --bind /.runcvm/guest /.runcvm/newroot/.runcvm/guest

  # Bind each path over the same path on the disk, recursively, so that each carries the mounts
  # below it, creating a mountpoint of the same kind if the disk lacks one: the disk holds an empty
  # directory at each mountpoint that is a directory, and nothing at a mounted file.
  ROOTDISK_CARRIED=()
  while IFS= read -r path
  do
    [ -n "$path" ] || continue

    for carried in "${ROOTDISK_CARRIED[@]}"
    do
      [[ "$path" = "$carried"/* ]] && continue 2
    done
    ROOTDISK_CARRIED+=("$path")

    if [ -d "$path" ]; then
      mkdir -p "/.runcvm/newroot$path"
    else
      mkdir -p "/.runcvm/newroot$(busybox dirname "$path")"
      [ -e "/.runcvm/newroot$path" ] || touch "/.runcvm/newroot$path"
    fi

    mount -i --options-source=disable --rbind "$path" "/.runcvm/newroot$path"
  done <<<"$ROOTDISK_MOUNTS"

  # Switch to the disk. Everything this script uses must already be on the disk: RunCVM's tools,
  # which find their libraries through /proc/self/exe, need /proc. Nothing needs the image's
  # filesystem afterwards, so detach it.
  cd /.runcvm/newroot
  busybox pivot_root . .runcvm/vmroot
  cd /
  busybox umount -l /.runcvm/vmroot
  rmdir /.runcvm/vmroot /.runcvm/newroot
fi

# Some kernels (e.g. Alpine's) build IPv6 as a module. Unless IPv6 is disabled on the kernel command
# line, load it now: the per-interface settings below need /proc/sys/net/ipv6, and must be made
# before the module's defaults could apply to any interface.
if ! [ -d /proc/sys/net/ipv6 ] && ! grep -qw 'ipv6.disable=1' /proc/cmdline; then
  busybox modprobe ipv6 2>/dev/null || true
fi

# Disable IPv6 on every interface by default (both those that already exist,
# and any that may appear later), before any of them are renamed or brought
# up, so that none of them briefly performs SLAAC/DAD or joins a
# solicited-node multicast group using its unwanted kernel-assigned EUI-64
# address. Interfaces with a captured IPv6 address are selectively
# re-enabled, by their real (post-rename) name, below.
# https://bugzilla.redhat.com/show_bug.cgi?id=501934
for i in default $(ls /sys/class/net/ | grep -v '^lo$')
do
  sysctl -q -w -e net.ipv6.conf.$i.disable_ipv6=1 net.ipv6.conf.$i.autoconf=0 net.ipv6.conf.$i.accept_ra=0 || true
done

# Bring up local interface
ip link set lo up

# Identify each interface by MAC address, then give each a temporary name
# (as we might ultimately need to rename e.g. eth0->eth1 and eth1->eth0).
for ifpath in /.runcvm/network/devices/*
do
  if=$(busybox basename "$ifpath")

  [ "$if" = "default" ] && continue

  load_network "$if"

  # Locate the actual network device by its MAC address.
  mac=$(busybox sed -r 's/^..:..:../52:54:00/' <<<$DOCKER_IF_MAC)
  device=$(ip -json link show | jq -r --arg mac "$mac" '.[] | select(.address == $mac) | .ifname')

  ip link set $device name $DOCKER_IF-tmp
done

# Configure, rename and bring up all interfaces.
for ifpath in /.runcvm/network/devices/*
do
  if=$(busybox basename "$ifpath")

  [ "$if" = "default" ] && continue

  load_network "$if"

  ip link set $DOCKER_IF-tmp name $DOCKER_IF

  if load_network6 "$if"; then
    # Re-enable IPv6 on this interface only. accept_ra/autoconf are left off
    # (as set for every interface above): Docker addresses IPv6 statically,
    # like IPv4, and runs no RA daemon on its bridge networks, so the VM
    # should behave deterministically rather than react to anything it can
    # now see on the raw L2 segment.
    sysctl -q -w -e net.ipv6.conf.$DOCKER_IF.disable_ipv6=0 net.ipv6.conf.$DOCKER_IF.autoconf=0 net.ipv6.conf.$DOCKER_IF.accept_ra=0 || true
  fi

  ip addr add $DOCKER_IF_IP/$DOCKER_IF_IP_NETPREFIX broadcast + dev $DOCKER_IF
  ip link set $DOCKER_IF up mtu "${DOCKER_IF_MTU:=1500}"

  # If this is the default gateway interface, establish the default gateway
  [ -n "$DOCKER_IF_IP_GW" ] && [ "$DOCKER_IF_IP_GW" != "-" ] && ip route add default via $DOCKER_IF_IP_GW

  if [ -n "$DOCKER_IF6_IP" ]; then
    # The address is definitionally ours: Docker allocated it, and the
    # container released it (at entrypoint time, before enslaving this
    # interface) well before this point, so nothing else can answer for it.
    # Skip DAD so the address is usable immediately: with DAD enabled the
    # address is 'tentative' for ~1s, and the default route below would
    # otherwise intermittently fail ('Network is unreachable') against a
    # tentative source address.
    ip -6 addr add $DOCKER_IF6_IP/$DOCKER_IF6_IP_NETPREFIX dev $DOCKER_IF nodad
    [ -n "$DOCKER_IF6_IP_GW" ] && [ "$DOCKER_IF6_IP_GW" != "-" ] && ip -6 route add default via $DOCKER_IF6_IP_GW dev $DOCKER_IF
  fi
done

# Read and install any supplementary routes.
while read -r DOCKER_RT_NET DOCKER_RT_GW DOCKER_RT_DEV DOCKER_RT_PREFSRC
do
  [ -n "$DOCKER_RT_NET" ] && [ -n "$DOCKER_RT_GW" ] && [ -n "$DOCKER_RT_DEV" ] && \
    ip route add "$DOCKER_RT_NET" via "$DOCKER_RT_GW" dev "$DOCKER_RT_DEV" || true
done </.runcvm/network/routes

# Read and install any supplementary IPv6 routes.
while read -r DOCKER_RT6_NET DOCKER_RT6_GW DOCKER_RT6_DEV
do
  [ -n "$DOCKER_RT6_NET" ] && [ -n "$DOCKER_RT6_GW" ] && [ -n "$DOCKER_RT6_DEV" ] && \
    ip -6 route add "$DOCKER_RT6_NET" via "$DOCKER_RT6_GW" dev "$DOCKER_RT6_DEV" || true
done </.runcvm/network/routes6

# TODO
# - bind-mount or overwrite /etc/resolv.conf, /etc/hosts and /etc/hostname?

# Setup hostname
hostname -F /etc/hostname

# Reports error $1 on the console device, which the container's output is connected to, and powers
# the VM off with exit status 1.
vm_init_error() {
  local console

  read -r console </.runcvm/console
  echo "RunCVM: Error: $1" >"/dev/$console"
  echo 1 >/.runcvm/exitcode
  poweroff -f
  exit 1
}

# Mount filesystems defined in /etc/fstab OR as defined in RUNCVM_DISKS
if [ -f /.runcvm/fstab ]; then
  # Load the kernel modules of each disk's filesystem, as listed in disk-filesystems.
  for fs in $(awk '$1 ~ /^UUID=/ { print $3 }' /.runcvm/fstab | busybox sort -u)
  do
    disk_fs "$fs" || vm_init_error "fs '$fs' is not supported"
    for module in "${DISK_FS_MODULES[@]}"
    do
      busybox modprobe "$module" || vm_init_error "fs '$fs' needs kernel module '$module', which the VM's kernel ($(busybox uname -r)) lacks"
    done
  done

  # Populate each new disk that its mkfs command left empty: copy each destination's contents, as
  # the image holds them, to its directory on the disk, with RunCVM's own cp, which preserves
  # ownership, permissions, timestamps, links and extended attributes.
  if [ -f /.runcvm/disks-populate ]; then
    while read -r id uuid fs dir dst
    do
      mnt="/.runcvm/disks/$id"
      if ! findmnt -rn --mountpoint "$mnt" >/dev/null; then
        mkdir -p "$mnt"
        BLKID_CONF="$RUNCVM_GUEST/etc/blkid.conf" BLKID_FILE=/dev/null mount -i --options-source=disable -t "$fs" -o noatime "UUID=$uuid" "$mnt" || \
          vm_init_error "dst '$dst' cannot be populated: mounting its new disk failed"
      fi

      mkdir -p "$mnt/$dir"
      if [ -d "$dst" ]; then
        $RUNCVM_GUEST/usr/bin/coreutils --coreutils-prog=cp -a "$dst/." "$mnt/$dir/" || \
          vm_init_error "dst '$dst' cannot be populated: copying its contents to its new disk failed"
      fi
    done </.runcvm/disks-populate

    # Unmount the disks again, for the fstab to mount them as for any other boot.
    for mnt in $(awk '{ print $1 }' /.runcvm/disks-populate | busybox sort -u)
    do
      busybox umount "/.runcvm/disks/$mnt" || vm_init_error "unmounting new disk '/.runcvm/disks/$mnt' after populating it failed"
    done
  fi

  # Resolve UUID= with RunCVM's own libblkid configuration, which scans devices and keeps no
  # cache, not with the image's /etc/blkid.conf and /run/blkid cache. -i keeps mount from running
  # any /sbin/mount.<type> helper from the image.
  if ! BLKID_CONF="$RUNCVM_GUEST/etc/blkid.conf" BLKID_FILE=/dev/null mount -i -a --fstab /.runcvm/fstab -o X-mount.mkdir; then
    # Name each entry left unmounted. A bind mount from a disk with layout 'subdirs' fails if the
    # disk, once mounted at /.runcvm/disks/<n>, has no directory for its destination: a
    # destination added to the disk's spec after the disk was created. That is reported only
    # where the disk itself is mounted, as an unmounted disk holds no directories to look for.
    unmounted=()
    while read -r src dst _
    do
      [[ -z "$dst" || "$src" = \#* ]] && continue
      findmnt -rn --mountpoint "$dst" >/dev/null && continue

      if [[ "$src" = /.runcvm/disks/* ]] && findmnt -rn --mountpoint "${src%/*}" >/dev/null && ! [ -d "$src" ]; then
        vm_init_error "dst '$dst' cannot be mounted: its disk has no directory '${src##*/}', so was created without this destination; destinations cannot be added to an existing disk"
      fi

      unmounted+=("$dst")
    done </.runcvm/fstab

    vm_init_error "mounting the filesystems in /.runcvm/fstab failed, leaving unmounted: ${unmounted[*]}"
  fi

  # Mount our fstab over the image's /etc/fstab, where the image has one. An image without one
  # (e.g. busybox, or a static binary's) has nothing that reads it, and has no file to mount over:
  # this script runs with 'bash -e' as the VM's PID 1, so a failed mount would halt the VM.
  if [ -e /etc/fstab ]; then
    mount -i --bind /.runcvm/fstab /etc/fstab
  fi
fi

# Mount cgroupfs as RUNCVM_CGROUPFS requests, by default:
# - nothing, if the entrypoint is systemd (which mounts its own);
# - else cgroup2 alone, on /sys/fs/cgroup.

# Load cgroupfs functions first.
. $RUNCVM_GUEST/scripts/functions/cgroupfs

# Load original entrypoint
mapfile -t ARGS </.runcvm/entrypoint

ARGS_INIT="${ARGS[0]}"

# Check if ARGS_INIT is a symlink and follow it if it is
if [ -L "$ARGS_INIT" ]; then
    ARGS_INIT=$(busybox readlink -f "$ARGS_INIT")
fi

if [[ "$ARGS_INIT" =~ /systemd$ ]]; then
  cgroupfs_mount "${RUNCVM_CGROUPFS:-none}"
else
  cgroupfs_mount "${RUNCVM_CGROUPFS:-2}"
fi

# Make directory for dropbear host keys and public/private keypair
mkdir -p /.runcvm/dropbear

# Create dropbear RSA public/private key pair
KEY_PUBLIC=$(dropbearkey -t rsa -s 2048 -f /.runcvm/dropbear/key 2>/dev/null | grep ^ssh | cut -d' ' -f2)

# Create json for dropbear EPKA module
cat <<_EOE_ >/.runcvm/dropbear/epka.json && chmod 400 /.runcvm/dropbear/epka.json
[
    {
        "user": "root",
        "keytype": "ssh-rsa",
        "key": "$KEY_PUBLIC",
        "options":"no-X11-forwarding",
        "comments": ""
    }
]
_EOE_

# Load choice of console device
read -r CONSOLE_DEVICE </.runcvm/console

# Rename /.dockerenv, because presence of this file leads to systemd-detect-virt detecting presence of a container,
# which in-turn prevents loading certain units (like systemd-modules-load.service), that
# specify 'ConditionVirtualization=!container'
[ -f "/.dockerenv" ] && busybox mv /.dockerenv /.dockerenv.runcvm

if [ "$RUNCVM_INIT" = "1" ]; then
  # If launched with '--init' (or --env=RUNCVM_INIT=1) then run our own init in place of Docker's/Podman's.

  cat >/etc/inittab <<_EOE_
$CONSOLE_DEVICE::respawn:-$RUNCVM_GUEST/scripts/runcvm-vm-start-wrapper
null::respawn:$RUNCVM_GUEST/scripts/runcvm-vm-qemu-ga
null::respawn:$RUNCVM_GUEST/usr/sbin/dropbear -REF -j -k -p $SSHD_PORT -A $RUNCVM_GUEST/tmp/dropbear/libepka_file.so,/.runcvm/dropbear/epka.json -P /.runcvm/dropbear/dropbear.pid
null::ctrlaltdel:$RUNCVM_GUEST/bin/poweroff
null::restart:$RUNCVM_GUEST/bin/poweroff
null::shutdown:$RUNCVM_GUEST/bin/poweroff
_EOE_

  # Allow runcvm-vm-start to run once (and only once)
  rm -f /.runcvm/once

  # Clear the environment, and run our own init, disconnecting stdout and stderr from terminal
  exec -c $RUNCVM_GUEST/bin/init &>/dev/null
else
  # If not, assume the user knows what they're doing: launch qemu-ga and just run their entrypoint.

  # Clean RUNCVM env vars
  clean_env

  # Run the qemu guest agent, needed to support future functionality
  $RUNCVM_GUEST/scripts/runcvm-vm-qemu-ga &>/dev/null &

  # Run dropbear SSH server, needed to support 'docker exec'.
  # It accepts only RunCVM's own key (via the EPKA plugin), and has no password logins; -j and -k
  # disable port forwarding. It runs commands with RunCVM's bash, and its sessions inherit its
  # environment, so it starts with an empty one: variables from the image, such as BASH_ENV,
  # would otherwise reach that bash.
  busybox env -i $RUNCVM_GUEST/usr/sbin/dropbear -REF -j -k -p $SSHD_PORT -A $RUNCVM_GUEST/tmp/dropbear/libepka_file.so,/.runcvm/dropbear/epka.json -P /.runcvm/dropbear/dropbear.pid &>/dev/null &

  # Run init from the image
  # Pipe input/output from/to console device
  exec </dev/$CONSOLE_DEVICE &>/dev/$CONSOLE_DEVICE
  
  # Invoke runcvm-init with --no-fork purely to create controlling tty,
  # then exec runcvm-vm-start
  exec -c $RUNCVM_GUEST/sbin/runcvm-init --no-fork $RUNCVM_GUEST/scripts/runcvm-vm-start
fi
