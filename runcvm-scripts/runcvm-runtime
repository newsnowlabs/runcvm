#!/opt/runcvm/lib/ld /opt/runcvm/bin/bash

# REFERENCES

# Qemu:
# - https://github.com/joshkunz/qemu-docker
# - https://mergeboard.com/blog/2-qemu-microvm-docker/
# - https://github.com/BBVA/kvm

# Virtiofs
# - https://vmsplice.net/~stefan/virtio-fs_%20A%20Shared%20File%20System%20for%20Virtual%20Machines.pdf
# - https://virtio-fs.gitlab.io/howto-qemu.html
# - https://www.tauceti.blog/posts/qemu-kvm-share-host-directory-with-vm-with-virtio/

# Container config.json spec
# - https://github.com/opencontainers/runtime-spec/
# - https://github.com/opencontainers/runtime-spec/blob/main/config.md

# Mount namespaces
# - https://www.kernel.org/doc/Documentation/filesystems/sharedsubtree.txt
# - https://www.redhat.com/sysadmin/mount-namespaces

RUNCVM=/opt/runcvm
RUNCVM_LD=$RUNCVM/lib/ld
RUNCVM_JQ=$RUNCVM/usr/bin/jq
RUNCVM_VM_MOUNTPOINT="/vm"
RUNCVM_GUEST=/.runcvm/guest
RUNCVM_ENTRYPOINT=$RUNCVM_GUEST/scripts/runcvm-ctr-entrypoint
RUNCVM_EXEC="$RUNCVM_GUEST/scripts/runcvm-ctr-exec"
RUNCVM_KERNELS=$RUNCVM/kernels
RUNCVM_GUEST_KERNELS=$RUNCVM_GUEST/kernels
RUNCVM_KERNEL_DEFAULT=debian

# The kernels (directories under $RUNCVM_KERNELS) for images of the RHEL and SUSE families of
# distributions, each of which RunCVM bundles one kernel for: see kernel_for_distro.
RUNCVM_KERNEL_RHEL_FAMILY=almalinux
RUNCVM_KERNEL_SUSE_FAMILY=opensuse
RUNCVM_MEM_SIZE_DEFAULT="512" # Default VM memory size (Mb) if not specified in container config
RUNCVM_CONTAINER_MEM_OVERHEAD="256" # Memory (Mb) overhead to allow for QEMU, virtiofsd, dnsmasq and other container memory footprint: 128Mb minimum, 256Mb recommended
RUNCVM_QEMU_TCG_TB_MEM_SIZE_DEFAULT="128" # Memory (Mb) for QEMU's translated-code cache under software emulation (TCG), added to the container's memory limit
# Address at which the VM reaches RunCVM's own services in the container (see RUNCVM_DNS_IP in the
# README): link-local, so never routed beyond the host, and outside the link-local addresses known to
# be used by cloud platforms (e.g. 169.254.169.254) and by Kubernetes (169.254.20.10).
RUNCVM_DNS_IP_DEFAULT="169.254.53.53"
RUNCVM_QEMU_TCG_TB_MEM_SIZE_MIN="32"
RUNCVM_QEMU_TCG_TB_MEM_SIZE_MAX="4096"
RUNCVM_DEBUG=""

# The PATH of RunCVM's own processes in the container and the VM: the RunCVM guest tool
# directories. Must match RUNCVM_PATH in runcvm-ctr-defaults.
RUNCVM_GUEST_PATH="$RUNCVM_GUEST/usr/sbin:$RUNCVM_GUEST/usr/bin:$RUNCVM_GUEST/sbin:$RUNCVM_GUEST/bin:$RUNCVM_GUEST/usr/lib/qemu"

# runcvm_env($path): the environment of RunCVM's own processes, given the environment of a
# container process (config.json's process.env, or process.json's env): its RUNCVM_* settings,
# TERM (used by QEMU's curses display) if present, PATH ($path) and HOME (/.runcvm, private to
# RunCVM). The process's original environment is passed in its arguments instead, and only the
# workload receives it, so that no variable meant for the workload (e.g. LD_LIBRARY_PATH,
# BASH_ENV, UID) can affect RunCVM's own scripts and tools.
RUNCVM_ENV_JQ='def runcvm_env($path):
  (. // []) | map(select(startswith("RUNCVM_") or startswith("TERM="))) + ["PATH=" + $path, "HOME=/.runcvm"];'

debug() {
  [ -n "$RUNCVM_DEBUG" ] && true || false
}

# Debug logs, and copies of the configuration the runtime is given and returns, go in this root-only
# directory (see RUNCVM_RUNTIME_DEBUG).
RUNCVM_DEBUG_DIR=/run/runcvm

enable_debug() {
  RUNCVM_DEBUG="1"
  busybox mkdir -p "$RUNCVM_DEBUG_DIR" && busybox chmod 700 "$RUNCVM_DEBUG_DIR"
}

# runcvm-runtime runs on the host, and uses only bash's builtins and RunCVM's own tools (busybox and
# jq, each run with RunCVM's loader), never the host's, so that it behaves alike whatever the host
# provides. The one exception is runc, which it wraps: find_runc resolves it in the PATH the runtime
# is given (HOST_PATH), and runc runs with that PATH. PATH itself names no existing directory, so
# that any other command, not being a function or builtin, fails the operation
# (command_not_found_handle).
HOST_PATH="$PATH"
PATH=/nonexistent

busybox() {
  "$RUNCVM_LD" "$RUNCVM/bin/busybox" "$@"
}

# bash runs this in a separate execution environment, in which error()'s exit would end only that
# environment: so, having reported the error, it ends the runtime itself.
command_not_found_handle() {
  report_error "internal error: '$1' is not one of RunCVM's own tools, which alone runcvm-runtime runs"
  kill -s KILL $$
}

log() {
  debug && echo "$(busybox date '+%Y-%m-%d %H:%M:%S.%6N'): $$: $@" >>"$RUNCVM_DEBUG_DIR/runtime-$$.log"
}

# Reports error $1: on stderr, in the debug log, and in the runtime log file the caller requested.
report_error() {

  # Skip past any docker error ending in CR
  (echo; echo) >&2

  # Dump message to stderr
  echo "RunCVM: Error: $1" >&2

  # Dump error also to the logfile
  log "RunCVM: Error: $1"

  # Write the error to the runtime log file requested by the caller (e.g. containerd), from
  # which errors are reported to the user (e.g. by 'docker run'): stderr is not relayed.
  if [ -n "$RUNC_LOG" ]; then
    if [ "$RUNC_LOG_FORMAT" = "json" ]; then
      jq -cn --arg msg "RunCVM: Error: $1" --arg time "$(busybox date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        '{level: "error", msg: $msg, time: $time}' >>"$RUNC_LOG" 2>/dev/null
    else
      echo "RunCVM: Error: $1" >>"$RUNC_LOG" 2>/dev/null
    fi
  fi
}

error() {
  report_error "$1"
  exit -1
}

# Prints path $1 in the image with each symbolic link resolved within the image's filesystem (below
# $ROOT), as the image itself would resolve it: an absolute link names a path in the image, and '..'
# stops at the image's root, so the result never names a file outside the image. Fails after 40
# links, as the kernel does.
image_resolve_path() {
  local rest="${1#/}" resolved="" comp target links=0

  while [ -n "$rest" ]
  do
    comp="${rest%%/*}"
    if [[ "$rest" = */* ]]; then rest="${rest#*/}"; else rest=""; fi

    case "$comp" in
      ""|.) continue ;;
      ..) resolved="${resolved%/*}"; continue ;;
    esac

    if [ -L "$ROOT$resolved/$comp" ]; then
      links=$((links+1))
      [ "$links" -le 40 ] || return 1
      target=$(busybox readlink "$ROOT$resolved/$comp") || return 1
      [[ "$target" = /* ]] && resolved=""
      rest="${target#/}${rest:+/$rest}"
    else
      resolved="$resolved/$comp"
    fi
  done

  echo "${resolved:-/}"
}

# Prints the path (on the host) of the image's os-release file: /etc/os-release, or else
# /usr/lib/os-release, each resolved within the image by image_resolve_path. Prints nothing if the
# image has neither.
image_os_release() {
  local path

  for path in /etc/os-release /usr/lib/os-release
  do
    path=$(image_resolve_path "$path") || continue
    if [ -f "$ROOT$path" ]; then
      echo "$ROOT$path"
      return 0
    fi
  done

  return 0
}

# Prints the kernel (a directory under $RUNCVM_KERNELS) for distribution $1, an os-release ID:
# the distribution's own, if RunCVM bundles one; else, for a distribution of the RHEL family,
# $RUNCVM_KERNEL_RHEL_FAMILY, or of the SUSE family, $RUNCVM_KERNEL_SUSE_FAMILY. Returns 1 if
# there is none.
kernel_for_distro() {
  local distro="$1" family

  [[ "$distro" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || return 1

  if [ -d "$RUNCVM_KERNELS/$distro" ]; then
    echo "$distro"
    return 0
  fi

  case "$distro" in
    almalinux|amzn|centos|fedora|ol|rhel|rocky) family="$RUNCVM_KERNEL_RHEL_FAMILY" ;;
    opensuse|opensuse-*|sl-micro|sle-micro|sled|sles|sles_sap|suse) family="$RUNCVM_KERNEL_SUSE_FAMILY" ;;
    *) return 1 ;;
  esac

  [ -d "$RUNCVM_KERNELS/$family" ] || return 1
  echo "$family"
}

# Sets RUNC to the runc binary to which RunCVM passes each command: the first 'runc' in the
# caller's PATH (as Docker itself finds runc), or else in the usual system directories. Docker's
# own packages install runc as /usr/bin/runc; Debian's and Ubuntu's runc package (a dependency of
# their docker.io package) as /usr/sbin/runc. Returns 1 if none is found.
find_runc() {
  local dir

  RUNC=$(PATH="$HOST_PATH" type -P runc) && return 0

  for dir in /usr/bin /usr/sbin /usr/local/bin /usr/local/sbin /bin /sbin
  do
    if [ -x "$dir/runc" ]; then
      RUNC="$dir/runc"
      return 0
    fi
  done

  return 1
}

load_env_from_file() {
  local file="$1"
  local var="$2"

  # Return gracefully if no $file exists
  if ! [ -f "$file" ]; then
    return 0
  fi

  while read LINE
  do
    local name="${LINE%%=*}"
    local value="${LINE#*=}"
    
    if [ "$name" != "$LINE" ] && [ "$value" != "$LINE" ] && [ "$name" = "$var" ]; then
      # We found variable $name: return it, removing any leading/trailing double quotes
      value="${value#\"}"
      echo "${value%\"}"
      return 0
    fi
  done <"$file"
  
  return 1
}

# split_list <array> <separator> <string>
# Sets <array> to the entries of <string> between <separator>s, each without the whitespace around
# it (such as the newline that ends a YAML block scalar), and skips entries of whitespace alone.
# <string> is split with mapfile, not read, which would stop at a newline. runcvm-ctr-defaults has its own copy.
split_list() {
  local -n __split_list="$1"
  local __item
  local -a __items=()

  mapfile -d "$2" -t __items < <(printf '%s' "$3")
  __split_list=()
  for __item in "${__items[@]}"
  do
    __item="${__item#"${__item%%[![:space:]]*}"}"
    __item="${__item%"${__item##*[![:space:]]}"}"
    [ -z "$__item" ] || __split_list+=("$__item")
  done
}

# normalise_path <variable>
# Removes the empty and '.' components of the absolute path in <variable>, leaving '' for '/'.
normalise_path() {
  local -n __path="$1"
  local __component __normalised=""
  local -a __components

  IFS='/' read -r -a __components <<<"$__path"
  for __component in "${__components[@]}"
  do
    [[ -z "$__component" || "$__component" = "." ]] || __normalised+="/$__component"
  done
  __path="$__normalised"
}

# HOME=$RUNCVM keeps jq from loading the invoking user's ~/.jq.
jq() {
  HOME=$RUNCVM $RUNCVM_LD $RUNCVM_JQ "$@"
}

# jq_set <file> <jq arguments...>
# Replaces <file> with jq's output. The output is written beside <file>, in the same directory (the
# bundle containerd gives the runtime), and renamed over it, so that the file is replaced whole.
jq_set() {
  local file="$1"
  shift
  
  local tmp="$file.runcvm-tmp.$$"

  # Any failure stops the operation: runc must never run a configuration only partly updated.
  if ! jq "$@" "$file" >"$tmp"; then
    busybox rm -f "$tmp"
    error "Failed to update $file"
  fi
  if ! busybox mv "$tmp" "$file"; then
    busybox rm -f "$tmp"
    error "Failed to replace $file"
  fi
}

jq_get() {
  local file="$1"
  shift
  
  jq -r "$@" $file
}

get_process_env() {
  local file="$1"
  local var="$2"
  local default="$3"
  local value
  
  value=$(jq_get "$file" --arg env "$var" '[.env[] | select(startswith($env + "="))][0] // empty | .[($env | length) + 1:]')
  
  [ -n "$value" ] && echo -n "$value" || echo -n "$default"
}

get_process_env_boolean() {
  local file="$1"
  local var="$2"
  local value
  
  value=$(jq_get "$file" --arg env "$var" '[.env[] | select(startswith($env + "="))][0] // empty | .[($env | length) + 1:]')
  
  [ -n "$value" ] && echo "1" || echo "0"
}

# Succeeds if $1 has the form RUNCVM_DNS_IP needs: a dotted-quad IPv4 address (without leading
# zeros), unicast, and not in 0.0.0.0/8 or 127.0.0.0/8. (runcvm-ctr-entrypoint checks that it is
# none of the container's own addresses.)
valid_dns_ip() {
  local ip="$1" octet
  local -a octets

  [[ "$ip" =~ ^(0|[1-9][0-9]{0,2})(\.(0|[1-9][0-9]{0,2})){3}$ ]] || return 1
  IFS=. read -r -a octets <<< "$ip"
  for octet in "${octets[@]}"; do [ "$octet" -le 255 ] || return 1; done
  [ "${octets[0]}" -ne 0 ] && [ "${octets[0]}" -ne 127 ] && [ "${octets[0]}" -lt 224 ]
}

# Return success if $1 is a valid RUNCVM_VIRTIOFSD_CACHE (see its use below).
valid_virtiofsd_cache() {
  local item policy="" writeback=0
  local -a items

  [ -z "$1" ] && return 0
  IFS=',' read -r -a items <<<"$1"
  [ "${#items[@]}" -gt 0 ] && [ "${1: -1}" != "," ] || return 1
  for item in "${items[@]}"; do
    case "$item" in
      writeback) [ "$writeback" = 0 ] || return 1; writeback=1 ;;
      auto|always|metadata|none|never) [ -z "$policy" ] || return 1; policy="$item" ;;
      *) return 1 ;;
    esac
  done
  [ "$writeback" = 0 ] || [[ "${policy:-auto}" =~ ^(auto|always)$ ]]
}

# check_virtiofsd_cache_paths <value>
# Checks <value>, RUNCVM_VIRTIOFSD_CACHE_PATHS (see runcvm-ctr-virtiofsd): a ';'-separated list of
# <path>=<policy>, each path absolute, other than '/', and without a '..' component. A path's last
# '=' separates it from its policy, so a path may contain '='. Entries are checked as virtiofsd
# does: each path is normalised (empty and '.' components dropped), and may not be the root, nor be
# given twice with different policies. Whitespace around an entry is ignored (see split_list), as
# runcvm-ctr-virtiofsd ignores it. Reports an invalid entry with error().
check_virtiofsd_cache_paths() {
  local entry path policy
  local -a entries
  local -A policies=()

  split_list entries ';' "$1"
  for entry in "${entries[@]}"
  do
    path="${entry%=*}"
    if [[ "$entry" != *=* || "$path" != /* || "/$path/" == */../* ]]; then
      error "RUNCVM_VIRTIOFSD_CACHE_PATHS entry '$entry' invalid (should be <path>=<policy>, with <path> absolute, other than '/', and without '..')"
    fi
    policy="${entry##*=}"
    case "$policy" in
      auto|always|metadata|never) ;;
      none) policy=never ;;
      *) error "RUNCVM_VIRTIOFSD_CACHE_PATHS entry '$entry' invalid (its policy should be one of the cache policies auto, always, metadata and none (or never))" ;;
    esac
    normalise_path path
    if [ -z "$path" ]; then
      error "RUNCVM_VIRTIOFSD_CACHE_PATHS entry '$entry' invalid (its path is '/', whose policy RUNCVM_VIRTIOFSD_CACHE sets)"
    fi
    if [ -n "${policies[$path]}" ] && [ "${policies[$path]}" != "$policy" ]; then
      error "RUNCVM_VIRTIOFSD_CACHE_PATHS gives '$path' two cache policies"
    fi
    policies[$path]="$policy"
  done
}

get_config_env() {
  local var="$1"
  local default="$2"
  local value

  value=$(jq_get "$CFG" --arg env "$var" '[.process.env[] | select(startswith($env + "="))][0] // empty | .[($env | length) + 1:]')
  
  [ -n "$value" ] && echo -n "$value" || echo -n "$default"
}

# config_env_is <var> <value>
# Whether the container's environment sets <var> to exactly <value>: its whole
# value, as the container's scripts see it. (get_config_env's output, read through command
# substitution, loses any trailing newlines, so cannot decide this.)
config_env_is() {
  [ "$(jq_get "$CFG" --arg entry "$1=$2" 'any(.process.env[]; . == $entry)')" = "true" ]
}

# The host's own settings for RunCVM, which apply to every Container/VM on the host and which a
# container cannot override: lines NAME=VALUE in RUNCVM_HOST_SETTINGS. Other lines, such as blank
# lines and comments starting '#', are ignored. The file is read, never sourced.
RUNCVM_HOST_SETTINGS=/etc/default/runcvm

# Prints host setting $1's value (the last line that sets it), or $2 if none does or there is no
# file.
get_host_setting() {
  local line value
  if [ -r "$RUNCVM_HOST_SETTINGS" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in "$1="*) value="${line#*=}" ;; esac
    done <"$RUNCVM_HOST_SETTINGS"
  fi
  echo -n "${value-$2}"
}

# RunCVM's capability sets (see the create command's RUNCVM_CAPS): its own processes' needs
# (minimal), and Docker's default capabilities with CAP_NET_ADMIN (engine).
RUNCVM_MINIMAL_CAPS='["CAP_CHOWN","CAP_DAC_OVERRIDE","CAP_FOWNER","CAP_FSETID","CAP_MKNOD",
  "CAP_NET_ADMIN","CAP_NET_BIND_SERVICE","CAP_SETFCAP","CAP_SETGID","CAP_SETUID","CAP_SYS_CHROOT"]'
RUNCVM_ENGINE_CAPS='["CAP_AUDIT_WRITE","CAP_CHOWN","CAP_DAC_OVERRIDE","CAP_FOWNER","CAP_FSETID",
  "CAP_KILL","CAP_MKNOD","CAP_NET_ADMIN","CAP_NET_BIND_SERVICE","CAP_NET_RAW","CAP_SETFCAP",
  "CAP_SETGID","CAP_SETPCAP","CAP_SETUID","CAP_SYS_CHROOT"]'
# A jq filter setting a capabilities object to exactly $caps, with no inheritable or ambient ones.
RUNCVM_CAPS_EXACTLY='{"bounding": $caps, "effective": $caps, "permitted": $caps,
  "inheritable": [], "ambient": []}'
# A jq filter adding $caps to a capabilities object's bounding, effective and permitted sets.
RUNCVM_CAPS_ADD='reduce ("bounding", "effective", "permitted") as $set (.;
  .[$set] = ((.[$set] // []) + $caps | unique))'

set_config_env() {
  local var="$1"
  local value="$2"
  
  jq_set "$CFG" --arg env "$var=$value" '.process.env |= (.+ [$env] | unique)'
}


# PARSE RUNC GLOBAL OPTIONS:
# --debug             enable debug logging
# --log value         set the log file to write runc logs to (default is '/dev/stderr')
# --log-format value  set the log format ('text' (default), or 'json') (default: "text")
# --root value        root directory for storage of container state (this should be located in tmpfs) (default: "/run/user/1000/runc")
# --criu value        path to the criu binary used for checkpoint and restore (default: "criu")
# --systemd-cgroup    enable systemd cgroup support, expects cgroupsPath to be of form "slice:prefix:name" for e.g. "system.slice:runc:434234"
# --rootless value    ignore cgroup permission errors ('true', 'false', or 'auto') (default: "auto")

COMMAND_LINE=("$@")

if debug; then
  log "Command line: $0 ${COMMAND_LINE[@]@Q}"
fi

while true
do
  case "$1" in
    --debug|--systemd-cgroup) shift; continue; ;;
    --log) RUNC_LOG="$2"; shift; shift; continue; ;;
    --log=*) RUNC_LOG="${1#--log=}"; shift; continue; ;;
    --log-format) RUNC_LOG_FORMAT="$2"; shift; shift; continue; ;;
    --log-format=*) RUNC_LOG_FORMAT="${1#--log-format=}"; shift; continue; ;;
    --root|--criu|--rootless) shift; shift; continue; ;;
    --root=*|--criu=*|--rootless=*) shift; continue; ;;
    *) break; ;;
  esac
done

COMMAND="$1"
shift

find_runc || error "runc not found in PATH ($HOST_PATH) or in /usr/bin, /usr/sbin, /usr/local/bin, /usr/local/sbin, /bin or /sbin"

if [ "$COMMAND" = "create" ]; then

  debug && log "Command: create"
  
  # USAGE:
  #    runc create [command options] <container-id>
  #   
  # PARSE 'create' COMMAND OPTIONS
  # --bundle value, -b value  path to the root of the bundle directory, defaults to the current directory
  # --console-socket value    path to an AF_UNIX socket which will receive a file descriptor referencing the master end of the console's pseudoterminal
  # --pid-file value          specify the file to write the process id to
  # --no-pivot                do not use pivot root to jail process inside rootfs.  This should be used whenever the rootfs is on top of a ramdisk
  # --no-new-keyring          do not create a new session keyring for the container.  This will cause the container to inherit the calling processes session key
  # --preserve-fds value      Pass N additional file descriptors to the container (stdio + $LISTEN_FDS + N in total) (default: 0)
  while true
  do
    case "$1" in
      --bundle|-b) shift; BUNDLE="$1"; shift; continue; ;;
      --console-socket|--pid-file|--preserve-fds) shift; shift; continue; ;;
      --no-pivot|--no-new-keyring) shift; continue; ;;
      *) break; ;;
    esac
  done

  ID="$1"

  CFG="$BUNDLE/config.json"
  ROOT=$(jq -r .root.path $CFG)

  # The container's environment, as given by Docker/Podman, for the workload (see below)
  WORKLOAD_ENV=$(jq -c '.process.env // []' "$CFG")

  # Allow user to enable debug logging
  if [ "$(get_config_env RUNCVM_RUNTIME_DEBUG)" = "1" ]; then
    enable_debug
  fi

  if debug; then
    log "Command line: $0 ${COMMAND_LINE[@]@Q}"
    log "Command: create bundle=$BUNDLE id=$ID root=$ROOT"
    
    # Save formatted config.json
    jq -r . <$CFG >"$RUNCVM_DEBUG_DIR/config.json-$$-1"
    
  fi
  
  # The Container/VM's network set-up (runcvm-ctr-entrypoint) moves the container's addresses and
  # routes onto bridges for the VM, so it must run in a network namespace of the container's own:
  # in the host's (e.g. 'docker run --network=host') it would reconfigure the host's interfaces.
  if [ "$(jq_get "$CFG" '[.linux.namespaces[]? | select(.type == "network")] | length')" = "0" ]; then
    error "The host's network namespace (e.g. --network=host) is not supported: a RunCVM Container/VM needs a network namespace of its own"
  fi

  # Pending support for user-specified mountpoint for the guest (VM) binaries and scripts
  set_config_env "RUNCVM_GUEST" "$RUNCVM_GUEST"

  ARG0=$(jq_get "$CFG" '.process.args[0]')
  # Now look in mounts for destination == $ARG0 (this works for Docker and Podman): Docker's
  # --init runs /sbin/docker-init or /dev/init, and Podman's /run/podman-init.
  if [ "$ARG0" = "/sbin/docker-init" ] || [ "$ARG0" = "/dev/init" ] || [ "$ARG0" = "/run/podman-init" ]; then
  
    # User intended an init process to be run in the container,
    # so arrange to run our own instead, that will launch the original entrypoint
    
    # Look for and remove a mountpoint for this process.
    jq_set "$CFG" --arg init "$ARG0" '(.mounts[] | select(.destination == $init)) |= empty'
    
    # Replace the first argument with our own entrypoint; and remove the second, '--' (for now, #TODO)
    jq_set "$CFG" --arg entrypoint "$RUNCVM_ENTRYPOINT" '.process.args[0] = $entrypoint | del(.process.args[1])'
    
    # We know the user intended an init process to be run in the container.
    # TODO: We might want to indicate this, so that our entrypoint does not skip doing this
    # if the original entrypoint also looks like an init process.
    set_config_env "RUNCVM_INIT" "1"
  else
    # We don't know if the original entrypoint is an init process or not.
    # Run our entrypoint first to work this out and do the right thing.
    
    jq_set "$CFG" --arg entrypoint "$RUNCVM_ENTRYPOINT" '.process.args |= [$entrypoint] + .'
  fi

  # SET RUNCVM_HAS_HOME
  # 
  # If the HOME env var was not set either in the image, or via docker run, 
  # then it will be missing in the config env. Detect this case for communication to runcvm-ctr-entrypoint
  # so that HOME can be set to the requested user's default homedir.
  #
  # - See runcvm-ctr-entrypoint for full details of how/why hasHome is needed and HOME gets set.
  if [ -n "$(get_config_env HOME)" ]; then
    set_config_env "RUNCVM_HAS_HOME" "1"
  else
    set_config_env "RUNCVM_HAS_HOME" "0"
  fi

  # CONFIGURE USER
  # - Must be root to run container
  RUNCVM_UIDGID=$(jq_get "$CFG" '(.process.user.uid | tostring) + ":" + (.process.user.gid | tostring) + ":" + ((.process.user.additionalGids // []) | join(","))')
  set_config_env "RUNCVM_UIDGID" "$RUNCVM_UIDGID"
  jq_set "$CFG" '.process.user = {"uid":0, "gid":0}'
  log "RUNCVM_UIDGID=$RUNCVM_UIDGID"

  # CONFIGURE CPUS
  # A CPU quota (docker run --cpus) gives the VM as many vCPUs as it allows CPUs, rounded up, so
  # that a fraction of a CPU gives one; without one, RUNCVM_CPUS is 0, which gives the VM as many
  # vCPUs as the container may use (see runcvm-ctr-entrypoint).
  RUNCVM_CPUS=$(jq_get "$CFG" '.linux.resources.cpu as $c | if ($c.quota // 0) > 0 then (($c.quota / ($c.period // 100000)) | ceil) else 0 end')
  set_config_env "RUNCVM_CPUS" "$RUNCVM_CPUS"
  log "RUNCVM_CPUS=$RUNCVM_CPUS"

  # QEMU's own threads and virtiofsd run in the container alongside the vCPUs and share its CPU
  # quota: a quota of exactly the vCPUs' CPUs throttles the whole container, vCPUs included,
  # whenever those threads need CPU while the vCPUs are busy. RUNCVM_CPU_HEADROOM (default 1; 0
  # keeps Docker's quota as it is) adds that many CPUs to a quota, for them; 'max' removes
  # the quota, leaving --cpus to set the vCPUs alone. Without a quota, nothing changes, though the
  # value is still checked.
  RUNCVM_CPU_HEADROOM=$(get_config_env "RUNCVM_CPU_HEADROOM" 1)
  if [ "$RUNCVM_CPU_HEADROOM" != "max" ] && { ! [[ "$RUNCVM_CPU_HEADROOM" =~ ^(0|[1-9][0-9]*)(\.[0-9]+)?$ ]] || ! jq -en --argjson h "$RUNCVM_CPU_HEADROOM" '$h <= 64' >/dev/null; }; then
    error "RUNCVM_CPU_HEADROOM '$RUNCVM_CPU_HEADROOM' invalid (should be a number of CPUs from 0 to 64, e.g. 1 or 0.5, or 'max')"
  fi
  if [ "$RUNCVM_CPUS" -gt 0 ]; then
    if [ "$RUNCVM_CPU_HEADROOM" = "max" ]; then
      jq_set "$CFG" '.linux.resources.cpu.quota = -1'
    else
      jq_set "$CFG" --argjson h "$RUNCVM_CPU_HEADROOM" \
        '.linux.resources.cpu |= (.quota = ((.quota + $h * (.period // 100000)) | floor))'
    fi
    log "CPU quota: $(jq_get "$CFG" '.linux.resources.cpu | "\(.quota) per \(.period // 100000)"') (RUNCVM_CPU_HEADROOM=$RUNCVM_CPU_HEADROOM)"
  fi

  # CONFIGURE CONSOLE
  # RUNCVM_TTY: 1 if the container has a terminal ('docker run -t'), else 0. The workload's input
  # and output pass through the VM's console either way; without a terminal, runcvm-vm-start puts
  # the console into raw mode, so that they pass through unchanged.
  RUNCVM_TTY=$(jq_get "$CFG" 'if .process.terminal then 1 else 0 end')
  set_config_env "RUNCVM_TTY" "$RUNCVM_TTY"
  log "RUNCVM_TTY=$RUNCVM_TTY"

  # CONFIGURE MOUNTS
  set_config_env "RUNCVM_VM_MOUNTPOINT" "$RUNCVM_VM_MOUNTPOINT"

  # No mount's destination may contain an ASCII control character (a byte 0x01-0x1F or 0x7F, such
  # as a tab or a newline): RunCVM names the destinations in the files it passes to the VM. The
  # first such destination is reported, in bash's $'...' notation. (runcvm-ctr-qemu rejects a
  # destination that leads to such a path through symbolic links in the image.)
  mapfile -d '' -t bad < <(jq -j '.mounts[].destination | select(test("[\u0001-\u001f\u007f]")) | . + "\u0000"' "$CFG")
  if [ "${#bad[@]}" -gt 0 ]; then
    bad=$(LC_ALL=C printf '%q' "${bad[0]}")
    error "mount destination $bad must not contain control characters (bytes 0x01-0x1F and 0x7F)"
  fi

  # First extract list of tmpfs mounts in fstab form, then delete them from the config. Each field
  # is encoded with fstab's octal escapes for '\', space, tab and newline before the fields are
  # joined, so that each field's boundaries survive.
  # Podman's tmpcopyup/notmpcopyup (copy the image's files into a tmpfs, or not) are dropped: the VM's mount rejects them.
  RUNCVM_TMPFS=$(jq_get "$CFG" 'def enc: gsub("\\\\"; "\\134") | gsub(" "; "\\040") | gsub("\t"; "\\011") | gsub("\n"; "\\012"); ( .mounts[] | select(.type == "tmpfs" and (.destination | test("^/dev(/|$)") | not) ) ) | [(.source | enc) + " " + (.destination | enc) + " tmpfs " + (.options | map(select(. != "rprivate" and . != "private" and . != "tmpcopyup" and . != "notmpcopyup")) | join(",") | enc) + " 0 0"] | .[0]')
  jq_set "$CFG" -r 'del( .mounts[] | select(.type == "tmpfs" and (.destination | test("^/dev(/|$)") | not) ) )'
  set_config_env "RUNCVM_TMPFS" "$RUNCVM_TMPFS"

  # Rewrite all pre-existing bind/volume mounts (except those at or below /disks) to mount
  # below $RUNCVM_VM_MOUNTPOINT instead of below /.
  #
  # TODO TO CONSIDER:
  # If we excluded /etc/(resolv.conf,hosts,hostname), and moved these to top of the array
  # (by promoting them at the end of the below statements), they would be present in both
  # container and VM.
  #
  # N.B. A mount at or underneath /disks will NOT be mapped to /vm/disks - this path is reserved for mounting disk files to the container
  # /dev/shm stays the container's own, not the VM's: it backs the VM's memory (see CONFIGURE
  # MEMORY below). Docker supplies it as a tmpfs, but Podman as a bind mount of its own shm.
  jq_set "$CFG" --arg vm "$RUNCVM_VM_MOUNTPOINT" '( .mounts[] | select(.type == "bind" and .destination != "/dev/shm" and (.destination | test("^/disks(/|$)") | not) ) ).destination |= $vm + .'

  # Mount / from container to $RUNCVM_VM_MOUNTPOINT, recursively binding all pre-existing mount points
  # (these being only the ones defined ahead of this item in the mounts[] array - so order matters!)
  jq_set "$CFG" --arg root "$ROOT" --arg vm "$RUNCVM_VM_MOUNTPOINT" '.mounts |= [{"destination":$vm,"type":"bind","source":$root,"options":["rbind","private","rw"]}] + .'

  # Mount /opt/runcvm from host to container
  # Define this at top of mounts[] so it is recursively mounted
  # and before (but after in the mounts[] array) /.runcvm so it can be mounted inside it
  jq_set "$CFG" --arg runcvm "$RUNCVM" --arg runcvm_guest "$RUNCVM_GUEST" '.mounts |= [{"destination":$runcvm_guest,"type":"bind","source":$runcvm,"options":["bind","private","ro"]}] + .'

  # Mount a tmpfs at /.runcvm in container
  # Define this at top of mounts[] so it is recursively mounted
  jq_set "$CFG" '.mounts |= [{"destination":"/.runcvm","type":"tmpfs","source":"runcvm","options":["nosuid","noexec","nodev","size=1M","mode=700"]}] + .'

  # Mount a tmpfs at /run in container
  # Define this at bottom of mounts[] so it is not recursively mounted to /vm
  jq_set "$CFG" '.mounts += [{"destination":"/run","type":"tmpfs","source":"run","options":["nosuid","noexec","nodev","size=1M","mode=700"]}]'

  # DETERMINE LAUNCH KERNEL:
  #
  # 1. If RUNCVM_KERNEL specified:
  #    - <dist> or <dist>/latest - use latest RUNCVM kernel available for this dist *and* ARGS
  #    - <dist>/<version> - use specific RUNCVM kernel version for this dist *and* ARGS
  # 2. Else, check /etc/os-release and:
  #    a. Use builtin kernel for this dist (if present in the expected location) *and* ARGS, if
  #       RunCVM bundles a kernel for the image's own ID
  #    b. Use latest RUNCVM kernel available for the first of ID, then each word of ID_LIKE, that
  #       kernel_for_distro finds a kernel for:
  #      - ID=alpine, VERSION_ID=3.16.0              => alpine/latest
  #      - ID=debian, VERSION_ID=11                  => debian/latest
  #      - ID=rocky, ID_LIKE="rhel centos fedora"    => almalinux/latest
  #      - ID=sles, ID_LIKE=suse                     => opensuse/latest
  #      - ID=kali, ID_LIKE=debian                   => debian/latest
  #    c. Else use $RUNCVM_KERNEL_DEFAULT (Debian's kernel): silently if the image gives no ID, and
  #       otherwise with a warning (RUNCVM_KERNEL_FALLBACK, '<ID> <kernel>', which
  #       runcvm-ctr-qemu reports)
  
  # Look for RUNCVM_KERNEL env var
  RUNCVM_KERNEL=$(get_config_env 'RUNCVM_KERNEL')
  log "RUNCVM_KERNEL='$RUNCVM_KERNEL' (1)"

  # Generate:
  # - RUNCVM_KERNEL_ID: the distro name (e.g. alpine, debian, ubuntu)
  # - RUNCVM_KERNEL_IDVER: the distro name and kernel version (e.g. alpine/5.15.59-0-virt, debian/5.10.0-16-amd64)

  if [ -n "$RUNCVM_KERNEL" ]; then
    # If found, validate
  
    # A distribution name with no kernel of its own names its family's kernel (e.g. 'ol' names
    # AlmaLinux's), as for an image of that distribution.
    if [[ "$RUNCVM_KERNEL" =~ ^[a-z]+$ ]] && ! [ -d "$RUNCVM_KERNELS/$RUNCVM_KERNEL" ] && \
       family=$(kernel_for_distro "$RUNCVM_KERNEL"); then
      RUNCVM_KERNEL="$family"
    fi

    if [[ "$RUNCVM_KERNEL" =~ \.\. ]]; then
      error "Kernel '$RUNCVM_KERNEL' invalid (contains '..')"
    fi
  
    if ! [[ "$RUNCVM_KERNEL" =~ ^[a-z]+(/[^/]+)?$ ]]; then
      error "Kernel '$RUNCVM_KERNEL' invalid (should match ^[a-z]+(/[^/]+)?$)"
    fi
  
    if ! [ -d "$RUNCVM_KERNELS/$RUNCVM_KERNEL" ]; then
      error "Kernel '$RUNCVM_KERNEL' not found (check $RUNCVM_KERNELS)"
    fi

    # If RUNCVM_KERNEL is a distro name only, append /latest
    if [[ "$RUNCVM_KERNEL" =~ ^[a-z]+$ ]]; then
      RUNCVM_KERNEL_IDVER="$RUNCVM_KERNEL/latest"
    else
      RUNCVM_KERNEL_IDVER="$RUNCVM_KERNEL"
    fi  

    RUNCVM_KERNEL_ID="${RUNCVM_KERNEL_IDVER%%/*}" # e.g. alpine, debian, ubuntu

  else
    # If not found, look for ID and ID_LIKE in the container image's os-release
    os_release="" os_id="" os_id_like=""
    os_release=$(image_os_release)
    if [ -n "$os_release" ]; then
      os_id=$(load_env_from_file "$os_release" "ID")
      os_id_like=$(load_env_from_file "$os_release" "ID_LIKE")
    fi

    RUNCVM_KERNEL_ID=""
    for distro in $os_id $os_id_like
    do
      RUNCVM_KERNEL_ID=$(kernel_for_distro "$distro") && break
    done

    # An in-image kernel is looked for only where the image's own ID is the name of the chosen
    # kernel: the case below gives that distribution's in-image kernel and initramfs paths, and its
    # kernel arguments.
    [ -n "$os_id" ] && [ "$RUNCVM_KERNEL_ID" = "$os_id" ] && RUNCVM_KERNEL_IMAGE_DISTRO=1

    # If still not found, assign a default
    if [ -z "$RUNCVM_KERNEL_ID" ]; then
      RUNCVM_KERNEL_ID="${RUNCVM_KERNEL_DEFAULT:-debian}"
      if [ -n "$os_id" ]; then
        set_config_env "RUNCVM_KERNEL_FALLBACK" "$os_id $RUNCVM_KERNEL_ID"
      fi
    fi

    RUNCVM_KERNEL_IDVER="$RUNCVM_KERNEL_ID/latest"
  fi
  
  log "RUNCVM_KERNEL='$RUNCVM_KERNEL' (2)"
  log "RUNCVM_KERNEL_ID='$RUNCVM_KERNEL_ID'"
  log "RUNCVM_KERNEL_IDVER='$RUNCVM_KERNEL_IDVER'"
  
  # Now look up the default kernel and initramfs paths and args for this kernel
  case "$RUNCVM_KERNEL_ID" in
          debian) RUNCVM_KERNEL_OS_KERNEL_PATH="/vmlinuz"
                  RUNCVM_KERNEL_OS_INITRAMFS_PATH="/initrd.img"
                  RUNCVM_KERNEL_ROOT="rootfstype=virtiofs root=runcvmfs noresume net.ifnames=1"
                  ;;
          ubuntu) RUNCVM_KERNEL_OS_KERNEL_PATH="/boot/vmlinuz"
                  RUNCVM_KERNEL_OS_INITRAMFS_PATH="/boot/initrd.img"
                  RUNCVM_KERNEL_ROOT="rootfstype=virtiofs root=runcvmfs noresume net.ifnames=1"
                  ;;
almalinux|fedora|ol) RUNCVM_KERNEL_OS_KERNEL_PATH="/boot/vmlinuz"
                  RUNCVM_KERNEL_OS_INITRAMFS_PATH="/boot/initramfs"
                  RUNCVM_KERNEL_ROOT="root=virtiofs:runcvmfs noresume net.ifnames=1"
                  ;;
        opensuse) RUNCVM_KERNEL_OS_KERNEL_PATH="/boot/vmlinuz"
                  RUNCVM_KERNEL_OS_INITRAMFS_PATH="/boot/initrd"
                  RUNCVM_KERNEL_ROOT="root=virtiofs:runcvmfs noresume net.ifnames=1"
                  ;;
  alpine|openwrt) RUNCVM_KERNEL_OS_KERNEL_PATH="/boot/vmlinuz-virt"
                  RUNCVM_KERNEL_OS_INITRAMFS_PATH="/boot/initramfs-virt"
                  RUNCVM_KERNEL_ROOT="rootfstype=virtiofs root=runcvmfs resume="
                  ;;

           *) error "Unrecognised image O/S '$RUNCVM_KERNEL'; specify --env=RUNCVM_KERNEL=<dist> or --env=RUNCVM_KERNEL=<dist>/<version>"; ;;
  esac
  
  # If no RUNCVM_KERNEL specified, look for a kernel and initramfs at the expected paths in the container image.
  if [[ -z "$RUNCVM_KERNEL" && "$RUNCVM_KERNEL_IMAGE_DISTRO" = "1" && -f "$ROOT/$RUNCVM_KERNEL_OS_KERNEL_PATH" && -f "$ROOT/$RUNCVM_KERNEL_OS_INITRAMFS_PATH" ]]; then
    RUNCVM_KERNEL_PATH="$RUNCVM_KERNEL_OS_KERNEL_PATH"
    RUNCVM_KERNEL_INITRAMFS_PATH="$RUNCVM_KERNEL_OS_INITRAMFS_PATH"
  else
    # If RUNCVM_KERNEL was specified, or we didn't find a kernel and initramfs at the expected paths in the container image,
    # select the latest RUNCVM kernel version and arrange to mount it.

    RUNCVM_KERNEL_VERSION=$(busybox readlink -f "$RUNCVM_KERNELS/$RUNCVM_KERNEL_IDVER")
    RUNCVM_KERNEL_VERSION="${RUNCVM_KERNEL_VERSION##*/}" # e.g. 5.15.53-0-virt

    RUNCVM_KERNEL_MOUNT_LIB_MODULES=$(get_config_env 'RUNCVM_KERNEL_MOUNT_LIB_MODULES')
    if [ -n "$RUNCVM_KERNEL_MOUNT_LIB_MODULES" ]; then
      RUNCVM_KERNEL_MODULES_SRC="$RUNCVM_KERNELS/$RUNCVM_KERNEL_ID/$RUNCVM_KERNEL_VERSION/modules"
      RUNCVM_KERNEL_MODULES_DST="/lib/modules"
    else
      RUNCVM_KERNEL_MODULES_SRC="$RUNCVM_KERNELS/$RUNCVM_KERNEL_ID/$RUNCVM_KERNEL_VERSION/modules/$RUNCVM_KERNEL_VERSION"
      RUNCVM_KERNEL_MODULES_DST="/lib/modules/$RUNCVM_KERNEL_VERSION"
    fi
    
    RUNCVM_KERNEL_PATH="$RUNCVM_GUEST_KERNELS/$RUNCVM_KERNEL_ID/$RUNCVM_KERNEL_VERSION/vmlinuz"
    RUNCVM_KERNEL_INITRAMFS_PATH="$RUNCVM_GUEST_KERNELS/$RUNCVM_KERNEL_ID/$RUNCVM_KERNEL_VERSION/initrd"

    jq_set "$CFG" --arg modules_dst "$RUNCVM_VM_MOUNTPOINT$RUNCVM_KERNEL_MODULES_DST" --arg modules_src "$RUNCVM_KERNEL_MODULES_SRC" '.mounts += [{"destination":$modules_dst,"type":"bind","source":$modules_src,"options":["bind","private","ro"]}]'
  fi

  log "RUNCVM_KERNEL='$RUNCVM_KERNEL'"
  log "RUNCVM_KERNEL_ID='$RUNCVM_KERNEL_ID'"
  log "RUNCVM_KERNEL_VERSION='$RUNCVM_KERNEL_VERSION'"
  log "RUNCVM_KERNEL_OS_KERNEL_PATH='$RUNCVM_KERNEL_OS_KERNEL_PATH'"
  log "RUNCVM_KERNEL_OS_INITRAMFS_PATH='$RUNCVM_KERNEL_OS_INITRAMFS_PATH'"
  log "RUNCVM_KERNEL_PATH='$RUNCVM_KERNEL_PATH'"
  log "RUNCVM_KERNEL_INITRAMFS_PATH='$RUNCVM_KERNEL_INITRAMFS_PATH'"
  log "RUNCVM_KERNEL_ROOT='$RUNCVM_KERNEL_ROOT'"
  log "RUNCVM_KERNEL_MODULES_SRC='$RUNCVM_KERNEL_MODULES_SRC'"
  log "RUNCVM_KERNEL_MODULES_DST='$RUNCVM_KERNEL_MODULES_DST'"
  
  set_config_env "RUNCVM_KERNEL_PATH" "$RUNCVM_KERNEL_PATH"
  set_config_env "RUNCVM_KERNEL_INITRAMFS_PATH" "$RUNCVM_KERNEL_INITRAMFS_PATH"
  set_config_env "RUNCVM_KERNEL_ROOT" "$RUNCVM_KERNEL_ROOT"

  # Auto-detect host architecture; respect user-supplied RUNCVM_QEMU_ARCH if set
  case "$(busybox uname -m)" in
    aarch64) RUNCVM_QEMU_ARCH_DEFAULT="arm64" ;;
    x86_64)  RUNCVM_QEMU_ARCH_DEFAULT="x86_64" ;;
    *)       RUNCVM_QEMU_ARCH_DEFAULT="x86_64" ;;
  esac
  RUNCVM_QEMU_ARCH="$(get_config_env 'RUNCVM_QEMU_ARCH' "$RUNCVM_QEMU_ARCH_DEFAULT")"
  set_config_env "RUNCVM_QEMU_ARCH" "$RUNCVM_QEMU_ARCH"

  # RUNCVM_KERNEL_MODULES: kernel modules for runcvm-vm-init to load at boot, by name.
  RUNCVM_KERNEL_MODULES="$(get_config_env 'RUNCVM_KERNEL_MODULES')"
  if [ -n "$RUNCVM_KERNEL_MODULES" ] && ! [[ "$RUNCVM_KERNEL_MODULES" =~ ^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$ ]]; then
    error "RUNCVM_KERNEL_MODULES '$RUNCVM_KERNEL_MODULES' invalid (should be a comma-separated list of kernel module names, e.g. kvm_intel,vxlan)"
  fi

  # RUNCVM_SHUTDOWN: how runcvm-ctr-shutdown asks the guest to power off when the container is
  # stopped (see runcvm-vm-init, which resolves 'auto'). A signal is a number, or a name that
  # RunCVM's busybox kill knows, with or without 'SIG'.
  RUNCVM_SHUTDOWN="$(get_config_env 'RUNCVM_SHUTDOWN')"
  if [ -n "$RUNCVM_SHUTDOWN" ] && ! [[ "$RUNCVM_SHUTDOWN" =~ ^(auto|systemd|busybox|acpi|all|signal:([1-9][0-9]?|(SIG)?[A-Z][A-Z0-9]*))$ ]]; then
    error "RUNCVM_SHUTDOWN '$RUNCVM_SHUTDOWN' invalid (should be auto, systemd, busybox, acpi, all, or signal:<signal>, e.g. signal:PWR or signal:38)"
  fi

  # RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT: how long, in seconds (fractions allowed, at most 86400), the
  # VM may cache that a name it looked up does not exist (see runcvm-ctr-virtiofsd).
  RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT="$(get_config_env 'RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT')"
  if [ -n "$RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT" ] && ! {
      [[ "$RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT" =~ ^(0|[1-9][0-9]{0,4})(\.[0-9]{1,9})?$ ]] &&
      { [ "${RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT%%.*}" -lt 86400 ] || [[ "$RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT" =~ ^86400(\.0+)?$ ]]; }
    }; then
    error "RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT '$RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT' invalid (should be a number of seconds from 0 to 86400, e.g. 1 or 0.5)"
  fi

  # RUNCVM_VIRTIOFSD_KILLPRIV: whether virtiofsd clears setuid and setgid bits itself (1; see
  # runcvm-ctr-virtiofsd) or leaves it to the VM (0, the default).
  RUNCVM_VIRTIOFSD_KILLPRIV="$(get_config_env 'RUNCVM_VIRTIOFSD_KILLPRIV')"
  case "$RUNCVM_VIRTIOFSD_KILLPRIV" in
    ''|0|1) ;;
    *) error "RUNCVM_VIRTIOFSD_KILLPRIV '$RUNCVM_VIRTIOFSD_KILLPRIV' invalid (should be 0 or 1)" ;;
  esac

  # RUNCVM_VIRTIOFSD_POLL and RUNCVM_VIRTIOFSD_POLL_US: how virtiofsd polls the VM's request queue
  # after it runs dry, and its window in microseconds (see runcvm-ctr-virtiofsd). Unset, or 'none',
  # or a window of 0 alone, it does not poll.
  RUNCVM_VIRTIOFSD_POLL="$(get_config_env 'RUNCVM_VIRTIOFSD_POLL')"
  case "$RUNCVM_VIRTIOFSD_POLL" in
    ''|none|fixed|adaptive) ;;
    *) error "RUNCVM_VIRTIOFSD_POLL '$RUNCVM_VIRTIOFSD_POLL' invalid (should be none, fixed or adaptive)" ;;
  esac
  RUNCVM_VIRTIOFSD_POLL_US="$(get_config_env 'RUNCVM_VIRTIOFSD_POLL_US')"
  if [ -n "$RUNCVM_VIRTIOFSD_POLL_US" ] && ! [[ "$RUNCVM_VIRTIOFSD_POLL_US" =~ ^(0|[1-9][0-9]{0,2}|1000)$ ]]; then
    error "RUNCVM_VIRTIOFSD_POLL_US '$RUNCVM_VIRTIOFSD_POLL_US' invalid (should be a whole number of microseconds from 0 to 1000)"
  fi
  if [[ "$RUNCVM_VIRTIOFSD_POLL" =~ ^(fixed|adaptive)$ && "$RUNCVM_VIRTIOFSD_POLL_US" == "0" ]]; then
    error "RUNCVM_VIRTIOFSD_POLL_US '0' invalid with RUNCVM_VIRTIOFSD_POLL '$RUNCVM_VIRTIOFSD_POLL' (should be from 1 to 1000)"
  fi

  # QEMU acceleration:
  # - kvm (default): use KVM; fail at creation if /dev/kvm is unavailable on this host
  # - auto: use KVM if /dev/kvm is available, otherwise (much slower) software emulation
  # - tcg: always use software emulation (e.g. for testing where KVM is unavailable)
  RUNCVM_QEMU_ACCEL="$(get_config_env 'RUNCVM_QEMU_ACCEL' 'kvm')"
  case "$RUNCVM_QEMU_ACCEL" in
    kvm|auto|tcg) ;;
    *) error "RUNCVM_QEMU_ACCEL '$RUNCVM_QEMU_ACCEL' invalid (should be kvm, auto or tcg)" ;;
  esac
  if [ "$RUNCVM_QEMU_ACCEL" = "kvm" ] && ! [ -e /dev/kvm ]; then
    error "/dev/kvm is unavailable on this host; launch with --env=RUNCVM_QEMU_ACCEL=auto or --env=RUNCVM_QEMU_ACCEL=tcg to allow (much slower) software emulation"
  fi
  set_config_env "RUNCVM_QEMU_ACCEL" "$RUNCVM_QEMU_ACCEL"

  # What /.runcvm/fstab lists of the container's volumes and bind mounts that a disk or tmpfs mount
  # hides, and that runcvm-vm-init mounts again over it (see write_manifests in runcvm-ctr-qemu):
  # - disks (default): each only as a comment, with the tmpfs that held it detached after boot
  # - all: each as a bind mount from where it is held, which systemd and 'mount -a' can mount again
  case "$(get_config_env 'RUNCVM_FSTAB' 'disks')" in
    disks|all) ;;
    *) error "RUNCVM_FSTAB '$(get_config_env 'RUNCVM_FSTAB')' invalid (should be disks or all)" ;;
  esac

  # The address at which the VM reaches dnsmasq, and from which 'docker exec' connects to the VM.
  RUNCVM_DNS_IP="$(get_config_env 'RUNCVM_DNS_IP' "$RUNCVM_DNS_IP_DEFAULT")"
  if ! valid_dns_ip "$RUNCVM_DNS_IP"; then
    error "RUNCVM_DNS_IP '$RUNCVM_DNS_IP' invalid (should be a unicast IPv4 address, not in 0.0.0.0/8 or 127.0.0.0/8; default $RUNCVM_DNS_IP_DEFAULT)"
  fi
  set_config_env "RUNCVM_DNS_IP" "$RUNCVM_DNS_IP"

  # virtiofsd's caching: a comma-separated list of at most one cache policy and 'writeback'.
  # Writeback caching needs a policy that caches file contents in the VM (auto or always).
  RUNCVM_VIRTIOFSD_CACHE="$(get_config_env 'RUNCVM_VIRTIOFSD_CACHE')"
  if ! valid_virtiofsd_cache "$RUNCVM_VIRTIOFSD_CACHE"; then
    error "RUNCVM_VIRTIOFSD_CACHE '$RUNCVM_VIRTIOFSD_CACHE' invalid (should be one of the cache policies auto, always, metadata and none (or never), optionally with 'writeback', which needs auto or always, e.g. 'always,writeback')"
  fi

  # The cache policy for the mounts within the VM's root filesystem (see runcvm-ctr-virtiofsd).
  RUNCVM_VIRTIOFSD_SUBMOUNT_CACHE="$(get_config_env 'RUNCVM_VIRTIOFSD_SUBMOUNT_CACHE')"
  case "$RUNCVM_VIRTIOFSD_SUBMOUNT_CACHE" in
    ''|auto|always|metadata|none|never) ;;
    *) error "RUNCVM_VIRTIOFSD_SUBMOUNT_CACHE '$RUNCVM_VIRTIOFSD_SUBMOUNT_CACHE' invalid (should be one of the cache policies auto, always, metadata and none (or never))" ;;
  esac

  # The cache policies for the mounts at or below given paths (see check_virtiofsd_cache_paths).
  RUNCVM_VIRTIOFSD_CACHE_PATHS="$(get_config_env 'RUNCVM_VIRTIOFSD_CACHE_PATHS')"
  check_virtiofsd_cache_paths "$RUNCVM_VIRTIOFSD_CACHE_PATHS"

  # Under software emulation, QEMU keeps a cache of translated code, whose size is set by
  # RUNCVM_QEMU_TCG_TB_MEM_SIZE (Mb) and added to the container's memory limit (below), so
  # that the VM's own memory and the container's memory limit remain aligned.
  RUNCVM_CONTAINER_MEM_TCG=0
  if [ "$RUNCVM_QEMU_ACCEL" = "tcg" ] || { [ "$RUNCVM_QEMU_ACCEL" = "auto" ] && ! [ -e /dev/kvm ]; }; then
    RUNCVM_QEMU_TCG_TB_MEM_SIZE="$(get_config_env 'RUNCVM_QEMU_TCG_TB_MEM_SIZE' "$RUNCVM_QEMU_TCG_TB_MEM_SIZE_DEFAULT")"
    case "$RUNCVM_QEMU_TCG_TB_MEM_SIZE" in ''|*[!0-9]*) RUNCVM_QEMU_TCG_TB_MEM_SIZE_VALID=0 ;; *) RUNCVM_QEMU_TCG_TB_MEM_SIZE_VALID=1 ;; esac
    if [ "$RUNCVM_QEMU_TCG_TB_MEM_SIZE_VALID" != "1" ] \
      || [ "$RUNCVM_QEMU_TCG_TB_MEM_SIZE" -lt "$RUNCVM_QEMU_TCG_TB_MEM_SIZE_MIN" ] \
      || [ "$RUNCVM_QEMU_TCG_TB_MEM_SIZE" -gt "$RUNCVM_QEMU_TCG_TB_MEM_SIZE_MAX" ]; then
      error "RUNCVM_QEMU_TCG_TB_MEM_SIZE '$RUNCVM_QEMU_TCG_TB_MEM_SIZE' invalid (should be a whole number of Mb from $RUNCVM_QEMU_TCG_TB_MEM_SIZE_MIN to $RUNCVM_QEMU_TCG_TB_MEM_SIZE_MAX)"
    fi
    set_config_env "RUNCVM_QEMU_TCG_TB_MEM_SIZE" "$RUNCVM_QEMU_TCG_TB_MEM_SIZE"
    RUNCVM_CONTAINER_MEM_TCG="$RUNCVM_QEMU_TCG_TB_MEM_SIZE"
  fi

  # Configure devices
  # /dev/net/tun — always needed
  jq_set "$CFG" '.linux.resources.devices += [{"allow":true,"type":"c","major":10,"minor":200,"access":"rwm"}]'
  jq_set "$CFG" '.linux.devices+=[{"path":"/dev/net/tun","type":"c","major":10,"minor":200,"fileMode":8630,"uid":0,"gid":0}]'

  # /dev/kvm — only inject if it will be used and exists on the host (runc fails if a listed
  # device is absent)
  if [ "$RUNCVM_QEMU_ACCEL" != "tcg" ] && [ -e /dev/kvm ]; then
    jq_set "$CFG" '.linux.resources.devices += [{"allow":true,"type":"c","major":10,"minor":232,"access":"rwm"}]'
    jq_set "$CFG" '.linux.devices+=[{"path":"/dev/kvm","type":"c","major":10,"minor":232,"fileMode":8630,"uid":0,"gid":0}]'
  fi

  # /dev/vhost-net — only if explicitly requested AND the device exists on the host
  if [ "$(get_config_env 'RUNCVM_QEMU_NET_VHOST')" = "1" ] && [ -e /dev/vhost-net ]; then
    jq_set "$CFG" '.linux.resources.devices += [{"allow":true,"type":"c","major":10,"minor":238,"access":"rwm"}]'
    jq_set "$CFG" '.linux.devices+=[{"path":"/dev/vhost-net","type":"c","major":10,"minor":238,"fileMode":8630,"uid":0,"gid":0}]'
  fi
  
  # Seccomp (RUNCVM_SECCOMP): the processes RunCVM runs in the container on the host (QEMU,
  # virtiofsd, dnsmasq, and RunCVM's own scripts and tools) run under a profile allowing the system
  # calls they need. The workload runs in the VM, behind the VM's kernel, so its system calls are
  # not the profile's concern. io_uring's calls (io_uring_setup, io_uring_enter, io_uring_register)
  # are allowed only where the container has disks (RUNCVM_DISKS) and RUNCVM_DISK_AIO does not
  # choose native or threads, the modes that do without io_uring (see disk_choose_aio in
  # runcvm-ctr-qemu); QEMU also tries io_uring for its event loop, and without it uses epoll.
  # - engine (the default): the engine's profile, with the calls RunCVM's processes need beyond
  #   its default also allowed: io_uring's (as above), get_mempolicy, set_mempolicy and mbind (which
  #   the default profile allows only with CAP_SYS_NICE), and chroot (for virtiofsd's --sandbox=chroot, which it
  #   allows only with CAP_SYS_CHROOT). The engine resolves its profile against the capabilities
  #   given to docker run or podman run, not those the runtime gives RunCVM's processes (below), so
  #   these calls must be allowed here, not left to a capability. They are also taken out of the
  #   profile's rules that deny them (Podman's profile denies chroot without CAP_SYS_CHROOT), as a
  #   rule naming a call takes precedence over a later one.
  # - minimal: RunCVM's own profile, scripts/seccomp/profile.json, in place of the one Docker or
  #   Podman resolved into the bundle, with io_uring's calls as above. It allows only the calls
  #   listed for the host's architecture in scripts/seccomp/<arch> and, for virtiofsd, in
  #   scripts/seccomp/virtiofsd, and denies any other with EPERM, as the engines' default profiles
  #   do. The image build writes it from those lists (build-utils/make-seccomp-profile.sh).
  # - unconfined: no profile, leaving RunCVM's processes unfiltered.
  # Under 'engine', a bundle the engine left with no profile (docker run --security-opt
  # seccomp=unconfined, or --privileged) is left unconfined, but that is not a supported way to run
  # them so: these options are reserved to apply, in future, to the VM rather than to RunCVM's
  # processes. 'minimal' gives every bundle RunCVM's profile, whether or not the engine gave it one.
  # A profile of the user's own (--security-opt seccomp=<file>) is unsupported: 'minimal' replaces
  # it, and 'engine' adds to it.
  RUNCVM_SECCOMP="$(get_config_env 'RUNCVM_SECCOMP')"
  [ -z "$RUNCVM_SECCOMP" ] || config_env_is RUNCVM_SECCOMP "$RUNCVM_SECCOMP" ||
    error "RUNCVM_SECCOMP invalid (should be minimal, engine or unconfined)"
  case "$RUNCVM_SECCOMP" in
    '') RUNCVM_SECCOMP=engine ;;
    minimal|engine) ;;
    unconfined) jq_set "$CFG" 'del(.linux.seccomp)' ;;
    *) error "RUNCVM_SECCOMP '$RUNCVM_SECCOMP' invalid (should be minimal, engine or unconfined)" ;;
  esac
  SECCOMP_IO_URING=
  # Whether RUNCVM_DISKS names any disk: its value split as runcvm-ctr-qemu splits it, with the same
  # split_list.
  split_list SECCOMP_DISK_SPECS ';' "$(get_config_env 'RUNCVM_DISKS')"
  if [ "${#SECCOMP_DISK_SPECS[@]}" -gt 0 ]; then
    # As runcvm-ctr-qemu reads it: native or threads, exactly, or else io_uring where it can.
    config_env_is RUNCVM_DISK_AIO native || config_env_is RUNCVM_DISK_AIO threads ||
      SECCOMP_IO_URING='"io_uring_setup","io_uring_enter","io_uring_register"'
  fi
  if [ "$RUNCVM_SECCOMP" = "engine" ]; then
    SECCOMP_ALLOW='"get_mempolicy","set_mempolicy","mbind","chroot"'
    [ -n "$SECCOMP_IO_URING" ] && SECCOMP_ALLOW+=",$SECCOMP_IO_URING"
    jq_set "$CFG" --argjson names "[$SECCOMP_ALLOW]" '
      if .linux.seccomp then
        .linux.seccomp.syscalls |= ((. // []) | map(if .action == "SCMP_ACT_ALLOW" then . else .names -= $names end)
          | map(select(.names | length > 0)))
        | .linux.seccomp.syscalls += [{"names": $names, "action": "SCMP_ACT_ALLOW"}]
      else . end'
  elif [ "$RUNCVM_SECCOMP" != "unconfined" ]; then
    SECCOMP_PROFILE="$RUNCVM/scripts/seccomp/profile.json"
    [ -f "$SECCOMP_PROFILE" ] || error "RUNCVM_SECCOMP=minimal: no seccomp profile ($SECCOMP_PROFILE) for this architecture; use RUNCVM_SECCOMP=engine"
    jq_set "$CFG" --slurpfile profile "$SECCOMP_PROFILE" --argjson io_uring "[$SECCOMP_IO_URING]" '
      .linux.seccomp = ($profile[0] | .syscalls[0].names += $io_uring)'
  fi
  
  # CONFIGURE MEMORY
  # Set /dev/shm to RUNCVM_MEM_SIZE env var, or to default
  # - it should be large enough to support VM memory
  RUNCVM_MEM_LIMIT=$(jq_get "$CFG" '.linux.resources.memory.limit')
  log "RUNCVM_MEM_LIMIT=$RUNCVM_MEM_LIMIT"
  if [ "$RUNCVM_MEM_LIMIT" != "null" ]; then
    RUNCVM_MEM_SIZE="$(( $RUNCVM_MEM_LIMIT/1024/1024 ))"
  else
    RUNCVM_MEM_SIZE="$RUNCVM_MEM_SIZE_DEFAULT"
  fi
  log "RUNCVM_MEM_SIZE=${RUNCVM_MEM_SIZE}M"
  set_config_env "RUNCVM_MEM_SIZE" "${RUNCVM_MEM_SIZE}M"

  # RUNCVM_HUGETLB: the VM's memory from the host's hugepages (1), from /dev/shm (0, the default),
  # or from hugepages where enough are free and /dev/shm otherwise (auto; see runcvm-ctr-qemu), for
  # which /dev/shm is sized as for 0.
  RUNCVM_HUGETLB=$(get_config_env "RUNCVM_HUGETLB")
  case "$RUNCVM_HUGETLB" in
    ''|0|1|auto) ;;
    *) error "RUNCVM_HUGETLB '$RUNCVM_HUGETLB' invalid (should be 0, 1 or auto)" ;;
  esac
  if [ "$RUNCVM_HUGETLB" != "1" ]; then
    jq_set "$CFG" --arg size "${RUNCVM_MEM_SIZE}M" '( .mounts[] | select(.destination == "/dev/shm") ) = {"destination": "/dev/shm","type": "tmpfs","source": "shm","options": ["nosuid","noexec","nodev","mode=1777","size=" + $size]}'
  # else
    # --shm-size applies; default 64m.
  fi

  # Set the container memory limit with a reasonable additional reserve to allow for
  # QEMU, virtiofsd, dnsmasq and other container memory footprint, plus (under software
  # emulation) QEMU's translated-code cache.
  jq_set "$CFG" --arg size "$((($RUNCVM_MEM_SIZE + $RUNCVM_CONTAINER_MEM_OVERHEAD + $RUNCVM_CONTAINER_MEM_TCG)*1024*1024))" '.linux.resources.memory.limit = ($size | tonumber)'

  # A memory-and-swap limit (docker run --memory-swap) must be at least the memory limit: raise it
  # by the same amount as the memory limit was raised above.
  if [ "$RUNCVM_MEM_LIMIT" != "null" ]; then
    jq_set "$CFG" --arg limit "$RUNCVM_MEM_LIMIT" '
      if (.linux.resources.memory.swap // 0) > 0
      then .linux.resources.memory.swap += .linux.resources.memory.limit - ($limit | tonumber)
      else . end'
  fi

  # The container's capabilities (RUNCVM_CAPS) are those of RunCVM's own processes (QEMU,
  # virtiofsd, dnsmasq and the network configuration), which run as root; the workload runs under
  # the VM's kernel. They are set in the bounding, effective and permitted sets, so that they hold
  # under no_new_privs too.
  # - minimal (the default): exactly these, whatever the container was given (e.g. docker run
  #   --cap-add, --cap-drop, --privileged, or --security-opt no-new-privileges), with the
  #   inheritable and ambient sets empty:
  #   - CAP_CHOWN, CAP_DAC_OVERRIDE, CAP_FOWNER, CAP_FSETID, CAP_MKNOD, CAP_SETFCAP, CAP_SETUID:
  #     virtiofsd keeps these for serving the VM's file operations, and fails to start without any
  #     of them (it sets its capabilities with capset, which fails unless all are permitted).
  #   - CAP_SETGID, CAP_SYS_CHROOT: virtiofsd's sandbox (dropping supplementary groups, and
  #     --sandbox=chroot).
  #   - CAP_NET_ADMIN: the container's network configuration (ip, nft) and QEMU's tap devices.
  #   - CAP_NET_BIND_SERVICE: dnsmasq's port 53, where the engine does not set
  #     net.ipv4.ip_unprivileged_port_start to 0 in the container's network namespace.
  # - engine: Docker's default capabilities and CAP_NET_ADMIN, added to those the container was
  #   given.
  # RUNCVM_SYS_ADMIN=1 adds CAP_SYS_ADMIN, for virtiofsd's --modcaps=+sys_admin and mke2fs's
  # copying of trusted.* xattrs. The exec command gives 'docker exec' processes the minimal sets.
  RUNCVM_CAPS="$(get_config_env 'RUNCVM_CAPS')"
  [ -z "$RUNCVM_CAPS" ] || config_env_is RUNCVM_CAPS "$RUNCVM_CAPS" ||
    error "RUNCVM_CAPS invalid (should be minimal or engine)"
  case "$RUNCVM_CAPS" in
    ''|minimal) jq_set "$CFG" --argjson caps "$RUNCVM_MINIMAL_CAPS" ".process.capabilities = $RUNCVM_CAPS_EXACTLY" ;;
    engine) jq_set "$CFG" --argjson caps "$RUNCVM_ENGINE_CAPS" ".process.capabilities |= ($RUNCVM_CAPS_ADD)" ;;
    *) error "RUNCVM_CAPS '$RUNCVM_CAPS' invalid (should be minimal or engine)" ;;
  esac
  if config_env_is RUNCVM_SYS_ADMIN 1; then
    jq_set "$CFG" --argjson caps '["CAP_SYS_ADMIN"]' ".process.capabilities |= ($RUNCVM_CAPS_ADD)"
  fi

  # RunCVM's processes in the container run with no_new_privs, whatever the container was given
  # (docker run --security-opt no-new-privileges): none of them gains privileges by executing a
  # setuid or setgid file, or one with file capabilities. They run as root, with the same
  # capabilities in the bounding, effective and permitted sets (above), so that each execve leaves
  # them those they hold, with no_new_privs as without it.
  jq_set "$CFG" '.process.noNewPrivileges = true'

  # CONFIGURE ENVIRONMENT
  # This must remain the last change to config.json: it follows every set_config_env, and the
  # placement of runcvm-ctr-entrypoint in process.args[0].
  #
  # Pass the workload's environment to runcvm-ctr-entrypoint as arguments, following its own
  # path: a count N, then N NAME=VALUE entries, before the original entrypoint and command.
  # Each entry being an argument of its own, it has the same size limit as an environment
  # string. Then reduce the environment to RunCVM's own (see runcvm_env above).
  jq_set "$CFG" \
    --slurpfile env <(printf '%s' "$WORKLOAD_ENV") \
    --arg path "$RUNCVM_GUEST_PATH" \
    "$RUNCVM_ENV_JQ"'
      .process.args = [.process.args[0], ($env[0] | length | tostring)] + $env[0] + .process.args[1:]
      | .process.env |= runcvm_env($path)'

  debug && busybox cp -a $CFG "$RUNCVM_DEBUG_DIR/config.json-$$-2"
  
elif [ "$COMMAND" = "exec" ]; then

  debug && log "Command: exec"

  # USAGE:
  #   runc exec [command options] <container-id> <command> [command options]  || -p process.json <container-id>
  #
  # PARSE 'exec' COMMAND OPTIONS
  # --console-socket value             path to an AF_UNIX socket which will receive a file descriptor referencing the master end of the console's pseudoterminal
  # --cwd value                        current working directory in the container
  # --env value, -e value              set environment variables
  # --tty, -t                          allocate a pseudo-TTY
  # --user value, -u value             UID (format: <uid>[:<gid>])
  # --additional-gids value, -g value  additional gids
  # --process value, -p value          path to the process.json
  # --detach, -d                       detach from the container's process
  # --pid-file value                   specify the file to write the process id to
  # --process-label value              set the asm process label for the process commonly used with selinux
  # --apparmor value                   set the apparmor profile for the process
  # --no-new-privs                     set the no new privileges value for the process
  # --cap value, -c value              add a capability to the bounding set for the process
  # --preserve-fds value               Pass N additional file descriptors to the container (stdio + $LISTEN_FDS + N in total) (default: 0)
  # --cgroup value                     run the process in an (existing) sub-cgroup(s). Format is [<controller>:]<cgroup>.
  # --ignore-paused                    allow exec in a paused container    
  while true
  do
    case "$1" in
      --console-socket|--cwd|--env|-e|--user|-u|--additional-gids|-g|--pid-file|--process-label|--apparmor|--cap|-c|--preserve-fds|--cgroup) shift; shift; continue; ;;
      --tty|-t|--detach|-d|--no-new-privs|--ignore-paused) shift; continue; ;;
      --process|-p) shift; PROCESS="$1"; continue; ;;
      *) break; ;;
    esac
  done

  # Allow user to enable debug logging
  if [ "$(get_process_env "$PROCESS" 'RUNCVM_RUNTIME_DEBUG' '0')" = "1" ]; then
    enable_debug
  fi

  if debug; then
    log "Command line: $0 ${COMMAND_LINE[@]@Q}"
    log "Command: exec process=$PROCESS"
    
    # Save formatted process.json
    jq -r . <$PROCESS >"$RUNCVM_DEBUG_DIR/process.json-$$-1"
  fi

  ARG1=$(jq_get "$PROCESS" '.args[0]')
  if [ "$ARG1" = "---" ]; then
    # 'docker exec <container> --- <command>' runs <command> in the container, on the host, rather
    # than in the VM, as 'docker exec' would in a standard container (with the capabilities the
    # engine gives it), for debugging and diagnostics; only where the host enables it, with
    # RUNCVM_EXEC_PASSTHROUGH=1 in RUNCVM_HOST_SETTINGS, as it reaches outside the VM's isolation.
    case "$(get_host_setting RUNCVM_EXEC_PASSTHROUGH 0)" in
      1) ;;
      0) error "'docker exec <container> --- <command>' is disabled on this host (RUNCVM_EXEC_PASSTHROUGH=1 in $RUNCVM_HOST_SETTINGS enables it)" ;;
      *) error "RUNCVM_EXEC_PASSTHROUGH in $RUNCVM_HOST_SETTINGS invalid (should be 0 or 1)" ;;
    esac
    jq_set "$PROCESS" 'del(.args[0])'
  else
    # The exec's process, which relays the command to the VM, runs on the host, in the container,
    # with RunCVM's own fixed set of capabilities (the minimal set), whatever the engine gave it
    # (e.g. docker exec --privileged, or the container's --cap-add) and whatever the container's or
    # the exec's RUNCVM_CAPS and RUNCVM_SYS_ADMIN: no more than the container's init holds in any
    # mode. It runs with no_new_privs, as the container's init does.
    jq_set "$PROCESS" --argjson caps "$RUNCVM_MINIMAL_CAPS" ".capabilities = $RUNCVM_CAPS_EXACTLY | .noNewPrivileges = true"

    uidgid=$(jq_get "$PROCESS" '(.user.uid | tostring) + ":" + (.user.gid | tostring) + ":" + ((.user.additionalGids // []) | join(","))')
    cwd=$(jq_get "$PROCESS" '.cwd')
    hasHome=$(get_process_env_boolean "$PROCESS" 'HOME')
    wantsTerminal=$(jq_get "$PROCESS" '.terminal')

    # Pass the command's environment to runcvm-ctr-exec as arguments (a count N, then N
    # NAME=VALUE entries, before the command), and reduce the environment to RunCVM's own (see
    # runcvm_env above).
    jq_set "$PROCESS" \
      --arg exec "$RUNCVM_EXEC" \
      --arg uidgid "$uidgid" \
      --arg cwd "$cwd" \
      --arg hasHome "$hasHome" \
      --arg wantsTerminal "$wantsTerminal" \
      --arg path "$RUNCVM_GUEST_PATH" \
      "$RUNCVM_ENV_JQ"'
        (.env // []) as $env
        | .args |= [$exec, $uidgid, $cwd, $hasHome, $wantsTerminal, ($env | length | tostring)] + $env + .
        | .env = ($env | runcvm_env($path))'

    # Force root (or whatever user qemu runs as)
    # Force cwd in the container to / 
    jq_set "$PROCESS" '.user = {"uid":0, "gid":0} | .cwd="/"'
  fi
  
  debug && busybox cp -a $PROCESS "$RUNCVM_DEBUG_DIR/process.json-$$-2"
fi

debug && log "--- LOG ENDS ---"

PATH="$HOST_PATH" exec "$RUNC" "${COMMAND_LINE[@]}"
