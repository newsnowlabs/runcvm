#!/.runcvm/guest/bin/bash

# Load config
. /.runcvm/config

# Load defaults and aliases
. $RUNCVM_GUEST/scripts/runcvm-ctr-defaults

OPTS=(--retry-path --statedir /.runcvm --pidfile /.runcvm/qemu-ga.pid)

# Find the guest agent's virtio-serial port by the name runcvm-ctr-qemu gives it, in sysfs: the
# /dev/virtio-ports/<name> links exist only where udev or mdev made them, and the agent's port is
# not necessarily the first /dev/vport* device. The virtio-serial driver adds the ports, and
# devtmpfs their device nodes, after the VM's PID 1 may have started this script, so wait for both
# for up to 10 seconds: without --init, nothing starts this script again.
find_dev() {
  local port

  for port in /sys/class/virtio-ports/*
  do
    [ "$(cat "$port/name" 2>/dev/null)" = "org.qemu.guest_agent.0" ] && [ -c "/dev/${port##*/}" ] &&
      DEV="/dev/${port##*/}" && return 0
  done
  return 1
}

DEV=
for (( i = 0; i < 100; i++ ))
do
  find_dev && break
  busybox sleep 0.1
done

[ -n "$DEV" ] || exit 0

OPTS+=(-p "$DEV")

# qemu-ga reads its configuration from $QGA_CONF (default /etc/qemu/qemu-ga.conf, in the image).
# RunCVM ships no such file, and qemu-ga silently uses its defaults when the file is missing.
exec -c "$RUNCVM_GUEST/bin/busybox" env QGA_CONF="$RUNCVM_GUEST/etc/qemu/qemu-ga.conf" "$(which qemu-ga)" "${OPTS[@]}"
