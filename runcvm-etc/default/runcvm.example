# RunCVM's host settings: NAME=VALUE lines that apply to every Container/VM on the host, and that
# no container can override. Other lines, such as blank lines and comments starting '#', are
# ignored. The file is read, never sourced, so quotes are part of a value: write
# RUNCVM_EXEC_PASSTHROUGH=1, not RUNCVM_EXEC_PASSTHROUGH="1".
#
# RunCVM reads two files, in this order:
#
# - /opt/runcvm/etc/default/runcvm: for settings distributed in a package image built from
#   RunCVM's. An install or upgrade replaces it with the image's, or removes it if the image has
#   none, so it is not for settings made by hand.
# - /etc/default/runcvm: the host's own settings, which an install or upgrade never changes.
#
# Where a setting is set more than once, the last line counts, so /etc/default/runcvm overrides
# /opt/runcvm/etc/default/runcvm.
#
# To use this example on a host, copy it to /etc/default/runcvm and remove '#' from the settings
# to set.

# 'docker exec <container> --- <command>' runs <command> in the container on the host, alongside
# QEMU and virtiofsd, outside the VM's isolation, for debugging and diagnostics: 1 enables it,
# 0 (the default) disables it.
#RUNCVM_EXEC_PASSTHROUGH=0
