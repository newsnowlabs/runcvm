     }
 
@@ -327,14 +393,34 @@ impl<F: FileSystem + SerializableFileSystem + Send + Sync + 'static> VhostUserFs
         Ok(())
     }
 
-    /// Polls `vring_state`'s queue for up to `self.queue_poll`, returning true as soon as the
-    /// guest has made a new request available, and false once the time is up.
-    fn poll_queue(&self, vring_state: &mut VringState<LoggedMemoryAtomic>) -> bool {
+    /// The window to poll the request queue for now.
+    fn poll_window(&self) -> Duration {
+        match self.queue_poll {
+            QueuePoll::None => Duration::ZERO,
+            QueuePoll::Fixed(window) => window,
+            QueuePoll::Adaptive(_) => self.poll_state.lock().unwrap().window.current,
+        }
+    }
+
+    /// With adaptive polling, adjusts the window for a request that arrived after polling, if
+    /// any, gave up: the queue ran dry at `dry`.
+    fn poll_missed(&self, dry: Instant) {
+        if matches!(self.queue_poll, QueuePoll::Adaptive(_)) {
+            self.poll_state.lock().unwrap().window.missed(dry.elapsed());
+        }
+    }
+
+    /// Polls `vring_state`'s queue until `deadline`, returning true as soon as the guest has made
+    /// a new request available, and false once the time is up.
+    fn poll_queue(
+        &self,
+        vring_state: &mut VringState<LoggedMemoryAtomic>,
+        deadline: Instant,
+    ) -> bool {
         let mem = match &self.mem {
             Some(m) => m.memory(),
             None => return false,
         };
-        let deadline = Instant::now() + self.queue_poll;
         loop {
             let queue = vring_state.get_queue();
             match queue.avail_idx(&*mem, Ordering::Acquire) {
@@ -365,7 +451,16 @@ impl<F: FileSystem + SerializableFileSystem + Send + Sync + 'static> VhostUserFs
             }
             _ => return Err(Error::HandleEventUnknownEvent.into()),
         };
-        let poll = device_event == REQ_QUEUE_EVENT && !self.queue_poll.is_zero();
+        let poll = device_event == REQ_QUEUE_EVENT && self.queue_poll != QueuePoll::None;
+        if poll {
+            // The guest notified virtiofsd of this request after it went back to waiting.
+            // Take `dry_since` before adjusting the window: `poll_missed()` locks `poll_state`
+            // itself, so the lock must not be held across the call.
+            let dry_since = self.poll_state.lock().unwrap().dry_since.take();
+            if let Some(dry) = dry_since {
+                self.poll_missed(dry);
+            }
+        }
 
         if self.event_idx {
             // vm-virtio's Queue implementation only checks avail_index
@@ -381,12 +476,23 @@ impl<F: FileSystem + SerializableFileSystem + Send + Sync + 'static> VhostUserFs
                 // While notifications are disabled, the guest adds requests without notifying
                 // (which costs it a VM exit, and virtiofsd a wake-up), so keep watching the
                 // request queue for a while before going back to waiting.
-                if poll && self.poll_queue(&mut vring_state) {
-                    continue;
+                let dry = Instant::now();
+                if poll {
+                    let window = self.poll_window();
+                    if !window.is_zero() && self.poll_queue(&mut vring_state, dry + window) {
+                        continue;
+                    }
                 }
                 if !vring_state.enable_notification().unwrap() {
+                    if poll {
+                        self.poll_state.lock().unwrap().dry_since = Some(dry);
+                    }
                     break;
                 }
+                // A request arrived between polling giving up and notifications being enabled.
+                if poll {
+                    self.poll_missed(dry);
+                }
             }
         } else {
             // Without EVENT_IDX, a single call is enough.
@@ -426,7 +532,7 @@ struct PremigrationThread {
 #[derive(Debug, Default)]
 pub struct VhostUserFsBackendBuilder {
     thread_pool_size: usize,
-    queue_poll: Duration,
+    queue_poll: QueuePoll,
