+
+/// How virtiofsd polls the request queue after it runs dry, before waiting for the guest to
+/// notify it of the next request.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum QueuePoll {
+    /// Wait at once.
+    #[default]
+    None,
+    /// Poll for this long each time.
+    Fixed(Duration),
+    /// Poll for a window that adapts to how closely requests follow one another, of at most this
+    /// long (see `PollWindow`).
+    Adaptive(Duration),
+}
+
+/// An adaptive polling window. It starts at zero; it grows (to `START`, then doubling, up to
+/// `max`) when the next request arrives after polling has given up, but within `max` of the queue
+/// running dry, as a longer window would have caught it; it halves (to zero below `START`) when the
+/// next request takes longer than `max`, as no window would have; and it stays as it is when
+/// polling catches the request.  So a guest issuing requests in quick succession is polled for, and
+/// an idle guest, or one whose requests are far apart, is not.
+#[derive(Debug, PartialEq, Eq)]
+struct PollWindow {
+    current: Duration,
+    max: Duration,
+}
+
+impl PollWindow {
+    const START: Duration = Duration::from_micros(4);
+
+    fn new(max: Duration) -> Self {
+        PollWindow {
+            current: Duration::ZERO,
+            max,
+        }
+    }
+
+    /// Adjusts the window after the next request arrived `waited` after the queue ran dry, with
+    /// polling for the current window not catching it.
+    fn missed(&mut self, waited: Duration) {
+        if waited > self.max {
+            self.current /= 2;
+            if self.current < Self::START {
+                self.current = Duration::ZERO;
+            }
+        } else if waited > self.current {
+            self.current = std::cmp::max(self.current * 2, Self::START).min(self.max);
+        }
+    }
+}
+
+#[derive(Debug)]
+struct PollState {
+    window: PollWindow,
+    dry_since: Option<Instant>,
 }
 
 impl<F: FileSystem + SerializableFileSystem + Send + Sync + 'static> VhostUserFsThread<F> {
-    fn new(fs: F, thread_pool_size: usize, queue_poll: Duration) -> Result<Self> {
