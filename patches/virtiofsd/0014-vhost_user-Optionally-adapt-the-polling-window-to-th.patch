+    #[test]
+    fn queue_poll_options() {
+        use QueuePollMode::{Adaptive, Fixed};
+        let us = Duration::from_micros;
+        assert_eq!(queue_poll(None, None), Ok(QueuePoll::None));
+        assert_eq!(queue_poll(None, Some(0)), Ok(QueuePoll::None));
+        assert_eq!(queue_poll(None, Some(20)), Ok(QueuePoll::Fixed(us(20))));
+        assert_eq!(
+            queue_poll(Some(QueuePollMode::None), Some(20)),
+            Ok(QueuePoll::None)
+        );
+        assert_eq!(queue_poll(Some(Fixed), None), Ok(QueuePoll::Fixed(us(50))));
