-    /// guest to notify. Polling applies without a thread pool only; zero, the default, disables
-    /// it.
-    pub fn set_queue_poll(mut self, duration: Duration) -> Self {
-        self.queue_poll = duration;
+    /// Set how to poll the request queue after it runs dry, before waiting for the guest to
+    /// notify. Polling applies without a thread pool only; the default is not to poll.
+    pub fn set_queue_poll(mut self, queue_poll: QueuePoll) -> Self {
+        self.queue_poll = queue_poll;
         self
     }
 
