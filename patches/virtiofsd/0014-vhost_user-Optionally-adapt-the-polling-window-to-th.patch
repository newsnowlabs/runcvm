 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const fn us(n: u64) -> Duration {
+        Duration::from_micros(n)
+    }
+
+    #[test]
+    fn poll_window_grows_while_requests_follow_closely() {
+        let mut w = PollWindow::new(us(50));
+        for expected in [4, 8, 16, 32, 50, 50] {
+            w.missed(us(40));
+            assert_eq!(w.current, us(expected));
+        }
+    }
+
+    #[test]
+    fn poll_window_grows_only_as_far_as_needed() {
+        let mut w = PollWindow::new(us(1000));
+        w.missed(us(3));
+        assert_eq!(w.current, us(4));
+        // A wait within the current window means polling would have caught it.
+        w.missed(us(4));
+        assert_eq!(w.current, us(4));
+    }
+
+    #[test]
+    fn poll_window_shrinks_to_zero_when_requests_are_far_apart() {
+        let mut w = PollWindow::new(us(50));
+        w.current = us(50);
+        for expected in [25, 12, 6, 0, 0] {
+            w.missed(us(51));
+            assert_eq!(w.current.as_micros(), expected);
+        }
+    }
+
+    #[test]
+    fn poll_window_stays_at_zero_while_idle() {
+        let mut w = PollWindow::new(us(50));
+        w.missed(Duration::from_secs(10));
+        assert_eq!(w.current, Duration::ZERO);
+    }
+}
