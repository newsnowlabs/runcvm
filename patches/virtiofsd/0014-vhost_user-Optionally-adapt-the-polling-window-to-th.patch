+#[derive(Clone, Copy, Debug, PartialEq, Eq, clap::ValueEnum)]
+enum QueuePollMode {
+    None,
+    Fixed,
+    Adaptive,
+}
+
+const DEFAULT_QUEUE_POLL_US: u64 = 50;
+
+/// The queue polling that `--queue-poll` and `--queue-poll-us` ask for.
+fn queue_poll(
+    mode: Option<QueuePollMode>,
+    window_us: Option<u64>,
+) -> std::result::Result<QueuePoll, String> {
+    let window = Duration::from_micros(window_us.unwrap_or(DEFAULT_QUEUE_POLL_US));
+    let queue_poll = match mode {
+        Some(QueuePollMode::None) => return Ok(QueuePoll::None),
+        None if window_us.unwrap_or(0) == 0 => return Ok(QueuePoll::None),
+        None | Some(QueuePollMode::Fixed) => QueuePoll::Fixed(window),
+        Some(QueuePollMode::Adaptive) => QueuePoll::Adaptive(window),
+    };
+    if window.is_zero() {
+        return Err("--queue-poll=fixed or adaptive needs a --queue-poll-us above 0".to_string());
+    }
+    Ok(queue_poll)
+}
