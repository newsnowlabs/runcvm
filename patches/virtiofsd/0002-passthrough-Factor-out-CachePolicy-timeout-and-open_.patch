+#[cfg(test)]
+mod cache_policy_tests {
+    use super::*;
+    use CachePolicy::*;
+
+    #[test]
+    fn open_options_match_previous_global_behaviour() {
+        let d = OpenOptions::DIRECT_IO;
+        let k = OpenOptions::KEEP_CACHE;
+        let c = OpenOptions::CACHE_DIR;
+        for (p, dir, want) in [
+            (Never, false, d),
+            (Never, true, OpenOptions::empty()),
+            (Metadata, false, d),
+            (Metadata, true, c | k),
+            (Auto, false, OpenOptions::empty()),
+            (Auto, true, OpenOptions::empty()),
+            (Always, false, k),
+            (Always, true, k | c),
+        ] {
+            assert_eq!(p.open_options(dir), want, "{p:?} dir={dir}");
+        }
+        assert_eq!(Never.timeout(), Duration::from_secs(0));
+        assert_eq!(Metadata.timeout(), Duration::from_secs(86400));
+        assert_eq!(Auto.timeout(), Duration::from_secs(1));
+        assert_eq!(Always.timeout(), Duration::from_secs(86400));
+    }
+}
