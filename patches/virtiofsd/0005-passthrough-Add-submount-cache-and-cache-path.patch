+    /// Cache policy (`None` meaning `cfg.cache_policy`) for the mount with ID `mnt_id` and unique
+    /// mount ID `unique_id` (if the kernel provides one).  The caller must hold an FD on the mount,
+    /// which keeps it, and so its ID, from going away while we look it up.  Mounts are matched by
+    /// their mount point when first seen; with unique mount IDs (Linux 6.8+) the result is
+    /// remembered for the mount's lifetime.
+    fn mount_cache_policy(&self, mnt_id: MountId, unique_id: Option<u64>) -> Option<CachePolicy> {
+        if mnt_id == self.root_mnt_id.load(Ordering::Relaxed) {
+            return None;
+        }
+        if let Some(id) = unique_id {
+            if let Some(policy) = self.mount_policies.read().unwrap().get(&id) {
+                return *policy;
+            }
