+    /// Read /proc/self/mountinfo (as seen when the sandbox was set up).  We only use pread(),
+    /// so concurrent readers do not disturb each other.
+    fn read_mountinfo(&self) -> io::Result<Vec<u8>> {
+        let file = self
+            .mountinfo
+            .as_ref()
+            .ok_or_else(|| other_io_error("No mountinfo"))?;
+        let mut buf = Vec::new();
+        let mut chunk = vec![0u8; 16384];
+        loop {
+            let n = file.read_at(&mut chunk, buf.len() as u64)?;
+            if n == 0 {
+                break;
+            }
+            buf.extend_from_slice(&chunk[..n]);
+        }
+        Ok(buf)
+    }
