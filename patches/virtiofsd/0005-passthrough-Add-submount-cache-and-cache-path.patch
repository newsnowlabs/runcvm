+
+    /// How much the guest may cache: never < metadata < auto < always.
+    fn caching_rank(&self) -> u8 {
+        match self {
+            CachePolicy::Never => 0,
+            CachePolicy::Metadata => 1,
+            CachePolicy::Auto => 2,
+            CachePolicy::Always => 3,
+        }
+    }
+}
+
+/// Normalise a `--cache-path` path lexically: it must be absolute; `//`, `.` and a trailing `/`
+/// are dropped and `..` is applied, but must not climb above the shared directory.  Symbolic
+/// links are deliberately not resolved: the path is matched against mount points as the kernel
+/// records them, which never contain symbolic links.  The shared directory itself (`/`) is
+/// rejected, as its policy is `--cache`.  Paths are bytes, as the kernel's are.
+pub fn normalize_cache_path(path: &[u8]) -> Result<Vec<u8>, String> {
+    let show = path.escape_ascii();
+    if !path.starts_with(b"/") {
+        return Err(format!("\"{show}\" is not an absolute path"));
+    }
+    let mut components: Vec<&[u8]> = Vec::new();
+    for c in path.split(|b| *b == b'/') {
+        match c {
+            b"" | b"." => {}
+            b".." => {
+                if components.pop().is_none() {
+                    return Err(format!("\"{show}\" leads outside the shared directory"));
+                }
+            }
+            c => components.push(c),
+        }
+    }
+    if components.is_empty() {
+        return Err(format!(
+            "\"{show}\" is the shared directory itself; use --cache for its policy"
+        ));
+    }
+    let mut normalized = Vec::with_capacity(path.len());
+    for c in components {
+        normalized.push(b'/');
+        normalized.extend_from_slice(c);
+    }
+    Ok(normalized)
+}
+
+/// Parse a `--cache-path` argument, `PATH=POLICY`.
+pub fn parse_cache_path(arg: &[u8]) -> Result<(Vec<u8>, CachePolicy), String> {
+    let show = arg.escape_ascii();
+    let eq = arg
+        .iter()
+        .rposition(|b| *b == b'=')
+        .ok_or_else(|| format!("\"{show}\": expected PATH=POLICY"))?;
+    let policy = std::str::from_utf8(&arg[eq + 1..])
+        .ok()
+        .and_then(|p| CachePolicy::from_str(p).ok())
+        .ok_or_else(|| format!("\"{show}\": invalid cache policy"))?;
+    Ok((normalize_cache_path(&arg[..eq])?, policy))
+}
+
+/// Find the policy of the longest configured path that is `rel` or a path-segment prefix of it
+/// (`/a` covers `/a`, `/a/b`, `/a/b/c`, but not `/ab`).  `rel` must be normalised.
+fn match_cache_path(paths: &HashMap<Vec<u8>, CachePolicy>, rel: &[u8]) -> Option<CachePolicy> {
+    let mut p = rel;
+    loop {
+        if let Some(policy) = paths.get(p) {
+            return Some(*policy);
+        }
+        match p.iter().rposition(|b| *b == b'/') {
+            Some(i) if i > 0 => p = &p[..i],
+            _ => return None,
+        }
+    }
+}
+
+/// Undo the octal escapes (`\040` etc.) in a /proc/self/mountinfo field.  Only `\` followed by
+/// three octal digits forming a byte value (`\000` to `\377`) is an escape; anything else is
+/// copied as it is.
+fn unescape_mountinfo(field: &[u8]) -> Vec<u8> {
+    let octal = |c: u8| (b'0'..=b'7').contains(&c);
+    let mut out = Vec::with_capacity(field.len());
+    let mut i = 0;
+    while i < field.len() {
+        match field[i..] {
+            [b'\\', a @ b'0'..=b'3', b, c, ..] if octal(b) && octal(c) => {
+                out.push(((a - b'0') << 6) | ((b - b'0') << 3) | (c - b'0'));
+                i += 4;
+            }
+            _ => {
+                out.push(field[i]);
+                i += 1;
+            }
+        }
+    }
+    out
+}
+
+/// Find the mount point of mount `mnt_id` in the contents of /proc/self/mountinfo.
+fn find_mount_point(mountinfo: &[u8], mnt_id: MountId) -> Option<Vec<u8>> {
+    mountinfo.split(|b| *b == b'\n').find_map(|line| {
+        let mut columns = line.split(|b| *b == b' ');
+        let id: MountId = std::str::from_utf8(columns.next()?).ok()?.parse().ok()?;
+        if id != mnt_id {
+            return None;
+        }
+        // Skip parent mount ID, major:minor and root within the filesystem
+        columns.nth(3).map(unescape_mountinfo)
+    })
+}
+
+/// Turn a mount point as given in mountinfo into a path relative to the shared directory, which
+/// mountinfo shows as `prefix`.  Returns `None` if the mount point is the shared directory itself
+/// or lies outside it.
+fn relative_mount_point<'a>(mount_point: &'a [u8], prefix: &[u8]) -> Option<&'a [u8]> {
+    let mut prefix = prefix;
+    while let [rest @ .., b'/'] = prefix {
+        prefix = rest;
+    }
+    let rel = mount_point.strip_prefix(prefix)?;
+    (rel.starts_with(b"/") && rel.len() > 1).then_some(rel)
+}
+
+/// Cache policy of a mount, other than the shared directory's own, whose mount point relative to
+/// the shared directory is `rel`.  `None` in the result stands for the file system's default
+/// policy (`--cache`).
+///
+/// Precedence: the longest `--cache-path` that is `rel` or a path-segment prefix of it; else
+/// `--submount-cache`; else `--cache`.
+fn resolve_mount_policy(
+    paths: &HashMap<Vec<u8>, CachePolicy>,
+    submount_cache: Option<CachePolicy>,
+    rel: &[u8],
+) -> Option<CachePolicy> {
+    match_cache_path(paths, rel).or(submount_cache)
+}
+
+/// The policy that caches least among `default`, `submount_cache` and the configured paths'
+/// policies: what to use for a mount whose mount point cannot be found out.
+fn most_conservative_policy(
+    default: CachePolicy,
+    submount_cache: Option<CachePolicy>,
+    paths: &HashMap<Vec<u8>, CachePolicy>,
+) -> CachePolicy {
+    std::iter::once(default)
+        .chain(submount_cache)
+        .chain(paths.values().copied())
+        .min_by_key(CachePolicy::caching_rank)
+        .unwrap_or(default)
 }
 
