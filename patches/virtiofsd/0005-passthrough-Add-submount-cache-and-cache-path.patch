+/// `STATX_MNT_ID_UNIQUE` (Linux 6.8+); not in all libc crates yet.
+const STATX_MNT_ID_UNIQUE: u32 = 0x4000;
+
+/// Return the unique (never reused) mount ID of the mount `fd` is on, or `None` if the kernel
+/// does not provide one (before Linux 6.8).
+pub fn mount_id_unique(fd: &impl AsRawFd) -> Option<u64> {
+    let mut stx_ui = MaybeUninit::<statx_st>::zeroed();
+    // Safe because this is a constant value and a valid C string.
+    let path = unsafe { CStr::from_bytes_with_nul_unchecked(EMPTY_CSTR) };
+    // Safe because the kernel will only write data in `stx_ui` and we check the return value.
+    let res = unsafe {
+        do_statx(
+            fd.as_raw_fd(),
+            path.as_ptr(),
+            libc::AT_EMPTY_PATH | libc::AT_SYMLINK_NOFOLLOW,
+            STATX_MNT_ID_UNIQUE,
+            stx_ui.as_mut_ptr(),
+        )
+    };
+    if res < 0 {
+        return None;
+    }
+    // Safe because the kernel has initialised it (or it is still zeroed).
+    let stx = unsafe { stx_ui.assume_init() };
+    (stx.stx_mask & STATX_MNT_ID_UNIQUE != 0).then_some(stx.stx_mnt_id)
+}
