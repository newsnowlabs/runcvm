+    /// Warn about configured cache paths that (as things stand) cannot match, because they
+    /// lead through a symbolic link, and about a host without mount IDs.
+    fn check_cache_paths(&self) {
+        if !self.per_mount_cache() {
+            return;
+        }
+        let Ok(root) = openat(
+            &libc::AT_FDCWD,
+            self.cfg.root_dir.as_str(),
+            libc::O_PATH | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+        ) else {
+            return;
+        };
+        if statx(&root, None).map(|st| st.mnt_id).unwrap_or(0) == 0 {
+            warn!("Mount IDs are not available; per-mount cache policies will not take effect");
+        }
+        for path in self.cache_paths.keys() {
+            let Ok(c_path) = CString::new(&path[1..]) else {
+                continue;
+            };
+            // SAFETY: all-zero byte-pattern represents a valid `libc::open_how`
+            let mut how: libc::open_how = unsafe { std::mem::zeroed() };
+            how.flags = (libc::O_PATH | libc::O_CLOEXEC) as u64;
+            how.resolve = libc::RESOLVE_BENEATH | libc::RESOLVE_NO_SYMLINKS;
+            // SAFETY: `c_path` is a valid C string and `how` a valid `open_how`; we check the
+            // return value and close the FD if we get one.
+            let fd = unsafe {
+                libc::syscall(
+                    libc::SYS_openat2,
+                    root.as_raw_fd(),
+                    c_path.as_ptr(),
+                    std::ptr::addr_of!(how),
+                    std::mem::size_of::<libc::open_how>(),
+                )
+            };
+            if fd >= 0 {
+                // Safe because we just opened this fd; dropping the `File` closes it.
+                drop(unsafe { File::from_raw_fd(fd as RawFd) });
+            } else if io::Error::last_os_error().raw_os_error() == Some(libc::ELOOP) {
+                warn!(
+                    "Cache path {}: leads through a symbolic link; mount points are matched by \
+                    their real paths, so this cache path will not match mounts reached through it",
+                    path.escape_ascii()
+                );
+            }
+        }
+    }
