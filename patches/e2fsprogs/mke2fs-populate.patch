+/*
+ * Exclusions (mke2fs -x) and staying on one file system
+ * (POPULATE_FS_ONE_FILE_SYSTEM) while populating
+ */
+#define MAX_POPULATE_EXCLUDES 256
+static const char *populate_excludes[MAX_POPULATE_EXCLUDES];
+static int populate_num_excludes;
+static dev_t populate_root_dev;
+
+errcode_t populate_fs_add_exclude(const char *pattern)
+{
+	if (populate_num_excludes == MAX_POPULATE_EXCLUDES)
+		return EXT2_ET_NO_MEMORY;
+	populate_excludes[populate_num_excludes++] = pattern;
+	return 0;
+}
+
+/*
+ * path is the file's path in the new file system, e.g. "/var/cache"; flags
+ * are the POPULATE_FS_* flags
+ */
+static int populate_pruned(const char *path, const struct stat *st, int flags)
+{
+	int i;
+
+	if ((flags & POPULATE_FS_ONE_FILE_SYSTEM) &&
+	    st->st_dev != populate_root_dev)
+		return 1;
+	for (i = 0; i < populate_num_excludes; i++)
+		if (fnmatch(populate_excludes[i], path, FNM_PATHNAME) == 0)
+			return 1;
+	return 0;
+}
