+/*
+ * Save and restore the working directory around populating the file system.
+ * An O_PATH descriptor, where available, needs no read permission on the
+ * directory.
+ */
+static int save_cwd(void)
+{
+#ifdef O_PATH
+	int fd = open(".", O_PATH | O_DIRECTORY);
+#else
+	int fd = open(".", O_RDONLY | O_DIRECTORY);
+#endif
+
+	if (fd < 0) {
+		com_err(program_name, errno, "%s",
+			_("while saving working directory"));
+		exit(1);
+	}
+	return fd;
+}
+
+static void restore_cwd(int fd)
+{
+	if (fchdir(fd) < 0) {
+		com_err(program_name, errno, "%s",
+			_("while restoring working directory"));
+		exit(1);
+	}
+}
