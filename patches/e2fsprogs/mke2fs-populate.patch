+/*
+ * Copy the contents of directory 'source' into a new top-level directory
+ * 'subdir' of the filesystem, giving 'subdir' the ownership, mode, times and
+ * xattrs of 'source'. Used for mke2fs -P SUBDIR=SRC. Paths below 'subdir'
+ * start with "/subdir", as in the new file system. Like populate_fs3(), this
+ * changes the working directory.
+ */
+errcode_t populate_fs_subdir(ext2_filsys fs, const char *source,
+			     const char *subdir, int flags,
+			     struct fs_ops_callbacks *fs_callbacks)
+{
+	struct file_info file_info;
+	struct hdlinks_s hdlinks;
+	struct stat st;
+	ext2_ino_t ino;
+	errcode_t retval;
+
+	if (!*subdir || strchr(subdir, '/') || !strcmp(subdir, ".") ||
+	    !strcmp(subdir, "..")) {
+		com_err(__func__, EINVAL,
+			_("subdirectory \"%s\" must be a single path component"),
+			subdir);
+		return EINVAL;
+	}
+	if (stat(source, &st)) {
+		retval = errno;
+		com_err(__func__, retval, _("while calling stat on %s"), source);
+		return retval;
+	}
+	if (!S_ISDIR(st.st_mode)) {
+		com_err(__func__, ENOTDIR, _("%s is not a directory"), source);
+		return ENOTDIR;
+	}
+
+	retval = do_mkdir_internal(fs, EXT2_ROOT_INO, subdir, 0, EXT2_ROOT_INO);
+	if (retval)
+		return retval;
+	retval = ext2fs_namei(fs, EXT2_ROOT_INO, EXT2_ROOT_INO, subdir, &ino);
+	if (retval) {
+		com_err(__func__, retval, _("while looking up \"%s\""), subdir);
+		return retval;
+	}
+	retval = set_inode_extra(fs, ino, &st);
+	if (retval)
+		return retval;
+	if ((flags & POPULATE_FS_NO_COPY_XATTRS) == 0) {
+		retval = set_inode_xattr(fs, ino, source);
+		if (retval)
+			return retval;
+	}
+	populate_root_dev = st.st_dev;
+
+	hdlinks.count = 0;
+	hdlinks.size = HDLINK_CNT;
+	hdlinks.hdl = realloc(NULL, hdlinks.size * sizeof(struct hdlink_s));
+	if (hdlinks.hdl == NULL)
+		return errno;
+	file_info.path_len = 0;
+	file_info.path_max_len = 255;
+	file_info.path = calloc(file_info.path_max_len, 1);
+	if (file_info.path == NULL) {
+		free(hdlinks.hdl);
+		return EXT2_ET_NO_MEMORY;
+	}
+	retval = path_append(&file_info, subdir);
+	if (retval) {
+		free(file_info.path);
+		free(hdlinks.hdl);
+		return retval;
+	}
+
+	link_append_flag = EXT2FS_LINK_EXPAND;
+	link_append_flag |= (flags & POPULATE_FS_LINK_APPEND) ?
+		EXT2FS_LINK_APPEND : 0;
+
+	/* An excluded subdir is left empty, like any excluded directory */
+	if (!populate_pruned(file_info.path, &st, flags))
+		retval = __populate_fs(fs, ino, source, EXT2_ROOT_INO, &hdlinks,
+				       &file_info, flags, fs_callbacks);
+
+	free(file_info.path);
+	free(hdlinks.hdl);
+	link_append_flag = EXT2FS_LINK_EXPAND;
+	return retval;
+}
