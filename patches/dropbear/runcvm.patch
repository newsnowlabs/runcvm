+/* Fill in the authstate for RUNCVM_USER, the only user the server accepts.
+ * The image's /etc/passwd and /etc/shadow are not read: they may be absent, or
+ * give the user a home directory that does not exist or a shell that cannot
+ * run commands. The user's password is locked. */
+static void fill_runcvm_user(const char* username) {
+	if (strcmp(username, RUNCVM_USER) != 0) {
+		return;
+	}
+	ses.authstate.pw_uid = 0;
+	ses.authstate.pw_gid = 0;
+	ses.authstate.pw_name = m_strdup(RUNCVM_USER);
+	ses.authstate.pw_dir = m_strdup("/");
+	ses.authstate.pw_shell = m_strdup(RUNCVM_SHELL);
+	ses.authstate.pw_passwd = m_strdup("!!");
+}
