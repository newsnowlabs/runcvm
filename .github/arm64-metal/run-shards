#!/bin/bash
# Runs on an arm64 metal host (see launch), in its RunCVM checkout, over SSH: runs the tests in
# SHARDS shards at once, each a tests/run --shard I/SHARDS with results in $RESULTS/shard-I,
# prefixing each line of a shard's output with "[I/SHARDS]". Exits 1 if any shard fails.
#
# Usage: run-shards SHARDS RESULTS [tests/run arguments...]
#
# On a c6g.metal (64 CPUs, 128 GB), 8 shards of up to RUNCVM_TEST_JOBS=3 Container/VMs each
# keep the host busy without overcommitting it: with more, the load passes twice the CPU count,
# and tests start to time out.

shards=$1 results=$2
shift 2
cd "$HOME/runcvm" || exit 1
export RUNCVM_TEST_JOBS=${RUNCVM_TEST_JOBS:-3}
echo "Host: $(nproc) CPUs, $(free -g | awk '/^Mem:/ { print $2 }') GB; $(git log -1 --format='%h %s')"
echo "Running tests/run $* in $shards shards of up to $RUNCVM_TEST_JOBS Container/VMs each"

pids=()
for i in $(seq 1 "$shards"); do
  (
    set -o pipefail
    tests/run "$@" --shard "$i/$shards" --results "$results/shard-$i" 2>&1 | sed -u "s|^|[$i/$shards] |"
  ) &
  pids+=($!)
done
status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
