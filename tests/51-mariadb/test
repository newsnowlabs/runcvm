#!/bin/bash -e

# Load framework functions (vm_opts); the cleanup functions below replace its own
. ../framework.sh

NODE=51-mariadb

nodes() {
  echo $NODE-mysqld $NODE-mysql
}

volumes() {
  echo ''
}

networks() {
  echo $NODE-network
}

_cleanup() {
  echo "> ($h) Cleaning up nodes ..."
  docker rm -f $(nodes) 2>/dev/null
  echo

  if [ "$(volumes)" != "" ]; then
    echo "> ($h) Cleaning up volumes ..."
    docker volume rm -f $(volumes)
  fi
  echo

  if [ -n "$IMAGE" ]; then
    echo "> ($h) Cleaning up temporary image ..."
    docker rmi $IMAGE
    echo
  fi
  
  rm -f /tmp/iid
  
  if [ "$(networks)" != "" ]; then
    echo "> ($h) Cleaning up networks ..."
    docker network rm $(networks)
  fi
  echo

  echo "> ($h) Cleaned up"
}

cleanup() {
  # Allow this to complete, even if we encounter errors
  set +e

  _cleanup
  
  # Restore setting to fail on error
  set -e
}

quit() {
  # Don't run a second time
  trap '' TERM INT EXIT
  
  cleanup

  echo "> ($h) Exiting with code $ERRORS"
}

trap quit TERM INT EXIT

h=$(hostname)

cleanup

echo "> ($h) Creating network $NODE-network ..."
docker network rm $(networks) 2>/dev/null || true
docker network create $NODE-network

# Launch a mariadb VM using RunCVM, with 1 CPU and 1G of memory unless the runner gives a size
# (--vm-cpus, --vm-memory): vm_opts follows those defaults, so that Docker takes its values.
# Nothing outside the VM changes its files, so it suits any cache policy the runner gives.
echo "> ($h) Launch RunCVM mariadb server as $NODE-mysqld ..."
docker run --runtime=${RUNTIME:-runcvm} --cpus=1 --memory=1G $(vm_opts) -d --rm --name=$NODE-mysqld --hostname=$NODE-mysqld --network=$NODE-network --env=MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=1 mariadb

echo "> ($h) Monitoring mariadb logs ..."
docker logs -f -t -n 0 $NODE-mysqld &

# Allow final test to complete, even if we encounter errors
set +e

# Seconds to wait for mariadb to accept connections: much longer under software emulation
if [ "$RUNCVM_TEST_ACCEL" = "tcg" ]; then WAIT=600; else WAIT=40; fi

# Launch a standard runc container from which to connect to the mariadb VM. It uses the mariadb
# image, which includes the mariadb client, so that the test does not depend on installing a
# client from the internet at run time.
echo "> ($h) Launching a standard container as client $NODE-mysql ..."
docker run -d --rm --runtime=runc --network=$NODE-network --name=$NODE-mysql --hostname=$NODE-mysql --entrypoint=sleep mariadb infinity

# Run the mariadb client in the client container against the mariadb VM, with the given arguments
mariadb_client() {
  docker exec $NODE-mysql mariadb --skip-ssl-verify-server-cert -u root -h $NODE-mysqld mysql "$@"
}

echo "> ($h) Waiting for mariadb startup and running test queries in the standard container ..."
wait_for "mysqld on $NODE-mysqld to accept connections" $WAIT mariadb_client -e ""
mariadb_client -e "select count(*) from user"
ERRORS=$?

echo "> ($h) Completed $NODE test with $ERRORS errors"

# bash -i

sleep 1
exit $ERRORS
