# Restarts a held volume's own mount units, then its ancestor's, printing what follows each.
SYSTEMD_PROBE = ('echo "failed=$(systemctl --failed --no-legend | wc -l)"; '
                 'systemctl restart home-v.mount && [ -e /home/v/.vol ] && echo restart_own=yes; '
                 'echo own >/home/v/own; '
                 'systemctl restart "$(systemd-escape -p --suffix=mount "/home/w x")" && '
                 'mountpoint -q "/home/w x" && echo restart_spaced=yes; '
                 # systemd restarts home-v.mount, which requires home.mount, in a job of its own, which
                 # 'systemctl restart home.mount' does not wait for.
                 'systemctl restart home.mount; a=lost; for i in $(seq 20); do [ -e /home/v/.vol ] && a=kept && break; '
                 'sleep 0.5; done; echo ancestor=$a; '
                 'echo "failed_after=$(systemctl --failed --no-legend | wc -l)"')


def run_systemd(case):
    mode, has_fstab = case
    name = "systemd-%s-%s" % (mode, "fstab" if has_fstab else "nofstab")
    vol = seed_volume(name + "-vol", {".vol": ""})
    disks = t.unique(name + "-disks")
    t.volume_create(disks)
    container = t.unique(name)
    t.cleanup_container(container)
    r = t.docker("run", "-d", "--name", container, *t.labels(), "--runtime=" + t.RUNTIME, *t.vm_opts(),
                 "--mount", "type=volume,src=%s,dst=/disks" % disks, "--mount", "type=volume,src=%s,dst=/home/v" % vol,
                 "-v", SPACED, "--env", "RUNCVM_DISKS=/disks/a,/home,ext4,64M", "--env", "RUNCVM_FSTAB=" + mode,
                 fstab_image if has_fstab else SYSTEMD_IMAGE)
    if r.returncode != 0 or not t.wait_for_exec(container, BOOT_TIMEOUT) or not t.wait_for(
            "systemd running in %s" % container, BOOT_TIMEOUT,
            ["docker", "exec", container, "sh", "-c", "systemctl is-system-running | grep -E 'running|degraded'"]):
        return {"error": r.stdout + t.docker("logs", container).stdout}
    if mode == "disks":
        r = t.docker("exec", container, "sh", "-c", 'echo "failed=$(systemctl --failed --no-legend | wc -l)"; '
                     '[ -e /home/v/.vol ] && echo vol=yes; [ -e /etc/fstab ] && echo etc=yes || echo etc=no')
    else:
        r = t.docker("exec", container, "sh", "-c", SYSTEMD_PROBE)
    failed = t.docker("exec", container, "systemctl", "--failed", "--no-legend").stdout
    t.docker("rm", "-f", container)
    return {"values": values(r), "failed": failed, "own": t.volume_read(vol, "own")}


for (mode, has_fstab), result in zip(SYSTEMD, t.parallel(run_systemd, SYSTEMD)):
    name = "systemd, RUNCVM_FSTAB=%s, image %s /etc/fstab" % (mode, "with" if has_fstab else "without")
    if not t.check("%s: booted" % name, True, "error" not in result):
        t.log("output:\n%s" % result["error"])
        continue
    v = result["values"]
    if not t.check("%s: no failed units" % name, "0", v.get("failed")):
        t.log("failed units:\n%s" % result["failed"])
    if mode == "disks":
        t.check("%s: the held volume is mounted" % name, "yes", v.get("vol"))
        t.check("%s: /etc/fstab" % name, "yes" if has_fstab else "no", v.get("etc"))
        continue
    t.check("%s: restarting the volume's mount unit mounts it again" % name, "yes", v.get("restart_own"))
    t.check("%s: a write to it then reaches the volume" % name, "own\n", result["own"])
    t.check("%s: restarting the mount unit of a volume at a path with a space" % name, "yes", v.get("restart_spaced"))
    t.check("%s: restarting the ancestor's mount unit mounts it again" % name, "kept", v.get("ancestor"))
    if not t.check("%s: no failed units after the restarts" % name, "0", v.get("failed_after")):
        t.log("failed units:\n%s" % result["failed"])

