# The exclusion matrix: a disk at /usr/share, of each filesystem and layout, with a volume, a
# bind-mounted directory and file, a tmpfs mount and another disk below it. Prints, for what the disk
# holds (UNDER): each of vol, bdir, tmp and apk as '<type>:<entries>'; bfile as '<type>:<size>', or
# 'none'; and whether the image's udhcpc/default.script was copied. Then, in the VM: each mount's
# marker.
MATRIX_PROBE = (UNDER +
                'for e in vol bdir tmp apk; do p=/tmp/under/$e; '
                'if [ -d "$p" ]; then echo "$e=dir:$(ls -A "$p" | wc -l)"; else echo "$e=none"; fi; done; '
                'p=/tmp/under/bfile; if [ -f "$p" ]; then echo "bfile=file:$(stat -c %s "$p")"; '
                'elif [ -e "$p" ]; then echo bfile=other; else echo bfile=none; fi; '
                '[ -f /tmp/under/udhcpc/default.script ] && echo script=copied || echo script=missing; '
                'echo "vm_vol=$(ls -A /usr/share/vol)"; echo "vm_bdir=$(ls /usr/share/bdir | grep -cx runcvm-ctr-qemu)"; '
                '[ -s /usr/share/bfile ] && echo vm_bfile=1; echo "vm_tmp=$(stat -f -c %T /usr/share/tmp)"; '
                'echo "vm_keys=$(ls /usr/share/apk/keys | wc -l)"')
MATRIX = [(fs, layout) for fs in ("ext4", "xfs", "btrfs") for layout in ("subdirs", "root")]


def run_matrix(case):
    fs, layout = case
    name = "matrix-%s-%s" % case
    disks = "/disks/a,/usr/share,%s,%s,layout=%s;/disks/b,/usr/share/apk,ext4,16M" % (fs, SIZE[fs], layout)
    opts = mount_opts(["--mount", "type=volume,src={vol},dst=/usr/share/vol",
                       "--mount", "type=bind,src=/opt/runcvm/scripts,dst=/usr/share/bdir,readonly",
                       "--mount", "type=bind,src=/opt/runcvm/LICENSE,dst=/usr/share/bfile,readonly",
                       "--mount", "type=tmpfs,dst=/usr/share/tmp"], name)
    return vm(name, disks, opts, MATRIX_PROBE, "/usr/share")


for (fs, layout), r in zip(MATRIX, t.parallel(run_matrix, MATRIX)):
    name = "%s, layout %s" % (fs, layout)
    if not t.check("%s: exit status" % name, 0, r.returncode):
        t.log("output:\n%s" % r.stdout)
        continue
    v = values(r)
    for e, what in (("vol", "volume"), ("bdir", "bind-mounted directory"), ("tmp", "tmpfs mount"),
