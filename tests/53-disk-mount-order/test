def runc(volume, script):
    t.docker("run", "--rm", "--runtime=runc", "--network=none", *t.labels(), "-v", "%s:/disks" % volume,
             "alpine", "sh", "-c", script, check=True)


# What the disk holds at its destination "$1": its entries, and state.img's contents, if any.
BACKING_PROBE = UNDER + 'echo "entries=$(ls -A /tmp/under | tr "\\n" " ")"; echo "state=$(cat /tmp/under/state.img 2>/dev/null)"'
BACKING = [(case, fs) for case in ("own", "other", "dangling", "prefixed", "unrelated") for fs in ("ext4", "xfs")]


def run_backing(case):
    kind, fs = case
    name = "backing-%s-%s" % case
    size = SIZE[fs]
    if kind in ("own", "other", "dangling"):
        shared = t.unique(name + "-shared")
        t.volume_create(shared)
        disks = "/disks/state.img,/data,%s,%s" % (fs, size)
        if kind == "other":
            disks = "/disks/a.img,/data,%s,%s;/disks/state.img,/other,ext4,16M" % (fs, size)
        if kind == "dangling":
            runc(shared, "ln -s state.img /disks/link.img")
            disks = "/disks/link.img,/data,%s,%s" % (fs, size)
        return vm(name, disks, ["--mount", "type=volume,src=%s,dst=/data" % shared], BACKING_PROBE, "/data",
                  disks_volume=shared)
    if kind == "prefixed":
        return vm(name, "/vm/srv/state.img,/srv,%s,%s" % (fs, size), [], BACKING_PROBE, "/srv")
    seed = seed_volume(name + "-seed", {"state.img": "seed"})
    return vm(name, "/data/state.img,/data,%s,%s" % (fs, size), ["--mount", "type=volume,src=%s,dst=/data" % seed],
              BACKING_PROBE, "/data")


for (kind, fs), r in zip(BACKING, t.parallel(run_backing, BACKING)):
