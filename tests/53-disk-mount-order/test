# Prints, for each path given, its device number, its filesystem type, and 'volume' if it holds .vol
# (a test volume's file), 'bind' if it holds LICENSE (the host's /opt/runcvm), or '-'.
PROBE = ('for p in "$@"; do m=-; [ -e "$p/.vol" ] && m=volume; [ -e "$p/LICENSE" ] && m=bind; '
         'echo "$p $(stat -c %d "$p") $(stat -f -c %T "$p") $m"; done')

FSTAB_MODES = [(False, "disks"), (True, "disks"), (False, "all")]


def run_layered(case):
    (name, disks, opts, expected), (init, fstab) = case
    name += "-%s-%s" % ("init" if init else "noinit", fstab)
    paths = list(expected) + ["/.runcvm/disks/%d" % n for n in range(disks.count(";") + 1)]
    return vm("layered-" + name, disks, mount_opts(opts, "layered-" + name), PROBE, *paths, init=init,
              env=["RUNCVM_FSTAB=" + fstab])


LAYERED_RUNS = [(case, mode) for case in LAYERED for mode in FSTAB_MODES]
t.param("init", "no, yes")
t.param("RUNCVM_FSTAB", "disks, all")
for ((name, disks, opts, expected), (init, fstab)), r in zip(LAYERED_RUNS, t.parallel(run_layered, LAYERED_RUNS)):
    name += ", %s, RUNCVM_FSTAB=%s" % ("--init" if init else "no --init", fstab)
    if not t.check("%s: exit status" % name, 0, r.returncode):
        t.log("output:\n%s" % r.stdout)
        continue
    probed = {}
    for line in r.stdout.replace("\r", "").splitlines():
        fields = line.split()
        if len(fields) == 4:
            probed[fields[0]] = (fields[1], fields[2], fields[3])
    disk_devices = [probed[p][0] for p in probed if p.startswith("/.runcvm/disks/")]
    for path, where in expected.items():
        dev, fstype, marker = probed.get(path, (None, None, None))
        if where == "tmpfs":
            t.check("%s: %s is the tmpfs mount" % (name, path), "tmpfs", fstype)
        elif where == "root":
            t.check("%s: %s is the whole-root disk" % (name, path), "ext2/ext3", fstype)
        elif where in ("volume", "bind"):
            kind = "volume" if where == "volume" else "bind mount"
            t.check("%s: %s is the %s, not on a disk" % (name, path, kind), True,
                    marker == where and fstype != "tmpfs" and dev not in disk_devices)
        else:
            disk = probed.get("/.runcvm/disks/%d" % where, (None, None, None))[0]
            t.check("%s: %s is on disk %d" % (name, path, where), True, disk is not None and dev == disk)

# --- Population ---------------------------------------------------------------------------------

