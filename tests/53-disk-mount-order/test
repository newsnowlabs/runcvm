        continue
    v = values(r)
    t.check("%s: outer disk's directory for /usr/share/apk is empty" % name, "", v.get("entries", "?").strip())
    t.check("%s: and has the image's directory's mode" % name, "755", v.get("mode"))
    t.check("%s: /usr/share/apk/keys, on the inner disk, holds the image's keys" % name, True,
            v.get("keys", "0").strip() not in ("", "0"))

# The exclusion matrix: a disk at /usr/share, of each filesystem and layout, with a volume, a
# bind-mounted directory and file, a tmpfs mount and another disk below it. Prints, for what the disk
# holds (UNDER): each of vol, bdir, tmp and apk as '<type>:<entries>'; bfile as '<type>:<size>', or
# 'none'; and whether the image's udhcpc/default.script was copied. Then, in the VM: each mount's
# marker.
MATRIX_PROBE = (UNDER +
                'for e in vol bdir tmp apk; do p=/tmp/under/$e; '
                'if [ -d "$p" ]; then echo "$e=dir:$(ls -A "$p" | wc -l)"; else echo "$e=none"; fi; done; '
                'p=/tmp/under/bfile; if [ -f "$p" ]; then echo "bfile=file:$(stat -c %s "$p")"; '
                'elif [ -e "$p" ]; then echo bfile=other; else echo bfile=none; fi; '
                '[ -f /tmp/under/udhcpc/default.script ] && echo script=copied || echo script=missing; '
                'echo "vm_vol=$(ls -A /usr/share/vol)"; echo "vm_bdir=$(ls /usr/share/bdir | grep -cx runcvm-ctr-qemu)"; '
                '[ -s /usr/share/bfile ] && echo vm_bfile=1; echo "vm_tmp=$(stat -f -c %T /usr/share/tmp)"; '
                'echo "vm_keys=$(ls /usr/share/apk/keys | wc -l)"')
MATRIX = [(fs, layout) for fs in ("ext4", "xfs", "btrfs") for layout in ("subdirs", "root")]


def run_matrix(case):
    fs, layout = case
    name = "matrix-%s-%s" % case
    disks = "/disks/a,/usr/share,%s,%s,layout=%s;/disks/b,/usr/share/apk,ext4,16M" % (fs, SIZE[fs], layout)
    opts = mount_opts(["--mount", "type=volume,src={vol},dst=/usr/share/vol",
                       "--mount", "type=bind,src=/opt/runcvm/scripts,dst=/usr/share/bdir,readonly",
                       "--mount", "type=bind,src=/opt/runcvm/LICENSE,dst=/usr/share/bfile,readonly",
                       "--mount", "type=tmpfs,dst=/usr/share/tmp"], name)
    return vm(name, disks, opts, MATRIX_PROBE, "/usr/share")


for (fs, layout), r in zip(MATRIX, t.parallel(run_matrix, MATRIX)):
    name = "%s, layout %s" % (fs, layout)
    if not t.check("%s: exit status" % name, 0, r.returncode):
        t.log("output:\n%s" % r.stdout)
        continue
    v = values(r)
    for e, what in (("vol", "volume"), ("bdir", "bind-mounted directory"), ("tmp", "tmpfs mount"),
                    ("apk", "other disk's destination")):
        t.check("%s: disk holds an empty directory at the %s" % (name, what), "dir:0", v.get(e))
    t.check("%s: disk holds an empty file at the bind-mounted file" % name, "file:0", v.get("bfile"))
    t.check("%s: disk holds the image's other files" % name, "copied", v.get("script"))
    t.check("%s: VM: the volume" % name, ".vol", v.get("vm_vol"))
    t.check("%s: VM: the bind-mounted directory" % name, "1", v.get("vm_bdir"))
    t.check("%s: VM: the bind-mounted file" % name, "1", v.get("vm_bfile"))
    t.check("%s: VM: the tmpfs mount" % name, "tmpfs", v.get("vm_tmp"))
    t.check("%s: VM: the other disk holds the image's keys" % name, True, v.get("vm_keys", "0") not in ("", "0"))

# A disk at a volume's destination, with another volume below it on the same host filesystem.
SEEDED_PROBE = UNDER + 'echo "entries=$(ls -A /tmp/under | tr "\\n" " ")"; echo "b=$(ls -A /tmp/under/b | wc -l)"; ' \
                       'echo "vm_b=$(ls -A /data/b)"'
SEEDED = ["ext4", "xfs"]


def run_seeded(fs):
    name = "seeded-" + fs
    a = seed_volume(name + "-a", {"a.txt": "a"})
    b = seed_volume(name + "-b", {".vol": ""})
    return vm(name, "/disks/a,/data,%s,%s" % (fs, SIZE[fs]),
              ["--mount", "type=volume,src=%s,dst=/data" % a, "--mount", "type=volume,src=%s,dst=/data/b" % b],
              SEEDED_PROBE, "/data")


for fs, r in zip(SEEDED, t.parallel(run_seeded, SEEDED)):
    name = "disk at a volume, volume below it, " + fs
    if not t.check("%s: exit status" % name, 0, r.returncode):
        t.log("output:\n%s" % r.stdout)
        continue
    v = values(r)
    t.check("%s: disk holds the first volume's files" % name, ["a.txt", "b"], sorted(v.get("entries", "").split()))
    t.check("%s: and an empty directory for the second" % name, "0", v.get("b"))
    t.check("%s: VM: the second volume" % name, ".vol", v.get("vm_b"))

# A disk at /etc.
ETC_PROBE = (UNDER + '[ "$(cat /etc/hostname)" = h53 ] && echo hostname=ok; grep -q h53 /etc/hosts && echo hosts=ok; '
             'grep -q nameserver /etc/resolv.conf && echo resolv=ok; [ -s /tmp/under/passwd ] && echo passwd=ok; '
             'for f in hostname hosts resolv.conf; do p=/tmp/under/$f; '
             'if [ -e "$p" ]; then echo "disk_$f=$(stat -c %s "$p")"; else echo "disk_$f=none"; fi; done')
ETC = ["ext4", "xfs"]

for fs, r in zip(ETC, t.parallel(lambda fs: vm("etc-" + fs, "/disks/a,/etc,%s,%s" % (fs, SIZE[fs]),
                                               ["--hostname", "h53"], ETC_PROBE, "/etc"), ETC)):
    name = "disk at /etc, " + fs
    if not t.check("%s: exit status" % name, 0, r.returncode):
        t.log("output:\n%s" % r.stdout)
        continue
    v = values(r)
    for key in ("hostname", "hosts", "resolv", "passwd"):
        t.check("%s: %s" % (name, {"passwd": "disk holds the image's /etc/passwd"}.get(key, "Docker's /etc/" + key)),
                "ok", v.get(key))
    for f in ("hostname", "hosts", "resolv.conf"):
        t.check("%s: disk holds an empty file at /etc/%s" % (name, f), "0", v.get("disk_" + f))

# --- Encoding -----------------------------------------------------------------------------------

ODD = ["a b", "c\\d", "e\\040f", "n\\nl", "caf\u00e9", "\u65e5\u672c"]
ODD_TMPFS = "tm p"
# For each path given after the disk's destination: 'ok' if it is a mountpoint, and the disk holds a
# directory there (where a disk's destination is given, else '-').
