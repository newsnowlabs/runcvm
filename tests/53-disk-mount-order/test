    ("outer-disk-last-symlink", "/disks/b,/run/b,ext4,16M;/disks/a,/var/run,ext4,16M", [],
     {"/run": 1, "/run/b": 0}),
    ("three-deep", "/disks/c,/srv/a/b,ext4,16M;/disks/a,/srv,ext4,16M;/disks/b,/srv/a,ext4,16M", [],
     {"/srv": 1, "/srv/a": 2, "/srv/a/b": 0}),
    ("tmpfs-above-disk", "/disks/b,/home/b,ext4,16M", ["--mount", "type=tmpfs,dst=/home"],
