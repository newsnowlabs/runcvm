#!/usr/bin/env python3
"""RUNCVM_DISKS: the order of the VM's mounts, what new disks hold, and RUNCVM_FSTAB.

- Nested disks, tmpfs mounts, volumes and bind mounts: nested disks in
  either order in RUNCVM_DISKS (including through the image's symbolic link
  /var/run), a tmpfs mount, a volume or a bind mount above a disk, a tmpfs
  mount below a disk, a tmpfs mount, a volume or a bind mount between two
  disks, a tmpfs mount below a volume below a disk, a volume below a disk
  below a volume or a tmpfs mount, a volume below a tmpfs mount, a disk at a
  volume's or a bind mount's destination (also where that disk is below
  another disk, or below a tmpfs mount), a volume reached through the
  image's symbolic link /var/run, a whole-root disk with a disk, volume and
  tmpfs mount, and destinations sharing only a prefix (/home and /homes):
  the Container/VM runs, with and without --init, and with RUNCVM_FSTAB=all,
  and each path is on the intended disk, tmpfs mount, volume or bind mount,
  as a deeper mount is mounted over a shallower one, and a disk over a
  volume or bind mount at its destination.
- A new disk leaves out another disk's destination below its own, holding
  an empty directory there with the directory's mode, whichever is listed
  first, for an ext4 and an xfs outer disk (populated by mke2fs and in the
  VM): with disks at /usr/share and /usr/share/apk, the outer disk's apk
  directory is empty, and /usr/share/apk, on the inner disk, holds the
  image's keys.
- What a new disk holds below its destination, for ext4, xfs and btrfs, and
  layouts 'subdirs' and 'root': an empty directory at a volume, a
  bind-mounted directory, a tmpfs mount and another disk; at a bind-mounted
  file, an empty file (which the VM creates as its mountpoint, the copy
  leaving the file out); and the image's other files. In the VM, each mount
  is in place.
- A new disk at a volume's destination, with another volume (on the same
  host filesystem) below it, holds the first volume's files and an empty
  directory for the second.
- A disk at /etc, ext4 and xfs: Docker's /etc/hostname, /etc/hosts and
  /etc/resolv.conf stay mounted over it, and the disk holds no copy of them,
  only an empty file as each one's mountpoint.
- Paths with spaces, backslashes, a literal '\\040', a backslash followed by
  'n', and UTF-8 characters: volumes (and a tmpfs mount) at such paths below
  an ext4 and an xfs disk, below an xfs disk with a whole-root disk
  (populated before the root switch, so after the volumes were accessed),
  and carried onto a whole-root disk, are each mounted at their paths, and a
  disk at their parent holds an empty directory at each.
- Control characters: a volume at a path with a newline, a file
  bind-mounted at one with a tab, a tmpfs mount at one with 0x7F, and a disk
  backing file with a newline are each rejected, with the path shown
  escaped, and nothing is created.
- Disk backing files below a destination, for ext4 and xfs: one volume at
  both /disks and /data, with a disk /disks/state.img at /data: the disk
  holds no state.img; likewise another disk's backing file in that volume,
  and a backing file named through a dangling symbolic link to state.img;
  a backing file under /vm (the image's view in the container) below its
  own destination is left out; and a volume's unrelated file with a
  backing file's name, at the container path of that backing file, is kept.
  Disks whose backing files are reached through symbolic links to paths
  with a space and a ',' start, mounted, when created and when reused.
- Invalid plans create nothing, and change no existing disk: a later disk
  without a size, or with a malformed one; a backing file path that is
  relative, or has a '.' or '..' component (including '..' after a directory
  not yet created, naming an existing disk); a 'root'-layout destination
  with whitespace or '..'; two disks with one backing file, by one path
  spelt two ways, through one volume mounted at two paths (neither file
  existing yet, at /disks and /disks/alias), through a dangling symbolic
  link, or as hard links; two existing disks with one UUID; a new ext4 disk
  with 257 mounts to leave out below its destination, or with 65
  destinations. Each is rejected, with exit status 1, naming the spec, and
  the disks' volume holds no new or changed file.
- An existing disk with changed mounts: created with a volume below it, then
  used without it (an empty directory remains on the disk), then with a
  tmpfs mount there.
- A whole-root disk with a new xfs disk: the xfs disk is populated from the
  image.
- RUNCVM_FSTAB: with 'disks', /.runcvm/fstab marks a held volume with a
  '#runcvm-held' comment, /.runcvm/submounts is gone, and an image without
  /etc/fstab is left without one; with 'all', it lists the volume as a bind
  mount from /.runcvm/submounts, mounted over /etc/fstab (created if the image
  lacks one), and 'mount -a' mounts an unmounted held volume again, writes to
  it reaching the volume. Under systemd (almalinux/9-init, with and without
  an image /etc/fstab): no failed units, in both modes; with 'all', restarting
  a held volume's own mount unit (also one at a path with a space) mounts it
  again, writes reaching the volume, and so does restarting its ancestor's
  unit (home.mount). An invalid RUNCVM_FSTAB is rejected.

Specs that are invalid in themselves, or together, and the planner's
held mounts, exclusions and manifests, are checked without a VM by
tests/54-disk-planner.
"""

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

TIMEOUT = 600 if t.ACCEL == "tcg" else 180
BOOT_TIMEOUT = 600 if t.ACCEL == "tcg" else 120
SIZE = {"ext4": "64M", "xfs": "320M", "btrfs": "128M"}  # mkfs.xfs needs 300M; mkfs.btrfs 109M.
SYSTEMD_IMAGE = "almalinux/9-init"


def seed_volume(name, files):
    """Create a labelled volume holding 'files' ({path: contents})."""
    volume = t.unique(name)
    t.volume_create(volume)
    script = "; ".join("printf %%s '%s' >'/v/%s'" % (body, path) for path, body in files.items())
    t.docker("run", "--rm", "--runtime=runc", "--network=none", *t.labels(), "-v", "%s:/v" % volume,
             "alpine", "sh", "-c", script or "true", check=True)
    return volume


def mount_opts(opts, name):
    """Return docker run options 'opts' with each {vol} and {vol2} replaced by a new volume's name,
    each volume holding a file .vol."""
    result = []
    for opt in opts:
        for key in ("vol", "vol2"):
            if "{%s}" % key in opt:
                opt = opt.replace("{%s}" % key, seed_volume("%s-%s" % (name, key), {".vol": ""}))
        result.append(opt)
    return result


def vm(name, disks, opts, script, *args, image="alpine", init=False, env=(), disks_volume=None):
    """Run 'script' (sh -c) with 'args' in a new Container/VM with RUNCVM_DISKS 'disks', a volume at
    /disks (new, unless 'disks_volume' is given) and further options 'opts'."""
    if disks_volume is None:
        disks_volume = t.unique(name + "-disks")
        t.volume_create(disks_volume)
    return t.docker("run", "--rm", "--name", t.unique(name), *t.labels(), "--runtime=" + t.RUNTIME,
                    *t.vm_opts(), *(["--init"] if init else []),
                    "--mount", "type=volume,src=%s,dst=/disks" % disks_volume, *opts,
                    *["--env=" + e for e in env], "--env", "RUNCVM_DISKS=" + disks,
                    image, "sh", "-c", script, "sh", *args, timeout=TIMEOUT)


def values(r):
    """The key=value lines of a result's output, as a dict."""
    return dict(line.split("=", 1) for line in r.stdout.replace("\r", "").splitlines() if "=" in line)


# Binds the mount at "$1" (a disk's destination) non-recursively at /tmp/under, showing what the
# disk itself holds there, without the mounts below it.
UNDER = 'mkdir -p /tmp/under && mount --bind "$1" /tmp/under && shift; '

# --- Layering ---------------------------------------------------------------------------------

