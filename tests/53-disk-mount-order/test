    ("xfs-outer-last", "/disks/b,/usr/share/apk,ext4,16M;/disks/a,/usr/share,xfs,320M", 1),
]

# Prints the entries of the outer disk's directory for /usr/share/apk, then its mode, then the
# number of entries in /usr/share/apk/keys.
POPULATED_PROBE = ('d=/.runcvm/disks/$1/usr-share/apk; echo "entries=$(ls -A "$d" | tr "\\n" " ")"; '
                   'echo "mode=$(stat -c %a "$d")"; '
                   'echo "keys=$(ls /usr/share/apk/keys | wc -l)"')

for (name, disks, outer), r in zip(POPULATED, t.parallel(
        lambda c: vm("populated-" + c[0], c[1], [], POPULATED_PROBE, str(c[2])), POPULATED)):
    if not t.check("%s: exit status" % name, 0, r.returncode):
