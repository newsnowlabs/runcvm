# {vol} and {vol2} in the options is a new volume holding a file .vol; the bind mounts are of the
# host's /opt/runcvm, which holds LICENSE and a directory scripts, so that a disk below the bind
# mount is at an existing directory, and nothing is created on the host.
LAYERED = [
    ("outer-disk-first", "/disks/a,/home,ext4,16M;/disks/b,/home/b,ext4,16M", [],
     {"/home": 0, "/home/b": 1}),
    ("outer-disk-last", "/disks/b,/home/b,ext4,16M;/disks/a,/home,ext4,16M", [],
