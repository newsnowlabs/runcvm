#!/usr/bin/env python3
"""RUNCVM_DISKS: creating, formatting, prepopulating and mounting disks.

- A disk whose backing file does not exist is created at the given size,
  formatted with the given filesystem, and mounted in the VM at its
  destination.
- A new disk is prepopulated with the image's existing contents at its
  destination.
- Several disks, separated by ';', are each mounted.
- A backing file may be in the container's own filesystem or in a volume.
- /disks, where backing files are usually kept, is mounted only in the
  container, not in the VM.
- A pre-existing backing file whose filesystem has a label of its own (made
  here with RunCVM's own mke2fs, from /opt/runcvm) is mounted at its
  destination, with its contents at its root.
- With RUNCVM_DISK_IOTHREADS=4, a disk of a 2-vCPU Container/VM, which has
  two queues, is served by two I/O threads (at most one per queue), and
  data written to it reads back.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

BOOT_TIMEOUT = 600 if t.ACCEL == "tcg" else 120

volume = t.unique("disks")
t.volume_create(volume)
name = t.unique("disks")
t.cleanup_container(name)

# A pre-existing labelled disk, /disks/labelled, holding the file 'marker'.
t.docker("run", "--rm", *t.labels(), "--runtime=runc", "--network=none", "-v", volume + ":/disks",
         "-v", "/opt/runcvm:/.runcvm/guest:ro", "alpine", "sh", "-c",
         "mkdir /src && echo labelled >/src/marker && truncate -s 32M /disks/labelled && "
         "MKE2FS_CONFIG=/.runcvm/guest/etc/mke2fs.conf /.runcvm/guest/sbin/mke2fs -q -F -t ext4 "
         "-L runcvm-label -d /src /disks/labelled", check=True)

# /disks/one in the volume, mounted at /data (new, empty); /disks/two in the volume, mounted at
# /etc/apk (prepopulated from the image); /disk-overlay in the container's filesystem;
# /disks/labelled, pre-existing, mounted at /labelled.
disks = ";".join(["/disks/one,/data,ext4,64M", "/disks/two,/etc/apk,ext4,32M", "/disk-overlay,/extra,ext4,32M",
                  "/disks/labelled,/labelled,ext4"])
t.docker("run", "-d", "--name", name, *t.labels(), "--runtime=" + t.RUNTIME, *t.vm_opts(),
         "--mount", "type=volume,src=%s,dst=/disks" % volume, "--env", "RUNCVM_DISKS=" + disks,
         "alpine", "sleep", "600", check=True)
if not t.wait_for_exec(name, BOOT_TIMEOUT):
    t.check("Container/VM started", True, False)
    t.finish()


def ex(*cmd):
    return t.docker("exec", name, *cmd).stdout.strip()


for dst in ("/data", "/etc/apk", "/extra", "/labelled"):
    t.check("%s is a mount point" % dst, True, t.docker("exec", name, "mountpoint", "-q", dst).returncode == 0)
    t.check("%s is mounted as ext4" % dst, "ext4", ex("awk", "$2 == \"%s\" { print $3 }" % dst, "/proc/mounts"))

# The backing file has exactly the requested size; the filesystem in it is smaller, by its own
# overhead (journal and metadata).
backing = t.docker("run", "--rm", "--runtime=runc", *t.labels(), "-v", volume + ":/v:ro",
                   "alpine", "stat", "-c", "%s", "/v/one").stdout.strip()
t.check("backing file /disks/one is 64M", str(64 * 1024 * 1024), backing)
blocks, bsize = (ex("stat", "-f", "-c", "%b %S", "/data").split() + ["0", "0"])[:2]
size_mb = int(blocks) * int(bsize) // (1024 * 1024)
t.check("/data filesystem is over 40M of the 64M disk (got %dM)" % size_mb, True, 40 < size_mb <= 64)

t.check("/etc/apk prepopulated from the image", True, "alpine" in ex("cat", "/etc/apk/repositories"))
t.check("/data starts empty", "", ex("ls", "-A", "/data"))
t.check("/labelled holds the pre-existing disk's contents", "labelled", ex("cat", "/labelled/marker"))
t.check("/disks is not visible in the VM", False, t.docker("exec", name, "test", "-e", "/disks/one").returncode == 0)
t.check("backing files created in the volume", "labelled one two",
        " ".join(sorted((t.docker("run", "--rm", "--runtime=runc", *t.labels(), "-v", volume + ":/v:ro",
                                  "alpine", "ls", "/v").stdout.split()))))

# RUNCVM_DISK_IOTHREADS: a 2-vCPU Container/VM's disk has two queues, so at most two I/O threads.
io_name = t.unique("disks-iothreads")
t.cleanup_container(io_name)
t.docker("run", "-d", "--name", io_name, *t.labels(), "--runtime=" + t.RUNTIME, *t.vm_opts(), "--cpus=2",
         "--env=RUNCVM_DISK_IOTHREADS=4", "--env=RUNCVM_DISKS=/disks/io,/io,ext4,64M",
         "alpine", "sleep", "600", check=True)
if t.check("RUNCVM_DISK_IOTHREADS=4: Container/VM started", True, t.wait_for_exec(io_name, BOOT_TIMEOUT)):
    qemu = [line for line in t.docker("top", io_name).stdout.splitlines() if "qemu-system" in line]
    iothreads = sorted(set(w.split(",")[1] for line in qemu for w in line.split()
                           if w.startswith("iothread,id=ioth0-")))
    t.check("RUNCVM_DISK_IOTHREADS=4 with 2 vCPUs: the disk's I/O threads", ["id=ioth0-0", "id=ioth0-1"], iothreads)
    r = t.docker("exec", io_name, "sh", "-c",
                 "dd if=/dev/urandom of=/io/f bs=1M count=16 2>/dev/null && sync && "
                 "md5sum /io/f | cut -d' ' -f1 && echo 3 >/proc/sys/vm/drop_caches && md5sum /io/f | cut -d' ' -f1")
    sums = r.stdout.split()
    t.check("RUNCVM_DISK_IOTHREADS=4: data written to the disk reads back", True,
            r.returncode == 0 and len(sums) == 2 and sums[0] == sums[1])

t.finish()
