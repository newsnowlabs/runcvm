#!/usr/bin/env python3
"""Volumes, bind mounts and tmpfs mounts in a RunCVM Container/VM.

The VM's filesystem, including volumes and bind mounts, is served from the
container over virtiofs:

- A named volume and a bind-mounted host directory are readable and
  writable in the VM, and files written there keep the writer's uid and
  gid on the host.
- A read-only bind mount (':ro') cannot be written in the VM.
- A single file can be bind-mounted.
- Each --tmpfs and --mount type=tmpfs mount is a tmpfs in the VM, with its
  options.
- Two Container/VMs sharing a volume with RUNCVM_VIRTIOFSD_CACHE=none see
  each other's writes at once.
- With RUNCVM_VIRTIOFSD_CACHE=always,writeback, virtiofsd runs with
  --writeback; a file written and closed in the VM is on the host at once,
  appends ('>>') extend a file rather than overwrite it, and data written
  to a file the VM still holds open reaches the host by the time a
  'docker stop' completes.
- With RUNCVM_VIRTIOFSD_CACHE=always and RUNCVM_VIRTIOFSD_SUBMOUNT_CACHE=auto,
  virtiofsd runs with --submount-cache=auto: a bind-mounted host file and a
  file in a volume, rewritten from outside the VM after the VM has read
  them, are read afresh in the VM; a file in the root filesystem, replaced
  with 'docker cp' after the VM has read it, is still read as before.
- With RUNCVM_VIRTIOFSD_CACHE=always and RUNCVM_VIRTIOFSD_CACHE_PATHS
  giving 'auto' for one volume's destination, virtiofsd runs with
  --cache-path for it: a file in that volume, rewritten from another
  container after the VM has read it, is read afresh, while a file in a
  second volume that no path covers keeps the root's 'always' and is still
  read as before.
- By default, virtiofsd runs with --negative-timeout=1, and with
  RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT=0 without it. A file the VM looked for
  in a volume and did not find is visible in the VM at once once the VM
  creates it, and, created from another container instead, within 3 s.

The expected values describe current behaviour. A change to it must update
them deliberately.
"""

import os
import shutil
import sys
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

BOOT_TIMEOUT = 600 if t.ACCEL == "tcg" else 120
VM = ["--runtime=" + t.RUNTIME, *t.vm_opts()]


def start(label, *opts, image=("alpine", "sleep", "600")):
    name = t.unique(label)
    t.cleanup_container(name)
    r = t.docker("run", "-d", "--name", name, *t.labels(), *VM, *opts, *image)
    return name if r.returncode == 0 and t.wait_for_exec(name, BOOT_TIMEOUT) else None


def ex(name, *cmd, user=None):
    return t.docker("exec", *(["--user", user] if user else []), name, *cmd)


def case_volume_and_binds():
    volume = t.unique("mounts")
    t.volume_create(volume)
    host = tempfile.mkdtemp(prefix="runcvm-test-")
    os.chmod(host, 0o777)
    with open(os.path.join(host, "from-host"), "w") as f:
        f.write("host-data\n")
    ro = tempfile.mkdtemp(prefix="runcvm-test-ro-")
    single = os.path.join(host, "single-file")
    with open(single, "w") as f:
        f.write("single\n")
    try:
        name = start("mounts", "-v", volume + ":/vol", "-v", host + ":/bind", "-v", ro + ":/ro:ro",
                     "-v", single + ":/single-file:ro", "--tmpfs", "/tmp1", "--tmpfs", "/tmp2:size=8m",
                     "--mount", "type=tmpfs,dst=/tmp3")
        if not name:
            return [("mounts: Container/VM started", True, False)]
        ex(name, "sh", "-c", "echo vm-data >/vol/f")
        ex(name, "sh", "-c", "echo vm-data >/bind/from-vm", user="1000:1000")
        st = os.stat(os.path.join(host, "from-vm")) if os.path.exists(os.path.join(host, "from-vm")) else None
        return [
            ("named volume: written in the VM, read on the host", "vm-data\n", t.volume_read(volume, "f")),
            ("bind mount: host file readable in the VM", "host-data", ex(name, "cat", "/bind/from-host").stdout.strip()),
            ("bind mount: file written by uid 1000 in the VM is owned by 1000:1000 on the host",
             (1000, 1000), (st.st_uid, st.st_gid) if st else None),
            ("read-only bind mount: write refused", False, ex(name, "touch", "/ro/x").returncode == 0),
            ("single-file bind mount", "single", ex(name, "cat", "/single-file").stdout.strip()),
            ("--tmpfs /tmp1: tmpfs in the VM", "tmpfs", ex(name, "stat", "-f", "-c", "%T", "/tmp1").stdout.strip()),
            ("--tmpfs /tmp2:size=8m: tmpfs in the VM", "tmpfs", ex(name, "stat", "-f", "-c", "%T", "/tmp2").stdout.strip()),
            ("--tmpfs /tmp2:size=8m: size option applied", "8192",
             (ex(name, "df", "-k", "/tmp2").stdout.split() or [""] * 9)[8]),
            ("--mount type=tmpfs /tmp3: tmpfs in the VM", "tmpfs",
             ex(name, "stat", "-f", "-c", "%T", "/tmp3").stdout.strip()),
        ]
    finally:
        shutil.rmtree(host, ignore_errors=True)
        shutil.rmtree(ro, ignore_errors=True)


def case_shared_volume():
    volume = t.unique("shared")
    t.volume_create(volume)
    opts = ["-v", volume + ":/shared", "--env=RUNCVM_VIRTIOFSD_CACHE=none"]
    names = t.parallel(lambda label: start(label, *opts), ["shared-a", "shared-b"], jobs=2)
    if not all(names):
        return [("shared volume: both Container/VMs started", True, False)]
    a, b = names
    results = []
    for i in range(3):
        ex(a, "sh", "-c", "echo round-%d >/shared/f" % i)
        results.append(("shared volume, cache=none: write %d in one VM seen at once in the other" % i,
                        "round-%d" % i, ex(b, "cat", "/shared/f").stdout.strip()))
    return results


def case_writeback():
    volume = t.unique("writeback")
    t.volume_create(volume)
    name = start("writeback", "-v", volume + ":/vol", "--env=RUNCVM_VIRTIOFSD_CACHE=always,writeback")
    if not name:
        return [("writeback: Container/VM started", True, False)]
    top = t.docker("top", name).stdout
    ex(name, "sh", "-c", "echo closed >/vol/closed && echo a >>/vol/appended && echo b >>/vol/appended")
    closed = t.volume_read(volume, "closed")
    appended = t.volume_read(volume, "appended")
    # The background shell keeps /vol/open open until the Container/VM stops.
    ex(name, "sh", "-c", "(exec 3>/vol/open; echo held-open >&3; exec sleep 600) >/dev/null 2>&1 &")
    stopped = t.docker("stop", name).returncode == 0
    return [
        ("writeback: virtiofsd runs with --writeback", True,
         any("virtiofsd" in line and "--writeback" in line for line in top.splitlines())),
        ("writeback: file written and closed in the VM is on the host", "closed\n", closed),
        ("writeback: appends extend the file", "a\nb\n", appended),
        ("writeback: 'docker stop' succeeded", True, stopped),
        ("writeback: data in a file held open is on the host after 'docker stop'", "held-open\n",
         t.volume_read(volume, "open")),
    ]


def case_submount_cache():
    volume = t.unique("submount")
    t.volume_create(volume)
    host = tempfile.mkdtemp(prefix="runcvm-test-")
    os.chmod(host, 0o755)
    with open(os.path.join(host, "f"), "w") as f:
        f.write("host-old\n")
    try:
        t.docker("run", "--rm", "--runtime=runc", "--network=none", *t.labels(), "-v",
                 volume + ":/v", "alpine", "sh", "-c", "echo vol-old >/v/f")
        name = start("submount", "-v", host + ":/bind", "-v", volume + ":/vol",
                     "--env=RUNCVM_VIRTIOFSD_CACHE=always",
                     "--env=RUNCVM_VIRTIOFSD_SUBMOUNT_CACHE=auto")
        if not name:
            return [("submount cache: Container/VM started", True, False)]
        top = t.docker("top", name).stdout
        ex(name, "sh", "-c", "echo root-old >/root-file")
        before = ex(name, "cat", "/bind/f", "/vol/f", "/root-file").stdout
        # Rewrite each file from outside the VM: the bind-mounted file on the host, in place; the
        # volume's from another (runc) container; the root filesystem's with 'docker cp'.
        with open(os.path.join(host, "f"), "w") as f:
            f.write("host-new\n")
        vol_new = t.docker("run", "--rm", "--runtime=runc", "--network=none", *t.labels(), "-v",
                           volume + ":/v", "alpine", "sh", "-c", "echo vol-new >/v/f")
        src = os.path.join(host, "root-file")
        with open(src, "w") as f:
            f.write("root-new\n")
        cp = t.docker("cp", src, name + ":/root-file")
        # Wait past the 1-second timeouts of 'auto' before reading again: a fixed wait, as polling
        # for the new contents would read the files in the meantime.
        t.docker("exec", name, "sleep", "3")
        return [
            ("submount cache: virtiofsd runs with --submount-cache=auto", True,
             any("virtiofsd" in line and "--submount-cache=auto" in line for line in top.splitlines())),
            ("submount cache: files read in the VM before", "host-old\nvol-old\nroot-old\n", before),
            ("submount cache: volume file rewritten from another container", 0, vol_new.returncode),
            ("submount cache: root file replaced with 'docker cp'", 0, cp.returncode),
            ("submount cache (auto): bind-mounted file rewritten on the host is read afresh",
             "host-new", ex(name, "cat", "/bind/f").stdout.strip()),
            ("submount cache (auto): volume file rewritten from another container is read afresh",
             "vol-new", ex(name, "cat", "/vol/f").stdout.strip()),
            ("root cache (always): root file replaced with 'docker cp' is read as before",
             "root-old", ex(name, "cat", "/root-file").stdout.strip()),
        ]
    finally:
        shutil.rmtree(host, ignore_errors=True)


def case_cache_paths():
    fresh, stale = t.unique("cachepath-a"), t.unique("cachepath-b")
    for volume in (fresh, stale):
        t.volume_create(volume)
        t.docker("run", "--rm", "--runtime=runc", "--network=none", *t.labels(), "-v",
                 volume + ":/v", "alpine", "sh", "-c", "echo old >/v/f")
    name = start("cachepath", "-v", fresh + ":/data/a", "-v", stale + ":/srv/b",
                 "--env=RUNCVM_VIRTIOFSD_CACHE=always",
                 "--env=RUNCVM_VIRTIOFSD_CACHE_PATHS=/data=auto")
    if not name:
        return [("cache paths: Container/VM started", True, False)]
    top = t.docker("top", name).stdout
    before = ex(name, "cat", "/data/a/f", "/srv/b/f").stdout
    rewritten = [t.docker("run", "--rm", "--runtime=runc", "--network=none", *t.labels(), "-v",
                          volume + ":/v", "alpine", "sh", "-c", "echo new >/v/f").returncode
                 for volume in (fresh, stale)]
    # Wait past the 1-second timeouts of 'auto' before reading again: a fixed wait, as polling
    # for the new contents would read the files in the meantime.
    t.docker("exec", name, "sleep", "3")
    return [
        ("cache paths: virtiofsd runs with --cache-path=/data=auto", True,
         any("virtiofsd" in line and "--cache-path=/data=auto" in line for line in top.splitlines())),
        ("cache paths: files read in the VM before", "old\nold\n", before),
        ("cache paths: both volumes' files rewritten from another container", [0, 0], rewritten),
        ("cache paths (/data=auto): volume file at /data/a rewritten from outside is read afresh",
         "new", ex(name, "cat", "/data/a/f").stdout.strip()),
        ("cache paths (uncovered, always): volume file at /srv/b rewritten from outside is read as before",
         "old", ex(name, "cat", "/srv/b/f").stdout.strip()),
    ]


def case_negative_timeout():
    volume = t.unique("negative")
    t.volume_create(volume)
    names = t.parallel(lambda opts: start(*opts),
                       [("negative", "-v", volume + ":/vol"),
                        ("negative-off", "--env=RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT=0")], jobs=2)
    if not all(names):
        return [("negative timeout: both Container/VMs started", True, False)]
    name, off = names

    def virtiofsd_args(n):
        return [line for line in t.docker("top", n, "-o", "pid,args").stdout.splitlines() if "virtiofsd" in line]

    inside = ex(name, "sh", "-c", "[ -e /vol/inside ] || echo absent; touch /vol/inside && [ -e /vol/inside ] && echo present").stdout.split()
    looked = ex(name, "sh", "-c", "[ -e /vol/outside ] || echo absent").stdout.strip()
    created = t.docker("run", "--rm", "--runtime=runc", "--network=none", *t.labels(), "-v",
                       volume + ":/v", "alpine", "touch", "/v/outside").returncode
    # Wait past the 1-second negative timeout before looking again: a fixed wait, as polling would
    # look up the name, and renew the negative entry, in the meantime.
    t.docker("exec", name, "sleep", "3")
    return [
        ("negative timeout: virtiofsd runs with --negative-timeout=1 by default", True,
         any("--negative-timeout=1" in line for line in virtiofsd_args(name))),
        ("negative timeout: virtiofsd runs without it with RUNCVM_VIRTIOFSD_NEGATIVE_TIMEOUT=0", False,
         any("--negative-timeout" in line for line in virtiofsd_args(off))),
        ("negative timeout: a file not found, then created in the VM, is found at once",
         ["absent", "present"], inside),
        ("negative timeout: a file not found in the VM", "absent", looked),
        ("negative timeout: the file created from another container", 0, created),
        ("negative timeout: the file created from another container is found within 3 s", 0,
         ex(name, "test", "-e", "/vol/outside").returncode),
    ]


for results in t.parallel(lambda f: f(), [case_volume_and_binds, case_shared_volume, case_writeback,
                                          case_submount_cache, case_cache_paths,
                                          case_negative_timeout], jobs=6):
    for desc, expected, actual in results:
        t.check(desc, expected, actual)

t.finish()
