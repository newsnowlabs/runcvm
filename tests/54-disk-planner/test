    ("bad-prealloc", "/disks/d,/srv/a,ext4,16M,prealloc=yes",
     "prealloc must be 'on' or 'off'"),
    ("repeated-prealloc", "/disks/d,/srv/a,ext4,16M,prealloc=on,prealloc=off",
     "prealloc specified more than once"),
    ("keyed-bad-prealloc", "src=/disks/d,dst=/srv/a,fs=ext4,size=16M,prealloc=1",
     "prealloc must be 'on' or 'off'"),
    ("keyed-repeated-prealloc", "prealloc=on,src=/disks/d,dst=/srv/a,fs=ext4,size=16M,prealloc=on",
     "prealloc specified more than once"),
