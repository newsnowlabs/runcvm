      has=["disk 0 new=1 layout=subdirs"])

# Backing-file views.
valid("view-own-through-alias", "/disks/state.img,/data,ext4,16M", setup="volume v /disks /data",
      has=["view 0 /data/state.img", "excl /data /data/state.img file"])
valid("view-own-existing-not-excluded", "/disks/state.img,/data,ext4", setup="volume v /disks /data && existing_disk /disks/state.img",
