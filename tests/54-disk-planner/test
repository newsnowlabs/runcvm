valid("distinct-files", "/disks/a,/srv/a,ext4,16M;/disks/b,/srv/b,ext4,16M",
      has=["disk 0 new=1 layout=subdirs", "disk 1 new=1 layout=subdirs"])

# Sizes.
for size in ("garbage", "1.5G", "10T"):
    invalid("size-" + size, "/disks/a,/srv/a,ext4,16M;/disks/b,/srv/b,ext4,%s" % size,
