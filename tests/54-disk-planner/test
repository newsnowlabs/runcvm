        "src '/disks/c' has the same filesystem UUID as the src of an earlier disk, '/disks/a'",
        spec="/disks/c,/srv/c,ext4", setup="existing_disk /disks/a && cp /disks/a /disks/c")
valid("claim-refuses-file-created-after-checks", "/disks/a,/srv/a,ext4,16M",
      env=[("AFTER_PLAN", '( echo other >/disks/a && disk_create_file 0 ); echo "content=$(cat /disks/a)"')],
      has=["Error: disk spec '/disks/a,/srv/a,ext4,16M' invalid: src '/disks/a' exists, though it did not when the "
