      has=["fstab #runcvm-held %d %s" % (n, enc(p)) for n, p in enumerate(ODD)] +
          ["held-mounts %d %s" % (n, enc(p)) for n, p in enumerate(ODD)] +
          ["fstab tmpfs %s tmpfs defaults 0 0" % enc("/srv/tm p")] +
          ["excl /srv %s dir" % enc(p) for p in ODD])
valid("fstab-all", "/disks/a,/data,ext4,16M", setup="volume v /data/v", env=[("RUNCVM_FSTAB", "all")],
