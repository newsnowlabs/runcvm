#!/usr/bin/env python3
"""RUNCVM_DISKS: parsing, checks and planning, without a VM.

Each case runs runcvm-ctr-qemu's parse, check and plan phases (sourced, so
that it only defines its functions), and its manifest writer, in a runc
container of its own whose root, bound non-recursively at /vm, stands for
the image, as in a RunCVM container; volumes are bind mounts from a tmpfs,
at /vm/<path> or, for /disks, in the container only; existing disks are
ext4 filesystems made by RunCVM's own mke2fs. Nothing is formatted or
booted. Each case checks the outcome: the error naming the spec, or what
the plan holds (held mounts, mount order, exclusions, backing-file views,
the manifests); and that the checks and planning left /disks unchanged.

- Invalid disk specs (syntax, destinations, layouts, options, filesystems,
  prealloc, keyed forms) and invalid combinations (shared destinations,
  with disks or tmpfs mounts) are rejected with their messages.
- Backing file paths: relative, with '.' or '..' components, ending in '/',
  or through a symbolic link to such a path in a directory that does not
  exist, are rejected; '//' is collapsed; a dangling symbolic link is
  followed to where the file will be created, also through a link with
  '../' or './' in a directory that exists.
- Control characters (bytes 0x01-0x1F and 0x7F): in a backing file path or
  a destination, given or reached through symbolic links (to the file, or
  in a directory above it), in a container mount's or a tmpfs mount's
  destination: each is rejected, with the path, and a spec holding it,
  shown escaped. UTF-8 characters, including a non-breaking space, and a
  backslash followed by 'n' are accepted.
- Backing-file identity: one file by two spellings, through one volume
  mounted at two paths (existing or not), or as hard links, is rejected;
  two existing disks with one filesystem UUID are rejected; distinct files
  are not. Creating a new disk's backing file refuses one that appeared
  after the checks, leaving it as it is.
- Sizes: a size that truncate rejects ('garbage', '1.5G', '10T'), also on a
  later disk, is rejected; a valid one is accepted.
- mke2fs's limits: 257 exclusions below an ext4 disk's destination, and 65
  destinations, are rejected; 256 and 64 are accepted, as are 257
  exclusions for xfs.
- Backing-file views: a backing file is seen by the VM through every mount
  of its filesystem below /vm (one volume at /disks and /data), at its own
  path below /vm, or not at all (a volume's unrelated file of the same
  name; /disks alone); each view below a new disk's destination is
  excluded from it, its own included.
- Exclusions and held mounts: container mounts, other disks' and tmpfs
  mounts' destinations below a new disk's destination are excluded,
  outermost only, including nested volumes on one device; a volume at a
  disk's destination is not excluded, nor held, even below another disk or
  a tmpfs mount; an existing disk has no exclusions.
- Manifests: paths with a space, '\\', a literal '\\040', a backslash
  followed by 'n', and UTF-8 characters are written escaped, and decode to
  the paths;
  RUNCVM_FSTAB=all writes held mounts as bind mounts from
  /.runcvm/submounts/<id>.
- The planner on random plans: held mounts are exactly the container mounts
  strictly below a disk or tmpfs mount, other than those at a disk's
  destination; mounts are ordered by depth, stably; exclusions are the
  outermost of the container mounts, disk and tmpfs destinations and
  backing-file views strictly below each new disk's destination (and
  /.runcvm for a whole-root disk); and paths survive encoding exactly.
"""

import os
import random
import shlex
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

REPO = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..")
SCRIPTS = os.path.realpath(os.path.join(REPO, "runcvm-scripts"))
GUEST = "/opt/runcvm"

# Runs in each case's container, with RunCVM's package at /.runcvm/guest, this repository's scripts
# at /t, and the case at /h/case: sets up the case, runs the planning phases in a subshell (an
# error ends it), and prints the plan and its manifests, then whether /disks is unchanged.
HARNESS = r'''
RUNCVM_GUEST=/.runcvm/guest
. /t/runcvm-ctr-defaults
. /t/runcvm-ctr-qemu
RUNCVM_VM_MOUNTPOINT=/vm
mkdir -p /vm && mount --bind / /vm

# volume <name> <path>...: a volume, mounted at each path (below /vm, or in the container for /disks).
volume() {
  local name="$1" p
  shift
  mkdir -p "/vols/$name"
  for p in "$@"
  do
    if [[ "$p" = /disks || "$p" = /disks/* ]]; then
      mkdir -p "$p" && mount --bind "/vols/$name" "$p"
    else
      mkdir -p "/vm$p" && mount --bind "/vols/$name" "/vm$p"
    fi
  done
}

# bindfile <path>: a file bind-mounted from the host at <path> in the image.
bindfile() {
  mkdir -p "/vm${1%/*}" && touch "/vm$1" && mount --bind /.runcvm/guest/LICENSE "/vm$1"
}

# existing_disk <path> [subdirs]: an existing ext4 disk, with layout 'subdirs' if asked.
existing_disk() {
  mkdir -p "${1%/*}" && busybox truncate -s 16M "$1" &&
    MKE2FS_CONFIG=$RUNCVM_GUEST/etc/mke2fs.conf mke2fs -q -F -t ext4 ${2:+-L runcvm-subdirs} "$1"
}

. /h/case
before=$(find /disks | sort; find /disks -type f -exec md5sum {} + | sort)
(
  container_mounts
  disks_parse "$RUNCVM_DISKS"
  tmpfs_parse
  plan_check
  plan_mounts
  for i in "${!DISK_SPEC[@]}"; do echo "disk $i new=${DISK_NEW[$i]} layout=${DISK_LAYOUT[$i]}"; done
  for i in "${!BACKING_PATH[@]}"; do echo "view ${BACKING_DISK[$i]} $(path_encode "${BACKING_PATH[$i]}")"; done
  for i in "${!HELD_CMOUNT[@]}"; do echo "held $(path_encode "${CMOUNT_PATH[${HELD_CMOUNT[$i]}]}")"; done
  for i in "${MOUNT_ORDER[@]}"; do echo "order ${MOUNT_KIND[$i]} $(path_encode "${MOUNT_PATH[$i]}")"; done
  for i in "${!EXCL_DEST[@]}"; do
    echo "excl ${DEST_GIVEN[${EXCL_DEST[$i]}]} $(path_encode "${EXCL_ON_DISK[$i]}") ${EXCL_TYPE[$i]}"
  done
  write_manifests
  [ ! -f /.runcvm/fstab ] || busybox sed 's/^/fstab /' /.runcvm/fstab
  [ ! -f /.runcvm/held-mounts ] || busybox sed 's/^/held-mounts /' /.runcvm/held-mounts
  echo planned
  # A case's further step, run once planning is done (e.g. creating a disk's backing file).
  [ -z "$AFTER_PLAN" ] || eval "$AFTER_PLAN"
) 2>&1
after=$(find /disks | sort; find /disks -type f -exec md5sum {} + | sort)
[ "$before" = "$after" ] && echo "disks unchanged" || echo "disks changed"
'''


def case_script(setup, disks, tmpfs=(), env=()):
    lines = [setup or ":", "RUNCVM_DISKS=%s" % shlex.quote(disks), "RUNCVM_TMPFS=%s" % shlex.quote("\n".join(tmpfs))]
    lines += ["%s=%s" % (k, shlex.quote(v)) for k, v in env]
    return "\n".join(lines) + "\n"


def run_case(case):
    """Run a case ({name, setup, disks, tmpfs, env}) in a runc container; return its output lines."""
    with tempfile.TemporaryDirectory() as d:
        with open(os.path.join(d, "harness"), "w") as f:
            f.write(HARNESS)
        with open(os.path.join(d, "case"), "w") as f:
            f.write(case_script(case.get("setup"), case.get("disks", ""), case.get("tmpfs", ()), case.get("env", ())))
        container = t.unique("planner-" + case["name"])
        try:
            r = t.docker("run", "--rm", "--name", container, *t.labels(), "--runtime=runc",
                         "--network=none", "--cap-add=SYS_ADMIN", "--security-opt=apparmor=unconfined",
                         "--tmpfs", "/.runcvm", "--tmpfs", "/disks", "--tmpfs", "/vols",
                         "-v", "%s:/.runcvm/guest:ro" % GUEST, "-v", "%s:/t:ro" % SCRIPTS, "-v", "%s:/h:ro" % d,
                         "alpine", "/.runcvm/guest/bin/bash", "/h/harness", timeout=60)
        except subprocess.TimeoutExpired:
            t.docker("rm", "-f", container)
            return ["timed out after 60s"]
    return r.stdout.splitlines()


