    ("dst-0x7f", "/disks/a,/srv/a\x7fb,ext4,16M", None, [],
     "Error: disk spec $'/disks/a,/srv/a\\177b,ext4,16M' invalid: dst $'/srv/a\\177b' " + CTL),
    ("src-through-linked-parent", "/disks/alias/state.img,/srv/a,ext4",
     "mkdir -p \"$(printf '/disks/st\\001')\" && existing_disk \"$(printf '/disks/st\\001/state.img')\" && "
     "ln -s \"$(printf 'st\\001')\" /disks/alias", [],
     "Error: disk spec '/disks/alias/state.img,/srv/a,ext4' invalid: src '/disks/alias/state.img' leads to "
     "$'/disks/st\\001/state.img', which " + CTL),
    ("container-mount-0x01", "/disks/a,/srv,ext4,16M", "volume v \"$(printf '/srv/a\\001b')\"", [],
     "Error: mount destination $'/srv/a\\001b' " + CTL),
    ("tmpfs-0x7f", "/disks/a,/srv,ext4,16M", None, ["tmpfs /srv/t\x7f tmpfs defaults 0 0"],
     "Error: tmpfs mount destination $'/srv/t\\177' " + CTL),
]:
    CASES.append(dict(name=name, disks=disks, setup=setup, tmpfs=tmpfs, error=error))
valid("utf8-and-printable-backslash-n-accepted", "/disks/a\\nb,/srv/caf\u00e9:/srv/no\u00a0break,ext4,16M",
      has=["disk 0 new=1 layout=subdirs", "order disk /srv/caf\u00e9", "order disk /srv/no\u00a0break"])

# Backing-file identity.
invalid("same-file-two-spellings", "/disks/a,/srv/a,ext4,16M;/disks//a,/srv/b,ext4,16M",
        "src '/disks//a' is the same file as the src of an earlier disk, '/disks/a'", spec="/disks//a,/srv/b,ext4,16M")
invalid("same-file-aliased-volume-new", "/disks/p/a,/srv/a,ext4,16M;/disks/q/a,/srv/b,ext4,16M",
