          setup=NESTED_SETUP, tmpfs=["tmpfs /srv/t tmpfs defaults 0 0"],
          has=["excl /srv %s/vol dir" % base, "excl /srv %s/f file" % base, "excl /srv %s/inner dir" % base,
               "excl /srv %s/t dir" % base, "held /srv/vol", "held /srv/vol/in", "held /srv/f",
               "order disk /srv", "order held /srv/vol/in"],
