# Disks invalid together, or with tmpfs mounts: (name, RUNCVM_DISKS, RUNCVM_TMPFS lines, the spec
# reported, expected message).
ACROSS = [
    ("same-dst-two-disks", "/disks/a,/home,ext4,16M;/disks/b,/home,ext4,16M", [],
     "/disks/b,/home,ext4,16M", "dst '/home' is also the dst of an earlier disk"),
    ("same-dst-disk-tmpfs", "/disks/b,/home,ext4,16M", ["tmpfs /home tmpfs defaults 0 0"],
     "/disks/b,/home,ext4,16M", "dst '/home' is also the destination of a tmpfs mount"),
]


def enc(path):
    return path.replace("\\", "\\134").replace(" ", "\\040").replace("\t", "\\011").replace("\n", "\\012")


SRC_RULE = "must be an absolute path to a file, without '.' or '..' components"
ODD = ["/srv/a b", "/srv/c\\d", "/srv/e\\040f", "/srv/n\\nl", "/srv/caf\u00e9", "/srv/\u65e5\u672c"]
CTL = "must not contain control characters (bytes 0x01-0x1F and 0x7F)"

# Each case: name; setup (shell, run in the case's container before planning); RUNCVM_DISKS;
# RUNCVM_TMPFS lines; other environment; and either 'error', a message the plan must fail with, with
# 'spec' the spec it names (by default RUNCVM_DISKS), or 'has' and 'lacks', output lines it must and
# must not print.
CASES = []


def invalid(name, disks, message, spec=None, setup=None, tmpfs=()):
    CASES.append(dict(name=name, disks=disks, setup=setup, tmpfs=list(tmpfs),
                      error="Error: disk spec '%s' invalid: %s" % (spec or disks, message)))


def valid(name, disks, has=(), lacks=(), setup=None, tmpfs=(), env=(), changes_disks=False):
    CASES.append(dict(name=name, disks=disks, setup=setup, tmpfs=list(tmpfs), env=list(env), has=list(has),
                      lacks=list(lacks), changes_disks=changes_disks))


# Disk specs alone.
for name, disks, message in INVALID:
    invalid(name, disks, message)
for name, disks, tmpfs, spec, message in ACROSS:
    invalid(name, disks, message, spec=spec, tmpfs=tmpfs)

# Backing file paths.
invalid("src-relative", "state.img,/srv/a,ext4,16M", "src 'state.img' " + SRC_RULE)
invalid("src-dot", "/disks/./a,/srv/a,ext4,16M", "src '/disks/./a' " + SRC_RULE)
invalid("src-dotdot", "/disks/x/../a,/srv/a,ext4,16M", "src '/disks/x/../a' " + SRC_RULE)
invalid("src-trailing-slash", "/disks/a/,/srv/a,ext4,16M", "src '/disks/a/' " + SRC_RULE)
invalid("src-dotdot-naming-existing-disk", "/disks/a,/data,ext4;/disks/missing/../a,/other,ext4,16M",
        "src '/disks/missing/../a' " + SRC_RULE, spec="/disks/missing/../a,/other,ext4,16M",
        setup="existing_disk /disks/a")
valid("src-double-slash", "/disks//a,/srv/a,ext4,16M", has=["disk 0 new=1 layout=subdirs"])
valid("src-dangling-link", "/disks/link.img,/data,ext4,16M",
      setup="volume v /disks /data && ln -s state.img /disks/link.img",
      has=["view 0 /data/state.img", "excl /data /data/state.img file"])
valid("src-link-dot", "/disks/dot.img,/data,ext4,16M",
      setup="volume v /disks /data && ln -s ./state.img /disks/dot.img",
      has=["view 0 /data/state.img", "excl /data /data/state.img file"])
valid("src-link-up-existing-dir", "/disks/sub/up.img,/data,ext4,16M",
      setup="volume v /disks /data && mkdir -p /disks/x /disks/sub && ln -s ../x/s.img /disks/sub/up.img",
      has=["disk 0 new=1 layout=subdirs", "view 0 /data/x/s.img", "excl /data /data/x/s.img file"])
invalid("src-link-up-missing-dir", "/disks/bad.img,/srv/a,ext4,16M",
        "src '/disks/bad.img' is a symbolic link to '/disks/../nope/s.img', which must be an absolute path to a "
        "file, without '.' or '..' components, where the directory holding it does not exist",
        setup="ln -s ../nope/s.img /disks/bad.img")
invalid("src-link-newline-dir", "/disks/link.img,/srv/a,ext4",
        "src '/disks/link.img' is a symbolic link to $'/disks/store\\n/state.img', which " + CTL,
        setup="mkdir -p '/disks/store\n' && existing_disk '/disks/store\n/state.img' && "
              "ln -s 'store\n' /disks/alias && ln -s alias/state.img /disks/link.img")
invalid("src-link-loop", "/disks/l1,/srv/a,ext4,16M", "src '/disks/l1' has too many levels of symbolic links",
        setup="ln -s l2 /disks/l1 && ln -s l1 /disks/l2")

# Control characters, each shown escaped in the error: (name, RUNCVM_DISKS, setup, RUNCVM_TMPFS lines,
# the whole error).
for name, disks, setup, tmpfs, error in [
    ("src-tab", "/disks/a\tb,/srv/a,ext4,16M", None, [],
     "Error: disk spec $'/disks/a\\tb,/srv/a,ext4,16M' invalid: src $'/disks/a\\tb' " + CTL),
    ("src-newline", "/disks/a\nb,/srv/a,ext4,16M", None, [],
     "Error: disk spec $'/disks/a\\nb,/srv/a,ext4,16M' invalid: src $'/disks/a\\nb' " + CTL),
    ("dst-newline-second-of-two", "/disks/a,/srv/a:/srv/b\nc,ext4,16M", None, [],
     "Error: disk spec $'/disks/a,/srv/a:/srv/b\\nc,ext4,16M' invalid: dst $'/srv/b\\nc' " + CTL),
    ("dst-0x01", "/disks/a,/srv/a\x01b,ext4,16M", None, [],
