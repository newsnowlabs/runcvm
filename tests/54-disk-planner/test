    ("keyed-no-dst", "src=/disks/d,fs=ext4,size=16M",
     "src, dst and fs must all be specified"),
    ("keyed-overlap", "src=/disks/d,dst=/srv/a,dst=/srv/a/b,fs=ext4,size=16M",
     "dst '/srv/a' and dst '/srv/a/b' overlap"),
    ("symlink-same", "/disks/d,/var/run:/run,ext4,16M",
     "dst '/var/run' and dst '/run' overlap, as '/run' and '/run'"),
    ("symlink-ancestor", "/disks/d,/run:/var/lock,ext4,16M",
     "dst '/run' and dst '/var/lock' overlap, as '/run' and '/run/lock'"),
    ("lost+found", "/disks/d,/lost+found:/home,ext4,16M",
     "dst '/lost+found' requires layout 'root'"),
    ("keyed-alias-repeated", "fs=ext4,source=/disks/d,target=/srv/a,src=/disks/e,size=16M",
