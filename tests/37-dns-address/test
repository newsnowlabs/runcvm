#!/usr/bin/env python3
"""RunCVM's DNS address (RUNCVM_DNS_IP) and bridge address (RUNCVM_BRIDGE_IP).

- On a user-defined network, the VM resolves another container's name, and
  'docker exec' works, by default and with RUNCVM_DNS_IP set to another
  link-local address. Where the container's DNS server is Docker's embedded
  one (127.0.0.11, on Docker's user-defined networks), the VM's resolv.conf
  names RUNCVM_DNS_IP (169.254.53.53 by default) in its place, which
  dnsmasq answers; elsewhere (e.g. under Podman, whose DNS server is at the
  network's gateway), it names the container's DNS servers unchanged, and no
  dnsmasq runs in the container.
- A malformed or non-unicast RUNCVM_DNS_IP, or one in 0.0.0.0/8 or
  127.0.0.0/8, fails Container/VM creation with an error naming it.
- RunCVM's bridge in the container has the address RUNCVM_BRIDGE_IP
  (169.254.53.1 by default), and the VM resolves names and serves 'docker
  exec' with it set to another link-local address too.
- A RUNCVM_BRIDGE_IP of the wrong form, or equal to RUNCVM_DNS_IP, fails
  Container/VM creation with an error naming RUNCVM_BRIDGE_IP.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

BOOT_TIMEOUT = 600 if t.ACCEL == "tcg" else 120
# '--dns-search=.' and '--dns-opt=ndots:1' keep the host's DNS search domains out of the lookups of
# container names, as in tests/24-networking.
VM = ["--runtime=" + t.RUNTIME, *t.vm_opts(), "--dns-search=.", "--dns-opt=ndots:1"]
DEFAULT = "169.254.53.53"
BRIDGE_DEFAULT = "169.254.53.1"

network = t.unique("net")
t.docker("network", "create", *t.labels(), network, check=True)
t.cleanup_network(network)

peer = t.unique("peer")
t.cleanup_container(peer)
t.docker("run", "-d", "--name", peer, *t.labels(), "--network", network, "alpine", "sleep", "600", check=True)


def nameservers(resolv_conf):
    return [line.split()[1] for line in resolv_conf.splitlines() if line.startswith("nameserver ")]


# The DNS servers a standard container on the network is given: Docker's embedded server, which
# RunCVM replaces in the VM with RUNCVM_DNS_IP, or the engine's own (e.g. Podman's, at the
# network's gateway), which the VM queries directly.
CONTAINER_DNS = nameservers(t.docker("run", "--rm", *t.labels(), "--network", network, "--dns-search=.",
                                     "--dns-opt=ndots:1", "alpine", "cat", "/etc/resolv.conf", check=True).stdout)
t.log("a standard container's DNS servers: %s" % CONTAINER_DNS)


def resolves_peer(name):
    r = t.docker("exec", name, "nslookup", peer)
    return r.returncode == 0 and "Address" in r.stdout.split("Name:", 1)[-1]


def local_addresses(pid):
    """The IPv4 addresses local to the network namespace of host process PID (its /proc/PID/net/fib_trie
    entries of type LOCAL), or None if unreadable."""
    try:
        with open("/proc/%s/net/fib_trie" % pid) as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    found = set()
    for previous, line in zip(lines, lines[1:]):
        if "/32 host LOCAL" in line and "|--" in previous:
            found.add(previous.split("|--")[1].strip())
    return found


def case_running(args):
    label, opts, address, bridge = args
    name = t.unique(label)
    t.cleanup_container(name)
    r = t.docker("run", "-d", "--name", name, *t.labels(), *VM, "--network", network, *opts, "alpine", "sleep", "600")
    if r.returncode != 0 or not t.wait_for_exec(name, BOOT_TIMEOUT):
        return [("%s: Container/VM starts and 'docker exec' works" % label, True, False)]
    local = local_addresses(t.docker("inspect", "-f", "{{.State.Pid}}", name).stdout.strip())
    # RunCVM's tools may run through its loader, so dnsmasq's path is any of its arguments.
    dnsmasq = any(word == "dnsmasq" or word.endswith("/dnsmasq")
                  for _, args in t.host_processes(name) for word in args.split())
    return [
        ("%s: dnsmasq runs in the container" % label, CONTAINER_DNS == ["127.0.0.11"], dnsmasq),
        ("%s: 'docker exec' works" % label, True, True),
        ("%s: the container holds the bridge address %s" % (label, bridge), True,
         local is not None and bridge in local),
        ("%s: the VM's DNS server" % label, [address] if CONTAINER_DNS == ["127.0.0.11"] else CONTAINER_DNS,
         nameservers(t.docker("exec", name, "cat", "/etc/resolv.conf").stdout)),
        ("%s: the VM resolves another container's name" % label, True, resolves_peer(name)),
    ]


def case_rejected(args):
    index, value = args
    name = t.unique("bad-%d" % index)
    t.cleanup_container(name)
    r = t.docker("run", "-d", "--name", name, *t.labels(), *VM, "--network", network,
                 "--env=RUNCVM_DNS_IP=" + value, "alpine", "sleep", "600")
    return [
        ("RUNCVM_DNS_IP=%r: creation fails" % value, True, r.returncode != 0),
        ("RUNCVM_DNS_IP=%r: error names RUNCVM_DNS_IP" % value, True, "RUNCVM_DNS_IP" in (r.stdout or "")),
    ]


def case_bridge_rejected(args):
    index, env = args
    name = t.unique("bad-bridge-%d" % index)
    t.cleanup_container(name)
    r = t.docker("run", "-d", "--name", name, *t.labels(), *VM, "--network", network,
                 *["--env=" + e for e in env], "alpine", "sleep", "600")
    desc = " ".join(env)
    return [
        ("%s: creation fails" % desc, True, r.returncode != 0),
        ("%s: error names RUNCVM_BRIDGE_IP" % desc, True, "RUNCVM_BRIDGE_IP" in (r.stdout or "")),
    ]


results = t.parallel(case_running, [("default", [], DEFAULT, BRIDGE_DEFAULT),
                                    ("override", ["--env=RUNCVM_DNS_IP=169.254.99.99"], "169.254.99.99", BRIDGE_DEFAULT),
                                    ("bridge", ["--env=RUNCVM_BRIDGE_IP=169.254.77.1"], DEFAULT, "169.254.77.1")])
results += [case_rejected(v) for v in enumerate(("bogus", "127.0.0.1", "0.1.2.3", "224.0.0.1", "169.254.300.1",
                                                   "169.254.053.53"))]
results += [case_bridge_rejected(v) for v in enumerate((["RUNCVM_BRIDGE_IP=bogus"], ["RUNCVM_BRIDGE_IP=127.0.0.2"],
                                                          ["RUNCVM_BRIDGE_IP=" + DEFAULT],
                                                          ["RUNCVM_DNS_IP=169.254.9.9", "RUNCVM_BRIDGE_IP=169.254.9.9"]))]

for checks in results:
    for desc, expected, actual in checks:
        t.check(desc, expected, actual)

t.finish()
