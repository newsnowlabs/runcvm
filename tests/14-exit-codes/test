#!/usr/bin/env python3
"""Exit status of 'docker run' for a RunCVM Container/VM.

Records RunCVM's exit-code contract (README, "Features and limitations"):
the entrypoint's own exit status is passed through, as for a container,
with and without --init: without --init, as the exit status of the VM's
PID 1; with --init, as runcvm-exit-watcher records it. A workload may
set the Container/VM's exit status itself by writing it to
/.runcvm/exitcode (reduced modulo 256) or by calling qemu-exit (0-127),
and both need root, since /.runcvm is root-only. Each case runs with and
without --init.

The exit status without --init is read from the kernel's log console,
which must leave /dev/console as the kernel would choose it itself: tty0
on x86, the virt machine's UART (ttyAMA0) on arm64. With
RUNCVM_KERNEL_DEBUG=1, there is no kernel log console: the user's console
(hvc0, in headless mode) is /dev/console, and shows the kernel's
messages, the panic among them; and without --init, the entrypoint's exit
status is not passed through. The console checks set headless mode and
RUNCVM_KERNEL_DEBUG themselves, whatever the runner's --vm-env.

A Container/VM whose boot fails in runcvm-vm-init (here, with its network
driver blacklisted, so that its network interface never appears) exits 1,
with RunCVM's error naming the failure in its output.

The expected values describe current behaviour. A change to the contract
must update them deliberately.
"""

import os
import platform
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

QEMU_EXIT = "/.runcvm/guest/sbin/qemu-exit"

# (name, docker run options, command, expected exit status without --init, and with it)
CASES = [
    ("exit-0", [], "exit 0", (0, 0)),
    ("exit-3", [], "exit 3", (3, 3)),
    ("exit-200", [], "exit 200", (200, 200)),
    ("missing-entrypoint", [], None, (127, 127)),
    ("exitcode-file-5", [], "echo 5 >/.runcvm/exitcode; exit 3", (5, 5)),
    ("exitcode-file-300", [], "echo 300 >/.runcvm/exitcode", (44, 44)),
    ("exitcode-file-minus-1", [], "echo -1 >/.runcvm/exitcode", (255, 255)),
    ("qemu-exit-7", [], QEMU_EXIT + " 7", (7, 7)),
    ("qemu-exit-127", [], QEMU_EXIT + " 127", (127, 127)),
    ("qemu-exit-0", [], QEMU_EXIT + " 0; exit 3", (0, 0)),
    ("non-root-exit-3", ["--user=1000"], "exit 3", (3, 3)),
    ("non-root-exitcode-file", ["--user=1000"], "echo 5 >/.runcvm/exitcode; exit 3", (3, 3)),
    ("non-root-qemu-exit", ["--user=1000"], QEMU_EXIT + " 7; exit 3", (3, 3)),
    ("kernel-debug-exit-3", ["--env=RUNCVM_KERNEL_DEBUG=1"], "exit 3", (0, 3)),
    ("vm-init-failure", ["--env=RUNCVM_KERNEL_APPEND=module_blacklist=virtio_net"], "echo RAN", (1, 1)),
]

# The message runcvm-vm-init's failure gives
VM_INIT_FAILED = "RunCVM: Error: runcvm-vm-init failed"

RUNS = [(init, case) for init in (False, True) for case in CASES]


def run(item):
    init, (name, opts, command, _) = item
    container = t.unique("%s%s" % (name, "-init" if init else ""))
    # A command of None runs an entrypoint that does not exist.
    cmd = ["/nonexistent"] if command is None else ["sh", "-c", command]
    r = t.docker("run", "--rm", "--name", container, *t.labels(), "--runtime=" + t.RUNTIME, *t.vm_opts(),
                 *(["--init"] if init else []), *opts, "alpine", *cmd)
    return r


results = t.parallel(run, RUNS)

for (init, (name, opts, command, expected)), r in zip(RUNS, results):
    desc = "%s, %s: %s" % (name, "--init" if init else "no --init", command or "/nonexistent")
    if not t.check(desc, expected[init], r.returncode):
        t.log("output:\n%s" % r.stdout)
    if name == "vm-init-failure":
        t.check("%s, %s: output reports the failure" % (name, "--init" if init else "no --init"),
                True, VM_INIT_FAILED in r.stdout)

# /proc/consoles lists each console, with flag C on /dev/console's entry
r = t.docker("run", "--rm", "--name", t.unique("consoles"), *t.labels(), "--runtime=" + t.RUNTIME, *t.vm_opts(),
             "--env=RUNCVM_DISPLAY_MODE=headless", "--env=RUNCVM_KERNEL_DEBUG=0", "alpine", "cat", "/proc/consoles")
consoles = {f[0]: f for f in (line.split() for line in r.stdout.splitlines()) if f}
preferred = [name for name, f in consoles.items() if "C" in "".join(f[1:])]
t.check("/dev/console is the kernel's own choice", ["ttyAMA0" if platform.machine() == "aarch64" else "tty0"],
        preferred)
t.check("the kernel log console is enabled", True, "hvc1" in consoles)

# With RUNCVM_KERNEL_DEBUG=1, headless: hvc0 alone, /dev/console, showing the kernel's messages
r = t.docker("run", "--rm", "--name", t.unique("consoles-debug"), *t.labels(), "--runtime=" + t.RUNTIME,
             *t.vm_opts(), "--env=RUNCVM_DISPLAY_MODE=headless", "--env=RUNCVM_KERNEL_DEBUG=1", "alpine", "cat",
             "/proc/consoles")
consoles = {f[0]: f for f in (line.split() for line in r.stdout.splitlines()) if f and f[0].startswith(("hvc", "tty"))}
preferred = [name for name, f in consoles.items() if "C" in "".join(f[1:])]
t.check("RUNCVM_KERNEL_DEBUG=1: /dev/console is the user's console", ["hvc0"], preferred)
t.check("RUNCVM_KERNEL_DEBUG=1: the output shows the kernel's panic", True, "Attempted to kill init!" in r.stdout)

t.finish()
