#!/usr/bin/env python3
"""Container lifecycle and 'docker' commands for a RunCVM Container/VM.

- 'docker run' options: --rm, --hostname, --add-host, --dns, --env-file.
- 'docker logs': the VM's console is a terminal, so stdout and stderr both
  arrive on the stdout stream, with CRLF line endings.
- 'docker cp', into and out of a running Container/VM.
- 'docker top' lists RunCVM's processes in the container (QEMU and its
  helpers), not the workload's processes in the VM.
- 'docker restart' boots the VM afresh.
- Restart policies act on the exit status set via /.runcvm/exitcode.

The expected values describe current behaviour. A change to it must update
them deliberately.
"""

import os
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

BOOT_TIMEOUT = 600 if t.ACCEL == "tcg" else 120
VM = ["--runtime=" + t.RUNTIME, *t.vm_opts()]


def case_rm():
    name = t.unique("rm")
    r = t.docker("run", "--rm", "--name", name, *t.labels(), *VM, "alpine", "true")
    gone = t.docker("inspect", name).returncode != 0
    return [("--rm: 'docker run' exit status", 0, r.returncode),
            ("--rm: container removed after exit", True, gone)]


def case_running():
    name = t.unique("running")
    t.cleanup_container(name)
    with tempfile.NamedTemporaryFile("w", suffix=".env", delete=False) as f:
        f.write("FROM_FILE=one\nSPACED=two words\n")
        env_file = f.name
    r = t.docker("run", "-d", "--name", name, *t.labels(), *VM, "--hostname=vmhost",
                 "--add-host=extra.example:10.1.2.3", "--dns=192.0.2.53", "--env-file=" + env_file,
                 "alpine", "sh", "-c", "echo to-stdout; echo to-stderr >&2; sleep 600")
    os.unlink(env_file)
    if r.returncode != 0 or not t.wait_for_exec(name, BOOT_TIMEOUT):
        return [("running: Container/VM started", True, False)]

    def ex(*cmd):
        return t.docker("exec", name, *cmd).stdout.strip()

    results = [
        ("--hostname", "vmhost", ex("hostname")),
        ("--add-host", "10.1.2.3", (ex("getent", "hosts", "extra.example").split() or [""])[0]),
        ("--dns", True, "nameserver 192.0.2.53" in ex("cat", "/etc/resolv.conf")),
        ("--env-file", "one|two words", ex("sh", "-c", 'echo "$FROM_FILE|$SPACED"')),
    ]

    # Read as bytes: text mode would translate the CRLF line endings under test.
    logs = subprocess.run(["docker", "logs", name], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out = logs.stdout.decode(errors="replace")
    results += [
        ("docker logs: stdout and stderr on the stdout stream, CRLF line endings",
         ["to-stdout\r", "to-stderr\r"], [l for l in out.split("\n") if l.startswith("to-")]),
        ("docker logs: nothing on the stderr stream", "", logs.stderr.decode(errors="replace").strip()),
    ]

    with tempfile.TemporaryDirectory() as d:
        src = os.path.join(d, "in")
        with open(src, "w") as f:
            f.write("copied-in\n")
        t.docker("cp", src, name + ":/tmp/in")
        results.append(("docker cp into the VM", "copied-in", ex("cat", "/tmp/in")))
        ex("sh", "-c", "echo copied-out >/tmp/out")
        t.docker("cp", name + ":/tmp/out", os.path.join(d, "out"))
        try:
            with open(os.path.join(d, "out")) as f:
                got = f.read().strip()
        except OSError:
            got = None
        results.append(("docker cp out of the VM", "copied-out", got))

    top = t.docker("top", name, "-eo", "pid,args").stdout
    results += [
        ("docker top lists QEMU", True, "qemu-system-" in top),
        ("docker top does not list the workload", False, "sleep 600" in top),
    ]
    return results


def case_restart():
    name = t.unique("restart")
    t.cleanup_container(name)
    r = t.docker("run", "-d", "--name", name, *t.labels(), *VM, "--init", "alpine", "sleep", "600")
    if r.returncode != 0 or not t.wait_for_exec(name, BOOT_TIMEOUT):
        return [("restart: Container/VM started", True, False)]
    boot1 = t.docker("exec", name, "cat", "/proc/sys/kernel/random/boot_id").stdout.strip()
    rc = t.docker("restart", "-t", "30", name).returncode
    up = t.wait_for_exec(name, BOOT_TIMEOUT)
    boot2 = t.docker("exec", name, "cat", "/proc/sys/kernel/random/boot_id").stdout.strip()
    return [("docker restart: exit status", 0, rc),
            ("docker restart: 'docker exec' works afterwards", True, up),
            ("docker restart: the VM booted afresh", True, bool(boot1) and bool(boot2) and boot1 != boot2)]


def case_restart_policy():
    name = t.unique("on-failure")
    t.cleanup_container(name)
    t.docker("run", "-d", "--name", name, *t.labels(), *VM, "--restart=on-failure:2",
             "alpine", "sh", "-c", "echo 1 >/.runcvm/exitcode")

    def state():
        return t.docker("inspect", "-f", "{{.RestartCount}} {{.State.Status}} {{.State.ExitCode}}", name).stdout.split()

    t.wait_for("%s to exhaust its restarts" % name, BOOT_TIMEOUT * 3,
               lambda: state()[:2] == ["2", "exited"], interval=2)
    return [("--restart=on-failure:2: restarted twice, exit status 1", ["2", "exited", "1"], state())]


CASES = [case_rm, case_running, case_restart, case_restart_policy]

for results in t.parallel(lambda f: f(), CASES, jobs=len(CASES)):
    for desc, expected, actual in results:
        t.check(desc, expected, actual)

t.finish()
