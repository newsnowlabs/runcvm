    def test_requirements(self):
        ft = FakeTests()
        try:
            ft.add("r-kvm", "#!/bin/bash\nexit 0\n", requires="kvm")
            r = ft.run()
            self.assertEqual(r.status("r-kvm"), "pass" if os.path.exists("/dev/kvm") else "skip")
            ft.add("s-typo", "#!/bin/bash\nexit 0\n", requires="vmm")
            r = ft.run()
            self.assertEqual(r.rc, 2)
            self.assertIn("unknown requirement 'vmm'", r.out)
        finally:
            ft.cleanup()

    def test_docker_version_requirement(self):
        ft = FakeTests()
        try:
            # A stand-in docker CLI, reporting $FAKE_DOCKER_VERSION as dockerd's version and
            # the runcvm runtime as registered; other commands succeed with no output.
            bindir = os.path.join(ft.root, "bin")
            os.makedirs(bindir)
            with open(os.path.join(bindir, "docker"), "w") as f:
                f.write(textwrap.dedent("""\
                    #!/bin/sh
                    case "$*" in
                      "info --format {{json .ServerVersion}}") echo "\\"$FAKE_DOCKER_VERSION\\"" ;;
                      "info --format {{.ServerVersion}}") echo "$FAKE_DOCKER_VERSION" ;;
                      "info --format {{json .Runtimes}}") echo '{"runcvm": {}}' ;;
                    esac
                    """))
            os.chmod(os.path.join(bindir, "docker"), 0o755)
            ft.add("t-docker-29", "#!/bin/bash\nexit 0\n", requires="docker>=29.0")
            for version, status in (("28.0.4", "skip"), ("28.10.0", "skip"), ("29.0.0", "pass"),
                                    ("29.9.3", "pass"), ("30.0.0-rc.1", "pass"), ("dev", "skip")):
                with self.subTest(version=version):
                    r = ft.run("t-docker-29", preflight=True,
                               env={"PATH": bindir + os.pathsep + os.environ["PATH"],
                                    "FAKE_DOCKER_VERSION": version})
                    self.assertEqual(r.rc, 0, r.out)
                    self.assertEqual(r.status("t-docker-29"), status)
                    if status == "skip":
                        self.assertEqual(r.test("t-docker-29")["reason"], "requires docker>=29.0 (%s)"
                                         % ("could not read dockerd's version" if version == "dev"
                                            else "dockerd is " + version))
            ft.add("u-docker-bad", "#!/bin/bash\nexit 0\n", requires="docker>=29")
            r = ft.run("u-docker-bad")
            self.assertEqual(r.rc, 2)
            self.assertIn("unknown requirement 'docker>=29'", r.out)
        finally:
            ft.cleanup()


class ProgressAndSignalTests(unittest.TestCase):
    """Results written during a run; SIGTERM, SIGHUP and a vanished terminal."""

    def setUp(self):
        self.ft = FakeTests()
        self.flag = os.path.join(self.ft.root, "release")
        self.pidfile = os.path.join(self.ft.root, "slow.pid")
        self.ft.add("a-quick", "#!/bin/bash\nexit 0\n")
        # Runs until the flag file exists, recording its PID; ignores SIGHUP.
        self.ft.add("b-slow", """\
            #!/bin/bash
            trap '' HUP
            echo $$ >%s
            while [ ! -e %s ]; do sleep 0.2; done
            exit 0
            """ % (self.pidfile, self.flag))
        self.ft.add("c-last", "#!/bin/bash\nfor i in $(seq 1 20000); do echo line $i; done\nexit 0\n")
        self.results = tempfile.mkdtemp(dir=self.ft.root)

    def tearDown(self):
        open(self.flag, "w").close()
        self.ft.cleanup()

    def start(self, stdout=subprocess.DEVNULL):
        e = dict(os.environ, RUNCVM_TEST_KILL_AFTER="2")
        return subprocess.Popen([RUNNER, "--dir", self.ft.dir, "--results", self.results, "--no-preflight"],
                                stdout=stdout, stderr=subprocess.STDOUT, env=e)

    def read(self, name):
        try:
            with open(os.path.join(self.results, name)) as f:
                return f.read()
        except OSError:
            return ""

    def wait_for_running(self, test):
        deadline = time.time() + 30
        while time.time() < deadline:
            if "RUNNING  %s" % test in self.read("summary.txt") and os.path.exists(self.pidfile):
                return
            time.sleep(0.2)
        self.fail("runner never reported %s as running" % test)

    def test_results_written_during_run(self):
        p = self.start()
        try:
            self.wait_for_running("b-slow")
            self.assertIn("PASS     a-quick", self.read("summary.txt"))
            self.assertIn("in progress: 1 of 3 tests done", self.read("summary.txt"))
            self.assertEqual(self.read("status"), "running\n")
            data = json.loads(self.read("results.json"))
            self.assertEqual((data["complete"], data["running"], data["status"]), (False, "b-slow", None))
            self.assertEqual([t["name"] for t in data["tests"]], ["a-quick"])
            open(self.flag, "w").close()
            self.assertEqual(p.wait(timeout=60), 0)
        finally:
            p.kill()
        self.assertNotIn("in progress", self.read("summary.txt"))
        self.assertNotIn("RUNNING", self.read("summary.txt"))
        self.assertEqual(self.read("status"), "0\n")
        data = json.loads(self.read("results.json"))
        self.assertEqual((data["complete"], data["running"], data["status"]), (True, None, 0))

    def test_sigterm_stops_run_and_writes_results(self):
        p = self.start()
        try:
            self.wait_for_running("b-slow")
            p.terminate()
            self.assertEqual(p.wait(timeout=60), 143)
        finally:
            p.kill()
        with open(self.pidfile) as f:
            pid = int(f.read())
        self.assertFalse(os.path.exists("/proc/%d" % pid), "the test in progress was left running")
        data = json.loads(self.read("results.json"))
        self.assertEqual([(t["name"], t["status"]) for t in data["tests"]],
                         [("a-quick", "pass"), ("b-slow", "interrupted")])
        self.assertEqual((data["complete"], data["status"]), (True, 143))
        self.assertEqual(self.read("status"), "143\n")

    def test_sighup_does_not_stop_run(self):
        p = self.start()
        try:
            self.wait_for_running("b-slow")
            p.send_signal(signal.SIGHUP)
            time.sleep(1)
            self.assertIsNone(p.poll(), "the runner exited on SIGHUP")
            open(self.flag, "w").close()
            self.assertEqual(p.wait(timeout=60), 0)
        finally:
            p.kill()
        self.assertEqual([t["status"] for t in json.loads(self.read("results.json"))["tests"]],
                         ["pass", "pass", "pass"])

    def test_vanished_terminal_does_not_stop_run(self):
        # The runner's stdout is a pipe whose reader has gone, as when a terminal goes away; c-last
        # writes more than a pipe holds.
        r, w = os.pipe()
        os.close(r)
        open(self.flag, "w").close()
        p = self.start(stdout=w)
        os.close(w)
        try:
            self.assertEqual(p.wait(timeout=120), 0)
        finally:
            p.kill()
        self.assertEqual([t["status"] for t in json.loads(self.read("results.json"))["tests"]],
                         ["pass", "pass", "pass"])
        with open(os.path.join(self.results, "logs", "c-last.log")) as f:
            self.assertEqual(sum(1 for _ in f), 20000)


@unittest.skipUnless(WITH_DOCKER or "--docker" in sys.argv, "real-Docker tests need --docker")
class DockerStandInTests(unittest.TestCase):
    """Real Docker, in stand-in mode (runc in place of RunCVM)."""

    def test_repository_tests_in_stand_in_mode(self):
        results = tempfile.mkdtemp(prefix="runcvm-selftest-")
        try:
            p = subprocess.run([RUNNER, "--mock", "--results", results], stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, universal_newlines=True, timeout=1800)
            with open(os.path.join(results, "results.json")) as f:
                data = json.load(f)
            statuses = {t["name"]: t["status"] for t in data["tests"]}
            for name, t in ((t["name"], t) for t in data["tests"]):
                with self.subTest(test=name):
                    if "vm" in t["requires"]:
                        self.assertEqual(t["status"], "skip")
                    elif t["status"] == "skip" and t["requires"]:
                        # Another requirement (e.g. ipv6) is not met on this host
                        self.assertTrue(t["reason"].startswith("requires "), t["reason"])
                    else:
                        self.assertEqual(t["status"], "pass", p.stdout[-4000:])
            self.assertEqual(p.returncode, 0, statuses)
        finally:
            shutil.rmtree(results, ignore_errors=True)

    def test_failures_leftovers_timeouts_and_volumes(self):
        ft = FakeTests()
        try:
            ft.add("t-wrong", """\
                #!/bin/bash -e
                . ../framework.sh
                check "user id" 1001 "$(docker run --rm $(labels) --runtime=$RUNTIME --user 1000 alpine id -u)"
                finish
                """)
            ft.add("u-leaky-and-volumes", """\
                #!/bin/bash -e
                . ../framework.sh
                V=$(unique results)
                volume_create $V
                docker run --rm --runtime=$RUNTIME $(labels) -v $V:/out alpine sh -c 'echo 42 >/out/answer'
                check "workload wrote result to volume" 42 "$(volume_read $V answer)"
                expect_exit "exit status of a container" 7 docker run --rm --runtime=$RUNTIME $(labels) alpine sh -c 'exit 7'
                docker network create $(labels) $(unique leaked-net) >/dev/null
                docker run -d $(labels) --name $(unique leaked) alpine sleep 600 >/dev/null
                trap - EXIT
                finish
                """)
            ft.add("v-hang", """\
                #!/bin/bash -e
                . ../framework.sh
                N=$(unique hang)
                docker run -d --rm --runtime=$RUNTIME $(labels) --name $N alpine sh -c 'while true; do echo waiting; sleep 1; done' >/dev/null
                docker logs -f $N | sed '/never-appears/q0'
                """, timeout=5)
            ft.add("w-python-docker", PY_PREAMBLE + textwrap.dedent("""\
                v = t.unique("pyresults")
                t.volume_create(v)
                t.docker("run", "--rm", "--runtime", t.RUNTIME, *t.labels(), "-v", v + ":/out", "alpine",
                         "sh", "-c", "echo hello >/out/greeting", check=True)
                t.check("python: workload wrote result to volume", "hello\\n", t.volume_read(v, "greeting"))
                c = t.unique("pyexec")
                t.docker("run", "-d", "--rm", "--runtime", t.RUNTIME, *t.labels(), "--name", c, "--hostname", c, "alpine", "sleep", "600", check=True)
                t.cleanup_container(c)
                t.check_cmd("python: wait_for_exec", lambda: t.wait_for_exec(c, 30))
                t.check("python: exec output", c, t.docker("exec", c, "hostname").stdout.strip())
                t.finish()
                """))
            run_id = "selftest-%d" % os.getpid()
            r = ft.run("--mock", preflight=True, env={"RUNCVM_TEST_RUN_ID": run_id})
            self.assertEqual(r.rc, 1, r.out)
            self.assertEqual(r.status("t-wrong"), "fail")
            self.assertEqual(r.status("u-leaky-and-volumes"), "pass", r.out)
            self.assertEqual(r.status("v-hang"), "timeout")
            self.assertEqual(r.status("w-python-docker"), "pass", r.out)
            for kind in (["ps", "-aq"], ["network", "ls", "-q"], ["volume", "ls", "-q"]):
                left = subprocess.run(["docker"] + kind + ["--filter", "label=runcvm-test.run=" + run_id],
                                      stdout=subprocess.PIPE, universal_newlines=True).stdout.split()
                self.assertEqual(left, [], "leftover %s" % kind[0])
        finally:
            ft.cleanup()

    def test_concurrent_runs_do_not_clash(self):
        procs, dirs = [], []
        for i in (1, 2):
            d = tempfile.mkdtemp(prefix="runcvm-selftest-")
            dirs.append(d)
            procs.append(subprocess.Popen([RUNNER, "--mock", "--tier", "core", "--results", d],
                                          stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT,
                                          env=dict(os.environ, RUNCVM_TEST_RUN_ID="concurrent-%d-%d" % (os.getpid(), i))))
        try:
            for p in procs:
                self.assertEqual(p.wait(timeout=900), 0)
        finally:
            for d in dirs:
                shutil.rmtree(d, ignore_errors=True)


class _Result(unittest.TextTestResult):
    """Name each test once, as Class.method: the form accepted as an argument to run it alone."""

    def getDescription(self, test):
        return "%s.%s" % (type(test).__name__, test._testMethodName)


class _Runner(unittest.TextTestRunner):
    resultclass = _Result


if __name__ == "__main__":
    if "--docker" in sys.argv:
        WITH_DOCKER = True
        sys.argv.remove("--docker")
    unittest.main(verbosity=2, testRunner=_Runner)
