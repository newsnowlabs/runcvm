#!/usr/bin/env python3
"""The container's seccomp filter, and QEMU's disks under it.

Container/VMs with a disk each: with RUNCVM_SECCOMP unset, =engine-plus,
=minimal, =engine and =unconfined; with RUNCVM_SYS_ADMIN=1; and launched with --security-opt
seccomp=unconfined, for which the engine gives the container no profile (not a
supported way to run unconfined, but one that must still work). Five more:
with RUNCVM_SECCOMP unset, one with a disk and RUNCVM_DISK_AIO=native, and one
with no disk; with RUNCVM_SECCOMP=minimal, one with no disk, and two with a
disk and --security-opt seccomp=unconfined or --privileged. For each:

- The container's init (runcvm-ctr-entrypoint) and QEMU, on the host, are
  seccomp-filtered (Seccomp: 2 in their /proc/<pid>/status) under a
  profile, and not filtered (Seccomp: 0) when unconfined; RUNCVM_SECCOMP=minimal
  applies its profile even where the engine gives the container none. virtiofsd,
  which installs a seccomp filter of its own, is not a witness.
- QEMU opens the disk with aio=io_uring, unless RUNCVM_DISK_AIO=native forces
  aio=native, or the host's kernel.io_uring_disabled turns io_uring off for
  QEMU: 2; or 1, except with RUNCVM_SYS_ADMIN=1, which gives QEMU
  CAP_SYS_ADMIN. Then aio=native.
- The VM boots, and reads back a file written to the disk.
- QEMU holds an io_uring instance (which it uses for its event loop where it
  can) only where the profile allows io_uring's system calls, which it does
  only for a container with a disk that may use io_uring (not with no disk,
  nor with RUNCVM_DISK_AIO=native), under either profile, or with no
  profile; and where the host's kernel.io_uring_disabled lets QEMU use
  io_uring. QEMU's file descriptors are
  read through a short-lived container with the host's process namespace, as
  they are readable only by root.

- With RUNCVM_SECCOMP=minimal, the profile in the container's bundle is
  RunCVM's own: it denies every other system call with EPERM, and allows
  exactly the calls listed for the host's architecture
  (runcvm-scripts/seccomp/<arch>, with runcvm-scripts/seccomp/virtiofsd;
  scripts/seccomp/ in the package), with io_uring's only where allowed
  (above), except that clone is allowed only without the flags that create
  namespaces, and clone3 fails with ENOSYS. With RUNCVM_SECCOMP=engine, it is
  the engine's default profile with RunCVM's further calls in a final allow
  rule of their own, and in no rule that denies them: the engine's own
  profile for the same options, read from a standard (runc) container's
  bundle, with those calls taken out of its denying rules and nothing else
  changed. By default, and with RUNCVM_SECCOMP=engine-plus, it is the same,
  except that the calls listed in runcvm-scripts/seccomp/engine-plus-deny are
  also taken out of every rule allowing them, clone and clone3 out of every
  rule, rules left empty dropped, and minimal's two clone rules added before
  RunCVM's own: computed here from the engine's own profile and the list, and
  compared with the bundle's. The engine's own profile allows at least one
  listed call, so that the comparison shows the narrowing. Where unconfined,
  the bundle has no profile. Each bundle is read, as root, through a
  short-lived container with the host's process namespace.

The denylist names none of the calls listed for any architecture, nor
virtiofsd's: calls RunCVM's processes make.

A Container/VM with an invalid RUNCVM_SECCOMP value fails to start, with an
error naming the variable.

The init's process is found with docker inspect, QEMU's with docker top, and
their status read from the host's /proc.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

BOOT_TIMEOUT = 600 if t.ACCEL == "tcg" else 120
IMAGE = "alpine"
SIZE = 64 << 20
CASES = {
    "default": [],
    "engine-plus": ["--env", "RUNCVM_SECCOMP=engine-plus"],
    "minimal": ["--env", "RUNCVM_SECCOMP=minimal"],
    "engine": ["--env", "RUNCVM_SECCOMP=engine"],
    "sys-admin": ["--env", "RUNCVM_SYS_ADMIN=1"],
    "runcvm-unconfined": ["--env", "RUNCVM_SECCOMP=unconfined"],
    "unconfined": ["--security-opt", "seccomp=unconfined"],
    "aio-native": ["--env", "RUNCVM_DISK_AIO=native"],
    "no-disk": [],
    "minimal-no-disk": ["--env", "RUNCVM_SECCOMP=minimal"],
    "minimal-unconfined": ["--env", "RUNCVM_SECCOMP=minimal", "--security-opt", "seccomp=unconfined"],
    "minimal-privileged": ["--env", "RUNCVM_SECCOMP=minimal", "--privileged"],
}
DISKLESS = ("no-disk", "minimal-no-disk")
MINIMAL = ("minimal", "minimal-no-disk", "minimal-unconfined", "minimal-privileged")
CLONE_NAMESPACE_FLAGS = 0x7E020000
UNCONFINED = ("runcvm-unconfined", "unconfined")
ENGINE = ("engine",)
CLONE_RULES = [
    {"names": ["clone"], "action": "SCMP_ACT_ALLOW",
     "args": [{"index": 0, "value": CLONE_NAMESPACE_FLAGS, "valueTwo": 0, "op": "SCMP_CMP_MASKED_EQ"}]},
    {"names": ["clone3"], "action": "SCMP_ACT_ERRNO", "errnoRet": 38},
]


def io_uring_disabled():
    """The host's kernel.io_uring_disabled, or "0" where the kernel has no such setting."""
    try:
        with open("/proc/sys/kernel/io_uring_disabled") as f:
            return f.read().strip()
    except OSError:
        return "0"


def io_uring_usable(case):
    """Whether the host's kernel.io_uring_disabled lets QEMU in CASE use io_uring."""
    disabled = io_uring_disabled()
    return disabled == "0" or (disabled == "1" and case == "sys-admin")


def io_uring_allowed(case):
    """Whether the container's seccomp profile in CASE allows io_uring's system calls."""
    return case in UNCONFINED or (case not in DISKLESS and case != "aio-native")


def qemu_io_uring_fds(case, pid):
    """The number of io_uring instances QEMU (host PID) holds, or None if unreadable."""
    r = t.docker("run", "--rm", "--name", t.unique("seccomp-fds-" + case), *t.labels(), "--runtime=runc",
                 "--privileged",
                 "--pid=host", IMAGE, "sh", "-c",
                 # QEMU opens and closes descriptors as it runs, so ls may fail on one that goes
                 # between its listing and its reading; the directory's presence is the test.
                 "ls -l /proc/%s/fd 2>/dev/null; test -d /proc/%s/fd" % (pid, pid))
    return r.stdout.count("anon_inode:[io_uring]") if r.returncode == 0 else None


IO_URING = {"io_uring_setup", "io_uring_enter", "io_uring_register"}
ENGINE_ADDED = {"chroot"}


def list_names(*files):
    """The system calls named in RunCVM's lists FILES (in scripts/seccomp), or None if one is
    unreadable."""
    seccomp = os.path.join(t.scripts_dir(), "seccomp")
    names = set()
    for f in files:
        try:
            with open(os.path.join(seccomp, f)) as lines:
                names.update(line.strip() for line in lines
                             if line.strip() and not line.startswith(("#", "virtiofsd-version")))
        except OSError:
            return None
    return names


def listed_calls():
    """The system calls RunCVM lists for this host's architecture (with virtiofsd's), or None
    where it lists none."""
    return list_names(os.uname().machine, "virtiofsd")


DENIED = list_names("engine-plus-deny")


def engine_plus(rules, added):
    """The rules engine-plus makes of the engine's RULES, RunCVM's calls ADDED being allowed."""
    out = []
    for rule in rules:
        drop = {"clone", "clone3"} | (DENIED if rule.get("action") == "SCMP_ACT_ALLOW" else added)
        names = [n for n in rule["names"] if n not in drop]
        if names:
            out.append(dict(rule, names=names))
    return out + CLONE_RULES


def expected_aio(case):
    """The aio mode QEMU should use for disks in CASE on this host."""
    if case == "aio-native":
        return "native"
    disabled = io_uring_disabled()
    if disabled == "2" or (disabled == "1" and case != "sys-admin"):
        return "native"
    return "io_uring"


def bundle_seccomp(name):
    """The seccomp section of container NAME's bundle: a dict, {} where it has none, or None if
    the bundle could not be read."""
    config = t.bundle_config(name)
    return None if config is None else config.get("linux", {}).get("seccomp") or {}


def seccomp_mode(pid):
    """The Seccomp field of /proc/PID/status on the host, or None if unreadable."""
    return t.proc_status(pid).get("Seccomp")


def run(case):
    volume = t.unique("seccomp-" + case)
    t.volume_create(volume)
    name = t.unique("seccomp-" + case)
    t.cleanup_container(name)
    results = {}

    disk = [] if case in DISKLESS else ["--mount", "type=volume,src=%s,dst=/disks" % volume,
                                        "--env", "RUNCVM_DISKS=/disks/d,/srv/d,ext4,%d" % SIZE]
    r = t.docker("run", "-d", "--name", name, *t.labels(), "--runtime=" + t.RUNTIME, *t.vm_opts(),
                 *CASES[case], *disk, IMAGE, "sleep", "infinity")
    if r.returncode != 0 or not t.wait_for_exec(name, BOOT_TIMEOUT):
        results["error"] = r.stdout + t.docker("logs", name).stdout
        return results

    results["init"] = seccomp_mode(t.docker("inspect", "-f", "{{.State.Pid}}", name).stdout.strip())
    results["profile"] = bundle_seccomp(name)
    if case not in MINIMAL and case not in UNCONFINED:
        # The engine's own profile for the same options, from a standard (runc) container.
        twin = t.unique("seccomp-engine-" + case)
        t.cleanup_container(twin)
        if t.docker("run", "-d", "--name", twin, *t.labels(), "--runtime=runc", *CASES[case],
                    IMAGE, "sleep", "infinity").returncode == 0:
            results["engine_profile"] = bundle_seccomp(twin)
    for pid, args in t.host_processes(name):
        if "qemu-system" in args:
            results["qemu"] = (seccomp_mode(pid), args)
            results["io_uring_fds"] = qemu_io_uring_fds(case, pid)
            break

    if case not in DISKLESS:
        r = t.docker("exec", name, "sh", "-c", "echo written >/srv/d/f && sync && cat /srv/d/f")
        results["disk"] = r.stdout.strip()
    results["logs"] = t.docker("logs", name).stdout
    return results


t.param("seccomp", ", ".join(CASES))
t.param("kernel.io_uring_disabled", io_uring_disabled())
for case, results in zip(CASES, t.parallel(run, list(CASES), remove=True)):
    aio = expected_aio(case)
    if "error" in results:
        t.check("%s: Container/VM started" % case, True, False)
        t.log(results["error"])
        continue

    filtered = "0" if case in UNCONFINED else "2"
    qemu_mode, qemu_args = results.get("qemu", (None, ""))
    t.check("%s: init's Seccomp mode" % case, filtered, results["init"])
    t.check("%s: QEMU's Seccomp mode" % case, filtered, qemu_mode)
    listed = listed_calls()
    profile = results.get("profile")
    if t.check("%s: bundle's seccomp profile read" % case, True, profile is not None):
        if case in UNCONFINED:
            t.check("%s: bundle has no seccomp profile" % case, {}, profile)
        elif case not in MINIMAL:
            plus = case not in ENGINE
            rules = profile.get("syscalls", [])
            added = rules[-1].get("names", []) if rules else []
            expected = ENGINE_ADDED | (IO_URING if io_uring_allowed(case) else set())
            t.check("%s: engine's profile kept, with its own rules" % case, True, len(rules) > 1)
            t.check("%s: RunCVM's calls added to the engine's profile" % case, sorted(expected), sorted(added))
            t.check("%s: RunCVM's rule allows" % case, "SCMP_ACT_ALLOW", rules[-1].get("action") if rules else None)
            denying = sorted(set(n for rule in rules if rule.get("action") != "SCMP_ACT_ALLOW"
                                 for n in rule.get("names", [])) & expected)
            t.check("%s: no rule denies RunCVM's calls" % case, [], denying)
            original = results.get("engine_profile")
            if t.check("%s: engine's own profile read" % case, True, bool(original)):
                if plus:
                    allowing = set(n for rule in original.get("syscalls") or []
                                   if rule.get("action") == "SCMP_ACT_ALLOW" for n in rule["names"])
                    t.check("%s: engine's own profile allows calls engine-plus denies" % case, True,
                            bool(allowing & (DENIED or set())))
                    t.check("%s: engine's rules less the denylist and clone, then the clone rules" % case,
                            engine_plus(original.get("syscalls") or [], expected), rules[:-1])
                    still = sorted(set(n for rule in rules if rule.get("action") == "SCMP_ACT_ALLOW"
                                       for n in rule.get("names", [])) & (DENIED or set()))
                    t.check("%s: no rule allows a denied call" % case, [], still)
                else:
                    kept = [dict(rule, names=[n for n in rule["names"] if n not in expected])
                            if rule.get("action") != "SCMP_ACT_ALLOW" else rule
                            for rule in original.get("syscalls") or []]
                    kept = [rule for rule in kept if rule.get("names")]
                    t.check("%s: engine's rules kept, less denials of RunCVM's calls" % case, kept, rules[:-1])
                t.check("%s: engine's profile otherwise unchanged" % case,
                        {k: v for k, v in original.items() if k != "syscalls"},
                        {k: v for k, v in profile.items() if k != "syscalls"})
        else:
            rules = profile.get("syscalls", [])
            t.check("%s: profile denies unlisted calls with EPERM" % case, ("SCMP_ACT_ERRNO", 1),
                    (profile.get("defaultAction"), profile.get("defaultErrnoRet")))
            expected = ((listed or set()) - {"clone", "clone3"}) | (IO_URING if io_uring_allowed(case) else set())
            t.check("%s: profile has RunCVM's three rules" % case, 3, len(rules))
            general = rules[0] if rules else {}
            t.check("%s: first rule allows" % case, "SCMP_ACT_ALLOW", general.get("action"))
            names = set(general.get("names", []))
            if not t.check("%s: first rule allows exactly the listed calls, less clone and clone3" % case,
                           True, names == expected and "args" not in general):
                t.log("%s: allowed but not listed: %s; listed but not allowed: %s"
                      % (case, " ".join(sorted(names - expected)) or "-",
                         " ".join(sorted(expected - names)) or "-"))
            t.check("%s: second rule allows clone only without namespace flags" % case,
                    {"names": ["clone"], "action": "SCMP_ACT_ALLOW",
                     "args": [{"index": 0, "value": CLONE_NAMESPACE_FLAGS, "valueTwo": 0, "op": "SCMP_CMP_MASKED_EQ"}]},
                    rules[1] if len(rules) > 1 else None)
            t.check("%s: third rule makes clone3 fail with ENOSYS" % case,
                    {"names": ["clone3"], "action": "SCMP_ACT_ERRNO", "errnoRet": 38},
                    rules[2] if len(rules) > 2 else None)
    holds = io_uring_allowed(case) and io_uring_usable(case)
    fds = results.get("io_uring_fds")
    if t.check("%s: QEMU's file descriptors read" % case, True, fds is not None):
        t.check("%s: QEMU holds an io_uring instance" % case, holds, fds > 0)
    if case in DISKLESS:
        continue
    t.check("%s: QEMU's disk uses aio=%s" % (case, aio), True, ("aio=%s," % aio) in qemu_args)
    t.check("%s: disk reads back what was written" % case, "written", results["disk"])
    if aio == "io_uring":
        t.check("%s: no warning that io_uring is unused" % case, False,
                "io_uring is not used for disks" in results["logs"])

t.check("engine-plus's denylist read", True, bool(DENIED))
for f in ("x86_64", "aarch64", "virtiofsd"):
    t.check("engine-plus's denylist names no call in scripts/seccomp/%s" % f, [],
            sorted((DENIED or set()) & (list_names(f) or set())))

name = t.unique("seccomp-invalid")
r = t.docker("run", "--rm", "--name", name, *t.labels(), "--runtime=" + t.RUNTIME, *t.vm_opts(),
             "--env", "RUNCVM_SECCOMP=bogus", IMAGE, "true")
t.check("invalid RUNCVM_SECCOMP: Container/VM fails to start", True, r.returncode != 0)
t.check("invalid RUNCVM_SECCOMP: error names RUNCVM_SECCOMP", True, "RUNCVM_SECCOMP" in (r.stdout or ""))

t.finish()
