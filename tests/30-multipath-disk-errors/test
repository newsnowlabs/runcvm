# A disk at /usr/share and one at /usr/share/apk: (name, RUNCVM_DISKS, the outer disk's position in
# RUNCVM_DISKS). Each has layout 'subdirs', so the outer disk's directory for /usr/share/apk is
# /.runcvm/disks/<n>/usr-share/apk. (An xfs filesystem needs at least 300M.)
POPULATED = [
    ("ext4-outer-first", "/disks/a,/usr/share,ext4,64M;/disks/b,/usr/share/apk,ext4,16M", 0),
    ("ext4-outer-last", "/disks/b,/usr/share/apk,ext4,16M;/disks/a,/usr/share,ext4,64M", 1),
    ("xfs-outer-first", "/disks/a,/usr/share,xfs,320M;/disks/b,/usr/share/apk,ext4,16M", 0),
    ("xfs-outer-last", "/disks/b,/usr/share/apk,ext4,16M;/disks/a,/usr/share,xfs,320M", 1),
]

# Prints the entries of the outer disk's directory for /usr/share/apk, then its mode, then the
# number of entries in /usr/share/apk/keys.
POPULATED_PROBE = ('d=/.runcvm/disks/$1/usr-share/apk; echo "entries=$(ls -A "$d" | tr "\\n" " ")"; '
                   'echo "mode=$(stat -c %a "$d")"; '
                   'echo "keys=$(ls /usr/share/apk/keys | wc -l)"')

# Prints, for each path given, its device number and filesystem type.
PROBE = 'for p in "$@"; do echo "$p $(stat -c %d "$p") $(stat -f -c %T "$p")"; done'


def run_across(case):
    name, disks, opts = case[:3]
    volume = t.unique("across-" + name)
    t.volume_create(volume)
    return t.docker("run", "--rm", "--name", t.unique(name), *t.labels(), "--runtime=" + t.RUNTIME,
                    *t.vm_opts(), "--mount", "type=volume,src=%s,dst=/disks" % volume, *opts,
                    "--env", "RUNCVM_DISKS=" + disks, "alpine", "true", timeout=TIMEOUT)


def run_layered(case):
    (name, disks, opts, expected), init = case
    name += "-init" if init else "-noinit"
    volume = t.unique("layered-" + name)
    t.volume_create(volume)
    paths = list(expected) + ["/.runcvm/disks/%d" % n for n in range(disks.count(";") + 1)]
    return t.docker("run", "--rm", "--name", t.unique(name), *t.labels(), "--runtime=" + t.RUNTIME,
                    *t.vm_opts(), *(["--init"] if init else []),
                    "--mount", "type=volume,src=%s,dst=/disks" % volume, *opts,
                    "--env", "RUNCVM_DISKS=" + disks, "alpine", "sh", "-c", PROBE, "sh", *paths,
                    timeout=TIMEOUT)


def run_populated(case):
    name, disks, outer = case
    volume = t.unique("populated-" + name)
    t.volume_create(volume)
    return t.docker("run", "--rm", "--name", t.unique(name), *t.labels(), "--runtime=" + t.RUNTIME,
                    *t.vm_opts(), "--mount", "type=volume,src=%s,dst=/disks" % volume,
                    "--env", "RUNCVM_DISKS=" + disks, "alpine", "sh", "-c", POPULATED_PROBE, "sh", str(outer),
                    timeout=TIMEOUT)


def run_invalid(case):
    name, disks, _ = case
    return t.docker("run", "--rm", "--name", t.unique(name), *t.labels(), "--runtime=" + t.RUNTIME,
                    *t.vm_opts(), "--env", "RUNCVM_DISKS=" + disks, "alpine", "true", timeout=TIMEOUT)


def run_changed(case):
    """Create a disk with spec 'first', then use it with spec 'second'; return both runs' results."""
    name, first, second = case[:3]
    volume = t.unique("changed-" + name)
    t.volume_create(volume)
    results = []
    for disks in (first, second):
        results.append(t.docker("run", "--rm", "--name", t.unique(name), *t.labels(), "--runtime=" + t.RUNTIME,
                                *t.vm_opts(), "--mount", "type=volume,src=%s,dst=/disks" % volume,
                                "--env", "RUNCVM_DISKS=" + disks, "alpine", "sh", "-c",
                                "awk '$5 ~ \"^/(srv|home)\" { print $4, $5 }' /proc/self/mountinfo | sort",
                                timeout=TIMEOUT))
    return results


for (name, disks, opts, spec, message), r in zip(ACROSS, t.parallel(run_across, ACROSS)):
    t.check("%s: exit status" % name, 1, r.returncode)
    if not t.check("%s: error message" % name, True, ("disk spec '%s' invalid: %s" % (spec, message)) in r.stdout):
        t.log("output:\n%s" % r.stdout)

LAYERED_RUNS = [(case, init) for case in LAYERED for init in (False, True)]
t.param("init", "no, yes")
for ((name, disks, opts, expected), init), r in zip(LAYERED_RUNS, t.parallel(run_layered, LAYERED_RUNS)):
    name += ", --init" if init else ", no --init"
    if not t.check("%s: exit status" % name, 0, r.returncode):
        t.log("output:\n%s" % r.stdout)
        continue
    probed = {}
    for line in r.stdout.replace("\r", "").splitlines():
        fields = line.split()
        if len(fields) == 3:
            probed[fields[0]] = (fields[1], fields[2])
    for path, where in expected.items():
        if where == "tmpfs":
            t.check("%s: %s is the tmpfs mount" % (name, path), "tmpfs", probed.get(path, (None, None))[1])
        else:
            disk = probed.get("/.runcvm/disks/%d" % where, (None, None))[0]
            t.check("%s: %s is on disk %d" % (name, path, where), True,
                    disk is not None and probed.get(path, (None, None))[0] == disk)

for (name, disks, outer), r in zip(POPULATED, t.parallel(run_populated, POPULATED)):
    if not t.check("%s: exit status" % name, 0, r.returncode):
        t.log("output:\n%s" % r.stdout)
        continue
    values = dict(line.split("=", 1) for line in r.stdout.replace("\r", "").splitlines() if "=" in line)
    t.check("%s: outer disk's directory for /usr/share/apk is empty" % name, "", values.get("entries", "?").strip())
    t.check("%s: and has the image's directory's mode" % name, "755", values.get("mode"))
    t.check("%s: /usr/share/apk/keys, on the inner disk, holds the image's keys" % name, True,
            values.get("keys", "0").strip() not in ("", "0"))

for (name, disks, message), r in zip(INVALID, t.parallel(run_invalid, INVALID)):
    t.check("%s: exit status" % name, 1, r.returncode)
    if not t.check("%s: error message" % name, True, ("disk spec '%s' invalid: %s" % (disks, message)) in r.stdout):
        t.log("output:\n%s" % r.stdout)

