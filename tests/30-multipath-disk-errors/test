#!/usr/bin/env python3
"""RUNCVM_DISKS: invalid disk specs, and disks whose spec changes.

- A spec with layout 'subdirs' whose destinations overlap (one is the same
  as, or an ancestor of, another, including through the image's symbolic
  links /var/run and /var/lock), or which has an empty, relative, '..',
  whitespace-containing or /lost+found destination; layout 'root' with several
  destinations; an unknown or repeated option; or a filesystem not listed in
  disk-filesystems: the Container/VM exits with status 1, reporting the
  invalid spec.
- An existing disk keeps the layout and filesystem it was created with: a
  spec giving the other layout, several destinations for a disk with layout
  'root', or another filesystem, is rejected in the same way.
- Adding a destination to an existing disk with layout 'subdirs': the VM
  reports that the disk has no directory for the destination, and the
  Container/VM exits with status 1.
- An existing disk with layout 'subdirs' whose file system cannot be mounted
  (zeroed from the end of its superblock to 64KiB, so including its block
  group descriptors): the VM reports the disk's mountpoint and its
  destination as left unmounted, not a missing directory, and the
  Container/VM exits with status 1.
- Leaving destinations out of an existing disk's spec, down to one, or
  reusing a disk created with a keyed spec (whose destination contains ':'):
  the Container/VM runs, with the remaining destinations mounted.
- Keyed specs (whose keys include Docker's aliases 'source', 'target' and
  'destination') with a repeated or unknown key, a field without '=', no dst
  or overlapping destinations are rejected likewise.
- Across disks and tmpfs mounts: two disks with one destination, or a disk
  and a tmpfs mount with one destination: the Container/VM exits with
  status 1, reporting the disk's spec, before creating that disk.
- Nested disks and tmpfs mounts, in either order in RUNCVM_DISKS (including
  through the image's symbolic link /var/run), a tmpfs mount above or below
  a disk, and destinations sharing only a prefix (/home and /homes): the
  Container/VM runs, with and without --init, and each path is on the
  intended disk or tmpfs, as a deeper mount is mounted over a shallower one.
- A new disk leaves out another disk's destination below its own, holding an
  empty directory there with the directory's mode, whichever is listed first,
  for an ext4 and an xfs outer disk (populated by mke2fs and in the VM): with
  disks at /usr/share and /usr/share/apk, the outer disk's apk directory is
  empty, and /usr/share/apk, on the inner disk, holds the image's keys.
"""

import os
import sys

