]

# Nested disks and tmpfs mounts: (name, RUNCVM_DISKS, further docker run options, {path: the disk
# expected there, by its position in RUNCVM_DISKS, or "tmpfs"}). Every disk has layout 'subdirs',
# so it is mounted at /.runcvm/disks/<n>, whose device a path on it shares.
LAYERED = [
    ("outer-disk-first", "/disks/a,/home,ext4,16M;/disks/b,/home/b,ext4,16M", [],
     {"/home": 0, "/home/b": 1}),
