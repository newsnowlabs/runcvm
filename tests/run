#!/usr/bin/env python3
"""RunCVM integration test runner.

Runs each test (a directory under the tests directory containing an
executable 'test' file, in any language), records an honest status for each,
writes per-test logs and machine-readable results, and exits non-zero if any
selected test failed or timed out.

Test status comes from the test's exit code:
  0       pass
  77      skipped (a prerequisite is absent; the test logs 'SKIP: <reason>')
  other   fail
A test still running at its time limit is stopped (SIGTERM to its whole
process group, then SIGKILL after a grace period) and recorded as timed out.

Runner exit codes:
  0    all selected tests passed or were skipped
  1    one or more tests failed or timed out
  2    harness error (bad arguments, no tests selected, unknown tier or
       requirement, Docker or runtime unavailable)
  130  interrupted (SIGINT, e.g. Ctrl-C)
  143  terminated (SIGTERM)
On SIGINT or SIGTERM, the test in progress is stopped and the results so far
are written. SIGHUP is ignored, so the run continues if the terminal goes away
(e.g. a dropped SSH session); output to the terminal is then discarded, while
logs and results are written as normal.

Results files (results.tap, junit.xml, results.json, summary.txt, status) are
rewritten before and after each test, so they always show the run's progress:
until the run ends, results.json has "complete": false and status reads
'running', and while a test runs, summary.txt and results.json name it.

Optional per-test metadata files, in each test directory:
  tier      'core' (default) or 'extended'
  timeout   time limit in seconds (overrides --timeout)
  requires  whitespace-separated requirements; a test whose requirements are
            not met is skipped without running:
              vm    real RunCVM Container/VMs (not met in stand-in mode)
              kvm   VMs use KVM acceleration: /dev/kvm present on this host,
                    and not in stand-in mode or with --accel tcg
              ipv6  dockerd can create an IPv6-enabled network
              docker>=<major>.<minor>
                    dockerd's version is at least <major>.<minor>, e.g.
                    docker>=29.0

Container engine (--engine docker|podman, or RUNCVM_TEST_ENGINE; default
docker). With podman, tests/engines/podman goes first in PATH, so that the
runner's and the tests' 'docker' commands run rootful Podman (through sudo
when not root), and RunCVM must be registered with Podman in
/etc/containers/containers.conf. Tests see RUNCVM_TEST_ENGINE, and
'docker>=<major>.<minor>' requirements are not met.

Stand-in mode (--mock, or RUNCVM_TEST_MOCK=1) runs tests with a standard
runtime (runc, unless --runtime or a non-RunCVM $RUNTIME is given) in place
of RunCVM, for developing the tests and the runner where KVM is unavailable.
Tests requiring 'vm' are skipped, and tests see RUNCVM_TEST_MOCK=1.

QEMU acceleration (--accel kvm|auto|tcg, or RUNCVM_TEST_ACCEL) is passed to
tests as RUNCVM_TEST_ACCEL; tests pass it to RunCVM Container/VMs as
RUNCVM_QEMU_ACCEL (framework helper vm_opts). With --accel tcg, real RunCVM
Container/VMs run under software emulation, e.g. where KVM is unavailable:
slow, but unlike stand-in mode it exercises RunCVM itself. Unset, RunCVM's
default applies.

TCG cases (--tcg-cases, or RUNCVM_TEST_TCG_CASES=1) are checks that launch a
Container/VM explicitly under software emulation, whatever --accel says. They
are slow, so a test runs them only when the runner sets RUNCVM_TEST_TCG_CASES
to 1 (framework helper tcg_cases): when asked to, or when VMs do not use KVM
anyway (--accel tcg, or no /dev/kvm). Otherwise the test records them as
skipped.

Detail lines (framework helper log_detail) record step-by-step progress, such
as each of many requests' outcomes. They are written to the test's log, but to
the terminal only with --verbose (or RUNCVM_TEST_VERBOSE=1). A detail line is
one that starts with the ASCII record separator (0x1e), which the runner
removes.

Requires only Python 3.6+ and the docker CLI.
"""

import argparse
import fnmatch
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
import xml.etree.ElementTree as ET

SKIP_CODE = 77
TIERS = ("core", "extended")
KNOWN_REQUIREMENTS = ("vm", "kvm", "ipv6")
DOCKER_VERSION_REQUIREMENT = re.compile(r"^docker>=(\d+)\.(\d+)$")
ACCELS = ("kvm", "auto", "tcg")
DEFAULT_TIMEOUT = 1800
DEFAULT_KILL_AFTER = 30


class HarnessError(Exception):
    pass


# ---------------------------------------------------------------------------
# Test discovery and selection
# ---------------------------------------------------------------------------

def read_meta(test_dir, name):
    path = os.path.join(test_dir, name)
    if not os.path.isfile(path):
        return None
    with open(path) as f:
        return f.read().strip()


class Test:
    def __init__(self, tests_dir, name, default_timeout):
        self.name = name
        self.dir = os.path.join(tests_dir, name)
        self.tier = (read_meta(self.dir, "tier") or "core").split()[0]
        timeout = read_meta(self.dir, "timeout")
        self.timeout = int(timeout) if timeout and timeout.isdigit() else default_timeout
        self.requires = (read_meta(self.dir, "requires") or "").split()


def discover(tests_dir, default_timeout):
    tests = []
    for name in sorted(os.listdir(tests_dir)):
        path = os.path.join(tests_dir, name, "test")
        if os.path.isfile(path) and os.access(path, os.X_OK):
            tests.append(Test(tests_dir, name, default_timeout))
    return tests


def select(tests, tier, patterns):
    by_name = {t.name: t for t in tests}
    for p in patterns:
        if not any(c in p for c in "*?[") and p not in by_name:
            raise HarnessError("test '%s' not found" % p)
    selected = []
    for t in tests:
        if patterns and not any(fnmatch.fnmatchcase(t.name, p) for p in patterns):
            continue
        if tier != "all" and t.tier != tier:
            continue
        selected.append(t)
    return selected


# ---------------------------------------------------------------------------
# Environment: Docker checks, requirements, clean-up
# ---------------------------------------------------------------------------

def docker(*args, timeout=60):
    """Run a docker CLI command; return a CompletedProcess (never raises on failure)."""
    try:
        return subprocess.run(("docker",) + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              universal_newlines=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(("docker",) + args, 255, "", str(e))


def warn(msg):
    print("%s: Warning: %s" % (os.path.basename(sys.argv[0]), msg), file=sys.stderr, flush=True)


class Environment:
    def __init__(self, runtime, mock, run_id, use_docker, accel=None, tcg_cases=False, engine="docker"):
        self.engine = engine
        self.runtime = runtime
        self.mock = mock
        self.accel = accel
        # TCG cases run when asked for, or when VMs do not use KVM anyway
        self.tcg_cases = tcg_cases or self.accel == "tcg" or not os.path.exists("/dev/kvm")
        self.run_id = run_id
        self.use_docker = use_docker
        self._probes = {}
        self._probe_notes = {}  # requirement -> why it is unmet, where known

    def preflight(self):
        if self.engine == "podman":
            # Podman's info names only its default OCI runtime, not those in containers.conf.
            r = docker("info", "--format", "{{.Version.Version}}")
            if r.returncode != 0:
                raise HarnessError("cannot run rootful Podman ('podman info' failed: %s)"
                                   % (r.stderr.strip().splitlines() or ["?"])[-1])
            r = docker("run", "--rm", "--runtime", self.runtime, "--help")
            if r.returncode != 0:
                raise HarnessError("Podman cannot use runtime '%s'" % self.runtime)
            return
        if docker("info", "--format", "{{json .ServerVersion}}").returncode != 0:
            raise HarnessError("cannot reach the Docker daemon ('docker info' failed)")
        r = docker("info", "--format", "{{json .Runtimes}}")
        try:
            runtimes = json.loads(r.stdout or "{}")
        except ValueError:
            runtimes = {}
        if self.runtime not in runtimes:
            raise HarnessError("runtime '%s' is not registered with Docker (registered: %s)"
                               % (self.runtime, ", ".join(sorted(runtimes)) or "none"))
        if (not self.mock and self.runtime.startswith("runcvm") and not os.path.exists("/dev/kvm")
                and self.accel in (None, "kvm")):
            warn("/dev/kvm not found: RunCVM VMs will fail unless emulation is allowed "
                 "(try --accel tcg, or --mock for stand-in mode)")

    def requirement_met(self, req):
        if req not in self._probes:
            self._probes[req] = self._probe(req)
        return self._probes[req]

    def _probe(self, req):
        if req == "vm":
            return not self.mock
        if req == "kvm":
            return not self.mock and self.accel != "tcg" and os.path.exists("/dev/kvm")
        if req == "ipv6":
            if not self.use_docker:
                return False
            # A random unique-local subnet, so that concurrent runs, or an existing
            # network on the same subnet, cannot make the probe fail.
            subnet = "fd%02x:%04x:%04x::/64" % tuple(int.from_bytes(os.urandom(n), "big") for n in (1, 2, 2))
            name = "rcvt-%s-ipv6-probe" % self.run_id
            r = docker("network", "create", "--ipv6", "--subnet", subnet,
                       "--label", "runcvm-test.run=%s" % self.run_id, name)
            if r.returncode == 0:
                docker("network", "rm", name)
                return True
            err = [l for l in (r.stderr or "").splitlines() if l.strip() and l.strip() != "exit status 1"]
            self._probe_notes[req] = "could not create an IPv6 network%s" % (": " + err[-1].strip() if err else "")
            return False
        m = DOCKER_VERSION_REQUIREMENT.match(req)
        if m:
            if not self.use_docker:
                return False
            if self.engine != "docker":
                self._probe_notes[req] = "the engine is %s, not Docker" % self.engine
                return False
            r = docker("info", "--format", "{{.ServerVersion}}")
            version = (r.stdout or "").strip()
            v = re.match(r"(\d+)\.(\d+)", version)
            if r.returncode != 0 or not v:
                self._probe_notes[req] = "could not read dockerd's version"
                return False
            if (int(v.group(1)), int(v.group(2))) >= (int(m.group(1)), int(m.group(2))):
                return True
            self._probe_notes[req] = "dockerd is %s" % version
            return False
        raise HarnessError("unknown requirement '%s'" % req)

    def reap(self, test_name):
        """Remove anything left behind that carries this run's and test's labels."""
        if not self.use_docker:
            return
        filters = ("--filter", "label=runcvm-test.run=%s" % self.run_id,
                   "--filter", "label=runcvm-test.test=%s" % test_name)
        ids = docker("ps", "-aq", *filters).stdout.split()
        if ids:
            docker("rm", "-fv", *ids, timeout=120)
        ids = docker("network", "ls", "-q", *filters).stdout.split()
        if ids:
            docker("network", "rm", *ids)
        ids = docker("volume", "ls", "-q", *filters).stdout.split()
        if ids:
            docker("volume", "rm", "-f", *ids)
        ids = docker("image", "ls", "-q", *filters).stdout.split()
        if ids:
            docker("image", "rm", "-f", *ids)


# ---------------------------------------------------------------------------
# Running a test
# ---------------------------------------------------------------------------

class Result:
    def __init__(self, test, status, rc=None, duration=0, reason=""):
        self.test = test
        self.status = status          # pass, fail, skip, timeout, interrupted
        self.rc = rc
        self.duration = duration
        self.reason = reason
        self.checks = []              # [(STATUS, description)]
        self.params = []              # [(key, value)]


def read_pairs(path):
    pairs = []
    if os.path.isfile(path):
        with open(path, errors="replace") as f:
            for line in f:
                line = line.rstrip("\n")
                if line:
                    a, _, b = line.partition("\t")
                    pairs.append((a, b))
    return pairs


_terminal_ok = True


def terminal_gone():
    """Stop writing to the terminal, and point stdout at /dev/null.

    A failed write can leave bytes in sys.stdout's buffer, and Python flushes it once more at exit:
    if that flush fails, Python exits with status 120 in place of the run's own. With stdout on
    /dev/null, the flush succeeds and the bytes are discarded.
    """
    global _terminal_ok
    _terminal_ok = False
    try:
        fd = os.open(os.devnull, os.O_WRONLY)
        os.dup2(fd, sys.stdout.fileno())
        os.close(fd)
    except (OSError, ValueError):
        pass


def say(text="", end="\n"):
    """Print to the terminal; once that fails (e.g. the terminal has gone away), stop trying."""
    if _terminal_ok:
        try:
            sys.stdout.write(text + end)
            sys.stdout.flush()
        except OSError:
            terminal_gone()


def say_bytes(data):
    if _terminal_ok:
        try:
            sys.stdout.buffer.write(data)
            sys.stdout.buffer.flush()
        except OSError:
            terminal_gone()


def signal_group(pgid, sig):
    try:
        os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError):
        pass


# Marks a line of a test's output as a detail line, shown on the terminal only with --verbose (see
# log_detail in framework.sh and framework.py).
DETAIL_MARK = b"\x1e"


def run_test(test, env, logs_dir, kill_after, verbose=False):
    log_path = os.path.join(logs_dir, test.name + ".log")
    checks_path = os.path.join(logs_dir, test.name + ".checks")
    params_path = os.path.join(logs_dir, test.name + ".params")
    for p in (checks_path, params_path):
        open(p, "w").close()

    child_env = dict(os.environ)
    child_env.update({
        "RUNTIME": env.runtime,
        "RUNCVM_TEST_ENGINE": env.engine,
        "RUNCVM_TEST_MOCK": "1" if env.mock else "0",
        "RUNCVM_TEST_ACCEL": env.accel or "",
        "RUNCVM_TEST_TCG_CASES": "1" if env.tcg_cases else "0",
        "RUNCVM_TEST_RUN_ID": env.run_id,
        "RUNCVM_TEST_NAME": test.name,
        "RUNCVM_TEST_CHECKS": checks_path,
        "RUNCVM_TEST_PARAMS": params_path,
    })

    start = time.time()
    proc = subprocess.Popen(["./test"], cwd=test.dir, env=child_env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
    pgid = proc.pid
    prefix = (test.name + " - ").encode()
    skip_reason = []

    def pump():
        with open(log_path, "wb") as log:
            for line in iter(proc.stdout.readline, b""):
                detail = line.startswith(DETAIL_MARK)
                if detail:
                    line = line[len(DETAIL_MARK):]
                log.write(line)
                log.flush()
                if verbose or not detail:
                    say_bytes(prefix + line)
                m = re.search(rb"SKIP: (.*)", line)
                if m and not skip_reason:
                    skip_reason.append(m.group(1).decode(errors="replace").strip())

    reader = threading.Thread(target=pump, daemon=True)
    reader.start()

    timed_out = False
    try:
        try:
            proc.wait(timeout=test.timeout)
        except subprocess.TimeoutExpired:
            timed_out = True
            signal_group(pgid, signal.SIGTERM)
            try:
                proc.wait(timeout=kill_after)
            except subprocess.TimeoutExpired:
                signal_group(pgid, signal.SIGKILL)
                proc.wait()
    except (KeyboardInterrupt, Terminated):
        signal_group(pgid, signal.SIGTERM)
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            signal_group(pgid, signal.SIGKILL)
            proc.wait()
        raise
    finally:
        # Stop anything the test left running in its process group (e.g. a
        # backgrounded 'docker logs -f'), so that it cannot hold the output
        # pipe open or outlive the test.
        signal_group(pgid, signal.SIGTERM)
        reader.join(5)
        if reader.is_alive():
            signal_group(pgid, signal.SIGKILL)
            reader.join(5)

    duration = int(round(time.time() - start))
    raw = proc.returncode
    rc = 128 - raw if raw is not None and raw < 0 else raw

    if timed_out:
        result = Result(test, "timeout", rc, duration, "timed out after %ss" % test.timeout)
    elif rc == 0:
        result = Result(test, "pass", rc, duration)
    elif rc == SKIP_CODE:
        result = Result(test, "skip", rc, duration, skip_reason[0] if skip_reason else "skipped")
    elif raw is not None and raw < 0:
        result = Result(test, "fail", rc, duration, "killed by signal %d" % -raw)
    else:
        result = Result(test, "fail", rc, duration, "exit code %d" % rc)

    result.checks = read_pairs(checks_path)
    result.params = read_pairs(params_path)
    return result


# ---------------------------------------------------------------------------
# Results
# ---------------------------------------------------------------------------

CONTROL_CHARS = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f]")


def tail(path, lines=200):
    try:
        with open(path, errors="replace") as f:
            return CONTROL_CHARS.sub("", "".join(f.readlines()[-lines:]))
    except OSError:
        return ""


def write_tap(path, results, header):
    out = ["TAP version 13", "1..%d" % len(results), "# " + header]
    for n, r in enumerate(results, 1):
        if r.checks:
            out.append("    1..%d" % len(r.checks))
            for m, (status, desc) in enumerate(r.checks, 1):
                if status == "PASS":
                    out.append("    ok %d - %s" % (m, desc))
                elif status == "SKIP":
                    out.append("    ok %d - %s # SKIP" % (m, desc))
                else:
                    out.append("    not ok %d - %s" % (m, desc))
        if r.status == "pass":
            out.append("ok %d - %s" % (n, r.test.name))
        elif r.status == "skip":
            out.append("ok %d - %s # SKIP %s" % (n, r.test.name, r.reason))
        else:
            out.append("not ok %d - %s # %s" % (n, r.test.name, r.reason))
    with open(path, "w") as f:
        f.write("\n".join(out) + "\n")


def write_junit(path, results, env, logs_dir):
    total = sum(1 + len(r.checks) for r in results)
    root = ET.Element("testsuites", name="runcvm", tests=str(total))
    for r in results:
        suite = ET.SubElement(root, "testsuite", name=r.test.name, time=str(r.duration))
        props = ET.SubElement(suite, "properties")
        for k, v in [("runtime", env.runtime), ("mock", "1" if env.mock else "0"),
                     ("accel", env.accel or ""), ("tcg_cases", "1" if env.tcg_cases else "0"),
                     ("tier", r.test.tier), ("requires", " ".join(r.test.requires))] + r.params:
            ET.SubElement(props, "property", name=k, value=v)
        for status, desc in r.checks:
            case = ET.SubElement(suite, "testcase", classname=r.test.name, name=desc)
            if status == "SKIP":
                ET.SubElement(case, "skipped")
            elif status != "PASS":
                ET.SubElement(case, "failure", message="check failed")
        case = ET.SubElement(suite, "testcase", classname=r.test.name, name=r.test.name,
                             time=str(r.duration))
        if r.status == "skip":
            ET.SubElement(case, "skipped", message=r.reason)
        elif r.status == "timeout":
            ET.SubElement(case, "failure", type="timeout", message=r.reason)
        elif r.status != "pass":
            ET.SubElement(case, "failure", message=r.reason)
        ET.SubElement(case, "system-out").text = tail(os.path.join(logs_dir, r.test.name + ".log"))
    ET.ElementTree(root).write(path, encoding="UTF-8", xml_declaration=True)


def write_json(path, results, env, tier, status_code, running):
    data = {
        "run_id": env.run_id, "runtime": env.runtime, "mock": env.mock, "accel": env.accel,
        "tcg_cases": env.tcg_cases, "tier": tier,
        "complete": status_code is not None, "running": running, "status": status_code,
        "tests": [{
            "name": r.test.name, "tier": r.test.tier, "requires": r.test.requires,
            "status": r.status, "exit_code": r.rc, "duration": r.duration, "reason": r.reason,
            "checks": [{"status": s, "description": d} for s, d in r.checks],
            "params": dict(r.params),
        } for r in results],
    }
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


def write_results(results_dir, logs_dir, results, env, args, selected, status_code=None, running=None):
    """Write all results files for the tests run so far. With status_code None, the run is still in
    progress, with the test named by 'running' (if any) under way. Each file is written to a
    temporary name and renamed into place, so that a reader never sees a partly written file."""
    counts = {s: sum(1 for r in results if r.status == s) for s in ("pass", "fail", "timeout", "skip")}
    header = "run id: %s; runtime: %s; mock: %d; accel: %s; tcg cases: %d; tier: %s" % (
        env.run_id, env.runtime, int(args.mock), args.accel or "default", int(env.tcg_cases), args.tier)

    lines = ["%-8s %-32s %5ss  %s" % (r.status.upper(), r.test.name, r.duration, r.reason) for r in results]
    if running:
        lines.append("%-8s %s" % ("RUNNING", running))
    lines += ["", "passed: %d  failed: %d  timed out: %d  skipped: %d  (of %d selected)"
              % (counts["pass"], counts["fail"], counts["timeout"], counts["skip"], len(selected))]
    if status_code is None:
        lines.append("in progress: %d of %d tests done" % (len(results), len(selected)))
    summary = "\n".join(lines) + "\n"

    def replace(name, write):
        path = os.path.join(results_dir, name)
        write(path + ".tmp")
        os.replace(path + ".tmp", path)

    def write_text(text):
        def write(path):
            with open(path, "w") as f:
                f.write(text)
        return write

    replace("results.tap", lambda p: write_tap(p, results, header))
    replace("junit.xml", lambda p: write_junit(p, results, env, logs_dir))
    replace("results.json", lambda p: write_json(p, results, env, args.tier, status_code, running))
    replace("summary.txt", write_text(summary))
    replace("status", write_text("running\n" if status_code is None else "%d\n" % status_code))
    return summary


class Terminated(Exception):
    """Raised on SIGTERM, to stop the run as on SIGINT, but with exit status 143."""


def on_sigterm(signum, frame):
    raise Terminated()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def truthy(value):
    return (value or "").strip().lower() in ("1", "yes", "true", "on")


def parse_args(argv):
    here = os.path.dirname(os.path.abspath(__file__))
    p = argparse.ArgumentParser(
        prog=os.path.basename(sys.argv[0]),
        description="Run RunCVM integration tests. TEST may be a test directory name "
                    "(e.g. 10-user-workdir) or a shell pattern (e.g. '1*'). With no TEST, "
                    "all tests in the selected tier run.",
        epilog="Environment: RUNTIME, RUNCVM_TEST_ENGINE, RUNCVM_TEST_MOCK, RUNCVM_TEST_ACCEL, RUNCVM_TEST_TCG_CASES, "
               "RUNCVM_TEST_RUN_ID, RUNCVM_TEST_RESULTS, "
               "RUNCVM_TEST_KILL_AFTER (seconds between SIGTERM and SIGKILL on timeout; "
               "default %d), RUNCVM_TEST_JOBS (Container/VMs a test may run at once; default 3). See the comment at the top of this file for details." % DEFAULT_KILL_AFTER)
    p.add_argument("tests", nargs="*", metavar="TEST")
    p.add_argument("-t", "--tier", choices=TIERS + ("all",), default="all",
                   help="tier to run (default: all)")
    p.add_argument("-T", "--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help="default per-test timeout in seconds (default: %d)" % DEFAULT_TIMEOUT)
    p.add_argument("-r", "--results", metavar="DIR", default=os.environ.get("RUNCVM_TEST_RESULTS"),
                   help="results directory (default: $RUNCVM_TEST_RESULTS, else "
                        "${TMPDIR:-/tmp}/runcvm-tests/<run-id>)")
    p.add_argument("-d", "--dir", default=here, help="tests directory (default: this script's directory)")
    p.add_argument("--runtime", default=None,
                   help="container runtime under test (default: $RUNTIME, else runcvm; runc with --mock)")
    p.add_argument("--engine", choices=("docker", "podman"),
                   default=os.environ.get("RUNCVM_TEST_ENGINE") or "docker",
                   help="container engine whose CLI runs the tests: docker (default), or rootful "
                        "podman, through its Docker-compatible CLI")
    p.add_argument("--mock", action="store_true", default=truthy(os.environ.get("RUNCVM_TEST_MOCK")),
                   help="stand-in mode: use a standard runtime and skip tests requiring 'vm'")
    p.add_argument("--accel", choices=ACCELS, default=os.environ.get("RUNCVM_TEST_ACCEL") or None,
                   help="QEMU acceleration for RunCVM Container/VMs (passed as RUNCVM_QEMU_ACCEL): "
                        "kvm, auto or tcg (software emulation); default: RunCVM's default")
    p.add_argument("--tcg-cases", action="store_true", default=truthy(os.environ.get("RUNCVM_TEST_TCG_CASES")),
                   help="run checks that launch Container/VMs under software emulation (TCG) even "
                        "where VMs use KVM (always on with --accel tcg, or without /dev/kvm)")
    p.add_argument("-v", "--verbose", action="store_true", default=truthy(os.environ.get("RUNCVM_TEST_VERBOSE")),
                   help="show tests' detail lines on the terminal as well as in their logs")
    p.add_argument("-x", "--exitfirst", action="store_true", help="stop after the first failure or timeout")
    p.add_argument("-l", "--list", action="store_true", help="list selected tests and exit")
    p.add_argument("--no-preflight", action="store_true",
                   help="skip Docker checks and clean-up (for tests that do not use Docker)")
    return p.parse_args(argv)


def choose_runtime(args):
    if args.runtime:
        return args.runtime
    env_runtime = os.environ.get("RUNTIME")
    if args.mock:
        return env_runtime if env_runtime and not env_runtime.startswith("runcvm") else "runc"
    return env_runtime or "runcvm"


def main(argv):
    args = parse_args(argv)
    tests_dir = os.path.abspath(args.dir)
    if not os.path.isdir(tests_dir):
        raise HarnessError("tests directory '%s' not found" % args.dir)

    runtime = choose_runtime(args)
    run_id = os.environ.get("RUNCVM_TEST_RUN_ID") or "%s-%d" % (time.strftime("%Y%m%d-%H%M%S"), os.getpid())
    kill_after = int(os.environ.get("RUNCVM_TEST_KILL_AFTER") or DEFAULT_KILL_AFTER)

    selected = select(discover(tests_dir, args.timeout), args.tier, args.tests)
    for t in selected:
        if t.tier not in TIERS:
            raise HarnessError("test '%s' has unknown tier '%s'" % (t.name, t.tier))
        for req in t.requires:
            if req not in KNOWN_REQUIREMENTS and not DOCKER_VERSION_REQUIREMENT.match(req):
                raise HarnessError("test '%s' has unknown requirement '%s' (known: %s)"
                                   % (t.name, req, ", ".join(KNOWN_REQUIREMENTS + ("docker>=<major>.<minor>",))))

    if args.list:
        for t in selected:
            print("%-32s %-9s %6ss  %s" % (t.name, t.tier, t.timeout, " ".join(t.requires)))
        return 0
    if not selected:
        raise HarnessError("no tests selected (tier '%s'%s)"
                           % (args.tier, ", patterns: " + " ".join(args.tests) if args.tests else ""))

    if args.engine == "podman":
        os.environ["PATH"] = os.path.join(tests_dir, "engines", "podman") + os.pathsep + os.environ.get("PATH", "")
    env = Environment(runtime, args.mock, run_id, use_docker=not args.no_preflight, accel=args.accel,
                      tcg_cases=args.tcg_cases, engine=args.engine)
    if not args.no_preflight:
        env.preflight()

    results_dir = args.results or os.path.join(os.environ.get("TMPDIR", "/tmp"), "runcvm-tests", run_id)
    logs_dir = os.path.join(results_dir, "logs")
    try:
        os.makedirs(logs_dir, exist_ok=True)
    except OSError as e:
        raise HarnessError("cannot create results directory '%s': %s" % (results_dir, e))

    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, on_sigterm)

    say("Running RunCVM integration tests")
    say("  run id:   %s" % run_id)
    say("  engine:   %s" % args.engine)
    say("  runtime:  %s%s" % (runtime, " (stand-in mode)" if args.mock else ""))
    say("  accel:    %s" % (args.accel or "(RunCVM default)"))
    say("  tcg:      %s" % ("cases run" if env.tcg_cases else "cases skipped (--tcg-cases to run them)"))
    say("  tier:     %s" % args.tier)
    say("  tests:    %s" % " ".join(t.name for t in selected))
    say("  results:  %s" % results_dir)
    say()

    results = []
    stopped = None  # 130 (SIGINT) or 143 (SIGTERM) if the run was stopped
    try:
        write_results(results_dir, logs_dir, results, env, args, selected)
        for t in selected:
            unmet = [r for r in t.requires if not env.requirement_met(r)]
            if unmet:
                notes = [env._probe_notes[r] for r in unmet if r in env._probe_notes]
                if "vm" in unmet and args.mock:
                    notes.insert(0, "stand-in mode")
                reason = "requires %s%s" % (", ".join(unmet), " (%s)" % "; ".join(notes) if notes else "")
                with open(os.path.join(logs_dir, t.name + ".log"), "w") as f:
                    f.write("SKIP: %s\n" % reason)
                results.append(Result(t, "skip", None, 0, reason))
                say("=== %s: SKIP (%s)\n" % (t.name, reason))
                write_results(results_dir, logs_dir, results, env, args, selected)
                continue

            write_results(results_dir, logs_dir, results, env, args, selected, running=t.name)
            say("=== %s (tier %s, timeout %ss)" % (t.name, t.tier, t.timeout))
            try:
                r = run_test(t, env, logs_dir, kill_after, verbose=args.verbose)
            except (KeyboardInterrupt, Terminated) as e:
                stopped = 143 if isinstance(e, Terminated) else 130
                r = Result(t, "interrupted", None, 0, "terminated" if stopped == 143 else "interrupted")
            env.reap(t.name)
            results.append(r)
            say("=== %s: %s%s in %ss\n" % (t.name, r.status.upper(), " (%s)" % r.reason if r.reason else "",
                                          r.duration))
            if stopped:
                break
            write_results(results_dir, logs_dir, results, env, args, selected)
            if args.exitfirst and r.status in ("fail", "timeout"):
                say("Stopping after first failure (--exitfirst)")
                break
    except (KeyboardInterrupt, Terminated) as e:
        # Stopped between tests: the results so far are complete.
        stopped = stopped or (143 if isinstance(e, Terminated) else 130)

    # The final results must be written whole, so further SIGINT and SIGTERM wait until they are.
    signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM})
    failed = any(r.status in ("fail", "timeout") for r in results)
    status_code = stopped or (1 if failed else 0)
    summary = write_results(results_dir, logs_dir, results, env, args, selected, status_code)

    say(summary, end="")
    say("Results: %s (results.tap, junit.xml, results.json, summary.txt, logs/)" % results_dir)
    say("RunCVM integration tests completed with status %d" % status_code)
    return status_code


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except HarnessError as e:
        print("%s: Error: %s" % (os.path.basename(sys.argv[0]), e), file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        sys.exit(130)
    except Terminated:
        sys.exit(143)
