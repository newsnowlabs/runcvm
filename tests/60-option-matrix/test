#!/usr/bin/env python3
"""RunCVM options that no other test runs, under the strictest confinement.

The processes RunCVM runs in the container (QEMU, virtiofsd, dnsmasq, and
RunCVM's scripts and tools) run here under RunCVM's own seccomp profile
(RUNCVM_SECCOMP=minimal) and capability set (RUNCVM_CAPS at its default,
minimal), which allow only what those processes need; which system calls they
make depends on the options a Container/VM is launched with. Each case launches one
Container/VM, with a disk where the option concerns its I/O or memory, on a
user-defined network:

- disks: RUNCVM_DISK_AIO=threads;
- memory: RUNCVM_HUGETLB=1 (where the host has at least 1 GiB of free
  hugepages) and RUNCVM_QEMU_MEM_PREALLOC=on;
- network: RUNCVM_QEMU_NET_VHOST=1 (where the host has /dev/vhost-net), and
  RUNCVM_IPV6=1 on a dual-stack network (where one can be created);
- display and devices: RUNCVM_DISPLAY_MODE=vnc with RUNCVM_QEMU_VGA=std;
  RUNCVM_QEMU_VGA=cirrus (x86-64); RUNCVM_DISPLAY_MODE=serial;
  RUNCVM_QEMU_DISPLAY=curses (with a terminal); RUNCVM_QEMU_USB=on;
  RUNCVM_BIOS=EFI (x86-64);
- virtiofsd: RUNCVM_VIRTIOFSD_KILLPRIV=1.

Each Container/VM boots and serves 'docker exec', with and without a
terminal; writes a file to its disk, where it has one, and reads it back;
writes, chowns and removes a file in the VM's root filesystem, through
virtiofsd; resolves its own name through DNS; has its network interface up;
and shuts down cleanly when asked to stop: its workload exits on SIGTERM, with
status 0, within docker stop's timeout. Each
option's own effect is checked too: in QEMU's or virtiofsd's command line
(the disk's aio mode, the memory backend's hugetlb or prealloc, vhost-net,
the VGA device, the serial monitor, the curses display, USB, the EFI
firmware, virtiofsd's --killpriv-v2), or for RUNCVM_IPV6=1, a global IPv6
address in the VM. Other options are left to their own tests, e.g.
disk filesystems and layouts to 21-disks and 29-multipath-disks, VNC to
36-vnc, CPU and memory sizes to 22-resources, extra networks to
38-multi-network, and capabilities and seccomp to 55-seccomp,
57-capabilities and 59-confinement-matrix.
"""

import os
import random
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

BOOT_TIMEOUT = 600 if t.ACCEL == "tcg" else 180
IMAGE = "alpine"
SIZE = 128 << 20
ARCH = os.uname().machine
DISK = "/disks/d,/srv/d,ext4,%d" % SIZE
STOP_TIMEOUT = 10
# Exits on docker stop's SIGTERM, which the VM's PID 1 otherwise ignores.
WORKLOAD = 'trap "exit 0" TERM; sleep infinity & wait'
X86 = ARCH == "x86_64"

# Each option's effect: (process, a string in its command line), or "ipv6" for a global IPv6 address.
EFFECTS = {
    "aio-threads": ("qemu", "aio=threads"),
    "hugetlb": ("qemu", "hugetlb=on"),
    "prealloc": ("qemu", "prealloc=on"),
    "vhost": ("qemu", "vhost=on"),
    "ipv6": "ipv6",
    "vnc-std": ("qemu", "-vga std" if X86 else "bochs-display"),
    "vga-cirrus": ("qemu", "-vga cirrus"),
    "serial": ("qemu", "-mon chardev=char0"),
    "curses": ("qemu", "-display curses"),
    "usb": ("qemu", "usb=on" if X86 else "qemu-xhci"),
    "efi": ("qemu", "OVMF.fd"),
    "virtiofsd-killpriv": ("virtiofsd", "--killpriv-v2"),
}


def hugepages_free():
    """The host's free hugepage memory, in bytes."""
    free = size = 0
    with open("/proc/meminfo") as f:
        for line in f:
            if line.startswith("HugePages_Free:"):
                free = int(line.split()[1])
            elif line.startswith("Hugepagesize:"):
                size = int(line.split()[1]) * 1024
    return free * size


# (name, docker run options, disk spec or None, reason to skip or None)
CASES = [
    ("aio-threads", ["--env", "RUNCVM_DISK_AIO=threads"], DISK, None),
    ("hugetlb", ["--memory=512m", "--env", "RUNCVM_HUGETLB=1"], DISK,
     None if hugepages_free() >= (1 << 30) else "the host has less than 1 GiB of free hugepages"),
    ("prealloc", ["--env", "RUNCVM_QEMU_MEM_PREALLOC=on"], DISK, None),
    ("vhost", ["--env", "RUNCVM_QEMU_NET_VHOST=1"], DISK,
     None if os.path.exists("/dev/vhost-net") else "the host has no /dev/vhost-net"),
    ("ipv6", ["--env", "RUNCVM_IPV6=1"], None, None),
    ("vnc-std", ["--env", "RUNCVM_DISPLAY_MODE=vnc", "--env", "RUNCVM_QEMU_VGA=std"], None, None),
    ("vga-cirrus", ["--env", "RUNCVM_QEMU_VGA=cirrus"], None,
     None if ARCH == "x86_64" else "cirrus is x86-64 only"),
    ("serial", ["--env", "RUNCVM_DISPLAY_MODE=serial"], None, None),
    ("curses", ["-t", "--env", "RUNCVM_QEMU_DISPLAY=curses"], None, None),
    ("usb", ["--env", "RUNCVM_QEMU_USB=on"], None, None),
    ("efi", ["--env", "RUNCVM_BIOS=EFI"], DISK, None if ARCH == "x86_64" else "EFI is x86-64 only"),
    ("virtiofsd-killpriv", ["--env", "RUNCVM_VIRTIOFSD_KILLPRIV=1"], None, None),
]

NETWORK = t.unique("options")
t.docker("network", "create", *t.labels(), NETWORK, check=True)
t.cleanup_network(NETWORK)
NETWORK6 = t.unique("options-ipv6")
SUBNET6 = "fd00:%04x:%04x::/64" % (random.randrange(1 << 16), random.randrange(1 << 16))
if t.docker("network", "create", *t.labels(), "--ipv6", "--subnet=" + SUBNET6, NETWORK6).returncode == 0:
    t.cleanup_network(NETWORK6)
else:
    CASES = [(n, o, d, "no IPv6 network could be created" if n == "ipv6" else s) for n, o, d, s in CASES]

RUNS = [c for c in CASES if c[3] is None]


def run(case):
    name, opts, disk, _ = case
    container = t.unique("option-" + name)
    disk_opts = []
    if disk:
        volume = t.unique("option-" + name)
        t.volume_create(volume)
        disk_opts = ["--mount", "type=volume,src=%s,dst=/disks" % volume, "--env", "RUNCVM_DISKS=" + disk]
    network = NETWORK6 if name == "ipv6" else NETWORK
    t.cleanup_container(container)
    r = t.docker("create", "--name", container, *t.labels(), "--runtime=" + t.RUNTIME, *t.vm_opts(),
                 "--network", network, "--env", "RUNCVM_SECCOMP=minimal", *opts, *disk_opts,
                 IMAGE, "sh", "-c", WORKLOAD)
    if r.returncode == 0:
        r = t.docker("start", container)
    results = {}
    if r.returncode != 0 or not t.wait_for_exec(container, BOOT_TIMEOUT):
        results["error"] = (r.stdout or "") + t.docker("logs", container).stdout
        return results
    if disk:
        results["disk"] = t.docker("exec", container, "sh", "-c",
                                   "echo written >/srv/d/f && sync && cat /srv/d/f").stdout.strip()
    results["rootfs"] = t.docker("exec", container, "sh", "-c",
                                 "echo a >/root/f && chown 12:34 /root/f && stat -c %u:%g /root/f"
                                 " && rm /root/f").stdout.strip()
    results["tty"] = t.docker("exec", "-t", container, "sh", "-c", "echo tty-ok").stdout.strip()
    # As an absolute name, so that the host's search domains (which the container inherits) play no
    # part in the lookup.
    results["dns"] = t.docker("exec", container, "nslookup", container + ".").returncode
    results["interfaces"] = len([line for line in t.docker("exec", container, "ip", "-o", "link", "show", "up")
                                 .stdout.splitlines() if ": lo:" not in line])
    effect = EFFECTS[name]
    if effect == "ipv6":
        results["effect"] = t.docker("exec", container, "ip", "-6", "-o", "addr", "show", "scope",
                                     "global").stdout.strip() != ""
    else:
        process, text = effect
        r = t.docker("top", container, "-eo", "pid,args")
        # By name anywhere in the line, as RunCVM runs each binary through its own loader.
        results["effect"] = any(process in line and text in line for line in r.stdout.splitlines()[1:])
    started = time.time()
    t.docker("stop", "-t", str(STOP_TIMEOUT), container)
    results["stop_seconds"] = time.time() - started
    results["stopped"] = t.docker("inspect", "-f", "{{.State.Running}} {{.State.ExitCode}}",
                                  container).stdout.strip()
    return results


t.param("arch", ARCH)
for name, _, _, reason in CASES:
    if reason:
        t.skip_check("%s: Container/VM boots" % name, reason)

for (name, opts, disk, _), results in zip(RUNS, t.parallel(run, RUNS, remove=True)):
    if not t.check("%s: Container/VM boots and 'docker exec' works" % name, True, "error" not in results):
        t.log(results["error"])
        continue
    if disk:
        t.check("%s: disk reads back what was written" % name, "written", results["disk"])
    t.check("%s: file chowned in the VM's root filesystem" % name, "12:34", results["rootfs"])
    t.check("%s: 'docker exec -t' works" % name, "tty-ok", results["tty"])
    t.check("%s: own name resolves through DNS" % name, 0, results["dns"])
    t.check("%s: network interface up" % name, 1, results["interfaces"])
    t.check("%s: option takes effect" % name, True, results["effect"])
    t.check("%s: stops when asked to, with its workload's exit status" % name, "false 0", results["stopped"])
    t.check("%s: shuts down within docker stop's timeout" % name, True,
            results["stop_seconds"] < STOP_TIMEOUT)

t.finish()
