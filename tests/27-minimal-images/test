#!/usr/bin/env python3
"""Minimal images run in RunCVM Container/VMs.

hello-world holds only a static binary: no shell, no /etc/group, no
/etc/fstab, no tools. RunCVM's VM start-up uses only its own tools, so the
binary runs and its output arrives, with and without --init, and with a
RUNCVM_DISKS disk or a --tmpfs mount, which RunCVM mounts without an
/etc/fstab in the image.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

TIMEOUT = 600 if t.ACCEL == "tcg" else 120

MOUNTS = {
    "": [],
    "disk": ["--env", "RUNCVM_DISKS=/disks/data,/data,ext4,64M"],
    "tmpfs": ["--tmpfs", "/scratch"],
}

for mount, mount_opts in MOUNTS.items():
    for init in (False, True):
        mode = ("--init" if init else "no --init") + (", with a %s" % mount if mount else "")
        name = t.unique("hello-world" + ("-init" if init else "") + ("-" + mount if mount else ""))
        r = t.docker("run", "--rm", "--name", name, *t.labels(),
                     "--runtime=" + t.RUNTIME, *t.vm_opts(), *(["--init"] if init else []),
                     *mount_opts, "hello-world", timeout=TIMEOUT)
        if not t.check("hello-world, %s: output arrives" % mode, True, "Hello from Docker!" in r.stdout):
            t.log("output:\n%s" % r.stdout)
        t.check("hello-world, %s: exit status" % mode, 0, r.returncode)

t.finish()
