#!/usr/bin/env python3
"""Kernels and images in RunCVM Container/VMs.

- Each kernel installed with RunCVM (RUNCVM_KERNEL=<dist>) boots, and
  loads kernel modules from the modules RunCVM provides (modprobe ip_vs),
  except the OpenWrt kernel, for which no module list is provided.
- Without RUNCVM_KERNEL, the kernel follows the image's distribution: the
  first, among its os-release ID and then each word of its ID_LIKE, that
  RunCVM has a kernel for. Other RHEL-family distributions (Oracle Linux,
  Rocky Linux, Amazon Linux) take the AlmaLinux kernel, openSUSE
  Tumbleweed (like Leap) the openSUSE kernel, and Kali Linux
  (ID_LIKE=debian) the Debian kernel.
- RUNCVM_KERNEL naming a distribution of a family (ol) boots the family's
  kernel.
- Each release of each distribution that RunCVM aims to support boots, from
  an image tagged with that release (listed in README.md's Supported
  distributions), so that each case names the release it tests. With
  tests/run --pull, the images are pulled first, so that each tag is tested
  as published now; otherwise the host's copies are used.
- An OpenWrt image, imported from OpenWrt's x86 rootfs (once per host, or
  again with --pull), gets the OpenWrt kernel.
- An image with no os-release gets Debian's kernel silently. An image of any
  other distribution (Arch Linux, Wolfi) gets Debian's kernel and shows the
  fallback-kernel warning; no other image shows it.
- /etc/os-release is read within the image: an absolute symbolic link names
  a file in the image, not the host's.
- An image's USER and WORKDIR apply in the VM.
- An entrypoint that cannot be executed: the error is shown, and the exit
  status is 0, as when any entrypoint exits without setting one (see
  tests/14-exit-codes).

The expected values describe current behaviour. A change to it must update
them deliberately.
"""

import atexit
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import framework as t  # noqa: E402

KERNELS_DIR = "/opt/runcvm/kernels"
TIMEOUT = 600 if t.ACCEL == "tcg" else 120
PROBE = 'echo "uname=$(uname -r)"; echo "id=$(id -u)"; echo "pwd=$(pwd)"; modprobe ip_vs 2>/dev/null && echo "modprobe=ok"'


def kernel_version(dist):
    """The version that a kernel dist's 'latest' link points to on this host, or None."""
    try:
        return os.path.basename(os.readlink(os.path.join(KERNELS_DIR, dist, "latest")))
    except OSError:
        return None


# (image, expected kernel dist): an image tagged with each release that RunCVM aims to support (see
# README.md's Supported distributions), then rolling and other distributions' images.
IMAGES = (("alpine:3.22", "alpine"), ("alpine:3.23", "alpine"), ("alpine:3.24", "alpine"),
          ("debian:bookworm-slim", "debian"), ("debian:trixie-slim", "debian"),
          ("ubuntu:22.04", "ubuntu"), ("ubuntu:24.04", "ubuntu"), ("ubuntu:26.04", "ubuntu"),
          ("almalinux:8", "almalinux"), ("almalinux:9", "almalinux"), ("almalinux:10", "almalinux"),
          ("rockylinux/rockylinux:8", "almalinux"), ("rockylinux/rockylinux:9", "almalinux"),
          ("rockylinux/rockylinux:10", "almalinux"),
          ("oraclelinux:8", "almalinux"), ("oraclelinux:9", "almalinux"), ("oraclelinux:10", "almalinux"),
          ("amazonlinux:2023", "almalinux"),
          ("fedora:44", "fedora"), ("fedora:45", "fedora"),
          ("opensuse/leap:16.0", "opensuse"), ("opensuse/leap:16.1", "opensuse"),
          ("opensuse/tumbleweed", "opensuse"),
          ("kalilinux/kali-rolling", "debian"),
          ("busybox", "debian"),
          ("archlinux", "debian"),
          ("cgr.dev/chainguard/wolfi-base", "debian"))

t.pull_images(["alpine"] + [i for i, _ in IMAGES])

# OpenWrt publishes no container image: import its x86 rootfs as one, once per host (or again with
# --pull). Like a pulled image, it is kept for later runs.
OPENWRT_RELEASE = "25.12.6"
OPENWRT_IMAGE = "runcvm-test/openwrt:" + OPENWRT_RELEASE
OPENWRT_ROOTFS = ("https://downloads.openwrt.org/releases/{0}/targets/x86/generic/"
                  "openwrt-{0}-x86-generic-rootfs.tar.gz".format(OPENWRT_RELEASE))
if t.PULL or t.docker("image", "inspect", OPENWRT_IMAGE).returncode != 0:
    r = t.docker("import", OPENWRT_ROOTFS, OPENWRT_IMAGE, timeout=600)
    if not t.check("imported OpenWrt %s" % OPENWRT_RELEASE, 0, r.returncode):
        t.log(r.stdout)

# An image declaring a non-root USER and a WORKDIR, built locally from alpine.
user_image = t.unique("user-image").lower()
subprocess.run(["docker", "build", "-q", *t.labels(), "-t", user_image, "-"], check=True,
               input="FROM alpine\nUSER 1000:1000\nWORKDIR /tmp\n", universal_newlines=True,
               stdout=subprocess.DEVNULL)
atexit.register(lambda: t.docker("rmi", "-f", user_image))

# An alpine image whose /etc/os-release is an absolute symbolic link to /usr/lib/os-release (alpine's
# own is a relative one).
link_image = t.unique("os-release-link").lower()
subprocess.run(["docker", "build", "-q", *t.labels(), "-t", link_image, "-"], check=True,
               input="FROM alpine\nRUN test -f /usr/lib/os-release && "
                     "ln -sfn /usr/lib/os-release /etc/os-release\n",
               universal_newlines=True, stdout=subprocess.DEVNULL)
atexit.register(lambda: t.docker("rmi", "-f", link_image))

FALLBACK_WARNING = "RunCVM has no kernel for the image's distribution"

# (name, docker run options, image and command, expected kernel dist,
#  modprobe expected to work (None: not checked))
CASES = [("kernel-" + k, ["--env=RUNCVM_KERNEL=" + k], ["alpine", "sh", "-c", PROBE], k, k != "openwrt")
         for k in ("alpine", "debian", "ubuntu", "almalinux", "fedora", "opensuse", "openwrt")]
CASES += [("kernel-ol", ["--env=RUNCVM_KERNEL=ol"], ["alpine", "sh", "-c", PROBE], "almalinux", True)]
# Each case is named after its image, tag included, so that releases of one distribution have distinct names.
CASES += [("image-" + i.replace(":", "-").replace("/", "-"), [], [i, "sh", "-c", PROBE], k, None)
          for i, k in IMAGES]
CASES += [("image-openwrt-" + OPENWRT_RELEASE, [], [OPENWRT_IMAGE, "sh", "-c", PROBE], "openwrt", None)]
CASES += [("image-os-release-link", [], [link_image, "sh", "-c", PROBE], "alpine", None)]

# The cases whose image's distribution has no RunCVM kernel, so whose output shows the warning.
FALLBACK_CASES = {"image-archlinux", "image-cgr.dev-chainguard-wolfi-base"}


def run(args):
    name, opts, image_cmd = args
    return t.docker("run", "--rm", "--name", t.unique(name), *t.labels(), "--runtime=" + t.RUNTIME,
                    *t.vm_opts(), *opts, *image_cmd, timeout=TIMEOUT)


RUNS = [(c[0], c[1], c[2]) for c in CASES] + [
    ("user-image", [], [user_image, "sh", "-c", PROBE]),
    ("no-entrypoint", [], ["alpine", "/no/such/program"]),
]
results = dict(zip([r[0] for r in RUNS], t.parallel(run, RUNS)))


def field(output, key):
    for line in output.replace("\r", "").splitlines():
        if line.startswith(key + "="):
            return line.split("=", 1)[1].split()[0]
    return None


for name, opts, image_cmd, dist, modprobe in CASES:
    r = results[name]
    expected = kernel_version(dist)
    if not t.check("%s: booted" % name, 0, r.returncode):
        t.log("output:\n%s" % r.stdout)
        continue
    if expected:
        t.check("%s: runs the %s kernel" % (name, dist), expected, field(r.stdout, "uname"))
    if modprobe is not None:
        t.check("%s: modprobe ip_vs works" % name, modprobe, field(r.stdout, "modprobe") == "ok")
    t.check("%s: %s the fallback-kernel warning" % (name, "shows" if name in FALLBACK_CASES else "does not show"),
            name in FALLBACK_CASES, FALLBACK_WARNING in r.stdout)

r = results["user-image"]
t.check("image USER applies", "1000", field(r.stdout, "id"))
t.check("image WORKDIR applies", "/tmp", field(r.stdout, "pwd"))

r = results["no-entrypoint"]
t.check("entrypoint not found: exit status", 0, r.returncode)
t.check("entrypoint not found: error shown", True, "unable to exec /no/such/program" in r.stdout)


t.finish()
